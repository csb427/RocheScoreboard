<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RocheScoreboard.Mac</AssemblyName>
    <Version>4.1.3</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Roche_Scoreboard/Models/SportMode.cs" Link="Native/Models/SportMode.cs" />
    <Compile Include="../../Roche_Scoreboard/Services/ChangelogService.cs" Link="Native/Services/ChangelogService.cs" />
    <Compile Include="../../Roche_Scoreboard/Models/GoalAnimationStyle.cs" Link="Native/Models/GoalAnimationStyle.cs" />
    <Compile Include="../../Roche_Scoreboard/Models/ScorebugLayout.cs" Link="Native/Models/ScorebugLayout.cs" />
    <Compile Include="../../Roche_Scoreboard/Models/TeamNameDisplayMode.cs" Link="Native/Models/TeamNameDisplayMode.cs" />
    <AvaloniaResource Include="../../Roche_Scoreboard/app.png" Link="Assets/app.png" />
    <InternalsVisibleTo Include="RocheScoreboard.Mac.Tests" />
    <ProjectReference Include="../RocheScoreboard.Core/RocheScoreboard.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="Svg.Skia" Version="3.4.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <Compile Include="../../Roche_Scoreboard/Models/CricketSetupResult.cs" Link="Native/Models/CricketSetupResult.cs" />
    <Compile Include="../../Roche_Scoreboard/Models/SetupResult.cs" Link="Native/Models/SetupResult.cs" />
    <Compile Include="../../Roche_Scoreboard/Models/TeamCatalogEntry.cs" Link="Native/Models/TeamCatalogEntry.cs" />
    <Compile Include="../../Roche_Scoreboard/Models/TeamPreset.cs" Link="Native/Models/TeamPreset.cs" />
  </ItemGroup>
</Project>
