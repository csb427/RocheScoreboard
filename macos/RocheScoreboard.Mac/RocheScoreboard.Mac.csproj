<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RocheScoreboard.Mac</AssemblyName>
    <Version>5.0.0</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Roche_Scoreboard/Services/ChangelogService.cs" Link="Native/Services/ChangelogService.cs" />
    <AvaloniaResource Include="../../Roche_Scoreboard/app.png" Link="Assets/app.png" />
    <AvaloniaResource Include="../../Roche_Scoreboard/Resources/SportArtwork/*-cartoon-v2.png" Link="Assets/SportArtwork/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../Roche_Scoreboard/Resources/ClubLogos/*" Link="Assets/ClubLogos/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Roche_Scoreboard/Resources/CricketClubs.json" LogicalName="Roche_Scoreboard.Resources.CricketClubs.json" />
    <InternalsVisibleTo Include="RocheScoreboard.Mac.Tests" />
    <ProjectReference Include="../RocheScoreboard.Core/RocheScoreboard.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="Svg.Skia" Version="3.4.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />

  </ItemGroup>
</Project>
