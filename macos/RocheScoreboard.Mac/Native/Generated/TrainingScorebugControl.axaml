                                <TextBlock x:Name="UpNextTitle" Text="" Foreground="White" FontSize="96" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis" Margin="0" />
