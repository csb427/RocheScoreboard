                                <Rectangle.Fill>
                                    <DrawingBrush TileMode="Tile" DestinationRect="0,0,22,22">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#42FFD070">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="4,4" RadiusX="2.2" RadiusY="2.2" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Viewbox x:Name="ExpAwayGoalTextViewbox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,12">
                                <TextBlock x:Name="ExpAwayOverlayText" Text="GOAL!" Foreground="White" FontSize="100" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="40" Color="White" Opacity="0.9" port:ProductionNames.Id="ExpAwayOverlayGlow" OffsetX="0" OffsetY="0" />
                                    </TextBlock.Effect>
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="0" ScaleY="0" port:ProductionNames.Id="ExpAwayOverlayScale" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="ExpTeamStoryTakeover" Grid.Column="1" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True" RenderTransformOrigin="50%,0%" ZIndex="205" IsVisible="False">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleY="0" port:ProductionNames.Id="ExpTeamStoryReveal" />
                    </Grid.RenderTransform>
                    <Border x:Name="ExpTeamStorySurface" BorderThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%" port:ProductionNames.Id="ExpTeamStoryGradient">
                                <GradientStop Color="#B8172C" Offset="0" port:ProductionNames.Id="ExpTeamStoryGradientStrong" />
                                <GradientStop Color="#5E0D18" Offset="0.56" port:ProductionNames.Id="ExpTeamStoryGradientMid" />
                                <GradientStop Color="#100308" Offset="1" port:ProductionNames.Id="ExpTeamStoryGradientDark" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image x:Name="ExpTeamStoryLogo" Stretch="UniformToFill" Opacity="0.24" Margin="-28,-46" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Image.Effect>
                                    <BlurEffect Radius="10" />
                                </Image.Effect>
                            </Image>
                            <Rectangle Opacity="0.38">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="#14000000" Offset="0" />
                                        <GradientStop Color="#78000000" Offset="0.58" />
                                        <GradientStop Color="#B8000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border x:Name="ExpTeamStoryPushEdge" Height="5" VerticalAlignment="Bottom" Background="#FFFFFFFF" Opacity="0.9" />
                            <TextBlock x:Name="ExpTeamStoryDirectionIndicator" Text="▲" IsVisible="False" />
                            <UniformGrid x:Name="ExpTeamStoryDirectionHost" Rows="1" Columns="3" Height="8" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="50%,50%" ZIndex="5">
                                <UniformGrid.RenderTransform>
                                    <ScaleTransform port:ProductionNames.Id="ExpTeamStoryDirectionFlip" />
                                </UniformGrid.RenderTransform>
                                <UniformGrid.Resources>
                                    <ControlTheme TargetType="Path" x:Key="{x:Type Path}">
                                        <Setter Property="Data" Value="M 1,5.5 L 6,0.5 L 11,5.5 Z" />
                                        <Setter Property="Width" Value="12" />
                                        <Setter Property="Height" Value="8" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Fill" Value="#FFFFD447" />
                                        <Setter Property="Stroke" Value="#FF101820" />
                                        <Setter Property="StrokeThickness" Value="0.8" />
                                        <Setter Property="StrokeJoin" Value="Round" />
                                    </ControlTheme>
                                </UniformGrid.Resources>
                                <Path />
                                <Path />
                                <Path />
                            </UniformGrid>
                            <Grid x:Name="ExpTeamStoryContent" Margin="12,5" Opacity="0" RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="16" port:ProductionNames.Id="ExpTeamStoryContentTranslate" />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34*" port:ProductionNames.Id="ExpTeamStoryMetricColumn" />
                                    <ColumnDefinition Width="66*" port:ProductionNames.Id="ExpTeamStoryDescriptorColumn" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,4,0">
                                    <TextBlock x:Name="ExpTeamStoryHeadline" Text="7" Foreground="White" FontFamily="{fonts:ProductionFont 'Arial Black'}" Width="250" FontSize="104" FontWeight="Black" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Viewbox>
                                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExpTeamStoryKicker" Text="GOALS&#10;IN A ROW" Foreground="#D7E4F2" FontFamily="{fonts:ProductionFont 'Stolzl Bold'}" FontSize="38" FontWeight="Black" LineHeight="34" TextWrapping="NoWrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                </Viewbox>
                                <TextBlock x:Name="ExpTeamStoryTeamName" Text="HOME TEAM" Foreground="White" FontFamily="{fonts:ProductionFont 'Stolzl Bold'}" FontSize="24" FontWeight="Black" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Stretch" TextAlignment="Left" IsVisible="False" />
                                <TextBlock x:Name="ExpTeamStoryFooter" Text="" IsVisible="False" />
                                <Viewbox x:Name="ExpTeamStoryTimerHost" IsVisible="False">
                                    <TextBlock x:Name="ExpTeamStoryTimer" Text="18:00" />
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Border x:Name="ExpRecentScoresBarBorder" Grid.Column="3" ClipToBounds="True" BorderThickness="1,0,0,0" BorderBrush="#667A8DA6" Background="#07111B" ZIndex="160">
                    <Grid x:Name="ExpRecentScoresContent" Margin="5,3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Viewbox x:Name="ExpRecentScoresHeader" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="1,0,1,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ExpRecentScoresRecentText" Text="RECENT" Foreground="#AFC6DC" FontFamily="{fonts:ProductionFont 'Stolzl Bold'}" FontSize="16" FontWeight="Black" />
                                <TextBlock x:Name="ExpRecentScoresTitleText" Text=" SCORES" Foreground="White" FontFamily="{fonts:ProductionFont 'Stolzl Bold'}" FontSize="16" FontWeight="Black" />
                            </StackPanel>
                        </Viewbox>
                        <Grid IsVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" port:ProductionNames.Id="ExpRecentScoresSpacerColumn" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid Grid.Row="1" x:Name="ExpRecentScoresCards">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
