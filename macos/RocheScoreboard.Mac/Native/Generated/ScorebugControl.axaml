                                <GradientStop Color="#5C470A" Offset="0.0" port:ProductionNames.Id="ExpAwayLogoCellGradStart" />
                                <GradientStop Color="#B68F12" Offset="1.0" port:ProductionNames.Id="ExpAwayLogoCellGradEnd" />
