                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.3" />
                                <GradientStop Color="#00FFFFFF" Offset="0.6" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="HeaderText" Text="TEAM BATTING" Foreground="White" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.5" OffsetX="0" OffsetY="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>
            <Border Grid.Row="1" IsHitTestVisible="False">
                <Border.Background>
                    <SolidColorBrush Color="#CC0000" port:ProductionNames.Id="SeparatorBg" />
                </Border.Background>
                <Border Opacity="0.4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="RowsPanel">
                    <StackPanel.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#0D1526" Offset="0" />
                            <GradientStop Color="#0A1020" Offset="1" />
                        </LinearGradientBrush>
                    </StackPanel.Background>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#020614" Offset="0" />
                        <GradientStop Color="#0E1648" Offset="0.5" />
                        <GradientStop Color="#020614" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
