<UserControl xmlns="https://github.com/avaloniaui" xmlns:port="clr-namespace:RocheScoreboard.Mac.Production" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.CricketSummaryControl" Background="Transparent" port:ProductionNames.Root="True" xmlns:native="clr-namespace:RocheScoreboard.Mac.Native" xmlns:motion="clr-namespace:Roche_Scoreboard.Services" xmlns:services="clr-namespace:Roche_Scoreboard.Services" xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base" xmlns:fonts="clr-namespace:RocheScoreboard.Mac.Native">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="RootGrid" Width="960" Height="540" Background="#0B1120" ClipToBounds="True">
            <Grid.RenderTransform>
                <TranslateTransform X="0" port:ProductionNames.Id="RootTranslate" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Border x:Name="SummaryHeaderPanel" Grid.Row="0">
                <Border.Background>
                    <SolidColorBrush Color="#CC0000" port:ProductionNames.Id="HeaderBg" />
                </Border.Background>
                <Grid>
                    <Image x:Name="SummaryHeaderLogo" Width="480" HorizontalAlignment="Center" Stretch="UniformToFill" Opacity=".15" IsHitTestVisible="False" />
                    <Border x:Name="HeaderSheen" Opacity="0.15" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                <GradientStop Color="#40000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="HeaderShimmer" Opacity="0.06" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.3" />
                                <GradientStop Color="#00FFFFFF" Offset="0.6" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeaderText" Text="TEAM BATTING" Foreground="White" FontSize="40" FontWeight="Bold" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SummaryClock" Grid.Column="1" Foreground="White" FontSize="40" FontWeight="Bold" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="SummaryColumnPanel" Grid.Row="1" IsHitTestVisible="False">
                <Border.Background>
                    <SolidColorBrush Color="#CC0000" port:ProductionNames.Id="SeparatorBg" />
                </Border.Background>
                <Grid x:Name="SummaryColumns" Margin="26,0" />
            </Border>
            <UniformGrid x:Name="RowsPanel" Grid.Row="2" Columns="1" Margin="12,6" ClipToBounds="True" />
            <Border Grid.Row="3" IsVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#020614" Offset="0" />
                        <GradientStop Color="#0E1648" Offset="0.5" />
                        <GradientStop Color="#020614" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="FooterTeamName" Text="TEAM" Foreground="#D6E3EF" FontSize="20" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" x:Name="FooterTeamScore" Text="0/0" Foreground="White" FontSize="28" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" Color="White" Opacity="0.2" OffsetX="0" OffsetY="0" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Grid.Column="3" x:Name="FooterOversLabel" Text="OVERS" Foreground="#D6E3EF" FontSize="16" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="4" x:Name="FooterOvers" Text="0" Foreground="White" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Border Grid.Column="5" Width="1" Height="28" VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0.15" Background="White" />
                        <TextBlock Grid.Column="6" x:Name="FooterStatLabel" Text="RUN RATE" Foreground="#D6E3EF" FontSize="16" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="7" x:Name="FooterStatValue" Text="0.00" Foreground="White" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Border Grid.Column="8" Width="1" Height="28" VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0.15" Background="White" />
                        <TextBlock Grid.Column="9" x:Name="FooterStat2Label" Text="P'SHIP" Foreground="#D6E3EF" FontSize="16" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="10" x:Name="FooterStat2Value" Text="0(0)" Foreground="White" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
