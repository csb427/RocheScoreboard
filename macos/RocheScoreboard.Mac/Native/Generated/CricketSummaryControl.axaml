<UserControl xmlns="https://github.com/avaloniaui" xmlns:port="clr-namespace:RocheScoreboard.Mac.Production" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.CricketSummaryControl" Background="Transparent" port:ProductionNames.Root="True" xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base" xmlns:fonts="clr-namespace:RocheScoreboard.Mac.Native">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="RootGrid" Width="960" Height="540" Background="#0B1120" ClipToBounds="True">
            <Grid.RenderTransform>
                <TranslateTransform X="0" port:ProductionNames.Id="RootTranslate" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="3" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0">
                <Border.Background>
                    <SolidColorBrush Color="#CC0000" port:ProductionNames.Id="HeaderBg" />
                </Border.Background>
                <Grid>
                    <Border Opacity="0.15" IsHitTestVisible="False">
                        <Border.Background>
