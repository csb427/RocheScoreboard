                                        <GradientStop Color="#1E293B" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Image x:Name="HomeCropImage" Stretch="UniformToFill" RenderTransformOrigin="50%,50%" />
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2">
