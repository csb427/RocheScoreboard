                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="BowlingHeaderText" Text="TEAM B BOWLING" Foreground="White" FontSize="19" FontWeight="Black" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="3">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#0D1526" Offset="0" />
                                <GradientStop Color="#0A1020" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="6,4,6,2" CornerRadius="2" Padding="10,0" BorderThickness="2">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#000080" port:ProductionNames.Id="BowlerBorder" />
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#111827" />
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BowlerIndicator" Text="▶" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="#000080" port:ProductionNames.Id="BowlingIndicatorBrush" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Grid.Column="1" x:Name="BowlerName" Text="M. STARC" Foreground="White" FontSize="21" FontWeight="Black" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Column="2" ClipToBounds="True" Height="26" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="BowlerFigures" Text="0-0" Foreground="White" FontSize="20" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform Y="0" port:ProductionNames.Id="BowlerFiguresTranslate" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <Grid Grid.Column="3" ClipToBounds="True" Height="18" VerticalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock x:Name="BowlerOvers" Text="0" Foreground="#D6E3EF" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform Y="0" port:ProductionNames.Id="BowlerOversTranslate" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Margin="6,2,6,4" CornerRadius="2" Padding="10,0" BorderThickness="2">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#000080" port:ProductionNames.Id="PrevBowlerBorderBrush" />
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#111827" />
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="   " FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" x:Name="PrevBowlerName" Text="" Foreground="#D6E3EF" FontSize="20" FontWeight="Black" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" x:Name="PrevBowlerFigures" Text="" Foreground="#94A3B8" FontSize="20" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="3" x:Name="PrevBowlerOvers" Text="" Foreground="#B7C5D3" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" VerticalAlignment="Center" Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Row="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#060D2E" Offset="0.0" />
                        <GradientStop Color="#0E1648" Offset="0.5" />
                        <GradientStop Color="#060D2E" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Canvas ClipToBounds="True">
                        <TextBlock x:Name="MarqueeText" Text="" Foreground="White" FontSize="42" FontWeight="Bold" Canvas.Top="14">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="800" port:ProductionNames.Id="MarqueeTranslate" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                    <Border x:Name="StatsBarBg" Opacity="0" Padding="8,6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#060D2E" Offset="0.0" />
                                <GradientStop Color="#0E1648" Offset="0.5" />
                                <GradientStop Color="#060D2E" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform Y="30" port:ProductionNames.Id="StatsBarTranslate" />
                        </Border.RenderTransform>
                        <UniformGrid Columns="4" Rows="1">
                            <Border CornerRadius="8" Background="#111B2E" Margin="3,0" Padding="8,4">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="Stat1Label" Text="EXTRAS" Foreground="#D6E3EF" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Stat1Value" Text="0" Foreground="White" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Background="#111B2E" Margin="3,0" Padding="8,4">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="Stat2Label" Text="P'SHIP" Foreground="#D6E3EF" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Stat2Value" Text="0(0)" Foreground="White" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Background="#111B2E" Margin="3,0" Padding="8,4">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="Stat3Label" Text="RUN RATE" Foreground="#D6E3EF" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Stat3Value" Text="0.00" Foreground="White" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Background="#111B2E" Margin="3,0" Padding="8,4">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="Stat4Label" Text="" Foreground="#D6E3EF" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Stat4Value" Text="" Foreground="White" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>
                    <Border x:Name="OverTrackerBg" Opacity="0" Padding="16,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#060D2E" Offset="0.0" />
                                <GradientStop Color="#0E1648" Offset="0.5" />
                                <GradientStop Color="#060D2E" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform Y="30" port:ProductionNames.Id="OverTrackerTranslate" />
                        </Border.RenderTransform>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock x:Name="OverTrackerLabel" Text="OVER 1" Foreground="#94A3B8" FontSize="16" FontWeight="Black" />
                                <Border Height="2" Margin="0,2,0,0" Opacity="0.4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Color="#818CF8" Offset="0" />
                                            <GradientStop Color="#00818CF8" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" x:Name="OverBallsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock x:Name="OverRunsLabel" Text="" Foreground="#C4D0DB" FontSize="17" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="OverRunsValue" Text="" Foreground="White" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="EventOverlay" Grid.Row="0" Grid.RowSpan="4" IsHitTestVisible="False" Opacity="0" ClipToBounds="True">
                <Border.Background>
                    <SolidColorBrush Color="#00000000" port:ProductionNames.Id="EventOverlayBg" />
                </Border.Background>
                <Grid>
                    <Rectangle x:Name="EventGradientBar" Width="2000" Height="600" HorizontalAlignment="Left" Opacity="0.6">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" port:ProductionNames.Id="EventGradientBarBrush">
                                <GradientStop Color="#FFFFFF" Offset="0.0" />
                                <GradientStop Color="#FFD700" Offset="0.15" />
                                <GradientStop Color="#FF6B00" Offset="0.3" />
                                <GradientStop Color="#FF0080" Offset="0.45" />
                                <GradientStop Color="#8000FF" Offset="0.6" />
                                <GradientStop Color="#00BFFF" Offset="0.75" />
                                <GradientStop Color="#00FF88" Offset="0.9" />
                                <GradientStop Color="#FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-1400" port:ProductionNames.Id="EventGradientScroll" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="EventShimmer" Width="120" Opacity="0" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                <GradientStop Color="#99FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-200" port:ProductionNames.Id="EventShimmerScroll" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Border x:Name="EventScoreGlow" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                <GradientStop Color="#CC000000" Offset="0" port:ProductionNames.Id="EventScoreGlowInner" />
                                <GradientStop Color="#00000000" Offset="1" port:ProductionNames.Id="EventScoreGlowOuter" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Rectangle x:Name="EventEdgeGlow" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock x:Name="EventOverlayText" Text="FOUR!" Foreground="White" FontSize="72" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="40" Color="White" Opacity="0.9" port:ProductionNames.Id="EventOverlayGlow" OffsetX="0" OffsetY="0" />
                        </TextBlock.Effect>
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" port:ProductionNames.Id="EventTextScale" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
