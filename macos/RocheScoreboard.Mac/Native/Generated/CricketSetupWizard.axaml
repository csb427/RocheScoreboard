                                            </Border.Effect>
                                        </Border>
                                        <Border Width="1" Opacity="0.5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.3" />
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.7" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Border x:Name="Step3Panel" ClipToBounds="False" Opacity="0" RenderTransformOrigin="50%,50%" Margin="0" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0" IsVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform X="80" port:ProductionNames.Id="Step3Translate" />
                        </Border.RenderTransform>
                        <Grid>
                            <Border x:Name="PlayersGlow" Opacity="0" IsHitTestVisible="False" IsVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="50%,20%" RadiusX="60%" RadiusY="50%">
                                        <GradientStop Color="#1A58A6FF" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Margin="0,10,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="PlayersHeaderGroup" Opacity="1" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform Y="15" port:ProductionNames.Id="PlayersHeaderTranslate" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="Players" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Enter the line-up now, or continue with 11 placeholders per team." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="1" ns4:WizardPair.MinimumColumnWidth="330">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ns4:OperatorGlassSurface Grid.Column="0" ClipToBounds="True" CornerRadius="26" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" VerticalAlignment="Top" Material="Regular" Padding="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#19191C" Offset="0" />
                                                <GradientStop Color="#1D1D21" Offset="0.5" />
                                                <GradientStop Color="#17171B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Border HorizontalAlignment="Left" Width="3" IsVisible="False">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#0A57FF" port:ProductionNames.Id="HomePlayerSideBrush" />
                                                </Border.Background>
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="20">
                                                <StackPanel Margin="0,6,0,10">
                                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                                                        <TextBlock x:Name="HomePlyTeamName" Text="HOME" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" Color="#58A6FF" Opacity="0" port:ProductionNames.Id="HomePlyGlow" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="PLAYER REGISTRATION" FontSize="9" FontWeight="SemiBold" Foreground="#4058A6FF" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" IsVisible="False" />
                                                    </StackPanel>
                                                    <TextBlock Text="Add Player" Margin="0,0,0,6" Theme="{StaticResource FieldLabel}" />
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="HomePlayerFirstBox" Theme="{StaticResource WizardField}" />
                                                        <TextBox x:Name="HomePlayerLastBox" Grid.Column="2" KeyDown="HomePlayerLastBox_KeyDown" Theme="{StaticResource WizardField}" />
                                                        <Button Grid.Column="4" Width="36" Height="36" Cursor="Hand" Click="AddHomePlayer_Click" VerticalAlignment="Center" Padding="0" MinHeight="0" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Add player">
                                                            <ns2:OperatorSymbol Kind="plus" Width="20" Height="20" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Button>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="44" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="First name" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="{DynamicResource ControlCentre.CaptionSize}" HorizontalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="Last name" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="{DynamicResource ControlCentre.CaptionSize}" HorizontalAlignment="Center" />
                                                    </Grid>
                                                    <Border Height="1" Margin="0,0,0,10">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="#00080C12" Offset="0" />
                                                                <GradientStop Color="#402A3A52" Offset="0.5" />
                                                                <GradientStop Color="#00080C12" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <ItemsControl x:Name="HomePlayerList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,6" CornerRadius="16" Background="{DynamicResource ControlCentre.RaisedBrush}" Padding="12,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="40" />
                                                                            <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                                        <Button Grid.Column="1" Tag="edit-home-player" Click="EditHomePlayer_Click" Width="36" Height="36" MinHeight="0" Padding="0" AutomationProperties.Name="Edit player" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Edit player">
                                                                            <ns2:OperatorSymbol Kind="more" Width="20" Height="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                        </Button>
                                                                        <Button Grid.Column="2" Tag="remove-home-player" Click="RemoveHomePlayer_Click" Width="36" Height="36" MinHeight="0" Padding="0" AutomationProperties.Name="Remove player" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Remove player">
                                                                            <TextBlock Text="×" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </ns4:OperatorGlassSurface>
                                    <Grid Grid.Column="1" HorizontalAlignment="Center" Width="2">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="#002A3A52" Offset="0" />
                                                <GradientStop Color="#AA2A3A52" Offset="0.5" />
                                                <GradientStop Color="#002A3A52" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                    </Grid>
                                    <ns4:OperatorGlassSurface Grid.Column="2" ClipToBounds="True" CornerRadius="26" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" VerticalAlignment="Top" Material="Regular" Padding="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#17171B" Offset="0" />
                                                <GradientStop Color="#1D1D21" Offset="0.5" />
                                                <GradientStop Color="#17171B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Border HorizontalAlignment="Left" Width="3" IsVisible="False">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#7A1A1A" port:ProductionNames.Id="AwayPlayerSideBrush" />
                                                </Border.Background>
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="20">
                                                <StackPanel Margin="0,6,0,10">
                                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                                                        <TextBlock x:Name="AwayPlyTeamName" Text="AWAY" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" Color="#FF6B6B" Opacity="0" port:ProductionNames.Id="AwayPlyGlow" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="PLAYER REGISTRATION" FontSize="9" FontWeight="SemiBold" Foreground="#40FF6B6B" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" IsVisible="False" />
                                                    </StackPanel>
                                                    <TextBlock Text="Add Player" Margin="0,0,0,6" Theme="{StaticResource FieldLabel}" />
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="AwayPlayerFirstBox" Theme="{StaticResource WizardField}" />
                                                        <TextBox x:Name="AwayPlayerLastBox" Grid.Column="2" KeyDown="AwayPlayerLastBox_KeyDown" Theme="{StaticResource WizardField}" />
                                                        <Button Grid.Column="4" Width="36" Height="36" Cursor="Hand" Click="AddAwayPlayer_Click" VerticalAlignment="Center" Padding="0" MinHeight="0" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Add player">
                                                            <ns2:OperatorSymbol Kind="plus" Width="20" Height="20" Foreground="#FF6B6B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Button>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="44" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="First name" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="{DynamicResource ControlCentre.CaptionSize}" HorizontalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="Last name" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="{DynamicResource ControlCentre.CaptionSize}" HorizontalAlignment="Center" />
                                                    </Grid>
                                                    <Border Height="1" Margin="0,0,0,10">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="#00080C12" Offset="0" />
                                                                <GradientStop Color="#402A2A3A" Offset="0.5" />
                                                                <GradientStop Color="#00080C12" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <ItemsControl x:Name="AwayPlayerList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,6" CornerRadius="16" Background="{DynamicResource ControlCentre.RaisedBrush}" Padding="12,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="40" />
                                                                            <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                                        <Button Grid.Column="1" Tag="edit-away-player" Click="EditAwayPlayer_Click" Width="36" Height="36" MinHeight="0" Padding="0" AutomationProperties.Name="Edit player" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Edit player">
                                                                            <ns2:OperatorSymbol Kind="more" Width="20" Height="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                        </Button>
                                                                        <Button Grid.Column="2" Tag="remove-away-player" Click="RemoveAwayPlayer_Click" Width="36" Height="36" MinHeight="0" Padding="0" AutomationProperties.Name="Remove player" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Remove player">
                                                                            <TextBlock Text="×" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </ns4:OperatorGlassSurface>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="Step3bPanel" ClipToBounds="False" Opacity="0" RenderTransformOrigin="50%,50%" Margin="0" Padding="0" CornerRadius="28" Background="Transparent" BorderThickness="0" MinHeight="0" IsVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform X="80" port:ProductionNames.Id="Step3bTranslate" />
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel>
                                <StackPanel x:Name="FormatHeaderGroup" Opacity="1" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform Y="15" port:ProductionNames.Id="FormatHeaderTranslate" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="Match format" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Choose an innings format and the competition delivery rules." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <Grid x:Name="FormatCardsGrid" ns4:WizardPair.MinimumColumnWidth="280" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="LimitedOversCard" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0">
                                        <RadioButton x:Name="LimitedFormatChoice" AutomationProperties.Name="Limited overs" GroupName="MatchFormat" MinHeight="136" Margin="0" Padding="20" HorizontalContentAlignment="Stretch" IsCheckedChanged="Native_FormatChoice_Click_Checked" Theme="{StaticResource SettingsTile}">
                                            <Grid IsHitTestVisible="False">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ns2:OperatorSymbol Kind="clock" Width="26" Height="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Limited overs" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="Set an over limit for each innings." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </RadioButton>
                                    </Border>
                                    <Border x:Name="MultiInningsCard" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0">
                                        <RadioButton x:Name="MultiFormatChoice" AutomationProperties.Name="Multi-innings" GroupName="MatchFormat" MinHeight="136" Margin="0" Padding="20" HorizontalContentAlignment="Stretch" IsCheckedChanged="Native_FormatChoice_Click_Checked" Theme="{StaticResource SettingsTile}">
                                            <Grid IsHitTestVisible="False">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ns2:OperatorSymbol Kind="scorecard" Width="26" Height="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Multi-innings" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="Play without a fixed over limit." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </RadioButton>
                                    </Border>
                                </Grid>
                                <ns4:OperatorGlassSurface Material="Regular" CornerRadius="24" Margin="0,0,0,16" Padding="22" IsVisible="{Binding Visibility, ElementName=OversInputPanel}">
                                    <StackPanel>
                                        <TextBlock Text="Over limit" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                        <StackPanel x:Name="OversInputPanel" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                                            <TextBlock Text="Overs per innings" FontSize="14" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="−" Width="48" Height="48" MinHeight="0" Padding="0" FontSize="24" AutomationProperties.Name="Reduce overs" Click="OversMinus_Click" Theme="{StaticResource CricketActionButton}" />
                                                <Border Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" CornerRadius="16" Height="76" Padding="8,0" Margin="8,0">
                                                    <TextBox x:Name="OversDisplay" Text="20" FontSize="48" Width="104" MaxLength="3" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Foreground="{DynamicResource ControlCentre.TextBrush}" CaretBrush="{DynamicResource ControlCentre.TextBrush}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Overs per innings" KeyDown="OversDisplay_KeyDown" ToolTip.Tip="Enter a whole number from 1 to 100. Enter confirms; Escape restores." TextChanged="Native_OversDisplay_TextChanged" LostFocus="Native_OversDisplay_LostKeyboardFocus" FocusAdorner="{x:Null}">
                                                        <TextBox.Template>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <ScrollViewer x:Name="PART_ContentHost">
                                                                        <TextPresenter x:Name="PART_TextPresenter" Text="{TemplateBinding Text, Mode=TwoWay}" CaretIndex="{TemplateBinding CaretIndex}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" LineHeight="{TemplateBinding LineHeight}" PasswordChar="{TemplateBinding PasswordChar}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" CaretBrush="{TemplateBinding CaretBrush}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </TextBox.Template>
                                                    </TextBox>
                                                </Border>
                                                <Button Content="+" Width="48" Height="48" MinHeight="0" Padding="0" FontSize="24" AutomationProperties.Name="Increase overs" Click="OversPlus_Click" Theme="{StaticResource CricketActionButton}" />
                                            </StackPanel>
                                            <TextBlock Text="OVERS" FontSize="9" FontWeight="SemiBold" Foreground="#6B5A00" HorizontalAlignment="Center" Margin="0,4,0,12" IsVisible="False" />
                                            <TextBlock Text="Quick lengths" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,6" />
                                            <UniformGrid Rows="1" Columns="5" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                                                <Button x:Name="OversPreset20Button" Content="20" MinHeight="42" Padding="4,8" Margin="3" FontSize="16" AutomationProperties.Name="20 overs per innings" Click="OversPreset20_Click" Theme="{StaticResource CricketActionButton}" />
                                                <Button x:Name="OversPreset40Button" Content="40" MinHeight="42" Padding="4,8" Margin="3" FontSize="16" AutomationProperties.Name="40 overs per innings" Click="OversPreset40_Click" Theme="{StaticResource CricketActionButton}" />
                                                <Button x:Name="OversPreset45Button" Content="45" MinHeight="42" Padding="4,8" Margin="3" FontSize="16" AutomationProperties.Name="45 overs per innings" Click="OversPreset45_Click" Theme="{StaticResource CricketActionButton}" />
                                                <Button x:Name="OversPreset50Button" Content="50" MinHeight="42" Padding="4,8" Margin="3" FontSize="16" AutomationProperties.Name="50 overs per innings" Click="OversPreset50_Click" Theme="{StaticResource CricketActionButton}" />
                                                <Button x:Name="OversPreset100Button" Content="100" MinHeight="42" Padding="4,8" Margin="3" FontSize="16" AutomationProperties.Name="100 overs per innings" Click="OversPreset100_Click" Theme="{StaticResource CricketActionButton}" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </ns4:OperatorGlassSurface>
                                <ns4:OperatorGlassSurface BorderBrush="#34465A" BorderThickness="1" Padding="22" Margin="0,0,0,16" Material="Regular" CornerRadius="24">
                                    <StackPanel>
                                        <TextBlock Text="Delivery rules" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="18" FontWeight="Bold" />
                                        <TextBlock Text="Set the competition rules before scoring. Byes and leg-byes count as normal deliveries." Foreground="#B5C6D8" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,10" />
                                        <CheckBox x:Name="ReplaceWideBallsToggle" IsChecked="True" Margin="0,3" Theme="{StaticResource SettingsToggle}">
                                            <TextBlock Text="Bowl an extra ball after a wide" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="15" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox x:Name="ReplaceNoBallsToggle" IsChecked="True" Margin="0,3" Theme="{StaticResource SettingsToggle}">
                                            <TextBlock Text="Bowl an extra ball after a no-ball" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="15" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox x:Name="FreeHitsToggle" IsChecked="False" Margin="0,3" Theme="{StaticResource SettingsToggle}">
                                            <TextBlock Text="Free hit after a no-ball" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="15" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="Free hits include an automatic output alert and the applicable wicket restrictions." Foreground="#B5C6D8" FontSize="12" TextWrapping="Wrap" Margin="56,3,0,0" />
                                    </StackPanel>
                                </ns4:OperatorGlassSurface>
                            </StackPanel>
                            <Grid IsHitTestVisible="False" IsVisible="False">
                                <Grid>
                                    <Border x:Name="FormatGlow" Opacity="0" IsHitTestVisible="False" IsVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="50%,20%" RadiusX="60%" RadiusY="50%">
                                                <GradientStop Color="#1A3FB950" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Margin="0,10,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="Step4Panel" ClipToBounds="False" Opacity="0" RenderTransformOrigin="50%,50%" Background="Transparent" BorderThickness="0" Margin="0" MinHeight="0" Padding="0" IsVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform X="80" port:ProductionNames.Id="Step4Translate" />
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel>
                                <StackPanel x:Name="MsgHeaderGroup" Opacity="1" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform Y="15" port:ProductionNames.Id="MsgHeaderTranslate" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="Venue and options" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Optional details. You can change these during the match." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <ns4:OperatorGlassSurface Background="Transparent" BorderThickness="0" Margin="0,0,0,16" MinHeight="0" Padding="22" ClipToBounds="False" Material="Regular" CornerRadius="26">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ns2:OperatorSymbol Kind="weather" Width="32" Height="32" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Venue weather" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Search the town, suburb or venue used for live conditions." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,14" />
                                            <ComboBox x:Name="SetupWeatherLocation" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="200" VerticalAlignment="Center" FontSize="16" Text="Melbourne, Australia" MinWidth="0" HorizontalAlignment="Stretch" Height="46" Theme="{StaticResource DarkCombo}" />
                                        </StackPanel>
                                    </Grid>
                                </ns4:OperatorGlassSurface>
                                <ns4:OperatorGlassSurface Grid.Column="2" Background="Transparent" BorderBrush="#1A2A40" BorderThickness="0" ClipToBounds="False" Margin="0,0,0,16" MinHeight="0" Padding="4" Material="Regular" CornerRadius="26" IsVisible="False">
                                    <Grid>
                                        <Border x:Name="MsgSectionGlow" Opacity="0.06" IsHitTestVisible="False" IsVisible="False">
                                            <Border.Background>
                                                <RadialGradientBrush Center="50%,15%" RadiusX="60%" RadiusY="50%">
                                                    <GradientStop Color="#3FB950" Offset="0" />
                                                    <GradientStop Color="#00000000" Offset="1" />
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Grid Margin="18,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="▣" FontSize="28" FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="SemiBold" Foreground="#67D17B" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Ticker messages" FontSize="20" FontWeight="SemiBold" Foreground="#3FB950" HorizontalAlignment="Center" />
                                                <TextBlock Text="Scroll across the bottom bar during the game" FontSize="12" FontWeight="SemiBold" Foreground="#2A6030" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border Grid.Row="1" Height="1" Margin="0,0,0,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                        <GradientStop Color="#003FB950" Offset="0" />
                                                        <GradientStop Color="#303FB950" Offset="0.5" />
                                                        <GradientStop Color="#003FB950" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Grid.Row="2" Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Padding="8" CornerRadius="16">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="SetupMessageList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#111113" BorderBrush="#3A3A40" BorderThickness="1" Padding="8,6" Margin="0,0,0,6" CornerRadius="3">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Border Grid.Row="0" Grid.ColumnSpan="4" CornerRadius="2" Padding="6,3" Margin="0,0,0,4" Background="{Binding HighlightBrush}">
                                                                            <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding TextBrush}" />
                                                                        </Border>
                                                                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Background="#060A10" Foreground="#E6EDF3" BorderBrush="#3A3A40" CaretBrush="White" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                                                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="TEXT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                            <Button Width="34" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickItemTextColor_Click" Tag="{Binding}" Background="{Binding TextBrush}" ToolTip.Tip="Click to choose text colour" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="HIGHLIGHT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                            <Button Width="50" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickItemHighlightColor_Click" Tag="{Binding}" Background="{Binding HighlightBrush}" ToolTip.Tip="Click to choose highlight colour. Right-click to clear." PointerReleased="Native_SetupClearItemHighlightColor_Click" />
                                                                        </StackPanel>
                                                                        <Button Grid.Row="1" Grid.Column="3" Content="✕" Width="30" Height="40" FontSize="12" FontWeight="SemiBold" Click="SetupRemoveMessageItem_Click" Tag="{Binding}" Background="#3A1A1A" Foreground="#E6EDF3" BorderBrush="#3A1A1A" VerticalAlignment="Bottom" ToolTip.Tip="Remove this message" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="SetupNewMessageBox" Margin="0,0,6,0" KeyDown="SetupNewMessageBox_KeyDown" Theme="{StaticResource WizardField}" />
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="TEXT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                    <Button x:Name="SetupNewMessageTextColorBtn" Width="34" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickNewTextColor_Click" Background="White" ToolTip.Tip="Choose text colour for new messages" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="HIGHLIGHT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                    <Button x:Name="SetupNewMessageHighlightColorBtn" Width="50" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickNewHighlightColor_Click" Background="Transparent" PointerReleased="Native_SetupClearNewHighlightColor_Click" ToolTip.Tip="Choose highlight colour. Right-click to clear." />
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="Add" Height="30" Click="SetupAddMessage_Click" Theme="{StaticResource SmallBtn}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </ns4:OperatorGlassSurface>
                            </StackPanel>
                            <Grid IsHitTestVisible="False" IsVisible="False">
                                <Grid>
                                    <Border x:Name="MsgGlow" Opacity="0" IsHitTestVisible="False" IsVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="50%,20%" RadiusX="50%" RadiusY="40%">
                                                <GradientStop Color="#203FB950" Offset="0" />
                                                <GradientStop Color="#083FB950" Offset="0.6" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#00000000" Offset="0.3" />
                                                <GradientStop Color="#30000000" Offset="1.0" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Margin="0,10,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1" ns4:WizardPair.MinimumColumnWidth="330">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                                <Grid>
                                                    <Border x:Name="WeatherGlowBg" Opacity="0.08" IsHitTestVisible="False" IsVisible="False">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="50%,40%" RadiusX="50%" RadiusY="50%">
                                                                <GradientStop Color="#58A6FF" Offset="0" />
                                                                <GradientStop Color="#00000000" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="☁" FontFamily="{fonts:ProductionFont 'Segoe UI Symbol'}" Foreground="#8CCBFF" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect Color="#58A6FF" BlurRadius="0" Opacity="0" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="LIVE WEATHER" FontSize="22" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Location for real-time conditions" FontSize="10" FontWeight="SemiBold" Foreground="#3A6090" HorizontalAlignment="Center" Margin="0,6,0,14" />
                                                        <Border Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" MinWidth="260" Padding="4" CornerRadius="16">
                                            </Border>
                                                        <TextBlock Text="TOSS RESULT (OPTIONAL)" FontSize="13" FontWeight="Bold" Foreground="#9CCBFF" Margin="0,18,0,6" IsVisible="False" />
                                                        <ComboBox x:Name="TossWinnerChoice" SelectedIndex="0" MinWidth="260" IsVisible="False" Theme="{StaticResource DarkCombo}">
                                                            <ComboBoxItem Content="Not recorded" />
                                                            <ComboBoxItem Content="Home team won" />
                                                            <ComboBoxItem Content="Away team won" />
                                                        </ComboBox>
                                                        <ComboBox x:Name="TossDecisionChoice" SelectedIndex="0" MinWidth="260" Margin="0,8,0,0" IsVisible="False" Theme="{StaticResource DarkCombo}">
                                                            <ComboBoxItem Content="Elected to bat" />
                                                            <ComboBoxItem Content="Elected to bowl" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Grid IsHitTestVisible="False" IsVisible="False">
                    <Border Opacity="0.006" IsHitTestVisible="False">
                        <Border.Background>
                            <VisualBrush TileMode="Tile" DestinationRect="0,0,40,40" SourceRect="0,0,40,40">
                                <VisualBrush.Visual>
                                    <Canvas Width="40" Height="40">
                                        <Line Stroke="White" StrokeThickness="1" StartPoint="0,40" EndPoint="40,0" />
                                    </Canvas>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="BgGlow" Opacity="0" IsHitTestVisible="False" IsVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="50%,30%" RadiusX="70%" RadiusY="70%">
                                <GradientStop Color="#2058A6FF" Offset="0" />
                                <GradientStop Color="#0858A6FF" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border ClipToBounds="True" IsHitTestVisible="False" Opacity="0.04">
                        <Border Width="200" HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform X="-300" port:ProductionNames.Id="BeamTranslate" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#30FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse Width="6" Height="6" Fill="#1858A6FF" Canvas.Left="60" Canvas.Top="80">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" Fill="#1258A6FF" Canvas.Left="180" Canvas.Top="200">
                            <Ellipse.Effect>
                                <BlurEffect Radius="4" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="#2058A6FF" Canvas.Left="300" Canvas.Top="120">
                            <Ellipse.Effect>
                                <BlurEffect Radius="2" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="#1558A6FF" Canvas.Left="420" Canvas.Top="350">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="5" Height="5" Fill="#1858A6FF" Canvas.Left="550" Canvas.Top="50">
                            <Ellipse.Effect>
                                <BlurEffect Radius="2" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="7" Height="7" Fill="#10FF6B6B" Canvas.Left="650" Canvas.Top="280">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="9" Height="9" Fill="#10FF6B6B" Canvas.Left="750" Canvas.Top="100">
                            <Ellipse.Effect>
                                <BlurEffect Radius="4" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#00000000" Offset="0.3" />
                                <GradientStop Color="#60000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Viewbox VerticalAlignment="Top" Margin="12,78,12,0" Stretch="Uniform" StretchDirection="DownOnly" Height="36" ZIndex="11">
        </Viewbox>
                    <Border x:Name="BottomAccent" VerticalAlignment="Bottom" Height="3" Opacity="0" IsHitTestVisible="False" ZIndex="11" IsVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#58A6FF" Offset="0" />
                                <GradientStop Color="#1AFFFFFF" Offset="0.5" />
                                <GradientStop Color="#FF6B6B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="FlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False" ZIndex="20" IsVisible="False" />
                </Grid>
            </Grid>
        </ns4:WizardViewport>
        <ns4:OperatorGlassSurface x:Name="HeaderPanel" Material="Regular" CornerRadius="28" Margin="16,12,16,8" Padding="14,10" Opacity="1" Grid.Row="0" MaxWidth="1440">
            <Border.RenderTransform>
                <TranslateTransform Y="-30" port:ProductionNames.Id="HeaderTranslate" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ns2:OperatorSymbol Kind="cricket" Width="28" Height="28" Foreground="{DynamicResource ControlCentre.TextBrush}" Margin="0,0,12,0" />
                    <TextBlock x:Name="HeaderTitle" Text="Set up cricket" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" Grid.Column="1" />
                    <TextBlock Text="1 of 4" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" x:Name="WizardStepCounter" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
                <ns4:OperatorSegmentedPanel x:Name="StepIndicator" Rows="1" Grid.Row="1" Height="62" Margin="0,8,0,0" Opacity="1">
                    <ns4:OperatorSegmentedPanel.RenderTransform>
                        <TranslateTransform Y="-20" port:ProductionNames.Id="StepIndicatorTranslate" />
                    </ns4:OperatorSegmentedPanel.RenderTransform>
                    <RadioButton x:Name="Step1Navigation" Click="GoToStep1_Click" GroupName="WizardSteps" Padding="4,6" MinHeight="0" Height="60" Theme="{StaticResource SettingsSegment}" ToolTip.Tip="Go to teams">
                        <StackPanel VerticalAlignment="Center">
                            <ns2:OperatorSymbol Kind="team" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step1Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step1Label" Text="Teams" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step1Dot" Width="36" Height="36" CornerRadius="18" Background="#58A6FF" BorderBrush="#58A6FF" BorderThickness="2" IsVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="#58A6FF" BlurRadius="0" Opacity="0" port:ProductionNames.Id="Step1Glow" OffsetX="0" OffsetY="0" />
                                </Border.Effect>
                                <TextBlock Text="1" Foreground="{DynamicResource ControlCentre.TextBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Step2Navigation" Click="GoToStep2_Click" GroupName="WizardSteps" Padding="4,6" MinHeight="0" Height="60" Theme="{StaticResource SettingsSegment}" ToolTip.Tip="Go to players">
                        <StackPanel VerticalAlignment="Center">
                            <ns2:OperatorSymbol Kind="players" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step2Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step2Label" Text="Players" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step2Dot" Width="36" Height="36" CornerRadius="18" Background="#242427" BorderBrush="#3A3A40" BorderThickness="2" IsVisible="False">
                                <TextBlock Text="2" Foreground="#8E8E98" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Step3Navigation" Click="GoToStep3_Click" GroupName="WizardSteps" Padding="4,6" MinHeight="0" Height="60" Theme="{StaticResource SettingsSegment}" ToolTip.Tip="Go to format">
                        <StackPanel VerticalAlignment="Center">
                            <ns2:OperatorSymbol Kind="settings" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step3Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step3Label" Text="Format" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step3Dot" Width="36" Height="36" CornerRadius="18" Background="#242427" BorderBrush="#3A3A40" BorderThickness="2" IsVisible="False">
                                <TextBlock Text="3" Foreground="#8E8E98" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Step4Navigation" Click="GoToStep4_Click" GroupName="WizardSteps" Padding="4,6" MinHeight="0" Height="60" Theme="{StaticResource SettingsSegment}" ToolTip.Tip="Go to options">
                        <StackPanel VerticalAlignment="Center">
                            <ns2:OperatorSymbol Kind="settings" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step4Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step4Label" Text="Options" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step4Dot" Width="36" Height="36" CornerRadius="18" Background="#242427" BorderBrush="#3A3A40" BorderThickness="2" IsVisible="False">
                                <TextBlock Text="4" Foreground="#8E8E98" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </ns4:OperatorSegmentedPanel>
            </Grid>
        </ns4:OperatorGlassSurface>
        <ns4:OperatorGlassSurface Material="Regular" CornerRadius="26" Padding="8,4" Margin="16,6,16,12" MaxWidth="680" Grid.Row="2">
            <Grid x:Name="NavBar" Grid.Row="0" Height="52" Opacity="1" Margin="0" ZIndex="10">
                <Grid.RenderTransform>
                    <TranslateTransform Y="30" port:ProductionNames.Id="NavBarTranslate" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Cursor="Hand" Click="Back_Click" RenderTransformOrigin="50%,50%" Padding="12,0" MinWidth="0" Height="44" VerticalAlignment="Center" MinHeight="0" IsVisible="False" Theme="{StaticResource ToolBtn}">
                    <Button.RenderTransform>
                        <ScaleTransform port:ProductionNames.Id="BackBtnScale" />
                    </Button.RenderTransform>
                    <TextBlock Text="Back" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="NextButton" Grid.Column="2" Cursor="Hand" Click="Next_Click" RenderTransformOrigin="50%,50%" Padding="12,0" MinWidth="0" Height="44" VerticalAlignment="Center" MinHeight="0" Theme="{StaticResource PrimaryCommandButton}">
                    <Button.RenderTransform>
                        <ScaleTransform port:ProductionNames.Id="NextBtnScale" />
                    </Button.RenderTransform>
                    <TextBlock x:Name="NextButtonText" Text="NEXT →" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </ns4:OperatorGlassSurface>
    </Grid>
</UserControl>
