<UserControl xmlns="https://github.com/avaloniaui" xmlns:ns3="clr-namespace:RocheScoreboard.Mac.Native" xmlns:port="clr-namespace:RocheScoreboard.Mac.Production" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.CricketSetupWizard" Background="#080C12" port:ProductionNames.Root="True" xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base" xmlns:fonts="clr-namespace:RocheScoreboard.Mac.Native">
    <UserControl.Resources>
        <Color x:Key="Shell">#080C12</Color>
        <Color x:Key="Surface0">#0E1420</Color>
        <Color x:Key="Surface1">#141C2A</Color>
        <Color x:Key="Surface2">#1A2436</Color>
        <Color x:Key="Surface3">#243044</Color>
        <Color x:Key="Edge">#2A3A52</Color>
        <Color x:Key="EdgeHi">#3A5070</Color>
        <Color x:Key="Accent">#58A6FF</Color>
        <Color x:Key="AccentDim">#1F6FEB</Color>
        <Color x:Key="TextBright">#E6EDF3</Color>
        <Color x:Key="TextMid">#8B949E</Color>
        <Color x:Key="TextDim">#484F58</Color>
        <Color x:Key="Go">#3FB950</Color>
        <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource Shell}" />
        <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}" />
        <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}" />
        <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />
        <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3}" />
        <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource Edge}" />
        <SolidColorBrush x:Key="EdgeHiBrush" Color="{StaticResource EdgeHi}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
        <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
        <SolidColorBrush x:Key="TextBrightBrush" Color="{StaticResource TextBright}" />
        <SolidColorBrush x:Key="TextMidBrush" Color="{StaticResource TextMid}" />
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
        <SolidColorBrush x:Key="GoBrush" Color="{StaticResource Go}" />
        <ControlTheme x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6688AA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </ControlTheme>
        <ControlTheme x:Key="WizardField" TargetType="TextBox" BasedOn="{StaticResource Native.Base.TextBox}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#0A1018" />
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
            <Setter Property="BorderBrush" Value="#1E3050" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="White" />
        </ControlTheme>
        <ControlTheme x:Key="SmallBtn" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="50%,50%" ns3:TemplateMotion.Spec="[{&quot;event&quot;:&quot;MouseEnter&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;BdSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleX&quot;,&quot;To&quot;:&quot;1.06&quot;,&quot;Duration&quot;:&quot;0:0:0.13&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.35&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;BdSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleY&quot;,&quot;To&quot;:&quot;1.06&quot;,&quot;Duration&quot;:&quot;0:0:0.13&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.35&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;BdLift&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Y&quot;,&quot;To&quot;:&quot;-2&quot;,&quot;Duration&quot;:&quot;0:0:0.13&quot;},{&quot;Storyboard.TargetName&quot;:&quot;RewardFlash&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;To&quot;:&quot;0.25&quot;,&quot;Duration&quot;:&quot;0:0:0.1&quot;}]},{&quot;event&quot;:&quot;MouseLeave&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;BdSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleX&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.17&quot;,&quot;Easing&quot;:&quot;ElasticEase&quot;,&quot;Oscillations&quot;:&quot;1&quot;,&quot;Springiness&quot;:&quot;5&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;BdSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleY&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.17&quot;,&quot;Easing&quot;:&quot;ElasticEase&quot;,&quot;Oscillations&quot;:&quot;1&quot;,&quot;Springiness&quot;:&quot;5&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;BdLift&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Y&quot;,&quot;To&quot;:&quot;0&quot;,&quot;Duration&quot;:&quot;0:0:0.17&quot;},{&quot;Storyboard.TargetName&quot;:&quot;RewardFlash&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;To&quot;:&quot;0&quot;,&quot;Duration&quot;:&quot;0:0:0.12&quot;}]},{&quot;event&quot;:&quot;Button.Click&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;BdSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleX&quot;,&quot;From&quot;:&quot;0.9&quot;,&quot;To&quot;:&quot;1.08&quot;,&quot;Duration&quot;:&quot;0:0:0.18&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.45&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;BdSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleY&quot;,&quot;From&quot;:&quot;0.9&quot;,&quot;To&quot;:&quot;1.08&quot;,&quot;Duration&quot;:&quot;0:0:0.18&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.45&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;BdLift&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Y&quot;,&quot;From&quot;:&quot;1&quot;,&quot;To&quot;:&quot;-1&quot;,&quot;Duration&quot;:&quot;0:0:0.14&quot;},{&quot;Storyboard.TargetName&quot;:&quot;RewardFlash&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;From&quot;:&quot;0.5&quot;,&quot;To&quot;:&quot;0&quot;,&quot;Duration&quot;:&quot;0:0:0.24&quot;}]}]">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1" port:ProductionNames.TemplateId="BdSc" />
                                    <TranslateTransform Y="0" port:ProductionNames.TemplateId="BdLift" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="RewardFlash" Background="#6658A6FF" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="Bd" Padding="12,5" Background="#141C2A" BorderBrush="#2A3A52" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="#1E2C40" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="BorderBrush" Value="#3A5070" />
            </Style>
            <Style Selector="^:pressed /template/ Border#Bd">
                <Setter Property="Background" Value="#0A1018" />
            </Style>
            <Style Selector="^:pressed /template/ Border#Bd">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="ItemContainerTheme">
                <Setter.Value>
                    <ControlTheme TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style Selector="^:selected /template/ Border#Bd">
                            <Setter Property="Background" Value="#243044" />
                        </Style>
                        <Style Selector="^:pointerover /template/ Border#Bd">
                            <Setter Property="Background" Value="#1A2436" />
                        </Style>
                    </ControlTheme>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Border" Grid.ColumnSpan="2" Background="#0A1018" BorderBrush="#1E3050" BorderThickness="1" />
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="10,7" IsReadOnly="False" Background="Transparent" Foreground="{StaticResource TextBrightBrush}" CaretBrush="White" BorderThickness="0" Focusable="True" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#141C2A" BorderBrush="#1E3050" BorderThickness="1,0,0,0" Cursor="Hand">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextMidBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False" ns3:PopupMotion.Kind="Slide">
                                <Border Background="#0E1420" BorderBrush="#3A5070" BorderThickness="1" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Border">
                <Setter Property="BorderBrush" Value="#3A5070" />
            </Style>
            <Style Selector="^:focus-within /template/ Border#Border">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <Grid>
        <Border Opacity="0.02" IsHitTestVisible="False">
            <Border.Background>
                <VisualBrush TileMode="Tile" DestinationRect="0,0,40,40" SourceRect="0,0,40,40">
                    <VisualBrush.Visual>
                        <Canvas Width="40" Height="40">
                            <Line Stroke="White" StrokeThickness="1" StartPoint="0,40" EndPoint="40,0" />
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
        </Border>
        <Border x:Name="BgGlow" Opacity="0" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="50%,30%" RadiusX="70%" RadiusY="70%">
                    <GradientStop Color="#2058A6FF" Offset="0" />
                    <GradientStop Color="#0858A6FF" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border ClipToBounds="True" IsHitTestVisible="False" Opacity="0.04">
            <Border Width="200" HorizontalAlignment="Left">
                <Border.RenderTransform>
                    <TranslateTransform X="-300" port:ProductionNames.Id="BeamTranslate" />
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#30FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Border>
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="6" Height="6" Fill="#1858A6FF" Canvas.Left="60" Canvas.Top="80">
                <Ellipse.Effect>
                    <BlurEffect Radius="3" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="10" Height="10" Fill="#1258A6FF" Canvas.Left="180" Canvas.Top="200">
                <Ellipse.Effect>
                    <BlurEffect Radius="4" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="4" Height="4" Fill="#2058A6FF" Canvas.Left="300" Canvas.Top="120">
                <Ellipse.Effect>
                    <BlurEffect Radius="2" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="8" Height="8" Fill="#1558A6FF" Canvas.Left="420" Canvas.Top="350">
                <Ellipse.Effect>
                    <BlurEffect Radius="3" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="5" Height="5" Fill="#1858A6FF" Canvas.Left="550" Canvas.Top="50">
                <Ellipse.Effect>
                    <BlurEffect Radius="2" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="7" Height="7" Fill="#10FF6B6B" Canvas.Left="650" Canvas.Top="280">
                <Ellipse.Effect>
                    <BlurEffect Radius="3" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="9" Height="9" Fill="#10FF6B6B" Canvas.Left="750" Canvas.Top="100">
                <Ellipse.Effect>
                    <BlurEffect Radius="4" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#00000000" Offset="0.3" />
                    <GradientStop Color="#60000000" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="HeaderPanel" VerticalAlignment="Top" Height="90" Opacity="0" IsHitTestVisible="False" ZIndex="10">
            <Border.RenderTransform>
                <TranslateTransform Y="-30" port:ProductionNames.Id="HeaderTranslate" />
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#EE080C12" Offset="0" />
                    <GradientStop Color="#00080C12" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ROCHE SCOREBOARD" FontSize="9" FontWeight="Black" Foreground="#4058A6FF" TextAlignment="Center" Margin="0,0,0,2" />
                <TextBlock x:Name="HeaderTitle" Text="MATCH SETUP" FontSize="18" FontWeight="Black" Foreground="#CCFFFFFF" TextAlignment="Center" />
                <Border Height="2" Width="80" Margin="0,8,0,0" CornerRadius="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#0058A6FF" Offset="0" />
                            <GradientStop Color="#6058A6FF" Offset="0.5" />
                            <GradientStop Color="#0058A6FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </StackPanel>
        </Border>
        <StackPanel x:Name="StepIndicator" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,78,0,0" Opacity="0" IsHitTestVisible="True" ZIndex="11">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="-20" port:ProductionNames.Id="StepIndicatorTranslate" />
            </StackPanel.RenderTransform>
            <StackPanel Orientation="Horizontal" Cursor="Hand" PointerReleased="Native_GoToStep1_Click">
                <Border x:Name="Step1Dot" Width="36" Height="36" CornerRadius="18" Background="#58A6FF" BorderBrush="#58A6FF" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect Color="#58A6FF" BlurRadius="15" Opacity="0.6" port:ProductionNames.Id="Step1Glow" OffsetX="0" OffsetY="0" />
                    </Border.Effect>
                    <TextBlock Text="1" Foreground="White" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step1Label" Text="TEAMS" Foreground="White" FontWeight="Black" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Border Width="32" Height="2" VerticalAlignment="Center" Margin="8,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#4058A6FF" Offset="0" />
                        <GradientStop Color="#2058A6FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel Orientation="Horizontal" Cursor="Hand" PointerReleased="Native_GoToStep2_Click">
                <Border x:Name="Step2Dot" Width="36" Height="36" CornerRadius="18" Background="#1A2436" BorderBrush="#2A3A52" BorderThickness="2">
                    <TextBlock Text="2" Foreground="#484F58" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step2Label" Text="PLAYERS" Foreground="#484F58" FontWeight="Black" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Border Width="32" Height="2" VerticalAlignment="Center" Margin="8,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#2058A6FF" Offset="0" />
                        <GradientStop Color="#1058A6FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel Orientation="Horizontal" Cursor="Hand" PointerReleased="Native_GoToStep3_Click">
                <Border x:Name="Step3Dot" Width="36" Height="36" CornerRadius="18" Background="#1A2436" BorderBrush="#2A3A52" BorderThickness="2">
                    <TextBlock Text="3" Foreground="#484F58" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step3Label" Text="FORMAT" Foreground="#484F58" FontWeight="Black" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Border Width="32" Height="2" VerticalAlignment="Center" Margin="8,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#1058A6FF" Offset="0" />
                        <GradientStop Color="#0858A6FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel Orientation="Horizontal" Cursor="Hand" PointerReleased="Native_GoToStep4_Click">
                <Border x:Name="Step4Dot" Width="36" Height="36" CornerRadius="18" Background="#1A2436" BorderBrush="#2A3A52" BorderThickness="2">
                    <TextBlock Text="4" Foreground="#484F58" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Step4Label" Text="OTHER" Foreground="#484F58" FontWeight="Black" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
        <Grid Margin="0,120,0,50">
            <Grid x:Name="TeamsStepContainer" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="20,0,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HomePresetCard" Grid.Column="0" Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1,2,1,1" Padding="12,10" Opacity="0" ClipToBounds="True">
                        <Border.RenderTransform>
                            <TranslateTransform X="-60" port:ProductionNames.Id="HomePresetTranslate" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#1A3A6A" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="HOME TEAM" Foreground="#7EB4FF" FontSize="10" FontWeight="Black" />
                                </Border>
                                <TextBlock x:Name="HomePresetEmpty" Text="No saved presets" Foreground="#3A5070" FontSize="10" VerticalAlignment="Center" IsVisible="False" />
                            </StackPanel>
                            <WrapPanel x:Name="HomePresetPanel" Grid.Row="1" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Save Current" Height="26" Margin="0,0,6,0" Click="SaveHomePreset_Click" Theme="{StaticResource SmallBtn}" />
                                <Button Content="Delete" Height="26" Click="DeleteHomePreset_Click" Theme="{StaticResource SmallBtn}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="AwayPresetCard" Grid.Column="2" Background="#1A0A0A" BorderBrush="#6A1A1A" BorderThickness="1,2,1,1" Padding="12,10" Opacity="0" ClipToBounds="True">
                        <Border.RenderTransform>
                            <TranslateTransform X="60" port:ProductionNames.Id="AwayPresetTranslate" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#4A1A1A" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="AWAY TEAM" Foreground="#FF9A9A" FontSize="10" FontWeight="Black" />
                                </Border>
                                <TextBlock x:Name="AwayPresetEmpty" Text="No saved presets" Foreground="#523030" FontSize="10" VerticalAlignment="Center" IsVisible="False" />
                            </StackPanel>
                            <WrapPanel x:Name="AwayPresetPanel" Grid.Row="1" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Save Current" Height="26" Margin="0,0,6,0" Click="SaveAwayPreset_Click" Theme="{StaticResource SmallBtn}" />
                                <Button Content="Delete" Height="26" Click="DeleteAwayPreset_Click" Theme="{StaticResource SmallBtn}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="Step2Panel" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HomeTeamCard" Grid.Column="0" ClipToBounds="True" Opacity="0" RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform port:ProductionNames.Id="HomeCardScale" />
                                <TranslateTransform X="-80" port:ProductionNames.Id="HomeCardTranslate" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#0A1628" Offset="0" />
                                <GradientStop Color="#122040" Offset="0.5" />
                                <GradientStop Color="#0D1830" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border x:Name="HomeGlow" Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="50%,15%" RadiusX="60%" RadiusY="50%">
                                        <GradientStop Color="#3058A6FF" Offset="0" />
                                        <GradientStop Color="#1058A6FF" Offset="0.5" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#00000000" Offset="0.2" />
                                        <GradientStop Color="#40000000" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14">
                                <StackPanel Margin="20,10,20,14">
                                    <StackPanel x:Name="HomeHeaderGroup" Opacity="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform Y="15" port:ProductionNames.Id="HomeHeaderTranslate" />
                                        </StackPanel.RenderTransform>
                                        <TextBlock Text="HOME" FontSize="28" FontWeight="Black" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="20" Color="#58A6FF" Opacity="0.5" OffsetX="0" OffsetY="0" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="TEAM CONFIGURATION" FontSize="9" FontWeight="SemiBold" Foreground="#4058A6FF" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="Team Name" Theme="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SetupHomeNameBox" Text="" Margin="0,0,0,10" Theme="{StaticResource WizardField}" />
                                    <TextBlock Text="Abbreviation (3-4 letters)" Theme="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SetupHomeAbbrBox" Text="" MaxLength="4" Margin="0,0,0,12" Theme="{StaticResource WizardField}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Primary Colour" Theme="{StaticResource FieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="SetupHomeColorBox" Width="80" Text="#0A2A6A" FontSize="11" FontFamily="{fonts:ProductionFont 'Consolas'}" Background="#0A1018" Foreground="{StaticResource TextBrightBrush}" BorderBrush="#1E3050" BorderThickness="1" Padding="6,4" CaretBrush="White" VerticalContentAlignment="Center" TextChanged="Native_SetupHomeColorBox_TextChanged" />
                                                <Border x:Name="SetupHomeColorPreview" Width="28" Height="26" Background="#0A2A6A" BorderBrush="#3A5070" BorderThickness="1" Cursor="Hand" Margin="4,0,0,0" PointerReleased="Native_PickSetupHomeColor_Click" />
                                                <Border Width="26" Height="26" Background="#141C2A" BorderBrush="#2A3A52" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_DropperSetupHomeColor_Click">
                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Text Colour" Theme="{StaticResource FieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="SetupHomeSecondaryBox" Width="80" Text="#FFFFFF" FontSize="11" FontFamily="{fonts:ProductionFont 'Consolas'}" Background="#0A1018" Foreground="{StaticResource TextBrightBrush}" BorderBrush="#1E3050" BorderThickness="1" Padding="6,4" CaretBrush="White" VerticalContentAlignment="Center" TextChanged="Native_SetupHomeSecondaryBox_TextChanged" />
                                                <Border x:Name="SetupHomeSecondaryPreview" Width="28" Height="26" Background="#FFFFFF" BorderBrush="#3A5070" BorderThickness="1" Cursor="Hand" Margin="4,0,0,0" PointerReleased="Native_PickSetupHomeSecondary_Click" />
                                                <Border Width="26" Height="26" Background="#141C2A" BorderBrush="#2A3A52" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_DropperSetupHomeSecondary_Click">
                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Margin="0,2,0,12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#0058A6FF" Offset="0" />
                                                <GradientStop Color="#3058A6FF" Offset="0.5" />
                                                <GradientStop Color="#0058A6FF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Logo" Theme="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Choose Logo" Height="28" Click="ChooseSetupHomeLogo_Click" Theme="{StaticResource SmallBtn}" />
                                        <TextBlock Grid.Column="1" x:Name="SetupHomeLogoText" Text="(none)" Foreground="#3A5070" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Border x:Name="SetupHomeLogoPreview" Background="#0A1018" Padding="8" Margin="0,4,0,0" HorizontalAlignment="Left" IsVisible="False">
                                        <Image x:Name="SetupHomeLogoImage" MaxHeight="60" MaxWidth="160" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" HorizontalAlignment="Center" IsHitTestVisible="False" Width="6" RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleY="0" port:ProductionNames.Id="DividerScale" />
                        </Border.RenderTransform>
                        <Grid>
                            <Border x:Name="DividerGlowLine" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#30FFFFFF" Offset="0.3" />
                                        <GradientStop Color="#50FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#30FFFFFF" Offset="0.7" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="3" />
                                </Border.Effect>
                            </Border>
                            <Border Width="1" Opacity="0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#FFFFFFFF" Offset="0.3" />
                                        <GradientStop Color="#FFFFFFFF" Offset="0.7" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="AwayTeamCard" Grid.Column="2" ClipToBounds="True" Opacity="0" RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform port:ProductionNames.Id="AwayCardScale" />
                                <TranslateTransform X="80" port:ProductionNames.Id="AwayCardTranslate" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#1A0A0A" Offset="0" />
                                <GradientStop Color="#2A1218" Offset="0.5" />
                                <GradientStop Color="#1E0D10" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border x:Name="AwayGlow" Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="50%,15%" RadiusX="60%" RadiusY="50%">
                                        <GradientStop Color="#30FF6B6B" Offset="0" />
                                        <GradientStop Color="#10FF6B6B" Offset="0.5" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#00000000" Offset="0.2" />
                                        <GradientStop Color="#40000000" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14">
                                <StackPanel Margin="20,10,20,14">
                                    <StackPanel x:Name="AwayHeaderGroup" Opacity="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform Y="15" port:ProductionNames.Id="AwayHeaderTranslate" />
                                        </StackPanel.RenderTransform>
                                        <TextBlock Text="AWAY" FontSize="28" FontWeight="Black" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="20" Color="#FF6B6B" Opacity="0.5" OffsetX="0" OffsetY="0" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="TEAM CONFIGURATION" FontSize="9" FontWeight="SemiBold" Foreground="#40FF6B6B" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="Team Name" Theme="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SetupAwayNameBox" Text="" Margin="0,0,0,10" Theme="{StaticResource WizardField}" />
                                    <TextBlock Text="Abbreviation (3-4 letters)" Theme="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SetupAwayAbbrBox" Text="" MaxLength="4" Margin="0,0,0,12" Theme="{StaticResource WizardField}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Primary Colour" Theme="{StaticResource FieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="SetupAwayColorBox" Width="80" Text="#7A1A1A" FontSize="11" FontFamily="{fonts:ProductionFont 'Consolas'}" Background="#0A1018" Foreground="{StaticResource TextBrightBrush}" BorderBrush="#1E3050" BorderThickness="1" Padding="6,4" CaretBrush="White" VerticalContentAlignment="Center" TextChanged="Native_SetupAwayColorBox_TextChanged" />
                                                <Border x:Name="SetupAwayColorPreview" Width="28" Height="26" Background="#7A1A1A" BorderBrush="#3A5070" BorderThickness="1" Cursor="Hand" Margin="4,0,0,0" PointerReleased="Native_PickSetupAwayColor_Click" />
                                                <Border Width="26" Height="26" Background="#141C2A" BorderBrush="#2A3A52" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_DropperSetupAwayColor_Click">
                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Text Colour" Theme="{StaticResource FieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="SetupAwaySecondaryBox" Width="80" Text="#FFFFFF" FontSize="11" FontFamily="{fonts:ProductionFont 'Consolas'}" Background="#0A1018" Foreground="{StaticResource TextBrightBrush}" BorderBrush="#1E3050" BorderThickness="1" Padding="6,4" CaretBrush="White" VerticalContentAlignment="Center" TextChanged="Native_SetupAwaySecondaryBox_TextChanged" />
                                                <Border x:Name="SetupAwaySecondaryPreview" Width="28" Height="26" Background="#FFFFFF" BorderBrush="#3A5070" BorderThickness="1" Cursor="Hand" Margin="4,0,0,0" PointerReleased="Native_PickSetupAwaySecondary_Click" />
                                                <Border Width="26" Height="26" Background="#141C2A" BorderBrush="#2A3A52" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_DropperSetupAwaySecondary_Click">
                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Margin="0,2,0,12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#00FF6B6B" Offset="0" />
                                                <GradientStop Color="#30FF6B6B" Offset="0.5" />
                                                <GradientStop Color="#00FF6B6B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Logo" Theme="{StaticResource FieldLabel}" />
