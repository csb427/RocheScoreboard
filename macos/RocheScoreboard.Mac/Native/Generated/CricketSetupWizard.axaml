                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#152231" />
                <Setter Property="BorderBrush" Value="#30465A" />
                <Setter Property="Foreground" Value="#C4D5E5" />
            </ControlTheme>
            <ControlTheme x:Key="KeeperRoleButton" TargetType="Button" BasedOn="{StaticResource PlayerRoleButton}">
                <Setter Property="native:NativeDataCondition.Active" Value="{Binding IsWicketkeeper}" />
                <Style Selector="^[(native|NativeDataCondition.Active)=True]">
                    <Setter Property="Background" Value="#22533C" />
                </Style>
                <Style Selector="^[(native|NativeDataCondition.Active)=True]">
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="^[(native|NativeDataCondition.Active)=True]">
                    <Setter Property="BorderBrush" Value="#75EDAD" />
                </Style>
            </ControlTheme>
