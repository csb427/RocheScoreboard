                                        <GradientStop Color="#1A0A0A" Offset="0" />
                                        <GradientStop Color="#200E0E" Offset="0.5" />
                                        <GradientStop Color="#140808" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border HorizontalAlignment="Left" Width="3">
                                        <Border.Background>
                                            <SolidColorBrush Color="#7A1A1A" port:ProductionNames.Id="AwayPlayerSideBrush" />
                                        </Border.Background>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14">
                                        <StackPanel Margin="20,10,20,14">
                                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <TextBlock x:Name="AwayPlyTeamName" Text="AWAY" FontSize="22" FontWeight="Black" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="18" Color="#FF6B6B" Opacity="0.5" port:ProductionNames.Id="AwayPlyGlow" OffsetX="0" OffsetY="0" />
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="PLAYER REGISTRATION" FontSize="9" FontWeight="SemiBold" Foreground="#40FF6B6B" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Add Player" Margin="0,0,0,6" Theme="{StaticResource FieldLabel}" />
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="AwayPlayerFirstBox" Theme="{StaticResource WizardField}" />
                                                <TextBox x:Name="AwayPlayerLastBox" Grid.Column="2" KeyDown="AwayPlayerLastBox_KeyDown" Theme="{StaticResource WizardField}" />
                                                <Border Grid.Column="4" Width="36" Height="36" Background="#2A1010" BorderBrush="#4A2020" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" PointerReleased="Native_AddAwayPlayer_Click">
                                                    <TextBlock Text="+" FontSize="22" FontWeight="Black" Foreground="#FF6B6B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="First name" Foreground="#503030" FontSize="10" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="Last name" Foreground="#503030" FontSize="10" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Border Height="1" Margin="0,0,0,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                        <GradientStop Color="#00080C12" Offset="0" />
                                                        <GradientStop Color="#402A2A3A" Offset="0.5" />
                                                        <GradientStop Color="#00080C12" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <ItemsControl x:Name="AwayPlayerList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,4" Background="#1A0D0D" BorderBrush="#3A1A1A" BorderThickness="1" Padding="8,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="28" Height="22" Margin="0,0,8,0" BorderBrush="#3A2020" BorderThickness="1" Cursor="Hand" Tag="{Binding}" PointerReleased="Native_ToggleAwayWicketkeeper_Click" ToolTip.Tip="Toggle Wicketkeeper">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="#2A1A1A" />
                                                                    </Border.Background>
                                                                    <TextBlock Text="WK" FontSize="9" FontWeight="Black" Foreground="#AA6868" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="#E8C8C8" FontSize="13" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="†" FontSize="11" Foreground="#FF6B6B" VerticalAlignment="Center" Margin="4,0,6,0" />
                                                                <Border Grid.Column="3" Width="22" Height="22" Background="#1A1010" BorderBrush="#3A2020" BorderThickness="1" Cursor="Hand" Tag="{Binding}" PointerReleased="Native_RemoveAwayPlayer_Click">
                                                                    <TextBlock Text="x" FontSize="13" Foreground="#AA6868" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="Step3bPanel" ClipToBounds="True" Opacity="0" RenderTransformOrigin="50%,50%" Margin="30,0,30,0" IsVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform X="80" port:ProductionNames.Id="Step3bTranslate" />
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#0A1220" Offset="0" />
                        <GradientStop Color="#101828" Offset="0.5" />
                        <GradientStop Color="#0D1520" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Border x:Name="FormatGlow" Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="50%,20%" RadiusX="60%" RadiusY="50%">
                                <GradientStop Color="#1A3FB950" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="FormatHeaderGroup" Opacity="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="15" port:ProductionNames.Id="FormatHeaderTranslate" />
                            </StackPanel.RenderTransform>
                            <TextBlock Text="FORMAT" FontSize="32" FontWeight="Black" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="25" Color="#3FB950" Opacity="0.5" OffsetX="0" OffsetY="0" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="MATCH CONFIGURATION" FontSize="9" FontWeight="SemiBold" Foreground="#403FB950" TextAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="LimitedOversCard" Grid.Column="0" Cursor="Hand" MinHeight="280" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="2" PointerReleased="Native_LimitedOversCard_Click">
                                <Grid>
                                    <Border x:Name="LimitedOversGlowBg" Opacity="0.15" IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                <GradientStop Color="#58A6FF" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,24">
                                        <TextBlock Text="◆" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" Foreground="#73B8FF" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#58A6FF" BlurRadius="14" Opacity="0.35" OffsetX="0" OffsetY="0" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="LIMITED OVERS" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock Text="T20, ODI, or custom overs" FontSize="10" FontWeight="SemiBold" Foreground="#5080AA" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        <StackPanel x:Name="OversInputPanel" Margin="0,20,0,0">
                                            <TextBlock Text="OVERS PER INNINGS" FontSize="10" FontWeight="Black" Foreground="#4058A6FF" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Border Width="40" Height="40" Background="#141008" BorderBrush="#3A3018" BorderThickness="1" Cursor="Hand" PointerReleased="Native_OversMinus_Click">
                                                    <TextBlock Text="-" FontSize="22" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" MinWidth="64" Height="64" Padding="10,0" Margin="6,0">
                                                    <TextBlock x:Name="OversDisplay" Text="20" FontSize="38" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect BlurRadius="12" Color="#D29922" Opacity="0.4" OffsetX="0" OffsetY="0" />
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                </Border>
                                                <Border Width="40" Height="40" Background="#141008" BorderBrush="#3A3018" BorderThickness="1" Cursor="Hand" PointerReleased="Native_OversPlus_Click">
                                                    <TextBlock Text="+" FontSize="22" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="OVERS" FontSize="9" FontWeight="SemiBold" Foreground="#6B5A00" HorizontalAlignment="Center" Margin="0,4,0,12" />
                                            <TextBlock Text="PRESETS" FontSize="9" FontWeight="Black" Foreground="#5A5030" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            <UniformGrid Columns="4" HorizontalAlignment="Center" MaxWidth="260">
                                                <Border Background="#141008" BorderBrush="#3A3018" BorderThickness="1" Cursor="Hand" Margin="3" PointerReleased="Native_OversPreset20_Click">
                                                    <TextBlock Text="20" FontSize="16" FontWeight="Black" Foreground="#8A7A40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6" />
                                                </Border>
                                                <Border Background="#141008" BorderBrush="#3A3018" BorderThickness="1" Cursor="Hand" Margin="3" PointerReleased="Native_OversPreset40_Click">
                                                    <TextBlock Text="40" FontSize="16" FontWeight="Black" Foreground="#8A7A40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6" />
                                                </Border>
                                                <Border Background="#141008" BorderBrush="#3A3018" BorderThickness="1" Cursor="Hand" Margin="3" PointerReleased="Native_OversPreset50_Click">
                                                    <TextBlock Text="50" FontSize="16" FontWeight="Black" Foreground="#8A7A40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6" />
                                                </Border>
                                                <Border Background="#141008" BorderBrush="#3A3018" BorderThickness="1" Cursor="Hand" Margin="3" PointerReleased="Native_OversPreset100_Click">
                                                    <TextBlock Text="100" FontSize="14" FontWeight="Black" Foreground="#8A7A40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6" />
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="LimitedOversSelected" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="8,4">
                                        <TextBlock Text="✓" FontSize="12" FontWeight="Black" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="MultiInningsCard" Grid.Column="2" Cursor="Hand" MinHeight="280" Background="#0A0E14" BorderBrush="#2A3A52" BorderThickness="1" PointerReleased="Native_MultiInningsCard_Click">
                                <Grid>
                                    <Border x:Name="MultiInningsGlowBg" Opacity="0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                <GradientStop Color="#3FB950" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,24">
                                        <TextBlock Text="▤" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" Foreground="#8CA7C4" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                        <TextBlock Text="MULTI INNINGS" FontSize="22" FontWeight="Black" Foreground="#C6D3E1" HorizontalAlignment="Center" />
                                        <TextBlock Text="Club cricket, Tests &amp; more" FontSize="10" FontWeight="SemiBold" Foreground="#8294A8" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        <TextBlock Text="No over limit" FontSize="10" Foreground="#64778C" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    </StackPanel>
                                    <Border x:Name="MultiInningsSelected" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#3FB950" Padding="8,4" IsVisible="False">
                                        <TextBlock Text="✓" FontSize="12" FontWeight="Black" Foreground="#0A1E0A" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="Step4Panel" ClipToBounds="True" Opacity="0" RenderTransformOrigin="50%,50%" IsVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform X="80" port:ProductionNames.Id="Step4Translate" />
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#0A1220" Offset="0" />
                        <GradientStop Color="#101828" Offset="0.5" />
                        <GradientStop Color="#0D1520" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Border x:Name="MsgGlow" Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="50%,20%" RadiusX="50%" RadiusY="40%">
                                <GradientStop Color="#203FB950" Offset="0" />
                                <GradientStop Color="#083FB950" Offset="0.6" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#00000000" Offset="0.3" />
                                <GradientStop Color="#30000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="MsgHeaderGroup" Opacity="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="15" port:ProductionNames.Id="MsgHeaderTranslate" />
                            </StackPanel.RenderTransform>
                            <TextBlock Text="OTHER" FontSize="32" FontWeight="Black" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="25" Color="#3FB950" Opacity="0.5" OffsetX="0" OffsetY="0" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="MATCH OPTIONS &amp; TICKER" FontSize="9" FontWeight="SemiBold" Foreground="#403FB950" TextAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#080E1A" BorderBrush="#1A3060" BorderThickness="1">
                                <Grid>
                                    <Border x:Name="WeatherGlowBg" Opacity="0.08" IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="50%,40%" RadiusX="50%" RadiusY="50%">
                                                <GradientStop Color="#58A6FF" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="☁" FontFamily="{fonts:ProductionFont 'Segoe UI Symbol'}" Foreground="#8CCBFF" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#58A6FF" BlurRadius="14" Opacity="0.35" OffsetX="0" OffsetY="0" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="LIVE WEATHER" FontSize="22" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Location for real-time conditions" FontSize="10" FontWeight="SemiBold" Foreground="#3A6090" HorizontalAlignment="Center" Margin="0,6,0,14" />
                                        <Border Background="#06091A" BorderBrush="#2A4A70" BorderThickness="1" HorizontalAlignment="Center" MinWidth="260" Padding="4">
                                            <ComboBox x:Name="SetupWeatherLocation" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="200" VerticalAlignment="Center" FontSize="14" Text="Melbourne, Australia" Theme="{StaticResource DarkCombo}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="#0A0E18" BorderBrush="#1A2A40" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Border x:Name="MsgSectionGlow" Opacity="0.06" IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="50%,15%" RadiusX="60%" RadiusY="50%">
                                                <GradientStop Color="#3FB950" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Margin="18,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <TextBlock Text="▣" FontSize="28" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" FontWeight="Black" Foreground="#67D17B" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <TextBlock Text="TICKER MESSAGES" FontSize="16" FontWeight="Black" Foreground="#3FB950" HorizontalAlignment="Center" />
                                            <TextBlock Text="Scroll across the bottom bar during the game" FontSize="9" FontWeight="SemiBold" Foreground="#2A6030" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Row="1" Height="1" Margin="0,0,0,10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#003FB950" Offset="0" />
                                                    <GradientStop Color="#303FB950" Offset="0.5" />
                                                    <GradientStop Color="#003FB950" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Row="2" Background="#060A10" BorderBrush="#1A2A3A" BorderThickness="1" Padding="8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="SetupMessageList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#0A1018" BorderBrush="#1E3050" BorderThickness="1" Padding="8,6" Margin="0,0,0,6" CornerRadius="3">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Border Grid.Row="0" Grid.ColumnSpan="4" CornerRadius="2" Padding="6,3" Margin="0,0,0,4" Background="{Binding HighlightBrush}">
                                                                        <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding TextBrush}" />
                                                                    </Border>
                                                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Background="#060A10" Foreground="#E6EDF3" BorderBrush="#1E3050" CaretBrush="White" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                                                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="TEXT" FontSize="8" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                        <Button Width="34" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Click="SetupPickItemTextColor_Click" Tag="{Binding}" Background="{Binding TextBrush}" ToolTip.Tip="Click to choose text colour" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="HIGHLIGHT" FontSize="8" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                        <Button Width="50" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Click="SetupPickItemHighlightColor_Click" Tag="{Binding}" Background="{Binding HighlightBrush}" ToolTip.Tip="Click to choose highlight colour. Right-click to clear." PointerReleased="Native_SetupClearItemHighlightColor_Click" />
                                                                    </StackPanel>
                                                                    <Button Grid.Row="1" Grid.Column="3" Content="✕" Width="30" Height="40" FontSize="12" FontWeight="Black" Click="SetupRemoveMessageItem_Click" Tag="{Binding}" Background="#3A1A1A" Foreground="#E6EDF3" BorderBrush="#3A1A1A" VerticalAlignment="Bottom" ToolTip.Tip="Remove this message" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SetupNewMessageBox" Margin="0,0,6,0" KeyDown="SetupNewMessageBox_KeyDown" Theme="{StaticResource WizardField}" />
                                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="TEXT" FontSize="8" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                <Button x:Name="SetupNewMessageTextColorBtn" Width="34" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Click="SetupPickNewTextColor_Click" Background="White" ToolTip.Tip="Choose text colour for new messages" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="HIGHLIGHT" FontSize="8" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                <Button x:Name="SetupNewMessageHighlightColorBtn" Width="50" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Click="SetupPickNewHighlightColor_Click" Background="Transparent" PointerReleased="Native_SetupClearNewHighlightColor_Click" ToolTip.Tip="Choose highlight colour. Right-click to clear." />
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="Add" Height="30" Click="SetupAddMessage_Click" Theme="{StaticResource SmallBtn}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="NavBar" VerticalAlignment="Bottom" Height="50" Opacity="0" Margin="30,0,30,0" ZIndex="10">
            <Grid.RenderTransform>
                <TranslateTransform Y="30" port:ProductionNames.Id="NavBarTranslate" />
            </Grid.RenderTransform>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#00080C12" Offset="0" />
                    <GradientStop Color="#DD080C12" Offset="0.3" />
                    <GradientStop Color="#FF080C12" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="BackButton" Grid.Column="0" Cursor="Hand" RenderTransformOrigin="50%,50%" Padding="28,0" Height="42" VerticalAlignment="Center" Background="#1A2436" BorderBrush="#2A3A52" BorderThickness="1.5" IsVisible="False" PointerReleased="Native_Back_Click" PointerEntered="Native_NavBtn_MouseEnter" PointerExited="Native_NavBtn_MouseLeave">
                <Border.RenderTransform>
                    <ScaleTransform port:ProductionNames.Id="BackBtnScale" />
                </Border.RenderTransform>
                <TextBlock Text="← BACK" Foreground="White" FontWeight="Black" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <Border x:Name="NextButton" Grid.Column="2" Cursor="Hand" RenderTransformOrigin="50%,50%" Padding="28,0" Height="42" VerticalAlignment="Center" Background="#1F6FEB" BorderBrush="#58A6FF" BorderThickness="1.5" PointerReleased="Native_Next_Click" PointerEntered="Native_NavBtn_MouseEnter" PointerExited="Native_NavBtn_MouseLeave">
                <Border.RenderTransform>
                    <ScaleTransform port:ProductionNames.Id="NextBtnScale" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#58A6FF" BlurRadius="15" Opacity="0.3" OffsetX="0" OffsetY="0" />
                </Border.Effect>
                <TextBlock x:Name="NextButtonText" Text="NEXT →" Foreground="White" FontWeight="Black" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
        </Grid>
        <Border x:Name="BottomAccent" VerticalAlignment="Bottom" Height="3" Opacity="0" IsHitTestVisible="False" ZIndex="11">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#58A6FF" Offset="0" />
                    <GradientStop Color="#1AFFFFFF" Offset="0.5" />
                    <GradientStop Color="#FF6B6B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="FlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False" ZIndex="20" />
    </Grid>
</UserControl>
