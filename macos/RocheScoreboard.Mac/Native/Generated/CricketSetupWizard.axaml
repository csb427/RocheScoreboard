                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </ControlTheme>
            <ControlTheme x:Key="WizardField" TargetType="TextBox" BasedOn="{StaticResource SettingsInput}" />
