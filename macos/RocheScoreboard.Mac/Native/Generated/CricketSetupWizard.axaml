                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Border x:Name="Step3Panel" ClipToBounds="True" Opacity="0" RenderTransformOrigin="50%,50%" Margin="30,0,30,0" IsVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform X="80" port:ProductionNames.Id="Step3Translate" />
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#0A1220" Offset="0" />
                        <GradientStop Color="#101828" Offset="0.5" />
                        <GradientStop Color="#0D1520" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Border x:Name="PlayersGlow" Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="50%,20%" RadiusX="60%" RadiusY="50%">
                                <GradientStop Color="#1A58A6FF" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="PlayersHeaderGroup" Opacity="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="15" port:ProductionNames.Id="PlayersHeaderTranslate" />
                            </StackPanel.RenderTransform>
                            <TextBlock Text="PLAYERS" FontSize="32" FontWeight="Black" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="25" Color="#58A6FF" Opacity="0.5" OffsetX="0" OffsetY="0" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="SQUAD SELECTION" FontSize="9" FontWeight="SemiBold" Foreground="#4058A6FF" TextAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#0A1A30" Offset="0" />
                                        <GradientStop Color="#0D1E38" Offset="0.5" />
                                        <GradientStop Color="#081220" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border HorizontalAlignment="Left" Width="3">
                                        <Border.Background>
                                            <SolidColorBrush Color="#0A57FF" port:ProductionNames.Id="HomePlayerSideBrush" />
                                        </Border.Background>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14">
                                        <StackPanel Margin="20,10,20,14">
                                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <TextBlock x:Name="HomePlyTeamName" Text="HOME" FontSize="22" FontWeight="Black" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="18" Color="#58A6FF" Opacity="0.5" port:ProductionNames.Id="HomePlyGlow" OffsetX="0" OffsetY="0" />
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="PLAYER REGISTRATION" FontSize="9" FontWeight="SemiBold" Foreground="#4058A6FF" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Add Player" Margin="0,0,0,6" Theme="{StaticResource FieldLabel}" />
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="HomePlayerFirstBox" Theme="{StaticResource WizardField}" />
                                                <TextBox x:Name="HomePlayerLastBox" Grid.Column="2" KeyDown="HomePlayerLastBox_KeyDown" Theme="{StaticResource WizardField}" />
                                                <Border Grid.Column="4" Width="36" Height="36" Background="#141C2A" BorderBrush="#2A3A52" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" PointerReleased="Native_AddHomePlayer_Click">
                                                    <TextBlock Text="+" FontSize="22" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="First name" Foreground="#3A5070" FontSize="10" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="Last name" Foreground="#3A5070" FontSize="10" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Border Height="1" Margin="0,0,0,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                        <GradientStop Color="#00080C12" Offset="0" />
                                                        <GradientStop Color="#402A3A52" Offset="0.5" />
                                                        <GradientStop Color="#00080C12" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <ItemsControl x:Name="HomePlayerList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,4" Background="#0D1828" BorderBrush="#1A2E4A" BorderThickness="1" Padding="8,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="28" Height="22" Margin="0,0,8,0" BorderBrush="#2A3A52" BorderThickness="1" Cursor="Hand" Tag="{Binding}" PointerReleased="Native_ToggleHomeWicketkeeper_Click" ToolTip.Tip="Toggle Wicketkeeper">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="#1A2436" />
                                                                    </Border.Background>
                                                                    <TextBlock Text="WK" FontSize="9" FontWeight="Black" Foreground="#6688AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="#C8D8E8" FontSize="13" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="†" FontSize="11" Foreground="#58A6FF" VerticalAlignment="Center" Margin="4,0,6,0" />
                                                                <Border Grid.Column="3" Width="22" Height="22" Background="#1A1E26" BorderBrush="#2A3A52" BorderThickness="1" Cursor="Hand" Tag="{Binding}" PointerReleased="Native_RemoveHomePlayer_Click">
                                                                    <TextBlock Text="x" FontSize="13" Foreground="#6688AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Grid Grid.Column="1" HorizontalAlignment="Center" Width="2">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Color="#002A3A52" Offset="0" />
                                        <GradientStop Color="#AA2A3A52" Offset="0.5" />
                                        <GradientStop Color="#002A3A52" Offset="1" />
