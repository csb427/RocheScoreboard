<Window xmlns="https://github.com/avaloniaui" xmlns:ns2="clr-namespace:Roche_Scoreboard.Services" xmlns:ns4="clr-namespace:Roche_Scoreboard.Views" xmlns:port="clr-namespace:RocheScoreboard.Mac.Production" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.ResumeGameDialog" ns2:OperatorDesign.IsEnabled="True" Title="Continue saved match" Width="580" Height="410" MinWidth="340" MinHeight="310" WindowStartupLocation="CenterOwner" Background="#09090B" Foreground="#FAFAFC" FontFamily="{fonts:ProductionFont 'Segoe UI Variable, Segoe UI'}" FontSize="15" ShowInTaskbar="False" xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:design="clr-namespace:Roche_Scoreboard.Services" port:ProductionNames.Root="True" xmlns:native="clr-namespace:RocheScoreboard.Mac.Native" xmlns:motion="clr-namespace:Roche_Scoreboard.Services" xmlns:services="clr-namespace:Roche_Scoreboard.Services" xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base" xmlns:fonts="clr-namespace:RocheScoreboard.Mac.Native" CanResize="True" SystemDecorations="Full" KeyDown="Native_Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/OperatorControls.axaml" />
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/ControlCentre.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ns4:OperatorGlassSurface x:Name="DialogShell" Material="Regular" GlassSource="{Binding Owner.Content, RelativeSource={RelativeSource AncestorType=Window}}" TextElement.Foreground="{DynamicResource ControlCentre.TextBrush}" Padding="24" Background="{DynamicResource ControlCentre.GlassBrush}" CornerRadius="30" BorderBrush="#68FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CONTINUE YOUR MATCH?" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PhaseText" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="14" Margin="0,8,0,12" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Click="KeepSaved_Click" Width="34" Height="34" MinHeight="0" Padding="0" FontSize="22" VerticalAlignment="Top" ToolTip.Tip="Continue later" Theme="{StaticResource ControlCentre.Button}" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="HomeTeamCard" Padding="12" Margin="0,0,0,8" Theme="{StaticResource SettingsSectionSurface}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="HomeLogoImage" Height="38" Stretch="Uniform" />
                            <TextBlock Foreground="White" x:Name="HomeNameText" Grid.Column="1" Margin="12,0,0,0" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border x:Name="AwayTeamCard" Padding="12" Margin="0,0,0,8" Theme="{StaticResource SettingsSectionSurface}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AwayLogoImage" Height="38" Stretch="Uniform" />
                            <TextBlock Foreground="White" x:Name="AwayNameText" Grid.Column="1" Margin="12,0,0,0" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2">
                <UniformGrid Columns="2">
                    <Button Content="CONTINUE LATER" Click="KeepSaved_Click" Height="46" FontSize="14" Padding="8,0" Margin="0,0,6,0" Theme="{StaticResource ControlCentre.Button}" />
                    <Button Content="CONTINUE MATCH" Click="Resume_Click" Height="46" FontSize="14" Padding="8,0" Margin="6,0,0,0" IsDefault="True" Theme="{StaticResource ControlCentre.PrimaryButton}" />
                </UniformGrid>
                <Button x:Name="DiscardButton" Content="DISCARD SAVE" Click="Discard_Click" MinHeight="0" Height="38" Padding="8,0" Margin="0,10,0,0" Foreground="#FFA3AA" Background="#302024" BorderBrush="#66424A" Theme="{StaticResource ControlCentre.Button}" />
            </StackPanel>
        </Grid>
    </ns4:OperatorGlassSurface>
</Window>
