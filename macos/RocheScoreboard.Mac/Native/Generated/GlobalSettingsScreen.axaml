<!-- Generated from production WPF source; edit the translator. -->
<UserControl xmlns="https://github.com/avaloniaui" xmlns:ns2="clr-namespace:Roche_Scoreboard.Services" xmlns:ns4="clr-namespace:Roche_Scoreboard.Views" xmlns:port="clr-namespace:RocheScoreboard.Mac.Production" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.GlobalSettingsScreen" Background="Transparent" SizeChanged="Settings_SizeChanged" ns2:OperatorDesign.IsEnabled="True" xmlns:local="clr-namespace:Roche_Scoreboard.Views" xmlns:motion="clr-namespace:Roche_Scoreboard.Services" port:ProductionNames.Root="True" xmlns:native="clr-namespace:RocheScoreboard.Mac.Native" xmlns:services="clr-namespace:Roche_Scoreboard.Services" xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base" xmlns:fonts="clr-namespace:RocheScoreboard.Mac.Native">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/OperatorControls.axaml" />
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/SettingsControls.axaml" />
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/ControlCentre.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ControlTheme TargetType="ComboBox" BasedOn="{StaticResource SettingsChoice}" x:Key="{x:Type ComboBox}" />
            <ControlTheme TargetType="TextBox" BasedOn="{StaticResource SettingsInput}" x:Key="{x:Type TextBox}" />
            <ControlTheme TargetType="CheckBox" BasedOn="{StaticResource SettingsToggle}" x:Key="{x:Type CheckBox}" />
            <ControlTheme x:Key="GlobalSettingsCard" TargetType="Border" BasedOn="{StaticResource SettingsSectionSurface}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,20" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="BorderThickness" Value="1" />
            </ControlTheme>
            <ControlTheme x:Key="PreferenceName" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource ControlCentre.BodySize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource ControlCentre.TextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </ControlTheme>
            <ControlTheme x:Key="PreferenceDetail" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource ControlCentre.CaptionSize}" />
                <Setter Property="Foreground" Value="{DynamicResource ControlCentre.SecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,18,0" />
            </ControlTheme>
            <ControlTheme x:Key="GroupCaption" TargetType="TextBlock" BasedOn="{StaticResource PreferenceName}">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="Margin" Value="20,18,20,10" />
            </ControlTheme>
            <ControlTheme x:Key="PreferenceDivider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="20,0" />
                <Setter Property="Background" Value="{DynamicResource ControlCentre.BorderBrush}" />
                <Setter Property="Opacity" Value=".45" />
            </ControlTheme>
            <ControlTheme x:Key="SettingsLaunchButton" TargetType="Button" BasedOn="{StaticResource ControlCentre.Button}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ns4:SettingsWorkspace x:Name="SettingsWorkspace" Heading="Settings" Subtitle="Set up the operator interface and shared output defaults.">
            <Border x:Name="AppearanceSection" Tag="APPEARANCE|theme light dark density compact comfortable" Theme="{StaticResource GlobalSettingsCard}">
                <StackPanel>
                    <TextBlock Text="Appearance" Theme="{StaticResource GroupCaption}" />
                    <Grid x:Name="AppearanceFieldsGrid" Margin="20,12,20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Interface theme" Theme="{StaticResource PreferenceName}" />
                            <TextBlock Text="Choose how the control panel looks." Theme="{StaticResource PreferenceDetail}" />
                        </StackPanel>
                        <ns4:OperatorGlassSurface x:Name="ThemeChoicePanel" Grid.Column="1" Material="Regular" CornerRadius="22" Padding="4" Width="270">
                            <ns4:OperatorSegmentedPanel Rows="1">
                                <RadioButton x:Name="LightThemeTile" AutomationProperties.Name="Light" Tag="theme:0" GroupName="AppTheme" Theme="{StaticResource SettingsSegment}" IsCheckedChanged="Native_PreferenceTile_Checked_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <ns2:OperatorSymbol Kind="light" Width="18" Height="18" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Text="Light" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="DarkThemeTile" AutomationProperties.Name="Dark" Tag="theme:1" GroupName="AppTheme" Theme="{StaticResource SettingsSegment}" IsCheckedChanged="Native_PreferenceTile_Checked_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <ns2:OperatorSymbol Kind="dark" Width="18" Height="18" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Text="Dark" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </ns4:OperatorSegmentedPanel>
                        </ns4:OperatorGlassSurface>
                    </Grid>
                    <Border Theme="{StaticResource PreferenceDivider}" />
                    <Grid x:Name="DensityFieldPanel" Margin="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Interface density" Theme="{StaticResource PreferenceName}" />
                            <TextBlock Text="Change text size and control spacing together." Theme="{StaticResource PreferenceDetail}" />
                        </StackPanel>
                        <ns4:OperatorGlassSurface x:Name="DensityChoicePanel" Grid.Column="1" Material="Regular" CornerRadius="22" Padding="4" Width="270">
                            <ns4:OperatorSegmentedPanel Rows="1">
                                <RadioButton x:Name="ComfortableTile" AutomationProperties.Name="Comfortable" Tag="density:0" GroupName="Density" Theme="{StaticResource SettingsSegment}" IsCheckedChanged="Native_PreferenceTile_Checked_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <ns2:OperatorSymbol Kind="comfortable" Width="18" Height="18" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Text="Comfortable" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="CompactTile" AutomationProperties.Name="Compact" Tag="density:1" GroupName="Density" Theme="{StaticResource SettingsSegment}" IsCheckedChanged="Native_PreferenceTile_Checked_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <ns2:OperatorSymbol Kind="compact" Width="18" Height="18" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Text="Compact" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </ns4:OperatorSegmentedPanel>
                        </ns4:OperatorGlassSurface>
                    </Grid>
                    <ComboBox x:Name="ThemeCombo" IsVisible="False" SelectionChanged="Native_ThemeCombo_SelectionChanged" />
                    <ComboBox x:Name="DensityCombo" IsVisible="False" SelectionChanged="Native_DensityCombo_SelectionChanged" />
                </StackPanel>
            </Border>
            <Border Tag="APPEARANCE|glass material transparency motion animations accessibility" Theme="{StaticResource GlobalSettingsCard}">
                <StackPanel>
                    <TextBlock Text="Materials &amp; motion" Theme="{StaticResource GroupCaption}" />
                    <Grid Margin="20,12,20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ns2:OperatorSymbol Kind="display" Width="26" Height="26" Foreground="#87CAFF" IsActive="{Binding IsChecked, ElementName=GlassMaterialToggle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Liquid glass" Theme="{StaticResource PreferenceName}" />
                            <TextBlock Text="Depth, lens highlights and translucent navigation. Turn off for solid surfaces." Theme="{StaticResource PreferenceDetail}" />
                        </StackPanel>
                        <CheckBox x:Name="GlassMaterialToggle" Grid.Column="2" Width="60" Content="" AutomationProperties.Name="Liquid glass operator surfaces" IsCheckedChanged="Native_InteractionPreference_Changed" />
                    </Grid>
                    <Border Theme="{StaticResource PreferenceDivider}" />
                    <Grid Margin="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ns2:OperatorSymbol Kind="automation" Width="25" Height="25" Foreground="#E6BE73" IsActive="{Binding IsChecked, ElementName=ReducedMotionToggle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Reduce motion" Theme="{StaticResource PreferenceName}" />
                            <TextBlock Text="Keep clear selection feedback with less movement. Also respects Windows accessibility settings." Theme="{StaticResource PreferenceDetail}" />
                        </StackPanel>
                        <CheckBox x:Name="ReducedMotionToggle" Grid.Column="2" Width="60" Content="" AutomationProperties.Name="Reduce operator interface motion" IsCheckedChanged="Native_InteractionPreference_Changed" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Tag="CONTROLS|navigation hints shortcuts volunteers" Theme="{StaticResource GlobalSettingsCard}">
                <Grid Margin="20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Navigation hints" Theme="{StaticResource PreferenceName}" />
                        <TextBlock Text="Show guidance for setup and common match actions." Theme="{StaticResource PreferenceDetail}" />
                    </StackPanel>
                    <CheckBox x:Name="QuickHintsToggle" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Show navigation hints" VerticalAlignment="Center" IsCheckedChanged="Native_QuickHintsToggle_Changed" />
                </Grid>
            </Border>
            <Border x:Name="OutputDefaultsSection" Tag="SCOREBOARD|output dimensions width height reset goal animation" Theme="{StaticResource GlobalSettingsCard}">
                <StackPanel>
                    <TextBlock Text="Output defaults" Theme="{StaticResource GroupCaption}" />
                    <Grid x:Name="GoalAnimationRow" Margin="20,12,20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Goal animation" Theme="{StaticResource PreferenceName}" />
                            <TextBlock Text="The starting choice for a new AFL match." Theme="{StaticResource PreferenceDetail}" />
                        </StackPanel>
                        <ComboBox x:Name="GoalAnimationCombo" Grid.Column="1" Width="270" SelectionChanged="Native_GoalAnimationCombo_SelectionChanged" />
                    </Grid>
                    <Border Theme="{StaticResource PreferenceDivider}" />
                    <Grid x:Name="OutputFieldsGrid" Margin="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Window dimensions" Theme="{StaticResource PreferenceName}" />
                            <TextBlock Text="Shared across AFL, cricket and training. Values are in pixels." Theme="{StaticResource PreferenceDetail}" />
                        </StackPanel>
                        <StackPanel x:Name="OutputDimensionsFieldPanel" Grid.Column="1" Width="270">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputWidthBox" Text="386" MaxLength="4" AutomationProperties.Name="Output width in pixels" Padding="10,8" />
                                <TextBlock Grid.Column="1" Text="×" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBox x:Name="OutputHeightBox" Grid.Column="2" Text="193" MaxLength="4" AutomationProperties.Name="Output height in pixels" Padding="10,8" />
                                <Button Grid.Column="3" Content="Apply" Margin="8,0,0,0" Padding="10,8" Click="ApplyOutputDimensions_Click" Theme="{StaticResource ControlCentre.PrimaryButton}" />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="2× preview" Click="DoubleOutputDimensions_Click" FontSize="13" Margin="0,0,8,0" Padding="12,8" Theme="{StaticResource SettingsLaunchButton}" />
                                <Button Content="Reset dimensions" Click="ResetOutputDimensions_Click" FontSize="13" Padding="12,8" Theme="{StaticResource SettingsLaunchButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="AutomationSection" Tag="AUTOMATION|automatic overlays quarter break rotation" Theme="{StaticResource GlobalSettingsCard}">
                <StackPanel>
                    <TextBlock Text="Automation" Theme="{StaticResource GroupCaption}" />
                    <Grid Margin="20,12,20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Quarter-break rotation" Theme="{StaticResource PreferenceName}" />
                            <TextBlock Text="Cycle presentation screens during AFL breaks." Theme="{StaticResource PreferenceDetail}" />
                        </StackPanel>
                        <CheckBox x:Name="BreakScreenToggle" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Quarter-break rotation" IsCheckedChanged="Native_BreakScreenToggle_Changed" />
                    </Grid>
                    <Border Theme="{StaticResource PreferenceDivider}" />
                    <Grid Margin="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Automatic overlays" Theme="{StaticResource PreferenceName}" />
                            <TextBlock Text="Show relevant match information during quiet play." Theme="{StaticResource PreferenceDetail}" />
                        </StackPanel>
                        <CheckBox x:Name="AutoOverlaysToggle" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Automatic overlays" IsCheckedChanged="Native_AutoOverlaysToggle_Changed" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Tag="SCOREBOARD|screensaver idle custom image video mp4 clock time" Theme="{StaticResource GlobalSettingsCard}">
                <StackPanel>
                    <TextBlock Text="Between matches" Theme="{StaticResource GroupCaption}" />
                    <Grid Margin="20,12,20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Idle screensaver" Theme="{StaticResource PreferenceName}" />
                            <TextBlock Text="Use the output display when no match is active." Theme="{StaticResource PreferenceDetail}" />
                        </StackPanel>
                        <CheckBox x:Name="ScreensaverToggle" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Idle screensaver" Theme="{StaticResource SettingsPower}" IsCheckedChanged="Native_ScreensaverToggle_Changed" />
                    </Grid>
                    <Border Theme="{StaticResource PreferenceDivider}" />
                    <Grid Margin="16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BuiltinScreensaverButton" Tag="builtin" Click="ScreensaverSource_Click" Margin="4" Padding="16" Theme="{StaticResource OperatorPresentationButton}">
                            <StackPanel>
                                <ns2:OperatorSymbol Kind="display" Width="26" Height="26" Foreground="#8BC7FF" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                <TextBlock Text="Sports scene" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Built-in movement" FontSize="13" Foreground="#B6B6C0" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="BuiltinScreensaverSelected" Text="✓ ACTIVE" Foreground="#82EDAF" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CustomScreensaverButton" Grid.Column="1" Tag="custom" Click="ScreensaverSource_Click" Margin="4" Padding="16" Theme="{StaticResource OperatorPresentationButton}">
                            <StackPanel>
                                <ns2:OperatorSymbol Kind="media" Width="26" Height="26" Foreground="#B59AFF" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                <TextBlock Text="Your media" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Image or MP4" FontSize="13" Foreground="#B6B6C0" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="CustomScreensaverSelected" Text="SELECT FILE →" Foreground="#B6B6C0" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="GlobalScreensaverStatus" Text="Built-in sports scene" Margin="20,0,20,18" Theme="{StaticResource PreferenceDetail}" />
                    <Border Theme="{StaticResource PreferenceDivider}" />
                    <Grid Margin="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Show the clock" VerticalAlignment="Center" Theme="{StaticResource PreferenceName}" />
                        <CheckBox x:Name="ScreensaverClockToggle" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Show the clock on the screensaver" IsChecked="True" IsCheckedChanged="Native_ScreensaverClock_Changed" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="StartupSection" Tag="SYSTEM|startup resume last sport" Theme="{StaticResource GlobalSettingsCard}">
                <StackPanel>
                    <TextBlock Text="On opening the app" Theme="{StaticResource GroupCaption}" />
                    <StackPanel Margin="16,0,16,16">
                        <RadioButton x:Name="ResumeStartupTile" Content="Resume a saved match" Tag="startup:0" GroupName="Startup" HorizontalContentAlignment="Left" Margin="0,4" Theme="{StaticResource SettingsTile}" IsCheckedChanged="Native_PreferenceTile_Checked_Checked" />
                        <RadioButton x:Name="LastModeStartupTile" Content="Open the last used sport" Tag="startup:1" GroupName="Startup" HorizontalContentAlignment="Left" Margin="0,4" Theme="{StaticResource SettingsTile}" IsCheckedChanged="Native_PreferenceTile_Checked_Checked" />
                        <RadioButton x:Name="SelectionStartupTile" Content="Choose a sport" Tag="startup:2" GroupName="Startup" HorizontalContentAlignment="Left" Margin="0,4" Theme="{StaticResource SettingsTile}" IsCheckedChanged="Native_PreferenceTile_Checked_Checked" />
                    </StackPanel>
                    <ComboBox x:Name="StartupModeCombo" IsVisible="False" SelectionChanged="Native_StartupModeCombo_SelectionChanged" />
                </StackPanel>
            </Border>
        </ns4:SettingsWorkspace>
        <Button x:Name="BackButton" Grid.Row="1" Content="←  Back to sports" HorizontalAlignment="Left" Margin="18,0,18,14" MinWidth="190" Height="42" Click="BackButton_Click" Theme="{StaticResource SettingsLaunchButton}" />
    </Grid>
</UserControl>
