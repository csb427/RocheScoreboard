<!-- Generated from production WPF source; edit the translator. -->
<UserControl xmlns="https://github.com/avaloniaui" xmlns:ns3="clr-namespace:Roche_Scoreboard.Views" xmlns:port="clr-namespace:RocheScoreboard.Mac.Production" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.WeatherScreenControl" UseLayoutRounding="True" xmlns:local="clr-namespace:Roche_Scoreboard.Views" port:ProductionNames.Root="True" xmlns:native="clr-namespace:RocheScoreboard.Mac.Native" xmlns:motion="clr-namespace:Roche_Scoreboard.Services" xmlns:services="clr-namespace:Roche_Scoreboard.Services" xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base" xmlns:fonts="clr-namespace:RocheScoreboard.Mac.Native">
    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="0" port:ProductionNames.Id="WeatherTitleRow" />
            <RowDefinition Height="149*" port:ProductionNames.Id="WeatherBodyRow" />
            <RowDefinition Height="44*" />
        </Grid.RowDefinitions>
        <Border x:Name="WeatherTitlePanel" Grid.Row="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,0,1" IsVisible="False" />
        <Grid Grid.Row="0" Margin="6,0" IsVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LocationText" Text="WEATHER" Foreground="White" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Segoe UI'}" Margin="0,0,8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBlock x:Name="WeatherTitleText" IsVisible="False" />
            <TextBlock x:Name="WeatherTimeText" Grid.Column="1" Text="1:26 PM" Foreground="#D6E3EF" FontSize="16" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Background="#0D1117" BorderBrush="#F0C040" BorderThickness="2" Margin="4,2,4,2">
            <Grid Margin="6,4,6,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78*" port:ProductionNames.Id="WeatherHeroRow" />
                    <RowDefinition Height="51*" port:ProductionNames.Id="WeatherStatsRow" />
                </Grid.RowDefinitions>
                <Grid x:Name="WeatherDataPanel" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Stretch="Uniform" Margin="2">
                        <TextBlock x:Name="CurrentIcon" Text="☀" FontFamily="{fonts:ProductionFont 'Segoe UI Emoji, Segoe UI Symbol'}" FontSize="80" Foreground="#FFD54A">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#FFD54A" Opacity="0.55" OffsetX="0" OffsetY="0" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Viewbox>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="2,0,2,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="CurrentTemp" Text="22°" Foreground="#FFD54A" FontSize="160" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" />
                        </Viewbox>
                        <TextBlock Grid.Row="1" x:Name="CurrentDescription" Text="Clear Sky" Foreground="White" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Segoe UI'}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,1" />
                    </Grid>
                </Grid>
                <Border x:Name="WeatherStatsPanel" Grid.Row="1" BorderBrush="#30363D" BorderThickness="0,1,0,0" Margin="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="5,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MIN " Foreground="#9ACBFF" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Segoe UI'}" VerticalAlignment="Center" />
                                <TextBlock x:Name="DayMinTemp" Text="14°" Foreground="#7AB8FF" FontSize="38" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Viewbox>
                        <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="5,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="FEELS " Foreground="#D6E3EF" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Segoe UI'}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FeelsLikeTemp" Text="20°" Foreground="White" FontSize="38" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Viewbox>
                        <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="5,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MAX " Foreground="#FF9292" FontSize="18" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Segoe UI'}" VerticalAlignment="Center" />
                                <TextBlock x:Name="DayMaxTemp" Text="26°" Foreground="#FF6E6E" FontSize="38" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Border>
                <Grid x:Name="WeatherUnavailablePanel" Grid.RowSpan="2" Margin="12,5" IsHitTestVisible="False" IsVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="WEATHER DATA UNAVAILABLE" Foreground="#FFD54A" FontFamily="{fonts:ProductionFont 'Arial'}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" TextAlignment="Center" />
                        <Border Height="2" Width="72" Margin="0,7,0,7" Background="#58A6FF" />
                        <TextBlock Text="SET A LOCATION OR CHECK THE CONNECTION" Foreground="#C9D1D9" FontFamily="{fonts:ProductionFont 'Arial'}" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <ns3:PresentationScoreBar x:Name="ScoreBar" Grid.Row="2" />
    </Grid>
</UserControl>
