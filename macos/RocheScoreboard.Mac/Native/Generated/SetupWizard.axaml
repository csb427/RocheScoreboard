                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.3" />
                                                    <GradientStop Color="#FFFFFFFF" Offset="0.7" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Border x:Name="Step3Panel" ClipToBounds="False" Opacity="0" RenderTransformOrigin="50%,50%" Margin="0" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0" IsVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform X="80" port:ProductionNames.Id="Step3Translate" />
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel>
                                <StackPanel x:Name="ClockHeaderGroup" Opacity="1" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform Y="15" port:ProductionNames.Id="ClockHeaderTranslate" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="Match clock" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Choose how the scoreboard counts time." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <Grid ns4:WizardPair.MinimumColumnWidth="260" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ns4:OperatorGlassSurface x:Name="CountUpCard" Grid.Row="0" Cursor="Hand" Margin="0" MinHeight="132" Background="Transparent" BorderBrush="#58A6FF" BorderThickness="2" CornerRadius="24" Material="Regular" Padding="20" ClipToBounds="False" Grid.Column="0" native:NativeActivation.Enabled="True" PointerReleased="Native_CountUpCard_Click">
                                        <Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ns2:OperatorSymbol Kind="clock" Width="30" Height="30" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Count up" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="Start at zero and show elapsed playing time." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <Border x:Name="CountUpSelected" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="6" Margin="0,0,0,0" Grid.Column="2" CornerRadius="10">
                                                    <TextBlock Text="✓" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" />
                                                </Border>
                                            </Grid>
                                            <Grid IsHitTestVisible="False" IsVisible="False">
                                                <Grid>
                                                    <Border x:Name="CountUpGlowBg" Opacity="0.15" IsHitTestVisible="False" IsVisible="False">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                <GradientStop Color="#58A6FF" Offset="0" />
                                                                <GradientStop Color="#00000000" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="CountUpIcon" Text="▲" FontSize="36" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" Color="#58A6FF" Opacity="0" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="COUNT UP" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Open-ended timing" FontSize="10" FontWeight="SemiBold" Foreground="#5080AA" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </ns4:OperatorGlassSurface>
                                    <ns4:OperatorGlassSurface x:Name="CountdownCard" Grid.Row="0" Cursor="Hand" MinHeight="132" Background="Transparent" BorderBrush="#3A3018" BorderThickness="1" CornerRadius="24" Material="Regular" Padding="20" Margin="0" ClipToBounds="False" Grid.Column="2" native:NativeActivation.Enabled="True" PointerReleased="Native_CountdownCard_Click">
                                        <Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ns2:OperatorSymbol Kind="clock" Width="30" Height="30" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Count down" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="Start at the quarter limit and count back to zero." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <Border x:Name="CountdownSelected" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="6" Grid.Column="2" CornerRadius="10" IsVisible="False">
                                                    <TextBlock Text="✓" FontSize="12" FontWeight="SemiBold" Foreground="#1A1400" />
                                                </Border>
                                            </Grid>
                                            <Grid IsHitTestVisible="False" IsVisible="False">
                                                <Grid>
                                                    <Border x:Name="CountdownGlowBg" Opacity="0" IsHitTestVisible="False" IsVisible="False">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                <GradientStop Color="#D29922" Offset="0" />
                                                                <GradientStop Color="#00000000" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="CountdownIcon" Text="▼" FontSize="36" FontWeight="SemiBold" Foreground="#6B5A00" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                        <TextBlock Text="COUNTDOWN" FontSize="20" FontWeight="SemiBold" Foreground="#8A7A50" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Timed quarters" FontSize="10" FontWeight="SemiBold" Foreground="#5A5030" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </ns4:OperatorGlassSurface>
                                </Grid>
                                <ns4:OperatorGlassSurface x:Name="ControlPanelCountdownOptionCard" Grid.Row="1" Margin="0,16,0,16" Padding="16,12" Background="#0E1B2B" BorderBrush="#58A6FF" BorderThickness="2" CornerRadius="22" Cursor="Hand" Opacity="0" MinHeight="90" RenderTransformOrigin="50%,50%" Material="Regular" IsVisible="False" native:NativeActivation.Enabled="True" PointerReleased="Native_ControlPanelCountdownOptionCard_Click">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform Y="24" port:ProductionNames.Id="ControlPanelCountdownCardTranslate" />
                                            <ScaleTransform ScaleX="0.96" ScaleY="0.96" port:ProductionNames.Id="ControlPanelCountdownCardScale" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <ns2:OperatorSymbol Kind="clock" Width="25" Height="25" Foreground="{DynamicResource ControlCentre.AccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Timing stoppages" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Control stoppage timing from the panel during count-up matches." Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="14" FontWeight="Normal" TextWrapping="Wrap" LineHeight="17" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <CheckBox Content="" Width="56" IsChecked="{Binding IsChecked, ElementName=SetupControlPanelCountdown, Mode=TwoWay}" AutomationProperties.Name="Enable timing stoppages" Theme="{StaticResource SettingsToggle}" />
                                            <Grid IsHitTestVisible="False" IsVisible="False">
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0" HorizontalAlignment="Center">
                                                    <Border x:Name="ControlPanelCountdownToggleTrack" Width="54" Height="28" CornerRadius="14" Background="#1F6FEB">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="0" Color="#58A6FF" Opacity="0" OffsetX="0" OffsetY="0" />
                                                        </Border.Effect>
                                                        <Canvas Width="54" Height="28" IsHitTestVisible="False" ClipToBounds="True">
                                                            <Ellipse x:Name="ControlPanelCountdownToggleThumb" Width="22" Height="22" Canvas.Left="3" Canvas.Top="3" Fill="White">
                                                                <Ellipse.RenderTransform>
                                                                    <TranslateTransform X="26" port:ProductionNames.Id="ControlPanelCountdownThumbTranslate" />
                                                                </Ellipse.RenderTransform>
                                                            </Ellipse>
                                                        </Canvas>
                                                    </Border>
                                                    <TextBlock x:Name="ControlPanelCountdownToggleLabel" Text="ON" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="10" FontWeight="SemiBold" Foreground="#58A6FF" />
                                                    <TextBlock x:Name="ControlPanelCountdownHintText" Text="Quarter length editable" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="9" FontWeight="SemiBold" Foreground="#9CC9FF" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </ns4:OperatorGlassSurface>
                                <ns4:OperatorGlassSurface x:Name="SetupDurationPanel" Material="Regular" CornerRadius="24" Margin="0,0,0,16" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Quarter length" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" />
                                            <TextBlock Text="Set the scheduled playing time for each quarter." FontSize="14" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,16" />
                                        </StackPanel>
                                        <StackPanel x:Name="QuarterLengthControls" Grid.Row="1">
                                            <Grid Margin="0,2,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="−" FontSize="28" Padding="0" Height="48" MinHeight="0" Click="MinutesMinus_Click" AutomationProperties.Name="Reduce quarter length" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="10,0">
                                                    <TextBlock x:Name="DurationMinutesDisplay" Text="20" FontSize="48" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="minutes" FontSize="14" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="+" FontSize="25" Padding="0" Height="48" MinHeight="0" Click="MinutesPlus_Click" AutomationProperties.Name="Increase quarter length" VerticalAlignment="Center" />
                                            </Grid>
                                            <UniformGrid Rows="1" Columns="4">
                                                <Border x:Name="Preset10Tile" CornerRadius="20" Margin="3">
                                                    <Button Content="10" FontSize="16" MinHeight="42" Padding="6,8" Click="SetupQuickDuration10_Click" AutomationProperties.Name="Ten minute quarters" />
                                                </Border>
                                                <Border x:Name="Preset15Tile" CornerRadius="20" Margin="3">
                                                    <Button Content="15" FontSize="16" MinHeight="42" Padding="6,8" Click="SetupQuickDuration15_Click" AutomationProperties.Name="Fifteen minute quarters" />
                                                </Border>
                                                <Border x:Name="Preset20Tile" CornerRadius="20" Margin="3">
                                                    <Button Content="20" FontSize="16" MinHeight="42" Padding="6,8" Click="SetupQuickDuration20_Click" AutomationProperties.Name="Twenty minute quarters" />
                                                </Border>
                                                <Border x:Name="Preset25Tile" CornerRadius="20" Margin="3">
                                                    <Button Content="25" FontSize="16" MinHeight="42" Padding="6,8" Click="SetupQuickDuration25_Click" AutomationProperties.Name="Twenty five minute quarters" />
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>
                                        <Border x:Name="DurationDisabledOverlay" Grid.Row="2" Margin="0,12,0,0" Background="Transparent" IsVisible="False">
                                            <TextBlock Text="Enable timing stoppages to set a quarter length for count-up matches." FontSize="14" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" />
                                        </Border>
                                        <Border x:Name="DurationGlowBg" IsHitTestVisible="False" IsVisible="False" />
                                    </Grid>
                                </ns4:OperatorGlassSurface>
                            </StackPanel>
                            <Grid IsHitTestVisible="False" IsVisible="False">
                                <Grid>
                                    <Border x:Name="ClockGlow" Opacity="0" IsHitTestVisible="False" IsVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="50%,20%" RadiusX="50%" RadiusY="40%">
                                                <GradientStop Color="#2558A6FF" Offset="0" />
                                                <GradientStop Color="#0858A6FF" Offset="0.6" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#00000000" Offset="0.3" />
                                                <GradientStop Color="#30000000" Offset="1.0" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <RadioButton x:Name="SetupCountUp" GroupName="SetupClock" IsVisible="False" IsCheckedChanged="Native_SetupClockMode_Changed" />
                                    <RadioButton x:Name="SetupCountdown" IsChecked="True" GroupName="SetupClock" IsVisible="False" IsCheckedChanged="Native_SetupClockMode_Changed" />
                                    <CheckBox x:Name="SetupControlPanelCountdown" IsChecked="True" IsVisible="False" IsCheckedChanged="Native_SetupClockMode_Changed" />
                                    <TextBox x:Name="SetupQuarterMinutes" Text="20" IsVisible="False" TextChanged="Native_SetupQuarterDuration_TextChanged" />
                                    <TextBox x:Name="SetupQuarterSeconds" Text="00" IsVisible="False" TextChanged="Native_SetupQuarterDuration_TextChanged" />
                                    <Grid Margin="24,10,24,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1" ns4:WizardPair.MinimumColumnWidth="330">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="Step4Panel" ClipToBounds="False" Opacity="0" RenderTransformOrigin="50%,50%" Background="Transparent" BorderThickness="0" Margin="0" MinHeight="0" Padding="0" IsVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform X="80" port:ProductionNames.Id="Step4Translate" />
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel>
                                <StackPanel x:Name="MsgHeaderGroup" Opacity="1" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform Y="15" port:ProductionNames.Id="MsgHeaderTranslate" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="Venue and options" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Optional details. You can change these during the match." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <ns4:OperatorGlassSurface x:Name="FinalsCard" Grid.Row="0" Cursor="Hand" Background="Transparent" BorderBrush="#2A2020" BorderThickness="0" Margin="0,0,0,16" MinHeight="0" Padding="22" ClipToBounds="False" Material="Regular" CornerRadius="26" native:NativeActivation.Enabled="True" PointerReleased="Native_FinalsCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ns2:OperatorSymbol Kind="star" Width="30" Height="30" Foreground="#EAC779" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Finals mode" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Use the gold match presentation accents." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border x:Name="FinalsSelectedBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D4A017" Padding="8,4" Grid.Column="2" CornerRadius="10" IsVisible="False">
                                            <TextBlock Text="✓" FontSize="12" FontWeight="SemiBold" Foreground="#1A1400" />
                                        </Border>
                                        <TextBlock x:Name="FinalsIcon" Text="★" FontSize="48" FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="SemiBold" Foreground="#D8B84F" HorizontalAlignment="Center" Margin="0,0,0,8" IsVisible="False" />
                                    </Grid>
                                </ns4:OperatorGlassSurface>
                                <ns4:OperatorGlassSurface x:Name="WeatherCard" Grid.Row="2" Background="Transparent" BorderBrush="#1A3060" BorderThickness="0" Margin="0,0,0,16" MinHeight="0" Padding="22" ClipToBounds="False" Material="Regular" CornerRadius="26">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ns2:OperatorSymbol Kind="weather" Width="32" Height="32" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Venue weather" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="Search the town, suburb or venue used for live conditions." FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,14" />
                                            <ComboBox x:Name="SetupWeatherLocation" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="200" VerticalAlignment="Center" FontSize="16" Text="Melbourne, Australia" MinWidth="0" HorizontalAlignment="Stretch" Height="46" Theme="{StaticResource DarkCombo}" />
                                        </StackPanel>
                                    </Grid>
                                </ns4:OperatorGlassSurface>
                                <ns4:OperatorGlassSurface Grid.Column="2" Background="Transparent" BorderBrush="#1A2A40" BorderThickness="0" ClipToBounds="False" Margin="0,0,0,16" MinHeight="0" Padding="4" Material="Regular" CornerRadius="26">
                                    <Grid>
                                        <Border x:Name="MsgSectionGlow" Opacity="0.06" IsHitTestVisible="False" IsVisible="False">
                                            <Border.Background>
                                                <RadialGradientBrush Center="50%,15%" RadiusX="60%" RadiusY="50%">
                                                    <GradientStop Color="#3FB950" Offset="0" />
                                                    <GradientStop Color="#00000000" Offset="1" />
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Grid Margin="18,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="▣" FontSize="28" FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="SemiBold" Foreground="#67D17B" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Ticker messages" FontSize="20" FontWeight="SemiBold" Foreground="#3FB950" HorizontalAlignment="Center" />
                                                <TextBlock Text="Scroll across the bottom bar during the game" FontSize="12" FontWeight="SemiBold" Foreground="#75C985" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border Grid.Row="1" Height="1" Margin="0,0,0,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                        <GradientStop Color="#003FB950" Offset="0" />
                                                        <GradientStop Color="#303FB950" Offset="0.5" />
                                                        <GradientStop Color="#003FB950" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Grid.Row="2" Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Padding="8" CornerRadius="16">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="SetupMessageList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#111113" BorderBrush="#3A3A40" BorderThickness="1" Padding="8,6" Margin="0,0,0,6" CornerRadius="3">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Border Grid.Row="0" Grid.ColumnSpan="4" CornerRadius="2" Padding="6,3" Margin="0,0,0,4" Background="{Binding HighlightBrush}">
                                                                            <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding TextBrush}" />
                                                                        </Border>
                                                                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Background="#060A10" Foreground="#E6EDF3" BorderBrush="#3A3A40" CaretBrush="White" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                                                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="TEXT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                            <Button Width="34" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickItemTextColor_Click" Tag="{Binding}" Background="{Binding TextBrush}" ToolTip.Tip="Click to choose text colour" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="HIGHLIGHT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                            <Button Width="50" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickItemHighlightColor_Click" Tag="{Binding}" Background="{Binding HighlightBrush}" ToolTip.Tip="Click to choose highlight colour. Right-click to clear." PointerReleased="Native_SetupClearItemHighlightColor_Click" />
                                                                        </StackPanel>
                                                                        <Button Grid.Row="1" Grid.Column="3" Content="✕" Width="30" Height="40" FontSize="12" FontWeight="SemiBold" Click="SetupRemoveMessageItem_Click" Tag="{Binding}" Background="#3A1A1A" Foreground="#E6EDF3" BorderBrush="#3A1A1A" VerticalAlignment="Bottom" ToolTip.Tip="Remove this message" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="SetupNewMessageBox" Margin="0,0,6,0" KeyDown="SetupNewMessageBox_KeyDown" Theme="{StaticResource WizardField}" />
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="TEXT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                    <Button x:Name="SetupNewMessageTextColorBtn" Width="34" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickNewTextColor_Click" Background="White" ToolTip.Tip="Choose text colour for new messages" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="HIGHLIGHT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                    <Button x:Name="SetupNewMessageHighlightColorBtn" Width="50" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickNewHighlightColor_Click" Background="Transparent" PointerReleased="Native_SetupClearNewHighlightColor_Click" ToolTip.Tip="Choose highlight colour. Right-click to clear." />
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="Add" Height="30" Click="SetupAddMessage_Click" Theme="{StaticResource SmallBtn}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </ns4:OperatorGlassSurface>
                            </StackPanel>
                            <Grid IsHitTestVisible="False" IsVisible="False">
                                <Grid>
                                    <Border x:Name="MsgGlow" Opacity="0" IsHitTestVisible="False" IsVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="50%,20%" RadiusX="50%" RadiusY="40%">
                                                <GradientStop Color="#203FB950" Offset="0" />
                                                <GradientStop Color="#083FB950" Offset="0.6" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#00000000" Offset="0.3" />
                                                <GradientStop Color="#30000000" Offset="1.0" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <CheckBox x:Name="SetupFinalsMode" IsVisible="False" />
                                    <Grid Margin="24,10,24,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1" ns4:WizardPair.MinimumColumnWidth="330">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="12" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Grid IsHitTestVisible="False" IsVisible="False">
                    <Border Opacity="0.006" IsHitTestVisible="False">
                        <Border.Background>
                            <VisualBrush TileMode="Tile" DestinationRect="0,0,40,40" SourceRect="0,0,40,40">
                                <VisualBrush.Visual>
                                    <Canvas Width="40" Height="40">
                                        <Line Stroke="White" StrokeThickness="1" StartPoint="0,40" EndPoint="40,0" />
                                    </Canvas>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="BgGlow" Opacity="0" IsHitTestVisible="False" IsVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="50%,30%" RadiusX="70%" RadiusY="70%">
                                <GradientStop Color="#2058A6FF" Offset="0" />
                                <GradientStop Color="#0858A6FF" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border ClipToBounds="True" IsHitTestVisible="False" Opacity="0.04">
                        <Border Width="200" HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform X="-300" port:ProductionNames.Id="BeamTranslate" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#30FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse Width="6" Height="6" Fill="#1858A6FF" Canvas.Left="60" Canvas.Top="80">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" Fill="#1258A6FF" Canvas.Left="180" Canvas.Top="200">
                            <Ellipse.Effect>
                                <BlurEffect Radius="4" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="#2058A6FF" Canvas.Left="300" Canvas.Top="120">
                            <Ellipse.Effect>
                                <BlurEffect Radius="2" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="#1558A6FF" Canvas.Left="420" Canvas.Top="350">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="5" Height="5" Fill="#1858A6FF" Canvas.Left="550" Canvas.Top="50">
                            <Ellipse.Effect>
                                <BlurEffect Radius="2" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="7" Height="7" Fill="#10FF6B6B" Canvas.Left="650" Canvas.Top="280">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="9" Height="9" Fill="#10FF6B6B" Canvas.Left="750" Canvas.Top="100">
                            <Ellipse.Effect>
                                <BlurEffect Radius="4" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#00000000" Offset="0.3" />
                                <GradientStop Color="#60000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Viewbox VerticalAlignment="Top" Margin="12,78,12,0" Stretch="Uniform" StretchDirection="DownOnly" Height="36" ZIndex="11">
        </Viewbox>
                    <Border x:Name="BottomAccent" VerticalAlignment="Bottom" Height="3" Opacity="0" IsHitTestVisible="False" ZIndex="11" IsVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#58A6FF" Offset="0" />
                                <GradientStop Color="#1AFFFFFF" Offset="0.5" />
                                <GradientStop Color="#FF6B6B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="FlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False" ZIndex="20" IsVisible="False" />
                </Grid>
                <Grid IsHitTestVisible="False" IsVisible="False">
                    <Border x:Name="FinalsGlowBg" Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                <GradientStop Color="#D4A017" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="WeatherGlowBg" Opacity="0.08" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="50%,40%" RadiusX="50%" RadiusY="50%">
                                <GradientStop Color="#58A6FF" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Grid>
        </ns4:WizardViewport>
        <ns4:OperatorGlassSurface x:Name="HeaderPanel" Material="Regular" CornerRadius="28" Margin="16,12,16,8" Padding="14,10" Opacity="1" Grid.Row="0" MaxWidth="1440">
            <Border.RenderTransform>
                <TranslateTransform Y="-30" port:ProductionNames.Id="HeaderTranslate" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ns2:OperatorSymbol Kind="match" Width="28" Height="28" Foreground="{DynamicResource ControlCentre.TextBrush}" Margin="0,0,12,0" />
                    <TextBlock x:Name="HeaderTitle" Text="Set up AFL" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" Grid.Column="1" />
                    <TextBlock Text="1 of 3" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" x:Name="WizardStepCounter" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
                <ns4:OperatorSegmentedPanel x:Name="StepIndicator" Rows="1" Grid.Row="1" Height="62" Margin="0,8,0,0" Opacity="1">
                    <ns4:OperatorSegmentedPanel.RenderTransform>
                        <TranslateTransform Y="-20" port:ProductionNames.Id="StepIndicatorTranslate" />
                    </ns4:OperatorSegmentedPanel.RenderTransform>
                    <RadioButton x:Name="Step1Navigation" Click="GoToStep1_Click" GroupName="WizardSteps" Padding="4,6" MinHeight="0" Height="60" Theme="{StaticResource SettingsSegment}" ToolTip.Tip="Go to teams">
                        <StackPanel VerticalAlignment="Center">
                            <ns2:OperatorSymbol Kind="team" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step1Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step1Label" Text="Teams" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step1Dot" Width="36" Height="36" CornerRadius="18" Background="#58A6FF" BorderBrush="#58A6FF" BorderThickness="2" IsVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="#58A6FF" BlurRadius="0" Opacity="0" port:ProductionNames.Id="Step1Glow" OffsetX="0" OffsetY="0" />
                                </Border.Effect>
                                <TextBlock Text="1" Foreground="{DynamicResource ControlCentre.TextBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Step2Navigation" Click="GoToStep2_Click" GroupName="WizardSteps" Padding="4,6" MinHeight="0" Height="60" Theme="{StaticResource SettingsSegment}" ToolTip.Tip="Go to clock">
                        <StackPanel VerticalAlignment="Center">
                            <ns2:OperatorSymbol Kind="clock" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step2Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step2Label" Text="Clock" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step2Dot" Width="36" Height="36" CornerRadius="18" Background="#242427" BorderBrush="#3A3A40" BorderThickness="2" IsVisible="False">
                                <TextBlock Text="2" Foreground="#8E8E98" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Step3Navigation" Click="GoToStep3_Click" GroupName="WizardSteps" Padding="4,6" MinHeight="0" Height="60" Theme="{StaticResource SettingsSegment}" ToolTip.Tip="Go to options">
                        <StackPanel VerticalAlignment="Center">
                            <ns2:OperatorSymbol Kind="settings" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step3Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step3Label" Text="Options" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step3Dot" Width="36" Height="36" CornerRadius="18" Background="#242427" BorderBrush="#3A3A40" BorderThickness="2" IsVisible="False">
                                <TextBlock Text="3" Foreground="#8E8E98" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </ns4:OperatorSegmentedPanel>
            </Grid>
        </ns4:OperatorGlassSurface>
        <ns4:OperatorGlassSurface Material="Regular" CornerRadius="26" Padding="8,4" Margin="16,6,16,12" MaxWidth="680" Grid.Row="2">
            <Grid x:Name="NavBar" Grid.Row="0" Height="52" Opacity="1" Margin="0" ZIndex="10">
                <Grid.RenderTransform>
                    <TranslateTransform Y="30" port:ProductionNames.Id="NavBarTranslate" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" MinWidth="0" Grid.Column="0" Click="Back_Click" Padding="12,0" Height="44" VerticalAlignment="Center" Background="#242427" BorderBrush="#3A3A40" BorderThickness="1.5" MinHeight="0" IsVisible="False" Theme="{StaticResource ToolBtn}">
                    <TextBlock Text="Back" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="NextButton" MinWidth="0" Grid.Column="2" Click="Next_Click" Padding="12,0" Height="44" VerticalAlignment="Center" MinHeight="0" Theme="{StaticResource PrimaryCommandButton}">
                    <TextBlock x:Name="NextButtonText" Text="NEXT →" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </ns4:OperatorGlassSurface>
    </Grid>
</UserControl>
