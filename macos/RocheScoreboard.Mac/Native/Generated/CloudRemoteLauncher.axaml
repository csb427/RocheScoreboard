<!-- Generated from production WPF source; edit the translator. -->
<UserControl xmlns="https://github.com/avaloniaui" xmlns:ns2="clr-namespace:Roche_Scoreboard.Services" xmlns:ns4="clr-namespace:RocheScoreboard.Mac.Native" xmlns:ns5="clr-namespace:Roche_Scoreboard.Views" xmlns:port="clr-namespace:RocheScoreboard.Mac.Production" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.CloudRemoteLauncher" ns2:OperatorDesign.IsEnabled="True" FontFamily="{fonts:ProductionFont 'Segoe UI Variable, Segoe UI'}" xmlns:views="clr-namespace:Roche_Scoreboard.Views" xmlns:motion="clr-namespace:Roche_Scoreboard.Services" port:ProductionNames.Root="True" xmlns:native="clr-namespace:RocheScoreboard.Mac.Native" xmlns:services="clr-namespace:Roche_Scoreboard.Services" xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base" xmlns:fonts="clr-namespace:RocheScoreboard.Mac.Native">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/ControlCentre.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="HeaderSurface" Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" CornerRadius="16">
            <Button x:Name="CollapsedButton" Click="CollapsedButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="10,8" AutomationProperties.Name="Expand cloud remote" AutomationProperties.ItemStatus="Collapsed" HorizontalContentAlignment="Stretch" Theme="{StaticResource ControlCentre.Button}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ns2:OperatorSymbol x:Name="LauncherRemoteSymbol" Kind="Remote" Width="22" Height="22" Foreground="{DynamicResource ControlCentre.AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cloud remote" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.AccentBrush}" />
                        <TextBlock x:Name="CollapsedStatusText" Text="Tap to start" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" />
                    </StackPanel>
                    <Path x:Name="CollapsedChevron" Grid.Column="2" Width="12" Height="8" Stretch="Fill" Data="M1,1 L6,6 L11,1" Stroke="{DynamicResource ControlCentre.AccentBrush}" StrokeThickness="1.8" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
                        <Path.RenderTransform>
                            <RotateTransform port:ProductionNames.Id="ChevronRotate" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Button>
        </Border>
        <Popup x:Name="DetailsPopup" PlacementTarget="{Binding ElementName=CollapsedButton}" Placement="Bottom" VerticalOffset="6" Closed="DetailsPopup_Closed" IsLightDismissEnabled="True" ns4:PopupMotion.Kind="None">
            <ns5:OperatorGlassSurface x:Name="DetailsSurface" Material="Regular" Width="300" MaxHeight="560" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" CornerRadius="20" RenderTransformOrigin="50%,50%" KeyboardNavigation.TabNavigation="Cycle" KeyDown="Native_DetailsPreviewKeyDown">
                <ns5:OperatorGlassSurface.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform port:ProductionNames.Id="DetailsScale" />
                        <TranslateTransform port:ProductionNames.Id="DetailsTravel" />
                    </TransformGroup>
                </ns5:OperatorGlassSurface.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="DetailsHeader" Margin="14,10,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cloud remote" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" />
                            <TextBlock Text="Join with your phone" FontSize="12" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" />
                        </StackPanel>
                        <Button x:Name="DetailsCloseButton" Grid.Column="1" Width="40" Height="40" MinHeight="40" Content="×" FontSize="22" Padding="0" AutomationProperties.Name="Close cloud remote" Click="DetailsClose_Click" Theme="{StaticResource ControlCentre.Button}" ToolTip.Tip="Close cloud remote (Esc)" />
                    </Grid>
                    <ScrollViewer x:Name="DetailsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" KeyboardNavigation.IsTabStop="False">
                        <StackPanel x:Name="ExpandedPanel" Margin="14,10,14,14" IsVisible="False">
                            <Border Height="1" Background="{DynamicResource ControlCentre.BorderBrush}" Margin="0,0,0,8" />
                            <TextBlock x:Name="StatusText" Text="Checking configuration…" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />
                            <StackPanel x:Name="IdleState" IsVisible="False">
                                <Button x:Name="StartButton" Content="Start cloud session" Height="42" MinHeight="0" Padding="8,0" FontSize="14" FontWeight="SemiBold" Background="{DynamicResource ControlCentre.RaisedBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Foreground="{DynamicResource ControlCentre.TextBrush}" Cursor="Hand" Click="StartButton_Click" />
                                <TextBlock Text="A new join code is created each time." FontSize="12" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="DisabledState" IsVisible="False">
                                <Border Background="{DynamicResource ControlCentre.RaisedBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Setup required" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="Add supabase.config.json next to the executable." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="LiveState" IsVisible="False">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#6E7681" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ConnectionLabel" Text="Connecting…" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="JOIN CODE" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" HorizontalAlignment="Center" />
                                <Button x:Name="CopyCodeButton" Background="{DynamicResource ControlCentre.RaisedBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" AutomationProperties.Name="Copy join code" MinHeight="44" Padding="10,6" Margin="0,4,0,4" Cursor="Hand" Click="JoinCodeBox_Click" Theme="{StaticResource ControlCentre.Button}" ToolTip.Tip="Copy join code">
                                    <TextBlock x:Name="JoinCodeText" Text="—" FontSize="22" FontWeight="SemiBold" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="{DynamicResource ControlCentre.TextBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                                </Button>
                                <Border Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Padding="6" HorizontalAlignment="Center" Margin="0,6,0,6">
                                    <Image x:Name="QrImage" Width="140" Height="140" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                                </Border>
                                <StackPanel x:Name="JoinUrlPanel" IsVisible="False">
                                    <TextBlock Text="OR OPEN" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,2" />
                                    <TextBlock x:Name="JoinUrlText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    <Button x:Name="CopyUrlButton" Content="Copy URL" Height="40" MinHeight="40" AutomationProperties.Name="Copy join URL" FontSize="13" FontWeight="Bold" Background="{DynamicResource ControlCentre.RaisedBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Foreground="{DynamicResource ControlCentre.TextBrush}" Cursor="Hand" Margin="0,4,0,0" Click="CopyUrlButton_Click" Theme="{StaticResource ControlCentre.Button}" />
                                </StackPanel>
                                <Button x:Name="EndButton" Content="End session" Height="40" MinHeight="40" FontSize="13" FontWeight="Bold" Background="Transparent" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Foreground="{DynamicResource ControlCentre.TextBrush}" Cursor="Hand" Margin="0,10,0,0" Click="EndButton_Click" Theme="{StaticResource ControlCentre.Button}" />
                            </StackPanel>
                            <TextBlock x:Name="CopyFeedbackText" Text="" MinHeight="18" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ns5:OperatorGlassSurface>
        </Popup>
    </Grid>
</UserControl>
