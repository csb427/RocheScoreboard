<UserControl xmlns="https://github.com/avaloniaui" xmlns:ns2="clr-namespace:Roche_Scoreboard.Services" xmlns:ns4="clr-namespace:Roche_Scoreboard.Views" xmlns:port="clr-namespace:RocheScoreboard.Mac.Production" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.SportSelectionScreen" Background="#070A0F" SizeChanged="SportViewport_SizeChanged" ns2:OperatorDesign.IsEnabled="True" xmlns:motion="clr-namespace:Roche_Scoreboard.Services" xmlns:local="clr-namespace:Roche_Scoreboard.Views" port:ProductionNames.Root="True" xmlns:native="clr-namespace:RocheScoreboard.Mac.Native" xmlns:services="clr-namespace:Roche_Scoreboard.Services" xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base" xmlns:fonts="clr-namespace:RocheScoreboard.Mac.Native">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/OperatorControls.axaml" />
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/ControlCentre.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <LinearGradientBrush x:Key="HomeIconFill" StartPoint="20%,0%" EndPoint="80%,100%">
                <GradientStop Color="White" />
                <GradientStop Color="#D5DEE9" Offset=".55" />
                <GradientStop Color="#8E9BAC" Offset="1" />
            </LinearGradientBrush>
            <DataTemplate x:Key="HomeResumeLabel">
                <StackPanel Orientation="Horizontal">
                    <ns2:OperatorSymbol Kind="resume" Width="20" Height="20" Margin="0,0,9,0" Foreground="{DynamicResource ControlCentre.TextBrush}" />
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ControlCentre.TextBrush}" />
                </StackPanel>
            </DataTemplate>
            <ControlTheme x:Key="SportsLaunchSurface" TargetType="Button">
                <Setter Property="motion:CricketActionMotion.Enabled" Value="False" />
                <Setter Property="motion:OperatorControlMotion.Enabled" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusAdorner" Value="{x:Null}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Grid x:Name="PART_Surface" RenderTransformOrigin="50%,50%">
                                    <Grid.RenderTransform>
                                        <ScaleTransform port:ProductionNames.TemplateId="TbSc" />
                                    </Grid.RenderTransform>
                                    <Border x:Name="PressWash" CornerRadius="32" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                                    <Border x:Name="ActionGlow" CornerRadius="32" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style Selector="^:pressed /template/ Border#PressWash">
                    <Setter Property="Opacity" Value=".1" />
                </Style>
            </ControlTheme>
            <ControlTheme x:Key="HomeUtility" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
                <Setter Property="motion:OperatorControlMotion.InflateOnPress" Value="True" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
            </ControlTheme>
            <DataTemplate x:Key="ReleaseAllLabel">
                <StackPanel Orientation="Horizontal">
                    <ns2:OperatorSymbol Kind="release-all" Width="18" Height="18" Margin="0,0,6,0" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="ReleaseNewLabel">
                <StackPanel Orientation="Horizontal">
                    <ns2:OperatorSymbol Kind="release-new" Width="18" Height="18" Margin="0,0,6,0" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="ReleaseFixedLabel">
                <StackPanel Orientation="Horizontal">
                    <ns2:OperatorSymbol Kind="release-fixed" Width="18" Height="18" Margin="0,0,6,0" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <ControlTheme x:Key="ReleaseFilter" TargetType="RadioButton" BasedOn="{StaticResource SettingsSegment}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="6,7" />
                <Setter Property="FontSize" Value="14" />
            </ControlTheme>
            <ControlTheme x:Key="ReleaseDisclosure" TargetType="Expander">
                <Setter Property="motion:DisclosureMotion.Enabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="#A9D9FF" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" Cursor="Hand" MinHeight="40" Padding="10,8" Margin="24,2,0,0" FocusAdorner="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="DisclosureHeader" CornerRadius="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ToggleButton.Styles>
                                        <Style Selector="ToggleButton:pointerover /template/ Border#DisclosureHeader">
                                            <Setter Property="Background" Value="#1C9DCFFF" />
                                        </Style>
                                        <Style Selector="ToggleButton:pressed /template/ Border#DisclosureHeader">
                                            <Setter Property="Background" Value="#339DCFFF" />
                                        </Style>
                                        <Style Selector="ToggleButton:focus /template/ Border#DisclosureHeader">
                                            <Setter Property="BorderBrush" Value="#A9D9FF" />
                                        </Style>
                                        <Style Selector="ToggleButton:focus /template/ Border#DisclosureHeader">
                                            <Setter Property="BorderThickness" Value="1" />
                                        </Style>
                                    </ToggleButton.Styles>
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsVisible="False" />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style Selector="^:expanded /template/ ContentPresenter#Body">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="ResponsiveScrollHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" PointerWheelChanged="Native_ResponsiveScrollHost_PreviewMouseWheel">
        <Grid x:Name="SportViewport" MinHeight="620" Width="{Binding ViewportWidth, ElementName=ResponsiveScrollHost}" Height="{Binding ViewportHeight, ElementName=ResponsiveScrollHost}" ClipToBounds="True">
            <Grid x:Name="HomeBackdrop" IsHitTestVisible="False">
                <ns4:OperatorSceneBackdrop />
                <Border>
                    <Border.Background>
                        <RadialGradientBrush Center="50%,45%" GradientOrigin="50%,45%" RadiusX="65%" RadiusY="85%">
                            <GradientStop Color="#002B3C55" />
                            <GradientStop Color="#3C02070D" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
            <Grid x:Name="HomeLayout" Margin="28,22,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="HomeToolbar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ns4:OperatorGlassSurface x:Name="SettingsTile" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="24" HorizontalAlignment="Left" Padding="14,9" Cursor="Hand" BorderBrush="#60FFFFFF" BorderThickness="1" native:NativeActivation.Enabled="True" PointerReleased="Native_Settings_Click" PointerEntered="Native_SettingsTile_MouseEnter" PointerExited="Native_SettingsTile_MouseLeave">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform port:ProductionNames.Id="SettingsTileScale" />
                                <TranslateTransform port:ProductionNames.Id="SettingsTileTranslate" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" Color="Black" Opacity=".18" port:ProductionNames.Id="SettingsTileGlow" OffsetX="2.82842712475" OffsetY="2.82842712475" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <ns2:OperatorSymbol Kind="Settings" Width="22" Height="22" Margin="0,0,9,0" Foreground="White" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SettingsActionCaption" Text="Settings" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="SettingsSubtitle" Text="Application preferences" Foreground="#B9C4D4" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ns4:OperatorGlassSurface>
                    <Button x:Name="HomeCommandsButton" Grid.Column="1" Content="Commands · Ctrl+K" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" Click="HomeCommands_Click" AutomationProperties.Name="Search commands, Control K" Theme="{StaticResource HomeUtility}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ns4:OperatorGlassSurface x:Name="ResumeUtilitySurface" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="24" Margin="8,0,0,0" IsVisible="{Binding Visibility, ElementName=ResumeSavedMatchButton}">
                            <Button x:Name="ResumeSavedMatchButton" Content="Continue match" Click="ResumeSavedMatch_Click" IsVisible="False" Theme="{StaticResource HomeUtility}" ToolTip.Tip="Review and resume the saved match" />
                        </ns4:OperatorGlassSurface>
                        <ns4:OperatorGlassSurface Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="24" Margin="8,0,0,0">
                            <Button x:Name="ChangelogToggle" Click="ChangelogToggle_Click" Theme="{StaticResource HomeUtility}">
                                <StackPanel Orientation="Horizontal">
                                    <ns2:OperatorSymbol x:Name="UpdatesActionIcon" Kind="Updates" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                                    <StackPanel>
                                        <TextBlock Text="What’s New" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="VersionLabel" Text="Latest release" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </ns4:OperatorGlassSurface>
                    </StackPanel>
                </Grid>
                <Border x:Name="HeaderPanel" Grid.Row="1" Background="Transparent" Margin="0,28,0,22" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform port:ProductionNames.Id="HeaderTranslate" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="HomeHeading" Text="Choose a sport" Foreground="White" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Name="HomeSubtitle" Text="Start a match or a training session." Foreground="#D8E2EC" FontSize="15" TextAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="ResumeSessionSurface" Grid.Row="2" Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="#6073B9FF" BorderThickness="1" CornerRadius="24" Padding="22,16" Margin="10,0,10,12">
                    <StackPanel>
                        <TextBlock x:Name="SessionHeading" Text="Ready for your next session" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SessionDetail" Text="No recoverable match saved. Start a new match below." Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="Output stays off when resuming. Use Show output window (Ctrl+K) when ready." Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <Button x:Name="HomeResumeButton" Content="Resume saved match" ContentTemplate="{StaticResource HomeResumeLabel}" Click="ResumeSavedMatch_Click" HorizontalAlignment="Left" Background="#284E739D" Margin="0,12,0,0" IsVisible="False" Theme="{StaticResource HomeUtility}" />
                    </StackPanel>
                </Border>
                <Grid x:Name="SportCardsGrid" Grid.Row="3" MaxWidth="1100" Height="330" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ns4:OperatorGlassSurface x:Name="HomeInteractionLens" Material="Clear" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="36" Width="0" Height="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="3" Grid.RowSpan="3">
                        <Border.RenderTransform>
                            <TranslateTransform port:ProductionNames.Id="HomeLensTranslate" />
                        </Border.RenderTransform>
                    </ns4:OperatorGlassSurface>
                    <ns4:OperatorGlassSurface x:Name="AflCard" Grid.Column="0" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="36" Margin="10" Cursor="Hand" ClipToBounds="True" RenderTransformOrigin="50%,50%" PointerEntered="Native_Card_MouseEnter" PointerExited="Native_Card_MouseLeave" native:NativeActivation.Enabled="True" PointerReleased="Native_AFL_Click">
                        <Border.RenderTransform>
