                            <Border x:Name="CricketFlash" CornerRadius="36" Background="White" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </ns4:OperatorGlassSurface>
                    <ns4:OperatorGlassSurface x:Name="TrainingCard" Grid.Column="2" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="36" Margin="10" Cursor="Hand" ClipToBounds="True" RenderTransformOrigin="50%,50%" PointerEntered="Native_TrainingTile_MouseEnter" PointerExited="Native_TrainingTile_MouseLeave" native:NativeActivation.Enabled="True" PointerReleased="Native_Training_Click">
