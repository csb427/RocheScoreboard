                <ns4:OperatorGlassSurface x:Name="ChangelogPanel" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="32" MaxWidth="1080" Margin="22" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="50%,50%">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX=".96" ScaleY=".96" port:ProductionNames.Id="ChangelogPanelScale" />
                            <TranslateTransform Y="24" port:ProductionNames.Id="ChangelogPanelTranslate" />
