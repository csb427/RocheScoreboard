                </Button.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="9" Background="#2058A6FF" Margin="0,0,10,0">
                        <TextBlock Text="✦" Foreground="#8CC8FF" FontSize="15" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WHAT’S NEW" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" FontWeight="Black" FontSize="12" Foreground="White" />
                        <TextBlock x:Name="VersionLabel" Text="CURRENT BUILD" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" FontWeight="SemiBold" FontSize="9" Foreground="#8FA5BD" />
                    </StackPanel>
                    <TextBlock Text="  ›" FontSize="21" FontWeight="Black" Foreground="#58A6FF" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ Border#Shell">
                        <Setter Property="Background" Value="#F0182738" />
                    </Style>
                    <Style Selector="Button:pointerover /template/ Border#Shell">
                        <Setter Property="BorderBrush" Value="#8858A6FF" />
                    </Style>
                    <Style Selector="Button:pressed /template/ Border#Shell">
                        <Setter Property="Background" Value="#FF0B1420" />
                    </Style>
                </Button.Styles>
            </Button>
            <Border x:Name="BottomAccent" VerticalAlignment="Bottom" Height="3" Opacity="0" IsHitTestVisible="False" ZIndex="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#58A6FF" Offset="0" />
                        <GradientStop Color="#1AFFFFFF" Offset="0.5" />
                        <GradientStop Color="#3FB950" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid x:Name="ChangelogOverlay" Opacity="0" ZIndex="100" IsVisible="False" KeyDown="Native_ChangelogOverlay_PreviewKeyDown">
                <Border Background="#D904080D" PointerReleased="Native_ChangelogBackdrop_Click" />
                <Border x:Name="ChangelogPanel" Width="980" MaxWidth="980" Margin="44" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#F50B1119" BorderBrush="#354E6A" BorderThickness="1" CornerRadius="22" ClipToBounds="True" RenderTransformOrigin="50%,50%">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0.96" ScaleY="0.96" port:ProductionNames.Id="ChangelogPanelScale" />
                            <TranslateTransform Y="24" port:ProductionNames.Id="ChangelogPanelTranslate" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="30,24" BorderBrush="#243244" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="ROCHE SCOREBOARD" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" FontSize="11" FontWeight="Black" Foreground="#58A6FF" />
                                    <TextBlock Text="What’s New" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" FontSize="34" FontWeight="Black" Foreground="White" Margin="0,3,0,0" />
                                    <TextBlock Text="Every operator-facing improvement, fix and release—kept in one searchable timeline." FontSize="13" Foreground="#9FB0C3" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="44" Height="44" Background="#182331" Foreground="White" BorderBrush="#31445A" FontSize="18" FontWeight="Bold" Content="×" Cursor="Hand" Click="ChangelogClose_Click" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="30,18,30,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChangelogSearchBox" Height="42" Padding="14,10" Background="#111A25" Foreground="White" CaretBrush="#58A6FF" BorderBrush="#31445A" FontSize="13" TextChanged="Native_ChangelogSearch_TextChanged" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                <Button Content="ALL" Tag="All" Click="ChangelogFilter_Click" Padding="16,8" Margin="0,0,6,0" />
                                <Button Content="NEW" Tag="New" Click="ChangelogFilter_Click" Padding="16,8" Margin="0,0,6,0" />
                                <Button Content="FIXED" Tag="Fixed" Click="ChangelogFilter_Click" Padding="16,8" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="30,8,30,28">
                            <StackPanel x:Name="ChangelogEntries" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
