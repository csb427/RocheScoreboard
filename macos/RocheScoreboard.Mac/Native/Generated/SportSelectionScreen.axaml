                                <RadioButton x:Name="AllReleaseFilter" Content="All" ContentTemplate="{StaticResource ReleaseAllLabel}" Tag="All" GroupName="ReleaseFilterChoice" IsChecked="True" Click="ChangelogFilter_Click" Theme="{StaticResource ReleaseFilter}" IsCheckedChanged="Native_ChangelogFilter_Click_Checked" />
                                <RadioButton x:Name="NewReleaseFilter" Content="New" ContentTemplate="{StaticResource ReleaseNewLabel}" Tag="New" GroupName="ReleaseFilterChoice" Click="ChangelogFilter_Click" Theme="{StaticResource ReleaseFilter}" IsCheckedChanged="Native_ChangelogFilter_Click_Checked" />
                                <RadioButton x:Name="FixedReleaseFilter" Content="Fixed" ContentTemplate="{StaticResource ReleaseFixedLabel}" Tag="Fixed" GroupName="ReleaseFilterChoice" Click="ChangelogFilter_Click" Theme="{StaticResource ReleaseFilter}" IsCheckedChanged="Native_ChangelogFilter_Click_Checked" />
                            </ns4:OperatorSegmentedPanel>
                            <TextBlock x:Name="ReleaseResultCount" Grid.Column="1" Foreground="#B8C4D6" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                        <Grid x:Name="ReleaseLayout" Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ns4:OperatorGlassSurface x:Name="ReleaseVersionRail" Material="Clear" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="25" Grid.RowSpan="2" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="ReleaseHistoryHeading" Text="Releases" Foreground="#C1D0E2" FontSize="13" FontWeight="SemiBold" Margin="9,7,9,12" />
                                    <ScrollViewer x:Name="ReleaseHistoryScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <WrapPanel x:Name="ReleaseVersionButtons" Orientation="Vertical" />
                                    </ScrollViewer>
                                </Grid>
                            </ns4:OperatorGlassSurface>
                            <ScrollViewer x:Name="ReleaseScroller" Grid.Column="1" Grid.RowSpan="2" Margin="20,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,2">
                                <StackPanel x:Name="ChangelogEntries" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </ns4:OperatorGlassSurface>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
