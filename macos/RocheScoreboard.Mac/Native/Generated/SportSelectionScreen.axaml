                                <Border.RenderTransform>
                                    <TranslateTransform port:ProductionNames.Id="AflBeamTranslate" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid x:Name="AflTileBody" Margin="20,18,20,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox x:Name="AflContentFit" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="165" Margin="0,0,0,12">
                                    <Border x:Name="AflIconGroup" Width="145" Height="155" RenderTransformOrigin="50%,50%">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform port:ProductionNames.Id="AflIconScale" />
                                                <TranslateTransform port:ProductionNames.Id="AflIconFloat" />
                                                <TranslateTransform port:ProductionNames.Id="AflIconHover" />
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <ns2:OperatorSymbol Kind="afl" Width="124" Height="124" Foreground="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Viewbox>
                                <StackPanel x:Name="AflTextPanel" Grid.Row="1">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform port:ProductionNames.Id="AflTextTranslate" />
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="AFL" FontSize="26" FontWeight="SemiBold" Foreground="White" TextAlignment="Center" />
                                    <TextBlock x:Name="AflDescription" Text="Australian football" FontSize="14" Foreground="#D8E2EC" TextAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="AflHover" CornerRadius="36" Background="White" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="AflFlash" CornerRadius="36" Background="White" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </ns4:OperatorGlassSurface>
                    <ns4:OperatorGlassSurface x:Name="CricketCard" Grid.Column="1" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="36" Margin="10" Cursor="Hand" ClipToBounds="True" RenderTransformOrigin="50%,50%" PointerEntered="Native_Card_MouseEnter" PointerExited="Native_Card_MouseLeave" native:NativeActivation.Enabled="True" PointerReleased="Native_Cricket_Click">
                        <Border.RenderTransform>
