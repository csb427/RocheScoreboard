                                    <Canvas Width="145" Height="155" RenderTransformOrigin="50%,50%">
                                        <Canvas.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform port:ProductionNames.Id="TrainingIconMotionScale" />
