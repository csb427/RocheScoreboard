        <Grid x:Name="CustomVideoHost" IsVisible="False" />
        <Image x:Name="CustomImage" Stretch="UniformToFill" IsVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <Grid x:Name="DefaultScene">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#030711" Offset="0" />
                    <GradientStop Color="#0A1A2C" Offset="0.48" />
                    <GradientStop Color="#07101C" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Rectangle Opacity="0.32">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="50%,48%" GradientOrigin="50%,48%" RadiusX="62%" RadiusY="82%">
                        <GradientStop Color="#304B90C8" Offset="0" />
                        <GradientStop Color="#00132638" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas Opacity="0.22" ClipToBounds="True">
                <Rectangle x:Name="LightBeamOne" Width="150" Height="420" RenderTransformOrigin="50%,50%" Canvas.Left="-105" Canvas.Top="-120">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#0058A6FF" />
                            <GradientStop Color="#3858A6FF" Offset="0.5" />
                            <GradientStop Color="#0058A6FF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.Effect>
                        <BlurEffect Radius="18" />
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-25" />
                            <TranslateTransform port:ProductionNames.Id="BeamOneTranslate" />
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="LightBeamTwo" Width="125" Height="420" RenderTransformOrigin="50%,50%" Canvas.Left="300" Canvas.Top="-90">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#00E7B94F" />
                            <GradientStop Color="#2AE7B94F" Offset="0.5" />
                            <GradientStop Color="#00E7B94F" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.Effect>
                        <BlurEffect Radius="20" />
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="27" />
                            <TranslateTransform port:ProductionNames.Id="BeamTwoTranslate" />
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
            <Canvas x:Name="FieldLayer" Width="500" Height="260" Opacity="0.09" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" RenderOptions.EdgeMode="Unspecified">
                <Canvas.Effect>
                    <BlurEffect Radius="0.55" />
                </Canvas.Effect>
                <Canvas.RenderTransform>
                    <TranslateTransform port:ProductionNames.Id="FieldTranslate" />
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="30" Canvas.Top="28" Width="440" Height="204" Stroke="#9BC8EE" StrokeThickness="2" />
                <Rectangle Canvas.Left="237" Canvas.Top="84" Width="26" Height="92" Stroke="#9BC8EE" StrokeThickness="1.5" RadiusX="2" RadiusY="2" />
                <Line Stroke="#9BC8EE" StrokeThickness="1.5" StartPoint="226,98" EndPoint="274,98" />
                <Line Stroke="#9BC8EE" StrokeThickness="1.5" StartPoint="226,162" EndPoint="274,162" />
                <Line Stroke="#9BC8EE" StrokeThickness="2" StartPoint="250,28" EndPoint="250,232" />
                <Line Stroke="#9BC8EE" StrokeThickness="2" StartPoint="30,94" EndPoint="82,94" />
                <Line Stroke="#9BC8EE" StrokeThickness="2" StartPoint="418,166" EndPoint="470,166" />
            </Canvas>
            <Canvas ClipToBounds="True" IsHitTestVisible="False">
                <Ellipse Width="7" Height="7" Fill="#B9E0FF" Opacity="0.55" Canvas.Left="34" Canvas.Top="42">
                    <Ellipse.RenderTransform>
                        <TranslateTransform port:ProductionNames.Id="ParticleOneTranslate" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="5" Height="5" Fill="#F2CA66" Opacity="0.50" Canvas.Left="310" Canvas.Top="138">
                    <Ellipse.RenderTransform>
                        <TranslateTransform port:ProductionNames.Id="ParticleTwoTranslate" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="#8EC8F3" Opacity="0.45" Canvas.Left="176" Canvas.Top="22">
                    <Ellipse.RenderTransform>
                        <TranslateTransform port:ProductionNames.Id="ParticleThreeTranslate" />
                    </Ellipse.RenderTransform>
                </Ellipse>
