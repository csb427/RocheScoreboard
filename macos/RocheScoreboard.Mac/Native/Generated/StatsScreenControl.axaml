            <TextBlock x:Name="StatsTimeText" Text="1:26 PM" Foreground="#58A6FF" FontSize="16" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" Margin="4,1,4,0">
