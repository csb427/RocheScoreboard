                    </Image>
                    <Rectangle Fill="#52000000" />
                    <TextBlock x:Name="StatsHomeTeamText" Text="HOME" FontSize="16" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="7,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Grid.Column="1" Text="VS" Foreground="#D5DEE7" FontSize="10" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" Margin="4,0" VerticalAlignment="Center" />
            <Border x:Name="StatsAwayTeamHeader" Grid.Column="2" Padding="0" ClipToBounds="True">
                <Border.Effect>
