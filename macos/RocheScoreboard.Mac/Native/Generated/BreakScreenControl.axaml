                <TextBlock x:Name="BreakTimeText" Text="1:26 PM" Foreground="#D6E3EF" FontSize="16" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <Border VerticalAlignment="Bottom" Height="2" Margin="70,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" port:ProductionNames.Id="TitleAccentGradient">
                            <GradientStop Color="#4488FF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.5" />
                            <GradientStop Color="#FF6644" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>
