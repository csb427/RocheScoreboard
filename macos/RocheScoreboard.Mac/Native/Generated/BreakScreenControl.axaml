            <RowDefinition Height="0" />
            <RowDefinition Height="149*" />
            <RowDefinition Height="44*" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="3" Opacity="0.23" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" port:ProductionNames.Id="BgGradient">
                    <GradientStop Color="#C0441A" Offset="0" />
                    <GradientStop Color="#070B11" Offset="0.32" />
                    <GradientStop Color="#070B11" Offset="0.68" />
                    <GradientStop Color="#1A7A1A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="BreakTitlePanel" Grid.Row="0" Background="#E80A1018" BorderBrush="#263448" BorderThickness="0,0,0,1" IsVisible="False">
            <Grid Margin="8,0">
