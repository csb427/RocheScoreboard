        <ControlTheme x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="50%,50%" ns3:TemplateMotion.Spec="[{&quot;event&quot;:&quot;MouseEnter&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;MbSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleX&quot;,&quot;To&quot;:&quot;1.13&quot;,&quot;Duration&quot;:&quot;0:0:0.11&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.35&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;MbSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleY&quot;,&quot;To&quot;:&quot;1.13&quot;,&quot;Duration&quot;:&quot;0:0:0.11&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.35&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;MbLift&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Y&quot;,&quot;To&quot;:&quot;-1&quot;,&quot;Duration&quot;:&quot;0:0:0.11&quot;},{&quot;Storyboard.TargetName&quot;:&quot;Flash&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;To&quot;:&quot;0.25&quot;,&quot;Duration&quot;:&quot;0:0:0.1&quot;}]},{&quot;event&quot;:&quot;MouseLeave&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;MbSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleX&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.15&quot;,&quot;Easing&quot;:&quot;ElasticEase&quot;,&quot;Oscillations&quot;:&quot;1&quot;,&quot;Springiness&quot;:&quot;5&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;MbSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleY&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.15&quot;,&quot;Easing&quot;:&quot;ElasticEase&quot;,&quot;Oscillations&quot;:&quot;1&quot;,&quot;Springiness&quot;:&quot;5&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;MbLift&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Y&quot;,&quot;To&quot;:&quot;0&quot;,&quot;Duration&quot;:&quot;0:0:0.15&quot;},{&quot;Storyboard.TargetName&quot;:&quot;Flash&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;To&quot;:&quot;0&quot;,&quot;Duration&quot;:&quot;0:0:0.12&quot;}]},{&quot;event&quot;:&quot;Button.Click&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;MbSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleX&quot;,&quot;From&quot;:&quot;0.9&quot;,&quot;To&quot;:&quot;1.15&quot;,&quot;Duration&quot;:&quot;0:0:0.16&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.45&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;MbSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleY&quot;,&quot;From&quot;:&quot;0.9&quot;,&quot;To&quot;:&quot;1.15&quot;,&quot;Duration&quot;:&quot;0:0:0.16&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.45&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;Flash&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;From&quot;:&quot;0.45&quot;,&quot;To&quot;:&quot;0&quot;,&quot;Duration&quot;:&quot;0:0:0.2&quot;}]}]">
