        </ControlTheme>
        <ControlTheme x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="TabRoot" RenderTransformOrigin="50%,50%" ns3:TemplateMotion.Spec="[{&quot;event&quot;:&quot;MouseEnter&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;Flash&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;To&quot;:&quot;0.2&quot;,&quot;Duration&quot;:&quot;0:0:0.1&quot;},{&quot;Storyboard.TargetName&quot;:&quot;AccBar&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;To&quot;:&quot;0.85&quot;,&quot;Duration&quot;:&quot;0:0:0.14&quot;}]},{&quot;event&quot;:&quot;MouseLeave&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;Flash&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;To&quot;:&quot;0&quot;,&quot;Duration&quot;:&quot;0:0:0.14&quot;},{&quot;Storyboard.TargetName&quot;:&quot;AccBar&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;Opacity&quot;,&quot;To&quot;:&quot;0&quot;,&quot;Duration&quot;:&quot;0:0:0.18&quot;}]}]">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="Flash" Background="#66818CF8" Opacity="0" Margin="2,1,2,1" IsHitTestVisible="False" />
                            <Border x:Name="Bd" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" Margin="0,0,2,0" Opacity="1">
                                <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
                            </Border>
                            <Border x:Name="AccBar" VerticalAlignment="Bottom" Height="2" Opacity="0" Margin="8,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="#00818CF8" Offset="0" />
                                        <GradientStop Color="#FF818CF8" Offset="0.5" />
                                        <GradientStop Color="#00818CF8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:selected /template/ Border#Bd">
                <Setter Property="Background" Value="#161B22" />
            </Style>
            <Style Selector="^:selected /template/ Border#Bd">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#Cp">
                <Setter Property="TextBlock.Foreground" Value="White" />
            </Style>
            <Style Selector="^:selected /template/ Border#AccBar">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="#1C2128" />
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#Cp">
                <Setter Property="TextBlock.Foreground" Value="{StaticResource TextStrongBrush}" />
            </Style>
            <Style Selector="^:selected:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="#1F252F" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <Grid Width="1500" Height="900" Background="{StaticResource ShellBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0D1117" BorderBrush="#21262D" BorderThickness="0,0,0,2" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#244A34" BorderThickness="1.5" Background="#0D2818" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#3FB950" Margin="0,0,6,0" />
                            <TextBlock Text="LIVE" Foreground="#3FB950" FontSize="11" FontWeight="Black" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="2" x:Name="InningsLabel" Text="1st Innings" Foreground="White" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" VerticalAlignment="Center" />
                    <Border Grid.Column="4" BorderBrush="#30363D" BorderThickness="1" Background="#161B22" Padding="10,4">
                        <TextBlock x:Name="HeaderOvers" Text="" Foreground="{StaticResource TextMidBrush}" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <TextBlock Grid.Column="6" x:Name="HeaderScore" Text="0/0" Foreground="White" FontSize="28" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" TabStripPlacement="Top" SelectionChanged="Native_MainTabControl_SelectionChanged">
                <TabControl.Resources>
                    <ControlTheme TargetType="TabItem" BasedOn="{StaticResource PanelTab}" x:Key="{x:Type TabItem}" />
                </TabControl.Resources>
                <TabItem Header="SCORING">
                    <Border Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0" Padding="12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="290" MinWidth="260" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" x:Name="BattingZone" BorderBrush="#4D3D8F" BorderThickness="1,3,1,1" Background="#0D0A28" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="BATTING" Foreground="#A78BFA" FontSize="10" FontWeight="Black" Margin="0,0,0,8" />
                                            <Border x:Name="StrikerBar" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" Padding="12,10" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TopBatterIndicator" Text="▶" Foreground="#818CF8" FontSize="14" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="StrikerName" Text="Striker" Foreground="White" FontSize="15" FontWeight="Bold" />
                                                        <TextBlock x:Name="StrikerStats" Text="0 (0)  SR 0.0" Foreground="{StaticResource TextMidBrush}" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" x:Name="StrikerRuns" Text="0" Foreground="White" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Grid.Column="3" Content="⋯" Click="StrikerMenu_Click" Theme="{StaticResource MenuBtn}" ToolTip.Tip="Options">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Change Batter" Click="ChangeStriker_Click" />
                                                                <MenuItem Header="Swap Strike" Click="SwapStrike_Click" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="NonStrikerBar" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="BottomBatterIndicator" Text="  " Foreground="#818CF8" FontSize="14" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="NonStrikerName" Text="Non-Striker" Foreground="White" FontSize="15" FontWeight="Bold" />
                                                        <TextBlock x:Name="NonStrikerStats" Text="0 (0)  SR 0.0" Foreground="{StaticResource TextMidBrush}" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" x:Name="NonStrikerRunsText" Text="0" Foreground="White" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Grid.Column="3" Content="⋯" Click="NonStrikerMenu_Click" Theme="{StaticResource MenuBtn}" ToolTip.Tip="Options">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Change Batter" Click="ChangeNonStriker_Click" />
                                                                <MenuItem Header="Swap Strike" Click="SwapStrike_Click" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" x:Name="BowlingZone" BorderBrush="#1A6040" BorderThickness="1,3,1,1" Background="#0D1E14" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="BOWLING" Foreground="#4ADE80" FontSize="10" FontWeight="Black" Margin="0,0,0,8" />
                                            <Border x:Name="BowlerBar" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="BowlerName" Text="Bowler" Foreground="White" FontSize="15" FontWeight="Bold" />
                                                        <TextBlock x:Name="BowlerStats" Text="0-0 (0)  Econ 0.00" Foreground="{StaticResource TextMidBrush}" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" x:Name="BowlerFigures" Text="0-0" Foreground="White" FontSize="20" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Grid.Column="2" Content="⋯" Click="BowlerMenu_Click" Theme="{StaticResource MenuBtn}" ToolTip.Tip="Options">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Change Bowler" Click="ChangeBowlerMenu_Click" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="OverDisplay" Text="This over: " Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Background="{StaticResource RegionAltBrush}" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="SCORING" Theme="{StaticResource SectionHead}" />
                                            <UniformGrid Columns="4" Margin="0,0,0,6">
                                                <Button Content="•" Click="Dot_Click" Background="#30363D" BorderBrush="#484F58" Theme="{StaticResource RunBtn}" ToolTip.Tip="Dot ball" />
                                                <Button Content="1" Click="Run1_Click" Margin="4,0" Background="#1E40AF" BorderBrush="#3B6AE0" Theme="{StaticResource RunBtn}" ToolTip.Tip="1 run" />
                                                <Button Content="2" Click="Run2_Click" Margin="0,0,4,0" Background="#1E40AF" BorderBrush="#3B6AE0" Theme="{StaticResource RunBtn}" ToolTip.Tip="2 runs" />
                                                <Button Content="3" Click="Run3_Click" Background="#1E40AF" BorderBrush="#3B6AE0" Theme="{StaticResource RunBtn}" ToolTip.Tip="3 runs" />
                                            </UniformGrid>
                                            <UniformGrid Columns="4">
                                                <Button Content="4" Click="Four_Click" BorderBrush="#22C55E" Theme="{StaticResource RunBtn}" ToolTip.Tip="Boundary four">
                                                    <Button.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#15803D" Offset="0" />
                                                            <GradientStop Color="#166534" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                </Button>
                                                <Button Content="5" Click="Run5_Click" Margin="4,0" Background="#1E40AF" BorderBrush="#3B6AE0" Theme="{StaticResource RunBtn}" ToolTip.Tip="5 runs" />
                                                <Button Content="6" Click="Six_Click" Margin="0,0,4,0" BorderBrush="#A855F7" Theme="{StaticResource RunBtn}" ToolTip.Tip="Maximum six">
                                                    <Button.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#7C3AED" Offset="0" />
                                                            <GradientStop Color="#9333EA" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                </Button>
                                                <Button Content="W" Click="Wicket_Click" BorderBrush="#F87171" Theme="{StaticResource RunBtn}" ToolTip.Tip="Wicket">
                                                    <Button.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#DC2626" Offset="0" />
                                                            <GradientStop Color="#B91C1C" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="3" Background="#1E1A00" BorderBrush="#D29922" BorderThickness="1,2,1,1" Padding="12" Margin="0,0,0,0">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="EXTRAS" Foreground="#D29922" FontSize="10" FontWeight="Black" Margin="0,0,0,8" />
                                                <UniformGrid Columns="4">
                                                    <Button Content="Wide" Click="Wide_Click" Background="#2A2000" BorderBrush="#9A7316" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Wide delivery" />
                                                    <Button Content="No Ball" Click="NoBall_Click" Background="#2A2000" BorderBrush="#9A7316" Theme="{StaticResource ToolBtn}" ToolTip.Tip="No ball" />
                                                    <Button Content="Bye" Click="Bye_Click" Background="#2A2000" BorderBrush="#9A7316" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Bye runs" />
                                                    <Button Content="Leg Bye" Click="LegBye_Click" Background="#2A2000" BorderBrush="#9A7316" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Leg bye" />
                                                </UniformGrid>
                                            </StackPanel>
                                            <Border x:Name="ExtrasPopup" Background="#161B22" BorderBrush="#D29922" BorderThickness="2" Padding="16" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsVisible="False" ZIndex="10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <TextBlock x:Name="ExtrasPopupTitle" Text="WIDE" Foreground="#D29922" FontSize="14" FontWeight="Black" VerticalAlignment="Center" />
                                                        <Button Content="✕" HorizontalAlignment="Right" Click="ExtrasPopupClose_Click" Theme="{StaticResource MenuBtn}" />
                                                    </Grid>
                                                    <TextBlock Text="Additional runs:" Foreground="{StaticResource TextMidBrush}" FontSize="12" Margin="0,0,0,6" />
                                                    <UniformGrid Columns="5" Margin="0,0,0,6">
                                                        <Button Content="0" Tag="0" Click="ExtrasRun_Click" Theme="{StaticResource ToolBtn}" />
                                                        <Button Content="+1" Tag="1" Click="ExtrasRun_Click" Theme="{StaticResource ToolBtn}" />
                                                        <Button Content="+2" Tag="2" Click="ExtrasRun_Click" Theme="{StaticResource ToolBtn}" />
                                                        <Button Content="+3" Tag="3" Click="ExtrasRun_Click" Theme="{StaticResource ToolBtn}" />
                                                        <Button Content="+4" Tag="4" Click="ExtrasRun_Click" Theme="{StaticResource ToolBtn}" />
                                                    </UniformGrid>
                                                    <TextBlock x:Name="ExtrasHintText" Text="Total: 1 + additional runs" Foreground="{StaticResource TextDimBrush}" FontSize="10" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="↩ Undo" Height="42" Click="Undo_Click" Background="#21262D" BorderBrush="#6B3A3E" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Undo last delivery" />
                                        <Button Grid.Column="2" Content="End Innings" Height="42" Click="EndInnings_Click" Background="#2A1416" BorderBrush="#6B3A3E" Foreground="#FF6B6B" Theme="{StaticResource ToolBtn}" ToolTip.Tip="End innings" />
                                    </Grid>
                                    <Button Grid.Row="7" Content="⟲  RESET MATCH" Height="42" FontSize="13" FontWeight="Black" Click="ResetMatch_Click" Background="#2A1416" BorderBrush="#6B3A3E" Foreground="#FF6B6B" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Reset the entire match and return to setup" />
                                </Grid>
                            </ScrollViewer>
                            <Border Grid.Column="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="2" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="DELIVERY LOG" Theme="{StaticResource SectionHead}" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="EventLog" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="DISPLAY &amp; OVERLAYS">
                    <Border Background="#0A0E18" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Border Opacity="0.06" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="30%,20%" RadiusX="70%" RadiusY="70%">
                                        <GradientStop Color="#818CF8" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#00000000" Offset="0.3" />
                                        <GradientStop Color="#40000000" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="PRESENTATION MODE" FontSize="14" FontWeight="Black" Foreground="#818CF8" Margin="0,0,0,2">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="12" Color="#818CF8" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="Select the active display for the scoreboard window" FontSize="9" FontWeight="SemiBold" Foreground="#3A4A6A" />
                                        </StackPanel>
                                        <UniformGrid Columns="3" Margin="0,0,0,6">
                                            <Border Cursor="Hand" Background="#0A1628" BorderBrush="#818CF8" BorderThickness="2" Margin="3" PointerReleased="Native_ShowScorebug_Click">
                                                <Grid MinHeight="80">
                                                    <Border Opacity="0.12" IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                <GradientStop Color="#818CF8" Offset="0" />
                                                                <GradientStop Color="#00000000" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Scorebug" Foreground="White" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Cursor="Hand" Background="#0A1628" BorderBrush="#30363D" BorderThickness="1" Margin="3" PointerReleased="Native_ShowBattingSummary_Click">
                                                <Grid MinHeight="80">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="🏏" FontSize="20" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Batting Card" Foreground="{StaticResource TextMidBrush}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Cursor="Hand" Background="#0A1628" BorderBrush="#30363D" BorderThickness="1" Margin="3" PointerReleased="Native_ShowBowlingSummary_Click">
                                                <Grid MinHeight="80">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Bowling Card" Foreground="{StaticResource TextMidBrush}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Cursor="Hand" Background="#0A1628" BorderBrush="#30363D" BorderThickness="1" Margin="3" PointerReleased="Native_ShowMatchCentre_Click">
                                                <Grid MinHeight="80">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="◈" Foreground="#60A5FA" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Match Centre" Foreground="{StaticResource TextMidBrush}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Cursor="Hand" Background="#0A1628" BorderBrush="#30363D" BorderThickness="1" Margin="3" PointerReleased="Native_ShowWindow_Click">
                                                <Grid MinHeight="80">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="🖥" FontSize="20" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Window" Foreground="{StaticResource TextMidBrush}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                        <Border Height="1" Background="#21262D" Margin="0,10,0,12" />
                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Text="OVERLAYS" FontSize="12" FontWeight="Black" Foreground="#818CF8" Margin="0,0,0,1" />
                                            <TextBlock Text="Trigger live overlays on the scorebug" FontSize="9" FontWeight="SemiBold" Foreground="#3A4A6A" />
                                        </StackPanel>
                                        <TextBlock Text="GAME ANALYSIS" Margin="0,0,0,6" Theme="{StaticResource SectionHead}" />
                                        <UniformGrid Columns="2" Margin="0,0,0,10">
                                            <Button Content="📊 Stats Bar" Click="OverlayStats_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Show stats bar on scorebug" />
                                            <Button Content="🤝 Partnership" Click="OverlayPartnership_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Show partnership overlay" />
                                            <Button Content="📋 Extras" Click="OverlayExtras_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Show extras breakdown overlay" />
                                            <Button Content="⚾ This Over" Click="OverlayThisOver_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Show this over ball tracker" />
                                        </UniformGrid>
                                        <TextBlock Text="BROADCAST BARS" Margin="0,0,0,6" Theme="{StaticResource SectionHead}" />
                                        <UniformGrid Columns="2" Margin="0,0,0,10">
                                            <Button Content="🤝 Partnership Bar" Click="OverlayPartnershipBar_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="AFL-style partnership bar" />
                                            <Button Content="📈 Run Rate" Click="OverlayRunRate_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Current vs required run rate" />
                                            <Button Content="🎯 Target/Chase" Click="OverlayTarget_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Target, runs needed, balls remaining" />
                                            <Button Content="⚡ Powerplay" Click="OverlayPowerplay_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Powerplay overs indicator" />
                                            <Button Content="📉 Last 5 Overs" Click="OverlayLast5_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Runs in last 5 overs" />
                                            <Button Content="🏜️ Drought" Click="OverlayDrought_Click" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Balls since last boundary" />
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                                <Border Grid.Column="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="2" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="TICKER MESSAGES" Theme="{StaticResource SectionHead}" />
                                        <ListBox Grid.Row="1" x:Name="MessageList" Background="Transparent" Foreground="White" FontSize="11" BorderThickness="0" />
                                        <Grid Grid.Row="2" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewMessageBox" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,4,0" Background="#161B22" Foreground="White" BorderBrush="#30363D" />
                                            <Button Grid.Column="1" Content="+" Width="26" Height="24" FontSize="11" FontWeight="Bold" Margin="0,0,3,0" Click="AddMessage_Click" Theme="{StaticResource ToolBtn}" />
                                            <Button Grid.Column="2" Content="−" Width="26" Height="24" FontSize="11" FontWeight="Bold" Click="RemoveMessage_Click" Theme="{StaticResource ToolBtn}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="SETTINGS">
                    <Border Background="#0D1117" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MATCH HEALTH" Foreground="#818CF8" Theme="{StaticResource SectionHead}" />
                                <Border Margin="0,0,0,10" Padding="16" Theme="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock x:Name="SettingsMatchText" Text="LIMITED OVERS • 20 OVERS" Foreground="White" FontSize="18" FontWeight="Black" />
                                        <TextBlock x:Name="SettingsStateText" Text="1ST INNINGS • 0/0 (0.0)" Foreground="#C4D0DD" FontSize="14" FontWeight="Bold" Margin="0,6,0,0" />
                                        <Border Height="1" Background="#30363D" Margin="0,12" />
                                        <TextBlock x:Name="SettingsAutosaveText" Text="● LIVE RECOVERY ARMED" Foreground="#67D17B" FontSize="13" FontWeight="Black" />
                                        <TextBlock Text="Every confirmed delivery is mirrored to the display, analytics, recovery state and connected remote." Foreground="#AAB7C5" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="16" Theme="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="OPERATOR GUARD" Foreground="#F0C96A" FontSize="13" FontWeight="Black" />
                                        <TextBlock x:Name="SettingsSelectionText" Text="Select both opening batters and a bowler to begin." Foreground="#D6E0EA" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BOWLING MANAGEMENT" Foreground="#818CF8" Theme="{StaticResource SectionHead}" />
                                <Border Padding="14" Theme="{StaticResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Change the bowler between overs. Mid-over changes are blocked to protect bowling figures." Foreground="#B6C2CF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <ListBox Grid.Row="1" x:Name="BowlerList" Background="#0D131D" Foreground="White" FontSize="14" FontWeight="SemiBold" BorderBrush="#30363D" BorderThickness="1" MinHeight="220" Padding="6" SelectionChanged="Native_BowlerList_SelectionChanged" />
                                        <TextBlock Grid.Row="2" Text="The active bowler, previous bowler and figures remain synchronised on every presentation." Foreground="#8291A2" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
            <Border x:Name="BatterSelectionOverlay" Background="#CC0D1117" Grid.RowSpan="2" IsVisible="False" ZIndex="50">
                <Border MaxWidth="420" MaxHeight="500" Background="#161B22" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="BatterSelectionTitle" Text="SELECT NEW BATTER" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="Choose the next batter to come in" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,0,0,10" />
                        <ListBox Grid.Row="2" x:Name="BatterSelectionList" Background="Transparent" Foreground="White" FontSize="14" BorderThickness="0" MinHeight="120" />
                        <Button Grid.Row="3" Content="Confirm" Height="36" FontSize="13" FontWeight="Bold" Margin="0,10,0,0" Click="ConfirmBatterSelection_Click">
                            <Button.Theme>
                                <ControlTheme TargetType="Button">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{StaticResource AccentBrush}" RenderTransformOrigin="50%,50%" ns3:TemplateMotion.Spec="[{&quot;event&quot;:&quot;Button.Click&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;CfSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleX&quot;,&quot;From&quot;:&quot;0.95&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.15&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.3&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;CfSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleY&quot;,&quot;From&quot;:&quot;0.95&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.15&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.3&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;}]}]">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1" port:ProductionNames.TemplateId="CfSc" />
                                                    </Border.RenderTransform>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style Selector="^:pointerover /template/ Border#Bd">
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Style>
                                </ControlTheme>
                            </Button.Theme>
                        </Button>
                    </Grid>
                </Border>
            </Border>
            <Border x:Name="BowlerSelectionOverlay" Background="#CC0D1117" Grid.RowSpan="2" IsVisible="False" ZIndex="50">
                <Border MaxWidth="420" MaxHeight="500" Background="#161B22" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="SELECT BOWLER" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" x:Name="BowlerSelectionHint" Text="End of over — choose the next bowler" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,0,0,10" />
                        <ListBox Grid.Row="2" x:Name="BowlerSelectionList" Background="Transparent" Foreground="White" FontSize="14" BorderThickness="0" MinHeight="120" />
                        <Button Grid.Row="3" Content="Confirm" Height="36" FontSize="13" FontWeight="Bold" Margin="0,10,0,0" Click="ConfirmBowlerSelection_Click">
                            <Button.Theme>
                                <ControlTheme TargetType="Button">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{StaticResource AccentBrush}" RenderTransformOrigin="50%,50%" ns3:TemplateMotion.Spec="[{&quot;event&quot;:&quot;Button.Click&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;CfSc2&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleX&quot;,&quot;From&quot;:&quot;0.95&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.15&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.3&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;CfSc2&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleY&quot;,&quot;From&quot;:&quot;0.95&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.15&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.3&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;}]}]">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1" port:ProductionNames.TemplateId="CfSc2" />
                                                    </Border.RenderTransform>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style Selector="^:pointerover /template/ Border#Bd">
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Style>
                                </ControlTheme>
                            </Button.Theme>
                        </Button>
                    </Grid>
                </Border>
            </Border>
            <Border x:Name="WicketDetailsOverlay" Background="#CC0D1117" Grid.RowSpan="2" IsVisible="False" ZIndex="50">
                <Border MaxWidth="420" MaxHeight="600" Background="#161B22" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#DC2626" BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="WICKET DETAILS" Foreground="#DC2626" FontSize="16" FontWeight="Black" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" x:Name="WicketBatsmanLabel" Text="Batter: J. Smith" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="2" Text="How out:" Foreground="{StaticResource TextMidBrush}" FontSize="12" Margin="0,0,0,4" />
                        <WrapPanel Grid.Row="3" Margin="0,0,0,10">
                            <Button Content="Bowled" Tag="Bowled" Click="WicketType_Click" Theme="{StaticResource ToolBtn}" />
                            <Button Content="Caught" Tag="Caught" Click="WicketType_Click" Theme="{StaticResource ToolBtn}" />
                            <Button Content="C &amp; B" Tag="CaughtAndBowled" Click="WicketType_Click" Theme="{StaticResource ToolBtn}" />
                            <Button Content="LBW" Tag="LBW" Click="WicketType_Click" Theme="{StaticResource ToolBtn}" />
                            <Button Content="Run Out" Tag="RunOut" Click="WicketType_Click" Theme="{StaticResource ToolBtn}" />
                            <Button Content="Stumped" Tag="Stumped" Click="WicketType_Click" Theme="{StaticResource ToolBtn}" />
                            <Button Content="Hit Wicket" Tag="HitWicket" Click="WicketType_Click" Theme="{StaticResource ToolBtn}" />
                            <Button Content="Other" Tag="Other" Click="WicketType_Click" Theme="{StaticResource ToolBtn}" />
                        </WrapPanel>
                        <StackPanel Grid.Row="4" x:Name="WicketFielderPanel" Margin="0,0,0,8" IsVisible="False">
                            <TextBlock Text="Fielder:" Foreground="{StaticResource TextMidBrush}" FontSize="12" Margin="0,0,0,4" />
                            <ListBox x:Name="WicketFielderList" Background="Transparent" Foreground="White" FontSize="13" BorderThickness="0" MaxHeight="120" />
                        </StackPanel>
                        <StackPanel Grid.Row="5" x:Name="WicketBowlerPanel" Margin="0,0,0,8" IsVisible="False">
                            <TextBlock Text="Bowler:" Foreground="{StaticResource TextMidBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBlock x:Name="WicketBowlerAutoLabel" Text="" Foreground="#4ADE80" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
                        </StackPanel>
                        <Grid Grid.Row="6" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Height="36" FontSize="13" FontWeight="Bold" Click="CancelWicket_Click" Theme="{StaticResource ToolBtn}" />
                            <Button Grid.Column="2" Content="Confirm Wicket" Height="36" FontSize="13" FontWeight="Bold" Click="ConfirmWicket_Click">
                                <Button.Theme>
                                    <ControlTheme TargetType="Button">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="#DC2626" RenderTransformOrigin="50%,50%" ns3:TemplateMotion.Spec="[{&quot;event&quot;:&quot;Button.Click&quot;,&quot;animations&quot;:[{&quot;Storyboard.TargetName&quot;:&quot;WkSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleX&quot;,&quot;From&quot;:&quot;0.95&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.15&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.3&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;},{&quot;Storyboard.TargetName&quot;:&quot;WkSc&quot;,&quot;Storyboard.TargetProperty&quot;:&quot;ScaleY&quot;,&quot;From&quot;:&quot;0.95&quot;,&quot;To&quot;:&quot;1&quot;,&quot;Duration&quot;:&quot;0:0:0.15&quot;,&quot;Easing&quot;:&quot;BackEase&quot;,&quot;Amplitude&quot;:&quot;0.3&quot;,&quot;EasingMode&quot;:&quot;EaseOut&quot;}]}]">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1" port:ProductionNames.TemplateId="WkSc" />
                                                        </Border.RenderTransform>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style Selector="^:pointerover /template/ Border#Bd">
                                            <Setter Property="Opacity" Value="0.85" />
                                        </Style>
                                    </ControlTheme>
                                </Button.Theme>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
            <Border x:Name="OverlayQueueBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Grid.Row="0" Padding="10,4" IsHitTestVisible="False" IsVisible="False" ZIndex="60">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#6366F1" Offset="0" />
                        <GradientStop Color="#818CF8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏳" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="OverlayQueueText" Text="0 queued" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
