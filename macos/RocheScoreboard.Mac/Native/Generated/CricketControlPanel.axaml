<!-- Generated from production WPF source; edit the translator. -->
<UserControl xmlns="https://github.com/avaloniaui" xmlns:ns2="clr-namespace:Roche_Scoreboard.Services" xmlns:ns4="clr-namespace:Roche_Scoreboard.Views" xmlns:port="clr-namespace:RocheScoreboard.Mac.Production" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.CricketControlPanel" Background="#09090B" SizeChanged="Console_SizeChanged" ns2:OperatorDesign.IsEnabled="True" xmlns:local="clr-namespace:Roche_Scoreboard.Views" xmlns:layout="clr-namespace:Roche_Scoreboard.Views" xmlns:motion="clr-namespace:Roche_Scoreboard.Services" port:ProductionNames.Root="True" xmlns:native="clr-namespace:RocheScoreboard.Mac.Native" xmlns:services="clr-namespace:Roche_Scoreboard.Services" xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base" xmlns:fonts="clr-namespace:RocheScoreboard.Mac.Native">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/OperatorControls.axaml" />
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/SettingsControls.axaml" />
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/CricketActions.axaml" />
                <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/ControlCentre.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ShellBrush" Color="#09090B" />
            <SolidColorBrush x:Key="RegionBrush" Color="#09090B" />
            <SolidColorBrush x:Key="RegionAltBrush" Color="#19191C" />
            <SolidColorBrush x:Key="RegionEdgeBrush" Color="#303035" />
            <ControlTheme x:Key="SectionHead" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource ControlCentre.Font}" />
                <Setter Property="FontSize" Value="{DynamicResource ControlCentre.CaptionSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource ControlCentre.SecondaryTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </ControlTheme>
            <ControlTheme x:Key="RunBtn" TargetType="Button" BasedOn="{StaticResource PrimaryCommandButton}">
                <Setter Property="Height" Value="54" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="FontSize" Value="23" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="0" />
            </ControlTheme>
            <ControlTheme x:Key="TossChoice" TargetType="RadioButton" BasedOn="{StaticResource SettingsCommand}">
                <Setter Property="Margin" Value="4" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </ControlTheme>
            <ControlTheme x:Key="Card" TargetType="Border" BasedOn="{StaticResource SettingsSectionSurface}" />
            <ControlTheme x:Key="MenuBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusAdorner" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Grid x:Name="PART_Surface" RenderTransformOrigin="50%,50%">
                                    <Grid.RenderTransform>
                                        <ScaleTransform port:ProductionNames.TemplateId="TbSc" />
                                    </Grid.RenderTransform>
                                    <Border CornerRadius="14" Background="{TemplateBinding Background}" />
                                    <Border x:Name="ActionGlow" CornerRadius="14" Background="White" Opacity="0" IsHitTestVisible="False" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Grid>
                                <Border x:Name="MenuKeyboardFocus" CornerRadius="14" BorderBrush="{DynamicResource ControlCentre.TextBrush}" BorderThickness="2" IsHitTestVisible="False" IsVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style Selector="^:focus:focus-visible /template/ Border#MenuKeyboardFocus">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value=".4" />
                </Style>
            </ControlTheme>
            <ControlTheme x:Key="PresentationButton" TargetType="Button" BasedOn="{StaticResource OperatorPresentationButton}">
                <Setter Property="Margin" Value="4" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="MinHeight" Value="96" />
            </ControlTheme>
            <ControlTheme x:Key="PlayerChoice" TargetType="ListBoxItem">
                <Setter Property="FocusAdorner" Value="{x:Null}" />
                <Setter Property="motion:OperatorControlMotion.Enabled" Value="True" />
                <Setter Property="motion:SelectionCheckMotion.Enabled" Value="True" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Margin" Value="6,5" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="#E6EDF3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Background="Transparent">
                                <Grid x:Name="PART_Surface" RenderTransformOrigin="50%,50%" ns2:OperatorRoundedClip.Radius="15">
                                    <Grid.RenderTransform>
                                        <ScaleTransform port:ProductionNames.TemplateId="TbSc" />
                                    </Grid.RenderTransform>
                                    <Border x:Name="Surface" CornerRadius="15" Background="#202024" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Margin="0,0,28,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </Border>
                                    <Border x:Name="ActionGlow" CornerRadius="15" Background="White" Opacity="0" IsHitTestVisible="False" />
                                    <Border x:Name="PlayerSelected" Width="22" Height="22" CornerRadius="11" Background="#24925C" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" RenderTransformOrigin="50%,50%" IsHitTestVisible="False" IsVisible="False">
                                        <Border.RenderTransform>
                                            <ScaleTransform port:ProductionNames.TemplateId="SelectionPop" />
                                        </Border.RenderTransform>
                                        <Path x:Name="SelectionStroke" Data="M2,7 L6,11 13,3" Stroke="White" StrokeThickness="2" StrokeDashArray="7,7" Width="15" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeLineCap="Round" />
                                    </Border>
                                </Grid>
                                <Border x:Name="PlayerFocus" CornerRadius="15" BorderBrush="{DynamicResource ControlCentre.TextBrush}" BorderThickness="2" IsHitTestVisible="False" IsVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style Selector="^:focus-within:focus-visible /template/ Border#PlayerFocus">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#Surface">
                    <Setter Property="Background" Value="{DynamicResource PlayerSelectionHover}" />
                </Style>
                <Style Selector="^:selected /template/ Border#Surface">
                    <Setter Property="Background" Value="{DynamicResource PlayerSelectionSurface}" />
                </Style>
                <Style Selector="^:selected /template/ Border#PlayerSelected">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </ControlTheme>
            <SolidColorBrush x:Key="PlayerSelectionHover" Color="#243348" />
            <SolidColorBrush x:Key="PlayerSelectionSurface" Color="#173655" />
            <SolidColorBrush x:Key="PlayerSelectionAccent" Color="#79B9FF" />
            <DataTemplate x:Key="PlayerChoiceContent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" FontSize="13" Foreground="#BBCADC" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Figures}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </DataTemplate>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8291A2" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="CricketRoot">
        <ns4:OperatorViewport x:Name="ConsoleViewport" MinimumCanvasWidth="380" MinimumCanvasHeight="0">
            <Grid Background="{StaticResource ShellBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="18" Margin="12,10,12,8" Background="#19191C" BorderBrush="#303035" BorderThickness="1" Padding="16,10">
                    <Grid x:Name="PersistentHeader">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="WorkflowBadge" CornerRadius="10" Grid.Column="0" BorderBrush="#244A34" BorderThickness="1.5" Background="#0D2818" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#3FB950" Margin="0,0,6,0" />
                                <TextBlock x:Name="WorkflowStatus" Text="LIVE" Foreground="#3FB950" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="2" x:Name="InningsLabel" Text="1st Innings" Foreground="White" FontSize="24" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center" />
                        <Border x:Name="HeaderOversBadge" CornerRadius="10" Grid.Column="4" BorderBrush="#3A3A40" BorderThickness="1" Background="#202024" Padding="10,4">
                            <TextBlock MinWidth="52" TextAlignment="Right" x:Name="HeaderOvers" Text="" Foreground="{StaticResource TextMidBrush}" FontSize="10" FontWeight="Bold" FontFeatures="tnum,lnum,-kern" />
                        </Border>
                        <TextBlock Grid.Column="6" MinWidth="96" TextAlignment="Right" x:Name="HeaderScore" Text="0/0" Foreground="White" FontSize="28" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center" FontFeatures="tnum,lnum,-kern" />
                    </Grid>
                </Border>
                <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" TabStripPlacement="Top" Theme="{StaticResource OperatorTabs}" SelectionChanged="Native_MainTabControl_SelectionChanged">
                    <TabControl.Resources>
                        <ControlTheme TargetType="TabItem" BasedOn="{StaticResource PanelTab}" x:Key="{x:Type TabItem}" />
                    </TabControl.Resources>
                    <TabItem x:Name="MatchTab" Header="1  MATCH" Tag="SCORING &amp; LOG">
                        <ScrollViewer x:Name="CricketMatchPageViewport" SizeChanged="Console_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0" Padding="12,12">
                                <Grid x:Name="ScoringColumns">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="290" MinWidth="260" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" x:Name="BattingZone" BorderBrush="#4D3D8F" CornerRadius="22" BorderThickness="1" Background="#0D0A28" Margin="0,0,0,8">
                                                <Grid ClipToBounds="True">
                                                    <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                                        <Image x:Name="BattingZoneLogo" Stretch="UniformToFill" Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=Canvas}}" Height="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=Canvas}}" Opacity=".06" />
                                                    </Canvas>
                                                    <StackPanel Margin="12">
                                                        <TextBlock x:Name="BattingStartHint" Text="Complete the toss before selecting players." Foreground="#F0C96A" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                        <Button x:Name="SelectOpeningBatters" Content="SELECT BATTERS" Click="SelectOpeningBatters_Click" Height="44" Margin="0,0,0,8" Theme="{StaticResource ToolBtn}" />
                                                        <TextBlock x:Name="BattingTeamHeading" Text="BATTING" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                        <Border x:Name="StrikerBar" CornerRadius="14" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" Padding="12,10" Margin="0,0,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="TopBatterIndicator" Text="▶" Foreground="#58A6FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock x:Name="StrikerName" Text="Striker" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="15" FontWeight="Bold" />
                                                                    <TextBlock x:Name="StrikerStats" Text="0 (0)  SR 0.0" Foreground="{StaticResource TextMidBrush}" FontSize="11" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                    <TextBlock x:Name="StrikerRuns" Text="0" Foreground="White" FontSize="24" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center" Margin="0,0,8,0" FontFeatures="tnum,lnum,-kern" />
                                                                    <TextBlock x:Name="StrikerBallsFaced" Text="" Foreground="#B9C9DC" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" FontFeatures="tnum,lnum,-kern" />
                                                                </StackPanel>
                                                                <Button Grid.Column="3" x:Name="StrikerMenuButton" AutomationProperties.Name="Batter options" Content="⋯" Click="StrikerMenu_Click" Theme="{StaticResource MenuBtn}" ToolTip.Tip="Options">
                                    </Button>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="NonStrikerBar" CornerRadius="14" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" Padding="12,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="BottomBatterIndicator" Text="  " Foreground="#58A6FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock x:Name="NonStrikerName" Text="Non-Striker" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="15" FontWeight="Bold" />
                                                                    <TextBlock x:Name="NonStrikerStats" Text="0 (0)  SR 0.0" Foreground="{StaticResource TextMidBrush}" FontSize="11" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                    <TextBlock x:Name="NonStrikerRunsText" Text="0" Foreground="White" FontSize="24" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <TextBlock x:Name="NonStrikerBallsFaced" Text="" Foreground="#B9C9DC" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" FontFeatures="tnum,lnum,-kern" />
                                                                </StackPanel>
                                                                <Button Grid.Column="3" x:Name="NonStrikerMenuButton" AutomationProperties.Name="Batter options" Content="⋯" Click="NonStrikerMenu_Click" Theme="{StaticResource MenuBtn}" ToolTip.Tip="Options">
                                    </Button>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" x:Name="BowlingZone" BorderBrush="#1A6040" CornerRadius="22" BorderThickness="1" Background="#0D1E14" Margin="0,0,0,8">
                                                <Grid ClipToBounds="True">
                                                    <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                                        <Image x:Name="BowlingZoneLogo" Stretch="UniformToFill" Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=Canvas}}" Height="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=Canvas}}" Opacity=".06" />
                                                    </Canvas>
                                                    <StackPanel Margin="12">
                                                        <TextBlock x:Name="BowlingStartHint" Text="Complete the toss before selecting players." Foreground="#F0C96A" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                        <Button x:Name="SelectOpeningBowler" Content="SELECT BOWLER" Click="SelectOpeningBowler_Click" Height="44" Margin="0,0,0,8" Theme="{StaticResource ToolBtn}" />
                                                        <TextBlock x:Name="BowlingTeamHeading" Text="BOWLING" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                        <Border x:Name="BowlerBar" CornerRadius="14" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" Padding="12,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock x:Name="BowlerName" Text="Bowler" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="15" FontWeight="Bold" />
                                                                    <TextBlock x:Name="BowlerStats" Text="0-0 (0)  Econ 0.00" Foreground="{StaticResource TextMidBrush}" FontSize="11" FontFeatures="tnum,lnum,-kern" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <TextBlock x:Name="BowlerFigures" Text="0-0" Foreground="White" FontSize="20" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <TextBlock x:Name="BowlerOverFigures" Text="" Foreground="#B9C9DC" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" x:Name="BowlerMenuButton" AutomationProperties.Name="Bowler options" Content="⋯" Click="BowlerMenu_Click" Theme="{StaticResource MenuBtn}" ToolTip.Tip="Options">
                                    </Button>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock x:Name="OverDisplay" Text="This over: " Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,6,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="ScoringCommands" CornerRadius="22" Grid.Row="2" Background="{StaticResource RegionAltBrush}" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock x:Name="OperatorFreeHitText" DockPanel.Dock="Right" Text="FREE HIT" Foreground="#FFD980" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" IsVisible="False" />
                                                        <TextBlock Text="SCORING" Theme="{StaticResource SectionHead}" />
                                                    </DockPanel>
                                                    <UniformGrid Columns="4" Margin="0,0,0,6">
                                                        <Button Content="•" Click="Dot_Click" Background="#3A3A40" BorderBrush="#484F58" Theme="{StaticResource RunBtn}" ToolTip.Tip="Dot ball" />
                                                        <Button Content="1" Click="Run1_Click" Background="#1E40AF" BorderBrush="#3B6AE0" Theme="{StaticResource RunBtn}" ToolTip.Tip="1 run" />
                                                        <Button Content="2" Click="Run2_Click" Background="#1E40AF" BorderBrush="#3B6AE0" Theme="{StaticResource RunBtn}" ToolTip.Tip="2 runs" />
                                                        <Button Content="3" Click="Run3_Click" Background="#1E40AF" BorderBrush="#3B6AE0" Theme="{StaticResource RunBtn}" ToolTip.Tip="3 runs" />
                                                    </UniformGrid>
                                                    <UniformGrid Columns="4">
                                                        <Button Content="4" Click="Four_Click" BorderBrush="#22C55E" Theme="{StaticResource RunBtn}" ToolTip.Tip="Boundary four">
                                                            <Button.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                    <GradientStop Color="#15803D" Offset="0" />
                                                                    <GradientStop Color="#166534" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Button.Background>
                                                        </Button>
                                                        <Button Content="5" Click="Run5_Click" Background="#1E40AF" BorderBrush="#3B6AE0" Theme="{StaticResource RunBtn}" ToolTip.Tip="5 runs" />
                                                        <Button Content="6" Click="Six_Click" BorderBrush="#A855F7" Theme="{StaticResource RunBtn}" ToolTip.Tip="Maximum six">
                                                            <Button.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                    <GradientStop Color="#7C3AED" Offset="0" />
                                                                    <GradientStop Color="#9333EA" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Button.Background>
                                                        </Button>
                                                        <Button Content="W" Click="Wicket_Click" BorderBrush="#F87171" Theme="{StaticResource RunBtn}" ToolTip.Tip="Wicket">
                                                            <Button.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                    <GradientStop Color="#DC2626" Offset="0" />
                                                                    <GradientStop Color="#B91C1C" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Button.Background>
                                                        </Button>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>
                                            <Button x:Name="ScoringLockBanner" Grid.Row="2" Grid.RowSpan="2" Click="ScoringGate_Click" Background="#152B43" BorderBrush="#79B9FF" BorderThickness="2" Margin="0" MinHeight="180" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="2" IsVisible="False" Theme="{StaticResource CricketActionButton}">
                                                <StackPanel VerticalAlignment="Center" Margin="24">
                                                    <TextBlock x:Name="ScoringReadyHint" Text="" Foreground="White" FontSize="25" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="ScoringReadyDetail" Foreground="#C2D8ED" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="StartTossButton" Grid.Row="2" Grid.RowSpan="2" Content="RECORD THE TOSS" Click="OpenToss_Click" Background="#163657" BorderBrush="#79B9FF" Foreground="White" MinHeight="180" FontSize="25" Margin="0" Theme="{StaticResource CricketActionButton}" ZIndex="3" />
                                            <Border x:Name="ExtraCommands" CornerRadius="22" Grid.Row="3" Background="#19191C" BorderBrush="#3A3A40" BorderThickness="1" Padding="12" Margin="0,0,0,0">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="EXTRAS" Foreground="#D29922" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                        <UniformGrid Columns="4">
                                                            <Button Content="Wide" Click="Wide_Click" Margin="3" Background="#29292D" BorderBrush="#4B4B51" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Wide delivery" />
                                                            <Button Content="No Ball" Click="NoBall_Click" Margin="3" Background="#29292D" BorderBrush="#4B4B51" Theme="{StaticResource ToolBtn}" ToolTip.Tip="No ball" />
                                                            <Button Content="Bye" Click="Bye_Click" Margin="3" Background="#29292D" BorderBrush="#4B4B51" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Bye runs" />
                                                            <Button Content="Leg Bye" Click="LegBye_Click" Margin="3" Background="#29292D" BorderBrush="#4B4B51" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Leg bye" />
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <UniformGrid Grid.Row="5" Columns="3">
                                                <Button x:Name="MatchOptionsButton" Content="OPTIONS" Click="MatchOptions_Click" Height="42" Margin="0,0,6,0" Theme="{StaticResource ToolBtn}" />
                                                <Button x:Name="UndoDeliveryButton" Content="↩ Undo" Height="42" Margin="0,0,6,0" Click="Undo_Click" Background="#303035" BorderBrush="#6B3A3E" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Undo last delivery" />
                                                <Button x:Name="EndInningsButton" Content="End innings" MinHeight="42" Click="EndInnings_Click" Foreground="White" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Innings and match options" />
                                            </UniformGrid>
                                            <Button Grid.Row="7" Grid.ColumnSpan="20" Content="Reset match" HorizontalAlignment="Stretch" Margin="0,12,0,0" MinWidth="0" Height="44" FontSize="13" FontWeight="SemiBold" Click="ResetMatch_Click" Background="#2A1416" BorderBrush="#6B3A3E" Foreground="#FF6B6B" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Reset the entire match and return to setup" />
                                        </Grid>
                                    </ScrollViewer>
                                    <Border Grid.Column="2" CornerRadius="22" Background="#19191C" BorderBrush="#303035" BorderThickness="1" Padding="16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="DELIVERY LOG" Theme="{StaticResource SectionHead}" />
                                                <ComboBox x:Name="DeliveryOverChoice" MinHeight="32" FontSize="12" Margin="0,4,0,8" Theme="{StaticResource SettingsChoice}" SelectionChanged="Native_DeliveryOverChoice_Changed" />
                                            </StackPanel>
                                            <ScrollViewer x:Name="DeliveryLogScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="EventLog" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="ScorecardTab" Header="2  SCORECARD" Tag="BATTING &amp; BOWLING">
                        <ContentControl x:Name="ScorecardHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" />
                    </TabItem>
                    <TabItem x:Name="OutputTab" Header="3  OUTPUT" Tag="PRESENTATIONS">
                        <ScrollViewer x:Name="CricketOutputPageViewport" SizeChanged="Console_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="#09090B" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0" Padding="20,16">
                                <Grid x:Name="DisplayColumns">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.65*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="LIVE OUTPUT ROUTER" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                                <TextBlock Text="One click changes the public screen · active output is highlighted" FontSize="12" Foreground="#9BB0C6" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Background="#142236" BorderBrush="#3D5F85" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                                <TextBlock x:Name="CricketOnAirText" Text="ON AIR · LIVE SCOREBUG" Foreground="#9CCBFF" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                                <Button x:Name="CricketExtrasOverlayButton" Content="EXTRAS" Click="ExtrasOverlay_Click" IsEnabled="False" MinHeight="48" Margin="4" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Show wides, no-balls, byes and leg-byes" />
                                                <Button x:Name="CricketBoundariesOverlayButton" Content="INNINGS BOUNDARIES" Click="BoundariesOverlay_Click" IsEnabled="False" MinHeight="48" Margin="4" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Show this innings' fours and sixes" />
                                            </UniformGrid>
                                            <UniformGrid x:Name="CricketPresentationGrid" Columns="2" Margin="0,0,0,18">
                                                <Button x:Name="Presentationscorebug" Tag="scorebug" Click="PresentationButton_Click" Theme="{StaticResource PresentationButton}">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4">
                                                        <TextBlock Text="LIVE" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                        <TextBlock Text="SCOREBUG" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Live scoring" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Presentationbatting" Tag="batting" Click="PresentationButton_Click" Theme="{StaticResource PresentationButton}">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4">
                                                        <TextBlock Text="BAT" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                        <TextBlock Text="BATTING" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Batting scorecard" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Presentationbowling" Tag="bowling" Click="PresentationButton_Click" Theme="{StaticResource PresentationButton}">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4">
                                                        <TextBlock Text="BOWL" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                        <TextBlock Text="BOWLING" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Bowling figures" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Presentationwindow" Tag="window" Click="PresentationButton_Click" Theme="{StaticResource PresentationButton}">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4">
                                                        <TextBlock Text="OUTPUT" FontSize="11" FontWeight="SemiBold" Foreground="#67D17B" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                        <TextBlock Text="SHOW WINDOW" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Restore output" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Presentationsummary" Tag="summary" Click="PresentationButton_Click" Theme="{StaticResource PresentationButton}">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4">
                                                        <TextBlock Text="MATCH" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                        <TextBlock Text="SUMMARY" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Score and leading players" FontSize="12" Foreground="#B6B6C0" TextWrapping="Wrap" TextAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Presentationworm" Tag="worm" Click="PresentationButton_Click" Theme="{StaticResource PresentationButton}">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4">
                                                        <TextBlock Text="SCOREWORM" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Compare innings progress" FontSize="12" Foreground="#B6B6C0" TextAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Presentationmanhattan" Tag="manhattan" Click="PresentationButton_Click" Theme="{StaticResource PresentationButton}">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4">
                                                        <TextBlock Text="MANHATTAN" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Runs and wickets per over" FontSize="12" Foreground="#B6B6C0" TextAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                            <TextBlock Text="CRICKET OVERLAYS" FontSize="14" Theme="{StaticResource SectionHead}" />
                                            <TextBlock x:Name="OverlayStatusText" Text="NO OVERLAY ON AIR" Foreground="#9CCBFF" FontWeight="Bold" FontSize="11" Margin="0,4,0,8" />
                                            <StackPanel x:Name="CricketOverlayButtons" />
                                            <Button Content="CANCEL CURRENT OVERLAY" Click="CancelCricketOverlay_Click" Height="42" Margin="4,10,4,8" Theme="{StaticResource ToolBtn}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="VENUE WEATHER" FontSize="14" Theme="{StaticResource SectionHead}" />
                                        <ns4:OperatorGlassSurface Material="Regular" Background="{DynamicResource ControlCentre.GlassBrush}" Theme="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock x:Name="CricketWeatherTemperature" Text="—" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource ControlCentre.TextBrush}" />
                                                <TextBlock x:Name="CricketWeatherDescription" Text="Waiting for weather" FontSize="15" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" />
                                                <TextBox x:Name="CricketWeatherLocation" Text="Melbourne" Margin="0,14,0,0" FontSize="16" Theme="{StaticResource SettingsInput}" />
                                                <Button Content="Update weather" Click="UpdateCricketWeather_Click" Height="50" Margin="0,12,0,0" Theme="{StaticResource ToolBtn}" />
                                            </StackPanel>
                                        </ns4:OperatorGlassSurface>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="CricketSettingsTab" Header="4  SETTINGS" Tag="MATCH OPTIONS">
                        <ns4:SettingsWorkspace Heading="CRICKET SETTINGS" Subtitle="Match, controls and output">
                            <Grid x:Name="CricketSettingsColumns" Tag="MATCH|innings format bowler players recovery selections">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MATCH HEALTH" Foreground="#58A6FF" Theme="{StaticResource SectionHead}" />
                                    <Border Margin="0,0,0,10" Padding="16" Theme="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock x:Name="SettingsMatchText" Text="LIMITED OVERS • 20 OVERS" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SettingsStateText" Text="1ST INNINGS • 0/0 (0.0)" Foreground="#C4D0DD" FontSize="14" FontWeight="Bold" Margin="0,6,0,0" />
                                            <Border Height="1" Background="#3A3A40" Margin="0,12" />
                                            <TextBlock x:Name="SettingsAutosaveText" Text="● LIVE RECOVERY ARMED" Foreground="#67D17B" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Every confirmed delivery is mirrored to the display, analytics, recovery state and connected remote." Foreground="#AAB7C5" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="16" Theme="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="OPERATOR GUARD" Foreground="#F0C96A" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock x:Name="SettingsSelectionText" Text="Select both opening batters and a bowler to begin." Foreground="#D6E0EA" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Theme="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="BROADCAST PREFERENCES" Theme="{StaticResource SectionHead}" />
                                            <CheckBox x:Name="CricketEventAnimations" Content="Scoring celebrations" IsChecked="True" ToolTip.Tip="Four, six, wicket, 50 and 100 presentations" Theme="{StaticResource SettingsToggle}" IsCheckedChanged="Native_CricketPresentationPreference_Changed" />
                                            <TextBlock Text="Play the moment first, then roll the figures. Scoring and recovery remain immediate." Foreground="#B9C9DC" TextWrapping="Wrap" Margin="0,8,0,16" />
                                            <CheckBox x:Name="CricketRollingFigures" Content="Rolling figure updates" IsChecked="True" Theme="{StaticResource SettingsToggle}" IsCheckedChanged="Native_CricketPresentationPreference_Changed" />
                                            <TextBlock Text="Turn off for instant, still figure updates." Foreground="#B9C9DC" TextWrapping="Wrap" Margin="0,8,0,14" />
                                            <CheckBox x:Name="CricketBowlerDetails" Content="Occasional bowler details in over strip" IsChecked="True" Theme="{StaticResource SettingsToggle}" IsCheckedChanged="Native_CricketPresentationPreference_Changed" />
                                            <TextBlock Text="During quiet play, show economy and only the extras the current bowler has delivered. The ball strip returns as soon as play resumes." Foreground="#B9C9DC" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Tag="AUTOMATION|automatic overlays cancel hold manual" Theme="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="OVERLAY AUTOMATION" Theme="{StaticResource SectionHead}" />
                                    <CheckBox x:Name="CricketAutomaticOverlays" Content="Automatic cricket overlays" IsChecked="True" Theme="{StaticResource SettingsToggle}" IsCheckedChanged="Native_AutoOverlays_Changed" />
                                    <TextBlock Text="Manual overlays remain available. Automatic selection favours fresh events and leaves quiet time after scoring and corrections." Foreground="#B6C2CF" FontSize="12" TextWrapping="Wrap" Margin="0,10" />
                                    <Button Content="CANCEL CURRENT OVERLAY" Click="CancelCricketOverlay_Click" Height="42" Theme="{StaticResource ToolBtn}" />
                                </StackPanel>
                            </Border>
                            <Border Tag="SYSTEM|application preferences output window dimensions appearance" Theme="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="APPLICATION PREFERENCES" Theme="{StaticResource SectionHead}" />
                                    <Button Click="OpenApplicationPreferences_Click" MinHeight="48" Theme="{StaticResource ToolBtn}">
                                        <TextBlock Text="APPLICATION &amp; OUTPUT PREFERENCES" TextWrapping="Wrap" TextAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </ns4:SettingsWorkspace>
                    </TabItem>
                </TabControl>
            </Grid>
        </ns4:OperatorViewport>
        <Border x:Name="BatterSelectionOverlay" KeyboardNavigation.TabNavigation="Cycle" Background="#B8000000" Grid.RowSpan="2" Padding="24" IsVisible="False" ZIndex="50">
            <Border x:Name="BatterSelectionCard" ClipToBounds="True" CornerRadius="26" MaxWidth="600" MaxHeight="680" Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image x:Name="BatterSelectionLogo" Grid.RowSpan="4" Stretch="UniformToFill" Opacity=".08" IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock x:Name="BatterSelectionTitle" Text="SELECT BATTER" FontSize="25" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                    <TextBlock x:Name="BatterSelectionTeamText" Grid.Row="1" Foreground="#DCE8F5" FontSize="16" FontWeight="Bold" Margin="0,7,0,16" TextWrapping="Wrap" />
                    <ListBox Grid.Row="2" x:Name="BatterSelectionList" Focusable="True" Background="Transparent" Foreground="White" BorderThickness="0" MinHeight="0" MaxHeight="440" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemTemplate="{StaticResource PlayerChoiceContent}" FocusAdorner="{x:Null}" ItemContainerTheme="{StaticResource PlayerChoice}" />
                    <StackPanel Grid.Row="3">
                        <Button MinHeight="0" Content="SKIP FOR NOW" Click="SkipPlayerSelection_Click" Height="36" Margin="0,8,0,0" Theme="{StaticResource ToolBtn}" />
                        <Button x:Name="ConfirmBatterButton" Grid.Row="3" Content="CONFIRM BATTER" Height="48" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" Click="ConfirmBatterSelection_Click" Background="#173655" BorderBrush="#79B9FF" Theme="{StaticResource ToolBtn}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <Border x:Name="BowlerSelectionOverlay" KeyboardNavigation.TabNavigation="Cycle" Background="#B8000000" Grid.RowSpan="2" Padding="24" IsVisible="False" ZIndex="50">
            <Border x:Name="BowlerSelectionCard" ClipToBounds="True" CornerRadius="26" MaxWidth="600" MaxHeight="680" Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image x:Name="BowlerSelectionLogo" Grid.RowSpan="4" Stretch="UniformToFill" Opacity=".08" IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="SELECT BOWLER" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="BowlerSelectionTeamText" Foreground="#DCE8F5" FontSize="16" FontWeight="Bold" Margin="0,7,0,0" />
                        <TextBlock x:Name="BowlerSelectionHint" Text="Choose the bowler for this over." Foreground="#BBCADC" FontSize="14" Margin="0,4,0,16" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox Grid.Row="2" x:Name="BowlerSelectionList" Focusable="True" Background="Transparent" Foreground="White" BorderThickness="0" MinHeight="0" MaxHeight="440" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemTemplate="{StaticResource PlayerChoiceContent}" FocusAdorner="{x:Null}" ItemContainerTheme="{StaticResource PlayerChoice}" />
                    <StackPanel Grid.Row="3">
                        <Button MinHeight="0" Content="SKIP FOR NOW" Click="SkipPlayerSelection_Click" Height="36" Margin="0,8,0,0" Theme="{StaticResource ToolBtn}" />
                        <Button x:Name="ConfirmBowlerButton" Grid.Row="3" Content="CONFIRM BOWLER" Height="48" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" Click="ConfirmBowlerSelection_Click" Background="#173655" BorderBrush="#79B9FF" Theme="{StaticResource ToolBtn}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <Border x:Name="DeliveryEntryOverlay" Background="#B8000000" Padding="12" IsVisible="False" ZIndex="90">
            <Border CornerRadius="26" ns2:OperatorRoundedClip.Radius="26" Background="#202024" BorderBrush="#52647A" BorderThickness="1" MaxWidth="620" MaxHeight="710" ClipToBounds="True">
                <ContentControl x:Name="DeliveryEntryContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>
        </Border>
        <Border x:Name="TossOverlay" KeyboardNavigation.TabNavigation="Cycle" Background="#A0000000" Padding="16" KeyDown="Native_Toss_PreviewKeyDown" IsVisible="False" ZIndex="80">
            <ns4:OperatorGlassSurface x:Name="TossSheet" CornerRadius="32" MaxWidth="620" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="#68FFFFFF" BorderThickness="1" Padding="24" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Record the toss" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" Margin="0,0,46,0" />
                            <Button Padding="0" MinHeight="0" Click="CloseToss_Click" HorizontalAlignment="Right" Width="34" Height="34" ToolTip.Tip="Close toss" Theme="{StaticResource ToolBtn}">
                                <ns2:OperatorSymbol Kind="close" Width="22" Height="22" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>
                        <TextBlock Text="Choose the winner, then their decision." Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,20" />
                        <TextBlock Text="Toss winner" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="13" Margin="4,0,0,7" />
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="TossHomeChoice" GroupName="TossTeam" MinHeight="82" HorizontalContentAlignment="Stretch" IsCheckedChanged="Native_TossChoice_Checked_Checked" Theme="{StaticResource TossChoice}" />
                            <RadioButton x:Name="TossAwayChoice" GroupName="TossTeam" MinHeight="82" HorizontalContentAlignment="Stretch" IsCheckedChanged="Native_TossChoice_Checked_Checked" Theme="{StaticResource TossChoice}" />
                        </UniformGrid>
                        <TextBlock Text="Decision" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="13" Margin="4,18,0,7" />
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="TossBatChoice" GroupName="TossDecision" MinHeight="70" IsCheckedChanged="Native_TossChoice_Checked_Checked" Theme="{StaticResource TossChoice}">
                                <StackPanel Orientation="Horizontal">
                                    <ns2:OperatorSymbol Kind="bat" Width="24" Height="24" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Bat" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TossBowlChoice" GroupName="TossDecision" MinHeight="70" IsCheckedChanged="Native_TossChoice_Checked_Checked" Theme="{StaticResource TossChoice}">
                                <StackPanel Orientation="Horizontal">
                                    <ns2:OperatorSymbol Kind="ball" Width="24" Height="24" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Bowl" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <TextBlock x:Name="TossSelectionSummary" Text="Choose the toss winner and their decision." Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,20,4,0" />
                        <TextBlock x:Name="TossError" Foreground="#FFB1B1" TextWrapping="Wrap" Margin="0,8" />
                        <Button x:Name="ConfirmTossButton" Content="Confirm toss" Click="ConfirmToss_Click" MinHeight="48" Theme="{StaticResource ControlCentre.PrimaryButton}" />
                    </StackPanel>
                </ScrollViewer>
            </ns4:OperatorGlassSurface>
        </Border>
    </Grid>
</UserControl>
