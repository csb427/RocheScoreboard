                        </StackPanel>
                    </Grid>
                </ns5:OperatorGlassSurface>
                <TabControl x:Name="MainTabControl" Grid.Row="1" Grid.RowSpan="2" Background="#090D14" BorderThickness="0" Padding="0" TabStripPlacement="Top" Theme="{StaticResource OperatorTabs}" SelectionChanged="Native_MainTabControl_SelectionChanged">
                    <TabControl.Resources>
