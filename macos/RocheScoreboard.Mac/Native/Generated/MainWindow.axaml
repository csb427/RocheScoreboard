                                                                            <TextBlock Text="+6" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                            <TextBlock Text="Goal" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            <Border Background="#20000000" CornerRadius="8" Padding="7,4" Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Visibility, ElementName=HomeGoalShortcutText}">
                                                                                <TextBlock x:Name="HomeGoalShortcutText" Text=" A" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Viewbox>
                                                                </Button>
                                                                <Button x:Name="HomeBehindButton" Grid.Row="2" Click="HomeBehind_Click" FontSize="16" BorderBrush="#3A4E66" Background="#1A2636" Foreground="White" Theme="{StaticResource PrimaryCommandButton}" ToolTip.Tip="Behind (+1 point) — S">
                                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="48">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="+1" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                            <TextBlock Text="Behind" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            <Border Background="#20000000" CornerRadius="8" Padding="7,4" Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Visibility, ElementName=HomeBehindShortcutText}">
                                                                                <TextBlock x:Name="HomeBehindShortcutText" Text=" S" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Viewbox>
                                                                </Button>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                    <Border x:Name="AwayScoringBorder" Grid.Column="2" BorderBrush="#8A3A3A" BorderThickness="1,3,1,1" Background="#1C0A0A" Padding="14" CornerRadius="22">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="12" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock x:Name="AwayScoringLabel" Text="AWAY" Foreground="#FFB0B0" FontSize="13" FontWeight="SemiBold" />
                                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image x:Name="AwayOperatorLogo" Width="64" Height="64" Margin="0,6,14,0" VerticalAlignment="Top" Stretch="Uniform" Source="{Binding Text, ElementName=AwayLogoPathText, Converter={StaticResource OperatorLogo}}">
                                                                    <Image.Theme>
                                                                        <ControlTheme TargetType="Image">
                                                                            <Setter Property="IsVisible" Value="False" />
                                                                        </ControlTheme>
                                                                    </Image.Theme>
                                                                </Image>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock x:Name="AwayOperatorDetails" Text="{Binding Text, ElementName=AwayScoreDisplay, Converter={StaticResource OperatorScorePart}, ConverterParameter=detail}" FontSize="21" Foreground="#C6C6CF" />
                                                                    <TextBlock x:Name="AwayOperatorTotal" Text="{Binding Text, ElementName=AwayScoreDisplay, Converter={StaticResource OperatorScorePart}, ConverterParameter=total}" FontSize="88" FontWeight="Bold" Foreground="White" Margin="-3,-8,0,0" />
                                                                </StackPanel>
                                                                <TextBlock x:Name="AwayScoreDisplay" Text="0.0.0" Foreground="White" FontSize="58" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Margin="0,4,0,0" IsVisible="False" />
                                                            </Grid>
                                                            <Grid Grid.Row="3">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="8" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <Button x:Name="AwayGoalButton" Grid.Row="0" Click="AwayGoal_Click" BorderBrush="#C56F6F" Background="#A63B3B" Foreground="White" Theme="{StaticResource PrimaryCommandButton}" ToolTip.Tip="Goal (+6 points) — K">
                                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="48">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="+6" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                            <TextBlock Text="Goal" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            <Border Background="#20000000" CornerRadius="8" Padding="7,4" Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Visibility, ElementName=AwayGoalShortcutText}">
                                                                                <TextBlock x:Name="AwayGoalShortcutText" Text=" K" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Viewbox>
                                                                </Button>
                                                                <Button x:Name="AwayBehindButton" Grid.Row="2" Click="AwayBehind_Click" FontSize="16" BorderBrush="#5A3A3A" Background="#2A1A1A" Foreground="White" Theme="{StaticResource PrimaryCommandButton}" ToolTip.Tip="Behind (+1 point) — L">
                                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="48">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="+1" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                            <TextBlock Text="Behind" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            <Border Background="#20000000" CornerRadius="8" Padding="7,4" Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Visibility, ElementName=AwayBehindShortcutText}">
                                                                                <TextBlock x:Name="AwayBehindShortcutText" Text=" L" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Viewbox>
                                                                </Button>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                            <Border x:Name="StartSwitchWarning" CornerRadius="12" Grid.Row="3" Background="#1E1A00" BorderBrush="#D29922" BorderThickness="1,2,1,1" Padding="10,6" IsVisible="False">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="Pressing Start will switch to the live scoreboard" Foreground="#D29922" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Grid Grid.Row="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" x:Name="StartPauseButton" Content="▶ Start" Height="60" FontSize="22" FontWeight="SemiBold" Click="StartPause_Click" Background="#0D3018" BorderBrush="#1A6040" BorderThickness="1.5" Foreground="White" Theme="{StaticResource PrimaryCommandButton}" ToolTip.Tip="Start or pause the game clock — Space" />
                                                <Button Grid.Column="2" x:Name="EndQtrButton" Content="End Qtr" Height="60" FontSize="12" FontWeight="Bold" Click="EndQuarter_Click" Background="#303035" BorderBrush="#D29922" Theme="{StaticResource ToolBtn}" ToolTip.Tip="End the current quarter — Ctrl+E" />
                                                <Button Grid.Column="2" x:Name="ContinueQtrButton" Content="↩ Resume Q" Height="60" FontSize="11" FontWeight="Bold" Click="ContinueQuarter_Click" Background="#1A2A14" BorderBrush="#3A6030" Foreground="#7EE068" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Resume the previous quarter from where it left off — does NOT start the next quarter" IsVisible="False" />
                                                <Button Grid.Column="4" x:Name="UndoButton" Content="UNDO" Height="60" FontSize="12" FontWeight="Bold" Click="Undo_Click" Background="#2A1416" BorderBrush="#E08A8F" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Undo the last score — Ctrl+Z" />
                                            </Grid>
                                            <Button Grid.Row="7" Grid.ColumnSpan="20" Content="Reset match" HorizontalAlignment="Stretch" Margin="0,12,0,0" MinWidth="0" Height="44" FontSize="14" FontWeight="SemiBold" Click="ResetMatch_Click" Background="#2A1416" BorderBrush="#E08A8F" Foreground="#FF6B6B" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Reset the entire match and return to setup" />
                                        </Grid>
                                    </ScrollViewer>
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ns5:CloudRemoteLauncher x:Name="ScoringTabCloudLauncher" Grid.Row="0" IsHitTestVisible="False" IsVisible="False" />
                                        <ns5:OperatorGlassSurface Material="Opaque" x:Name="MatchLogPanel" Grid.Row="2" MinHeight="180" VerticalAlignment="Stretch" Background="#09090B" BorderBrush="#303035" BorderThickness="1" CornerRadius="22" Padding="0" ClipToBounds="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#202024" BorderBrush="#303035" BorderThickness="0,0,0,1" Padding="12,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="" FontFamily="{fonts:ProductionFont 'Segoe MDL2 Assets'}" FontSize="12" Foreground="#818CF8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Text="MATCH LOG" FontSize="10" FontWeight="SemiBold" Foreground="#818CF8" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="MatchLogCountBadge" Text="" FontSize="9" FontWeight="Bold" Foreground="#A8B0BA" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                        <Button MinHeight="0" Grid.Column="1" Content="＋ ADD SCORE" Click="AddMatchLogScore_Click" Height="28" Padding="10,3" FontSize="10" FontWeight="SemiBold" Cursor="Hand" Background="#172B22" Foreground="#7EE2A8" BorderBrush="#397653" BorderThickness="1" />
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer x:Name="MatchLogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,4">
                                                    <StackPanel x:Name="EventList" />
                                                </ScrollViewer>
                                                <TextBlock x:Name="MatchLogEmptyHint" Grid.Row="1" Text="Score events will appear here" Foreground="#7A8693" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </ns5:OperatorGlassSurface>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="OutputStudioTab" Header="2  OUTPUT" Tag="PRESENTATIONS" ToolTip.Tip="Public screens and live overlays · Ctrl+2">
                        <ScrollViewer x:Name="AflOutputPageViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="#09090B" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid x:Name="AflOutputColumns" Margin="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.65*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <StackPanel HorizontalAlignment="Left" Margin="0,0,0,12">
                                                    <TextBlock Text="LIVE OUTPUT ROUTER" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2">

                                            </TextBlock>
                                                    <TextBlock Text="One click changes the public screen · active output is always highlighted" FontSize="10" FontWeight="SemiBold" Foreground="#9BB0C6" />
                                                </StackPanel>
                                                <Border Background="#142236" BorderBrush="#3D5F85" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                                    <TextBlock x:Name="CurrentDisplayText" Text="ON AIR · LIVE SCOREBUG" Foreground="#9CCBFF" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                                <UniformGrid x:Name="AflPresentationGrid" Columns="4" Margin="0,0,0,6">
                                                    <ns5:OperatorActionBorder x:Name="PresCardScorebug" Cursor="Hand" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_OperatorTile_PresCardScorebug_Click">
                                                        <Grid MinHeight="106">
                                                            <Border x:Name="PresGlowScorebug" Opacity="0.12" IsHitTestVisible="False">
                                                                <Border.Background>
                                                                    <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                        <GradientStop Color="#58A6FF" Offset="0" />
                                                                        <GradientStop Color="#00000000" Offset="1" />
                                                                    </RadialGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="LIVE" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                                <TextBlock Text="SCOREBUG" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Live overlay" FontSize="10" FontWeight="SemiBold" Foreground="#B9D8FA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                                <TextBlock Text="KEY 1" FontSize="10" FontWeight="SemiBold" Foreground="#8FC5FF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Border x:Name="PresCheckScorebug" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2">
                                                                <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="PresCardSummary" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_OperatorTile_PresCardSummary_Click">
                                                        <Grid MinHeight="106">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="QTR" FontSize="11" FontWeight="SemiBold" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                                <TextBlock Text="BREAKDOWN" FontSize="14" FontWeight="SemiBold" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Quarter history" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                                <TextBlock Text="KEY 2" FontSize="10" FontWeight="SemiBold" Foreground="#AFA0E8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Border x:Name="PresCheckSummary" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                                <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="PresCardWorm" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_OperatorTile_PresCardWorm_Click">
                                                        <Grid MinHeight="106">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="FLOW" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                                <TextBlock Text="MARGIN FLOW" FontSize="14" FontWeight="SemiBold" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Lead over time" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                                <TextBlock Text="KEY 3" FontSize="10" FontWeight="SemiBold" Foreground="#57D8A9" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Border x:Name="PresCheckWorm" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                                <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="PresCardStats" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_OperatorTile_PresCardStats_Click">
                                                        <Grid MinHeight="106">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="DATA" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                                <TextBlock Text="STATS" FontSize="14" FontWeight="SemiBold" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Full match stats" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                                <TextBlock Text="KEY 4" FontSize="10" FontWeight="SemiBold" Foreground="#E2A52C" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Border x:Name="PresCheckStats" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                                <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="PresCardWeather" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_OperatorTile_PresCardWeather_Click">
                                                        <Grid MinHeight="106">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="WX" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                                <TextBlock Text="WEATHER" FontSize="14" FontWeight="SemiBold" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Live forecast" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                                <TextBlock Text="KEY 5" FontSize="10" FontWeight="SemiBold" Foreground="#58BEEA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Border x:Name="PresCheckWeather" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                                <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="PresCardWindow" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_OperatorTile_PresCardWindow_Click">
                                                        <Grid MinHeight="106">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock x:Name="WindowToggleIcon" Text="OUT" FontSize="11" FontWeight="SemiBold" Foreground="#F472B6" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                                <TextBlock x:Name="WindowToggleTitle" Text="WINDOW" FontSize="14" FontWeight="SemiBold" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                                <Grid HorizontalAlignment="Center" Margin="0,5,0,0" Width="40" Height="20" Cursor="Hand">
                                                                    <Border x:Name="WindowToggleTrack" CornerRadius="10" Background="#21262D" BorderBrush="#7A8693" BorderThickness="1" />
                                                                    <Border x:Name="WindowToggleThumb" Width="16" Height="16" CornerRadius="8" Background="#6A6A80" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                                                        <Border.RenderTransform>
                                                                            <TranslateTransform X="0" port:ProductionNames.Id="WindowToggleThumbTranslate" />
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock x:Name="WindowToggleLabel" Text="Open" MinWidth="40" TextAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#A8B8C9" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="PresCardQuarterBreak" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_OperatorTile_PresCardQuarterBreak_Click">
                                                        <Grid MinHeight="106">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="BREAK" FontSize="11" FontWeight="SemiBold" Foreground="#F7D878" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                                <TextBlock Text="MATCH CARD" FontSize="14" FontWeight="SemiBold" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Teams + totals" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Border x:Name="PresCheckQuarterBreak" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                                <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="PresCardScreensaver" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_OperatorTile_PresCardScreensaver_Click">
                                                        <Grid MinHeight="106">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="IDLE" FontSize="11" FontWeight="SemiBold" Foreground="#67E8F9" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                                <TextBlock Text="SCREENSAVER" FontSize="13" FontWeight="SemiBold" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Venue standby" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Border x:Name="PresCheckScreensaver" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                                <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                </UniformGrid>
                                                <Border Height="1" Margin="0,6,0,14">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                            <GradientStop Color="#0058A6FF" Offset="0" />
                                                            <GradientStop Color="#3058A6FF" Offset="0.5" />
                                                            <GradientStop Color="#0058A6FF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                    <TextBlock Text="LIVE TRIGGERS" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2">

                                            </TextBlock>
                                                    <TextBlock Text="Manual actions always restore the scorebug and output before firing" FontSize="10" FontWeight="SemiBold" Foreground="#8DA397" />
                                                </StackPanel>
                                                <TextBlock Text="GAME ANALYSIS" FontSize="11" FontWeight="SemiBold" Foreground="#75D286" Margin="3,0,0,6" />
                                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayStatsBar_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="STATS BAR" FontSize="11" FontWeight="SemiBold" Foreground="#75D286" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayWinProb_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="🎯" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="WIN PROB" FontSize="11" FontWeight="SemiBold" Foreground="#75D286" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayLeadChanges_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="↕" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="LEAD CHANGES" FontSize="11" FontWeight="SemiBold" Foreground="#75D286" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayQtrScores_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="🏁" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="QTR SCORES" FontSize="11" FontWeight="SemiBold" Foreground="#75D286" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayRecentScores_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="RECENT SCORES" FontSize="11" FontWeight="SemiBold" Foreground="#75D286" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                </UniformGrid>
                                                <TextBlock Text="SCORING EVENTS" FontSize="11" FontWeight="SemiBold" Foreground="#E7B94F" Margin="3,0,0,6" />
                                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#14100A" BorderBrush="#3A2A10" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayScoringRun_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="🔥" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="SCORING RUN" FontSize="11" FontWeight="SemiBold" Foreground="#E7B94F" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#14100A" BorderBrush="#3A2A10" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayScoreless_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="⏱" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="LAST SCORE" FontSize="11" FontWeight="SemiBold" Foreground="#E7B94F" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#0A1428" BorderBrush="#1A2A44" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayHomeDrought_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="🏠" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="HOME DROUGHT" FontSize="11" FontWeight="SemiBold" Foreground="#9CCBFF" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#1A0A0A" BorderBrush="#3A1A1A" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayAwayDrought_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="✈" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="AWAY DROUGHT" FontSize="11" FontWeight="SemiBold" Foreground="#FFB5B5" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                </UniformGrid>
                                                <TextBlock Text="DISPLAY" FontSize="11" FontWeight="SemiBold" Foreground="#78B7FF" Margin="3,0,0,6" />
                                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#1A1408" BorderBrush="#C9B070" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayWarning_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="5 MIN WARN" FontSize="11" FontWeight="SemiBold" Foreground="#E7B94F" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                </UniformGrid>
                                                <TextBlock Text="WEATHER &amp; CONDITIONS" FontSize="11" FontWeight="SemiBold" Foreground="#86C8F5" Margin="3,0,0,6" />
                                                <UniformGrid Columns="4" Margin="0,0,0,4">
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#06101C" BorderBrush="#14284A" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayWeatherForecast_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="☀" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="FORECAST" FontSize="11" FontWeight="SemiBold" Foreground="#86C8F5" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#06101C" BorderBrush="#14284A" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayWeatherStats_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="🌡" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="WEATHER" FontSize="11" FontWeight="SemiBold" Foreground="#86C8F5" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder Cursor="Hand" Background="#06101C" BorderBrush="#14284A" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OperatorTile_OverlayRainForecast_Click">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                            <TextBlock Text="🌧" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                            <TextBlock Text="RAIN" FontSize="11" FontWeight="SemiBold" Foreground="#86C8F5" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </ns5:OperatorActionBorder>
                                                </UniformGrid>
                                                <Button x:Name="CancelOverlayButton" Content="CANCEL CURRENT OVERLAY" Height="42" Margin="4,14,4,8" Cursor="Hand" FontSize="11" FontWeight="SemiBold" Foreground="#FFD8D8" Background="#241014" BorderBrush="#A83D4C" BorderThickness="1" Click="CancelCurrentOverlay_Click" Theme="{StaticResource ToolBtn}" />
                                            </StackPanel>
                                        </ScrollViewer>
                                        <Border Grid.Column="2" Background="#09090B" BorderBrush="#1A2A40" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Grid Margin="16,14">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                                        <TextBlock Text="ON-AIR TICKER" FontSize="17" FontWeight="SemiBold" Foreground="#67D17B" />
                                                        <TextBlock Text="Type a saved message, then switch it on. Multiple messages rotate automatically." FontSize="11" FontWeight="SemiBold" Foreground="#9ABDA2" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Content="WELCOME" Tag="Welcome to today's match" Click="TickerTemplate_Click" FontSize="9" FontWeight="SemiBold" Padding="8,3" Margin="0,0,5,0" Theme="{StaticResource ToolBtn}" />
                                                            <Button Content="QUARTER BREAK" Tag="Quarter break — play resumes shortly" Click="TickerTemplate_Click" FontSize="9" FontWeight="SemiBold" Padding="8,3" Margin="0,0,5,0" Theme="{StaticResource ToolBtn}" />
                                                            <Button Content="THANK YOU" Tag="Thank you for joining us today" Click="TickerTemplate_Click" FontSize="9" FontWeight="SemiBold" Padding="8,3" Theme="{StaticResource ToolBtn}" />
                                                        </WrapPanel>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Border Background="#0C2112" BorderBrush="#245C31" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,8,0">
                                                                <TextBlock x:Name="TickerMessageCountText" Text="0 ON AIR" FontSize="10" FontWeight="SemiBold" Foreground="#75E18A" />
                                                            </Border>
                                                            <Button x:Name="TickerDisableAllButton" Content="TURN ALL OFF" FontSize="9" FontWeight="SemiBold" Padding="9,3" IsEnabled="False" Margin="0,0,5,0" Click="DisableAllTickerMessages_Click" BorderBrush="#4A5870" Foreground="#DCE5EF" Theme="{StaticResource ToolBtn}" />
                                                            <Button x:Name="TickerUndoDeleteButton" Content="UNDO DELETE" FontSize="9" FontWeight="SemiBold" Padding="9,3" Margin="0,0,5,0" Click="UndoTickerDelete_Click" BorderBrush="#3A6A52" Foreground="#9FE6B7" IsVisible="False" Theme="{StaticResource ToolBtn}" />
                                                            <Button x:Name="TickerClearAllButton" Content="DELETE SAVED" FontSize="9" FontWeight="SemiBold" Padding="9,3" IsEnabled="False" Click="ClearTickerMessages_Click" BorderBrush="#6B3030" Foreground="#FF9999" Theme="{StaticResource ToolBtn}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <Border Grid.Row="1" Height="1" Margin="0,0,0,10">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="#003FB950" Offset="0" />
                                                                <GradientStop Color="#303FB950" Offset="0.5" />
                                                                <GradientStop Color="#003FB950" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border Grid.Row="2" Background="#060A10" BorderBrush="#1A2A3A" BorderThickness="1" Padding="6">
                                                        <Grid>
                                                            <StackPanel x:Name="TickerEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300">
                                                                <TextBlock Text="✦" FontSize="30" Foreground="#3FB950" HorizontalAlignment="Center" />
                                                                <TextBlock Text="NO MESSAGES ON AIR" FontSize="15" FontWeight="SemiBold" Foreground="#DCE7E0" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                                                <TextBlock Text="Choose a quick template or type a short update below. Press Enter to add it instantly." FontSize="12" FontWeight="SemiBold" Foreground="#8FA99A" TextAlignment="Center" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto" ZIndex="1">
                                                                <ItemsControl x:Name="MessageList">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="0,0,0,6" Padding="8,7" Background="#0A1018" BorderBrush="#1E3050" BorderThickness="1" CornerRadius="6">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,10,0" IsCheckedChanged="Native_TickerSlotEnabled_Changed" Theme="{StaticResource TickerSlotToggle}" ToolTip.Tip="Show or hide this message on the public display" />
                                                                                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" Background="#060A10" Foreground="#E6EDF3" BorderBrush="#1E3050" CaretBrush="White" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,6,0" MaxLength="140" TextChanged="Native_MessageItem_TextChanged" />
                                                                                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                                        <Button MinHeight="0" Width="32" Height="30" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Click="PickItemTextColor_Click" Tag="{Binding}" Background="{Binding TextBrush}" ToolTip.Tip="Text colour" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="3" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                        <Button MinHeight="0" Width="42" Height="30" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Click="PickItemHighlightColor_Click" Tag="{Binding}" Background="{Binding HighlightBrush}" ToolTip.Tip="Highlight colour · right-click to remove" PointerReleased="Native_ClearItemHighlightColor_Click" />
                                                                                    </StackPanel>
                                                                                    <Button Padding="0" MinHeight="0" Grid.Column="4" Content="×" Width="34" Height="34" FontSize="16" FontWeight="SemiBold" Click="RemoveMessageItem_Click" Tag="{Binding}" BorderBrush="#3A1A1A" VerticalAlignment="Center" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Clear this preset slot" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Row="3" Margin="0" IsVisible="False">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                            <TextBlock Text="QUICK ADD" FontSize="11" FontWeight="SemiBold" Foreground="#A8BBAE" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <Button Content="WELCOME" Tag="Welcome to today's match" Click="TickerTemplate_Click" FontSize="10" FontWeight="SemiBold" Padding="8,3" Margin="0,0,5,0" Theme="{StaticResource ToolBtn}" />
                                                            <Button Content="QUARTER BREAK" Tag="Quarter break — play resumes shortly" Click="TickerTemplate_Click" FontSize="10" FontWeight="SemiBold" Padding="8,3" Margin="0,0,5,0" Theme="{StaticResource ToolBtn}" />
                                                            <Button Content="THANK YOU" Tag="Thank you for joining us today" Click="TickerTemplate_Click" FontSize="10" FontWeight="SemiBold" Padding="8,3" Theme="{StaticResource ToolBtn}" />
                                                        </StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="NewMessageBox" FontSize="13" MaxLength="140" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" CaretBrush="White" Padding="10,7" VerticalContentAlignment="Center" Margin="0,0,6,0" KeyDown="NewMessageBox_KeyDown" TextChanged="Native_NewMessageBox_TextChanged" ToolTip.Tip="Ticker message — maximum 140 characters" />
                                                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="TEXT" FontSize="10" FontWeight="Bold" Foreground="#A9BDD2" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                <Button MinHeight="0" x:Name="NewMessageTextColorBtn" Width="40" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Background="White" Click="PickNewTextColor_Click" ToolTip.Tip="Click to choose text colour for the new message" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="HIGHLIGHT" FontSize="10" FontWeight="Bold" Foreground="#A9BDD2" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                <Button MinHeight="0" x:Name="NewMessageHighlightColorBtn" Width="56" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Background="Transparent" Click="PickNewHighlightColor_Click" PointerReleased="Native_ClearNewHighlightColor_Click" ToolTip.Tip="Click to choose highlight colour. Right-click to clear (no highlight)." />
                                                            </StackPanel>
                                                            <Button Padding="0" MinHeight="0" Grid.Column="3" Content="+" Width="34" Height="40" FontSize="14" FontWeight="SemiBold" Click="AddMessage_Click" BorderBrush="#1A3A24" VerticalAlignment="Bottom" Theme="{StaticResource ToolBtn}" />
                                                        </Grid>
                                                        <TextBlock x:Name="TickerCharacterCountText" Text="0 / 140 · ENTER TO ADD" FontSize="10" FontWeight="SemiBold" Foreground="#738497" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="MediaDeskTab" Header="3  MEDIA" Tag="VIDEO &amp; TICKER" ToolTip.Tip="Video playback and ticker messages · Ctrl+3">
                        <ScrollViewer x:Name="AflMediaPageViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="#09090B" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid x:Name="AflMediaColumns" Margin="16,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                            <TextBlock Text="VIDEO PLAYBACK" FontSize="18" FontWeight="SemiBold" Foreground="#58A6FF">

                                    </TextBlock>
                                            <TextBlock Text="Upload, preview and broadcast custom video clips to the scoreboard window." TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="#A9CCF2" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border x:Name="AflMediaControlsCard" CornerRadius="22" Grid.Row="1" Grid.Column="0" Background="#19191C" BorderBrush="#303035" BorderThickness="1" Padding="18">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="MEDIA · CONTROL CENTRE" Foreground="#78B7FF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                    <Border Background="#09090B" BorderBrush="#6F86A8" BorderThickness="1" Padding="14" Margin="0,0,0,18">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="VideoTabFilePathText" Text="No file selected" Foreground="#9CC4F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                <Button MinHeight="0" Grid.Column="1" Content="📁 Browse" Width="120" Height="30" Click="VideoTabBrowse_Click" Margin="10,0,0,0" BorderBrush="#6F86A8" FontWeight="Bold" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Pick a video or image file. It is auto-loaded into the scoreboard player." />
                                                            </Grid>
                                                            <TextBlock x:Name="VideoTabFileMetaText" Text="Supported: mp4, mov, mkv, webm, avi, wmv, m4v, ts, mpg, mpeg, 3gp, flv, png, jpg, jpeg, bmp, gif, tif, tiff, webp and other Windows-supported formats." Foreground="#8FB8E8" FontSize="11" Margin="0,8,0,12" TextWrapping="Wrap" />
                                                            <Button MinHeight="0" x:Name="VideoTabShowOnScoreboardButton" Content="🖥  Show on Scoreboard" Height="38" FontSize="13" FontWeight="SemiBold" Click="VideoTabShowOnScoreboard_Click" IsEnabled="False" BorderBrush="#6F86A8" Margin="0,0,0,8" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Take over the scoreboard output with this video." />
                                                            <Button MinHeight="0" x:Name="VideoTabPlayPauseButton" Content="▶  Play" Height="40" FontSize="13" FontWeight="SemiBold" Click="VideoTabPlayPause_Click" IsEnabled="False" BorderBrush="#1F7A3F" Background="#0E2A18" Foreground="#7FE0A0" Theme="{StaticResource ToolBtn}" />
                                                            <Button MinHeight="0" x:Name="VideoTabRestartButton" Content="⟲  Restart" Height="30" FontSize="11" FontWeight="Bold" Click="VideoTabRestart_Click" Margin="0,8,0,0" IsEnabled="False" BorderBrush="#6F86A8" Theme="{StaticResource ToolBtn}" />
                                                            <Button MinHeight="0" x:Name="VideoTabUnloadButton" Content="✕  Unload Video" Height="30" FontSize="11" FontWeight="Bold" Click="VideoTabUnload_Click" Margin="0,8,0,0" IsEnabled="False" BorderBrush="#5A2A2A" Background="#2A1212" Foreground="#E08080" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Stop playback, clear the current video, and return the scoreboard to its previous screen." />
                                                            <TextBlock x:Name="VideoTabStatusText" Text="No video loaded." Foreground="#7FE0A0" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Button x:Name="VideoTabApplyButton" Click="VideoTabApply_Click" IsEnabled="False" IsVisible="False" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                        <Border x:Name="AflMediaPreviewCard" CornerRadius="22" Grid.Row="1" Grid.Column="2" Background="#000000" BorderBrush="#303035" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Rectangle x:Name="VideoTabLiveMirror" Stretch="Uniform" />
                                                    <Grid x:Name="VideoTabPreviewPlaceholder">
                                                        <Border Background="#19191C" />
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="🎬" FontSize="56" HorizontalAlignment="Center" Foreground="#6F86A8" />
                                                            <TextBlock Text="PREVIEW" FontSize="14" FontWeight="SemiBold" Foreground="#8FB8E8" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                            <TextBlock Text="Open the scoreboard window to see a live mirror here." FontSize="12" Foreground="#A9CCF2" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#A0000000" Padding="8,4" Margin="8">
                                                        <StackPanel>
                                                            <TextBlock x:Name="VideoTabPreviewBadge" Text="LIVE · MIRRORING SCOREBOARD" Foreground="#78B7FF" FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="VideoTabTelemetryText" Text="" Foreground="#7FE0A0" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="VideoTabDiagnosticText" Text="" Foreground="#E8D08A" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="320" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Border Grid.Row="1" Background="#09090B" BorderBrush="#303035" BorderThickness="0,1,0,0" Padding="12,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="VideoTabCurrentTimeText" Grid.Column="0" Text="0:00" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="42" FontFeatures="tnum,lnum,-kern" />
                                                            <Slider x:Name="VideoTabSeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" SmallChange="1" LargeChange="5" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="#FF0000" Background="#2A2A40" Thumb.DragStarted="VideoTabSeek_DragStarted" Thumb.DragCompleted="VideoTabSeek_DragCompleted" ValueChanged="VideoTabSeek_ValueChanged" PointerReleased="Native_VideoTabSeek_PreviewMouseLeftButtonUp" />
                                                            <TextBlock x:Name="VideoTabDurationText" Grid.Column="2" Text="0:00" Foreground="#8B97A8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right" />
                                                        </Grid>
                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="SPEED" Foreground="#B8D7F6" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <ComboBox x:Name="VideoTabSpeedCombo" Padding="8,4" Width="112" Height="26" Background="#19191C" BorderBrush="#6F86A8" Foreground="#E6EDF3" SelectionChanged="Native_VideoTabSpeed_Changed">
                                                                    <ComboBoxItem Content="0.25x" Tag="0.25" />
                                                                    <ComboBoxItem Content="0.5x" Tag="0.5" />
                                                                    <ComboBoxItem Content="0.75x" Tag="0.75" />
                                                                    <ComboBoxItem Content="Normal" Tag="1.0" IsSelected="True" />
                                                                    <ComboBoxItem Content="1.25x" Tag="1.25" />
                                                                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                                                                    <ComboBoxItem Content="1.75x" Tag="1.75" />
                                                                    <ComboBoxItem Content="2x" Tag="2.0" />
                                                                </ComboBox>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" />
                                                            <Button Padding="0" MinHeight="0" x:Name="VideoTabMuteButton" Grid.Column="2" Width="44" Height="44" Click="VideoTabMute_Click" BorderBrush="#6F86A8" AutomationProperties.Name="Mute scoreboard audio" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Mute scoreboard audio">
                                                                <ns2:OperatorSymbol x:Name="VideoTabAudioSymbol" Kind="audio" Width="24" Height="24" Foreground="{DynamicResource ControlCentre.TextBrush}" />
                                                            </Button>
                                                            <Slider x:Name="VideoTabVolumeSlider" Grid.Column="3" Minimum="0" Maximum="1" Value="1" Width="100" Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="VideoTabVolume_Changed" ToolTip.Tip="Scoreboard volume" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="MatchSetupTab" Header="4  SETUP" Tag="TEAMS &amp; OPTIONS" ToolTip.Tip="Teams, match options and app settings · Ctrl+4">
                        <ScrollViewer x:Name="AflSettingsPageViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Background="#09090B" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Border IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#00000000" Offset="0.3" />
                                                <GradientStop Color="#30000000" Offset="1.0" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <RadioButton x:Name="ClockModeCountUp" IsChecked="True" GroupName="ClockMode" IsCheckedChanged="Native_ClockMode_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="ClockModeCountdown" GroupName="ClockMode" IsCheckedChanged="Native_ClockMode_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="LayoutClassicRadio" GroupName="LayoutChoice" IsChecked="True" IsCheckedChanged="Native_LayoutRadio_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="LayoutExpandedRadio" GroupName="LayoutChoice" IsCheckedChanged="Native_LayoutRadio_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="LayoutRetroRadio" GroupName="LayoutChoice" IsCheckedChanged="Native_LayoutRadio_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="LayoutNoLogosRadio" GroupName="LayoutChoice" IsCheckedChanged="Native_LayoutRadio_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="AnimBroadcastRadio" GroupName="AnimChoice" IsChecked="True" IsCheckedChanged="Native_AnimationRadio_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="AnimElectricRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="AnimCinematicRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="AnimCleanRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="AnimClassicRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed_Checked" IsVisible="False" />
                                    <RadioButton x:Name="AnimCustomVideoRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed_Checked" IsVisible="False" />
                                    <TextBlock x:Name="HomeLogoPathText" IsVisible="False" />
                                    <TextBlock x:Name="AwayLogoPathText" IsVisible="False" />
                                    <Grid x:Name="AflSettingsColumns">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="238" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="AflSettingsCompactBar" Grid.Row="0" Grid.ColumnSpan="2" Margin="14,12" IsVisible="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="AflSettingsCompactChoice" Click="AflSettingsCategories_Click" Height="44" MinHeight="0" Padding="12,8" HorizontalContentAlignment="Stretch" Theme="{StaticResource ToolBtn}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="⌄" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="AflSettingsCompactCaption" Text="Match" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                            <Grid x:Name="AflSettingsCompactSearch" Grid.Column="1" Margin="8,0,0,0" />
                                        </Grid>
                                        <ns5:OperatorGlassSurface Material="Regular" x:Name="AflSettingsRail" Grid.Column="0" CornerRadius="22" Margin="12,12,8,12" Padding="16" Background="#19191C" BorderBrush="#303035" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="SettingsHeaderTitle" TextWrapping="Wrap" Text="LIVE MATCH SETTINGS" Foreground="#F2F6FC" FontSize="18" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SettingsHeaderSubtitle" Text="AFL match, controls and output" Foreground="#B6B6C0" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <WrapPanel x:Name="AflSettingsCategoryList" Orientation="Vertical" Grid.Row="2" VerticalAlignment="Top" Margin="0,14,0,0">
                                                    <ns5:OperatorActionBorder x:Name="SettingsNavBtn_Teams" CornerRadius="14" Padding="12,10" Margin="0,0,6,6" Cursor="Hand" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" PointerReleased="Native_OperatorTile_SettingsNav_Teams_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="8" Background="#2AA9B0" HorizontalAlignment="Left">
                                                                <ns2:OperatorSymbol Kind="match" Width="19" Height="19" Foreground="#101418" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="Match" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="SettingsNavBtn_Keybinds" CornerRadius="14" Padding="12,10" Margin="0,0,6,6" Cursor="Hand" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" PointerReleased="Native_OperatorTile_SettingsNav_Keybinds_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="8" Background="#35AE7A" HorizontalAlignment="Left">
                                                                <ns2:OperatorSymbol Kind="settings" Width="19" Height="19" Foreground="#101418" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="Interaction" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="SettingsNavBtn_Display" CornerRadius="14" Padding="12,10" Margin="0,0,6,6" Cursor="Hand" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" PointerReleased="Native_OperatorTile_SettingsNav_Display_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="8" Background="#ED8A2C" HorizontalAlignment="Left">
                                                                <ns2:OperatorSymbol Kind="output" Width="19" Height="19" Foreground="#101418" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="Scoreboard" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="SettingsNavBtn_Overlays" CornerRadius="14" Padding="12,10" Margin="0,0,6,6" Cursor="Hand" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" PointerReleased="Native_OperatorTile_SettingsNav_Overlays_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="8" Background="#9D65E9" HorizontalAlignment="Left">
                                                                <ns2:OperatorSymbol Kind="settings" Width="19" Height="19" Foreground="White" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="Automation" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="SettingsNavBtn_Media" CornerRadius="14" Padding="12,10" Margin="0,0,6,6" Cursor="Hand" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" PointerReleased="Native_OperatorTile_SettingsNav_Media_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="8" Background="#3582EF" HorizontalAlignment="Left">
                                                                <ns2:OperatorSymbol Kind="media" Width="19" Height="19" Foreground="White" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="Assets" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                    <ns5:OperatorActionBorder x:Name="SettingsNavBtn_Advanced" CornerRadius="14" Padding="12,10" Margin="0" Cursor="Hand" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" PointerReleased="Native_OperatorTile_SettingsNav_Advanced_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="8" Background="#738296" HorizontalAlignment="Left">
                                                                <ns2:OperatorSymbol Kind="settings" Width="19" Height="19" Foreground="White" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="Application" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ns5:OperatorActionBorder>
                                                </WrapPanel>
                                                <Border x:Name="SettingsSearchHost" Grid.Row="1" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="#52647A" BorderThickness="1" CornerRadius="20" Height="44" Padding="8,0" Margin="0,12,0,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox x:Name="SettingsSearchBox" MinHeight="0" Height="42" Padding="4,7" Grid.Column="1" Background="Transparent" Foreground="#E6EDF3" CaretBrush="#58A6FF" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center" TextChanged="Native_SettingsSearch_TextChanged" ToolTip.Tip="Search all settings (Ctrl+F)" />
                                                        <TextBlock x:Name="SettingsSearchPlaceholder" Grid.Column="1" Text="Search settings…" FontSize="11" Foreground="#A8B0BA" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,0,0" />
                                                        <ns5:OperatorActionBorder x:Name="SettingsSearchClear" Grid.Column="2" Padding="4,0,0,0" Cursor="Hand" IsVisible="False" PointerReleased="Native_OperatorTile_SettingsSearchClear_Click">
                                                            <TextBlock Text="✕" FontSize="11" Foreground="#8B949E" />
                                                        </ns5:OperatorActionBorder>
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="SettingsEssentialsHint" Grid.Row="3" Text="Specialist controls are hidden. Use Advanced Tools when you need automation, media or system settings." Foreground="#8FB8A0" FontSize="9" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,12,2,0" IsVisible="False" />
                                            </Grid>
                                        </ns5:OperatorGlassSurface>
                                        <Border x:Name="SettingsNoResults" Grid.Column="1" Background="Transparent" IsVisible="False">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Foreground="#7A8693" Margin="0,40,0,8" />
                                                <TextBlock x:Name="SettingsNoResultsText" Text="No settings match your search" FontSize="13" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" />
                                                <TextBlock Text="Try a different keyword or clear the filter" FontSize="10" Foreground="#A8B0BA" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" Margin="14,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel HorizontalAlignment="Stretch">
                                                <Border x:Name="SettingsSection_Teams" Tag="teams team home away name abbreviation colour color logo primary secondary jumper" Theme="{StaticResource SettingsSectionSurface}">
                                                    <StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <TextBlock Text="TEAMS" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,0,0,2">

                                                </TextBlock>
                                                            <TextBlock Text="Edit team names, abbreviations, colours, and logos" FontSize="9" FontWeight="SemiBold" Foreground="#8FB8E8" />
                                                        </StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1,2,1,1" Padding="14,10">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <Border Background="#1A3A6A" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                                            <TextBlock Text="HOME TEAM" Foreground="#7EB4FF" FontSize="10" FontWeight="SemiBold" />
                                                                        </Border>
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="8" />
                                                                                <ColumnDefinition Width="70" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBox x:Name="HomeNameBox" Text="Home Team" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="10,7" VerticalContentAlignment="Center" TextChanged="Native_TeamSettings_TextChanged" />
                                                                            <TextBox x:Name="HomeAbbrBox" Grid.Column="2" Text="HOM" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="6,7" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="4" TextChanged="Native_TeamSettings_TextChanged" />
                                                                        </Grid>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBox x:Name="HomeColorBox" Width="66" Text="#0A2A6A" FontSize="10" VerticalContentAlignment="Center" Margin="0,0,3,0" IsVisible="False" />
                                                                            <ns5:OperatorActionBorder x:Name="HomeColorPreview" Width="30" Height="28" Background="#0A2A6A" AutomationProperties.Name="Choose home primary colour" Cursor="Hand" Theme="{StaticResource TeamColourSwatch}" ToolTip.Tip="Choose home primary colour" PointerReleased="Native_PickHomeColor_Click" />
                                                                            <ns5:OperatorActionBorder Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_OperatorTile_DropperHomeColor_Click">
                                                                                <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </ns5:OperatorActionBorder>
                                                                            <TextBox x:Name="HomeSecondaryColorBox" Width="66" Text="#FFFFFF" FontSize="10" VerticalContentAlignment="Center" IsVisible="False" />
                                                                            <ns5:OperatorActionBorder x:Name="HomeSecondaryColorPreview" Width="30" Height="28" Background="#FFFFFF" AutomationProperties.Name="Choose home secondary colour" Cursor="Hand" Margin="8,0,0,0" Theme="{StaticResource TeamColourSwatch}" ToolTip.Tip="Choose home secondary colour" PointerReleased="Native_PickHomeSecondaryColor_Click" />
                                                                            <ns5:OperatorActionBorder Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_OperatorTile_DropperHomeSecondaryColor_Click">
                                                                                <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </ns5:OperatorActionBorder>
                                                                            <TextBlock Text="Primary" Foreground="#7DA0CA" FontSize="8" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                            <TextBlock Text="/ Text" Foreground="#7DA0CA" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                            <Button MinHeight="0" Content="📂 Logo" Height="26" FontSize="10" FontWeight="Bold" Click="BrowseHomeLogo_Click" BorderBrush="#1A3A6A" Padding="8,0" Theme="{StaticResource ToolBtn}" />
                                                                            <Button Padding="0" MinHeight="0" Content="✕" Width="26" Height="26" FontSize="10" FontWeight="Bold" Click="ClearHomeLogo_Click" BorderBrush="#3A2020" Margin="4,0,0,0" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Remove logo" />
                                                                            <TextBlock x:Name="HomeLogoStatusText" Text="" Foreground="#7DA0CA" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Column="2" Background="#1A0A0A" BorderBrush="#6A1A1A" BorderThickness="1,2,1,1" Padding="14,10">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <Border Background="#4A1A1A" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                                            <TextBlock Text="AWAY TEAM" Foreground="#FF9A9A" FontSize="10" FontWeight="SemiBold" />
                                                                        </Border>
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="8" />
                                                                                <ColumnDefinition Width="70" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBox x:Name="AwayNameBox" Text="Away Team" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="10,7" VerticalContentAlignment="Center" TextChanged="Native_TeamSettings_TextChanged" />
                                                                            <TextBox x:Name="AwayAbbrBox" Grid.Column="2" Text="AWA" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="6,7" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="4" TextChanged="Native_TeamSettings_TextChanged" />
                                                                        </Grid>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBox x:Name="AwayColorBox" Width="66" Text="#7A1A1A" FontSize="10" VerticalContentAlignment="Center" Margin="0,0,3,0" IsVisible="False" />
                                                                            <ns5:OperatorActionBorder x:Name="AwayColorPreview" Width="30" Height="28" Background="#7A1A1A" AutomationProperties.Name="Choose away primary colour" Cursor="Hand" Theme="{StaticResource TeamColourSwatch}" ToolTip.Tip="Choose away primary colour" PointerReleased="Native_PickAwayColor_Click" />
                                                                            <ns5:OperatorActionBorder Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_OperatorTile_DropperAwayColor_Click">
                                                                                <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </ns5:OperatorActionBorder>
                                                                            <TextBox x:Name="AwaySecondaryColorBox" Width="66" Text="#FFFFFF" FontSize="10" VerticalContentAlignment="Center" IsVisible="False" />
                                                                            <ns5:OperatorActionBorder x:Name="AwaySecondaryColorPreview" Width="30" Height="28" Background="#FFFFFF" AutomationProperties.Name="Choose away secondary colour" Cursor="Hand" Margin="8,0,0,0" Theme="{StaticResource TeamColourSwatch}" ToolTip.Tip="Choose away secondary colour" PointerReleased="Native_PickAwaySecondaryColor_Click" />
                                                                            <ns5:OperatorActionBorder Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_OperatorTile_DropperAwaySecondaryColor_Click">
                                                                                <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </ns5:OperatorActionBorder>
                                                                            <TextBlock Text="Primary" Foreground="#523030" FontSize="8" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                            <TextBlock Text="/ Text" Foreground="#523030" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                            <Button MinHeight="0" Content="📂 Logo" Height="26" FontSize="10" FontWeight="Bold" Click="BrowseAwayLogo_Click" BorderBrush="#4A1A1A" Padding="8,0" Theme="{StaticResource ToolBtn}" />
                                                                            <Button Padding="0" MinHeight="0" Content="✕" Width="26" Height="26" FontSize="10" FontWeight="Bold" Click="ClearAwayLogo_Click" BorderBrush="#3A2020" Margin="4,0,0,0" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Remove logo" />
                                                                            <TextBlock x:Name="AwayLogoStatusText" Text="" Foreground="#523030" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="SettingsSection_Match" Tag="match clock countdown count up quarter duration minutes seconds finals timer time siren adjust set quarter labels custom break ht qt ft override" Theme="{StaticResource SettingsSectionSurface}">
                                                    <StackPanel>
                                                        <Border Height="1" Margin="0,0,0,14">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                    <GradientStop Color="#00D29922" Offset="0" />
                                                                    <GradientStop Color="#30D29922" Offset="0.5" />
                                                                    <GradientStop Color="#00D29922" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <TextBlock Text="MATCH" FontSize="14" FontWeight="SemiBold" Foreground="#D29922" Margin="0,0,0,2">

                                                </TextBlock>
                                                            <TextBlock Text="Choose the scoreboard clock. Stoppage time is a separate operator tool." FontSize="9" FontWeight="SemiBold" Foreground="#C9A74A" />
                                                        </StackPanel>
                                                        <Grid Margin="0,0,0,8" Height="100">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border x:Name="SettingsCountUpCard" Grid.Column="0" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="2">
                                                                <Border.Resources>
                                                                    <ResourceDictionary>
                                                                        <ResourceDictionary.MergedDictionaries>
                                                                            <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/SettingsControls.axaml" />
                                                                        </ResourceDictionary.MergedDictionaries>
                                                                    </ResourceDictionary>
                                                                </Border.Resources>
                                                                <Grid>
                                                                    <Border x:Name="SettingsCountUpGlow" Opacity="0.12" IsHitTestVisible="False">
                                                                        <Border.Background>
                                                                            <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                                <GradientStop Color="#58A6FF" Offset="0" />
                                                                                <GradientStop Color="#00000000" Offset="1" />
                                                                            </RadialGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="▲" FontSize="26" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center">

                                                            </TextBlock>
                                                                        <TextBlock Text="COUNT UP" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <Border x:Name="SettingsCountUpCheck" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="6,3">
                                                                        <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <Border x:Name="SettingsCountdownCard" Grid.Column="2" Background="#0E0C08" BorderBrush="#C9B070" BorderThickness="1">
                                                                <Border.Resources>
                                                                    <ResourceDictionary>
                                                                        <ResourceDictionary.MergedDictionaries>
                                                                            <ResourceInclude Source="avares://RocheScoreboard.Mac/Native/Generated/Resources/SettingsControls.axaml" />
                                                                        </ResourceDictionary.MergedDictionaries>
                                                                    </ResourceDictionary>
                                                                </Border.Resources>
                                                                <Grid>
                                                                    <Border x:Name="SettingsCountdownGlow" Opacity="0" IsHitTestVisible="False">
                                                                        <Border.Background>
                                                                            <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                                <GradientStop Color="#D29922" Offset="0" />
                                                                                <GradientStop Color="#00000000" Offset="1" />
                                                                            </RadialGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="▼" FontSize="26" FontWeight="SemiBold" Foreground="#6B5A00" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="COUNTDOWN" FontSize="14" FontWeight="SemiBold" Foreground="#8A7A50" HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <Border x:Name="SettingsCountdownCheck" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="6,3" IsVisible="False">
                                                                        <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="#1A1400" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                        <Border x:Name="SettingsControlPanelCountdownOptionCard" Margin="0,0,0,8" Padding="0" Background="Transparent" Focusable="False" Opacity="1" RenderTransformOrigin="50%,0%" IsVisible="False">
                                                            <Border.RenderTransform>
                                                                <TransformGroup>
                                                                    <TranslateTransform port:ProductionNames.Id="SettingsControlPanelCountdownCardTranslate" />
                                                                    <ScaleTransform port:ProductionNames.Id="SettingsControlPanelCountdownCardScale" />
                                                                </TransformGroup>
                                                            </Border.RenderTransform>
                                                            <CheckBox x:Name="SettingsShowControlPanelCountdown" IsChecked="True" AutomationProperties.Name="Show stoppage clock in Match tab" AutomationProperties.HelpText="Local countdown for count-up games. At zero, it pauses the match clock." Theme="{StaticResource ControlCentre.StoppageToggle}" IsCheckedChanged="Native_SettingsShowControlPanelCountdown_Changed" />
                                                        </Border>
                                                        <StackPanel x:Name="QuarterDurationPanel" Margin="0,0,0,8" IsVisible="False">
                                                            <Border Background="#0C0A04" BorderBrush="#C9B070" BorderThickness="1" Padding="14,14,14,6">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="SCOREBOARD COUNTDOWN START" FontSize="9" FontWeight="SemiBold" Foreground="#8A7A40" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <ns5:OperatorActionBorder Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" PointerReleased="Native_OperatorTile_SettingsMinutesMinus_Click">
                                                                            <TextBlock Text="−" FontSize="18" FontWeight="SemiBold" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </ns5:OperatorActionBorder>
                                                                        <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" MinWidth="56" Height="52" Padding="0" Margin="6,0">
                                                                            <TextBox x:Name="QuarterMinutesBox" Text="20" FontSize="30" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="3" KeyDown="QuarterDurationBox_KeyDown" AutomationProperties.Name="Quarter duration minutes">
                                                                                <TextBox.Effect>
                                                                                    <DropShadowEffect BlurRadius="10" Color="#D29922" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                                                </TextBox.Effect>
                                                                            </TextBox>
                                                                        </Border>
                                                                        <ns5:OperatorActionBorder Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" PointerReleased="Native_OperatorTile_SettingsMinutesPlus_Click">
                                                                            <TextBlock Text="+" FontSize="18" FontWeight="SemiBold" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </ns5:OperatorActionBorder>
                                                                        <TextBlock Text=":" FontSize="30" FontWeight="SemiBold" Foreground="#6B5A00" VerticalAlignment="Center" Margin="8,0" />
                                                                        <ns5:OperatorActionBorder Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" PointerReleased="Native_OperatorTile_SettingsSecondsMinus_Click">
                                                                            <TextBlock Text="−" FontSize="18" FontWeight="SemiBold" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </ns5:OperatorActionBorder>
                                                                        <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" MinWidth="56" Height="52" Padding="0" Margin="6,0">
                                                                            <TextBox x:Name="QuarterSecondsBox" Text="00" FontSize="30" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="2" KeyDown="QuarterDurationBox_KeyDown" AutomationProperties.Name="Quarter duration seconds">
                                                                                <TextBox.Effect>
                                                                                    <DropShadowEffect BlurRadius="10" Color="#D29922" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                                                </TextBox.Effect>
                                                                            </TextBox>
                                                                        </Border>
                                                                        <ns5:OperatorActionBorder Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" PointerReleased="Native_OperatorTile_SettingsSecondsPlus_Click">
                                                                            <TextBlock Text="+" FontSize="18" FontWeight="SemiBold" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </ns5:OperatorActionBorder>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                                        <TextBlock Text="MINUTES" FontSize="8" FontWeight="SemiBold" Foreground="#6B5A00" Width="128" TextAlignment="Center" />
                                                                        <TextBlock Text="SECONDS" FontSize="8" FontWeight="SemiBold" Foreground="#6B5A00" Width="128" TextAlignment="Center" Margin="16,0,0,0" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock x:Name="QuarterDurationError" MaxWidth="340" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" IsVisible="False" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="ClockStatusText" Text="Count Up · Stopped · 00:00" Foreground="#D29922" FontSize="10" Margin="0,0,0,8" />
                                                        <Border Height="0" Margin="0" Opacity="0" IsHitTestVisible="False" IsVisible="False" />
                                                        <Expander Header="CORRECT SCOREBOARD CLOCK" Theme="{StaticResource SettingsExpander}">
                                                            <Border Background="#0C0A04" BorderBrush="#C9B070" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="LIVE SCOREBOARD CLOCK" FontSize="9" FontWeight="SemiBold" Foreground="#8A7A40" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                                    <TextBlock Text="Only changes the quarter clock shown on the scoreboard. Edit stoppage time from STOPPAGE CLOCK in the Match tab." FontSize="9" Foreground="#A68F56" TextWrapping="Wrap" TextAlignment="Center" Margin="4,0,4,8" />
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <Button Padding="0" MinHeight="0" Content="−10s" Width="46" Height="28" FontSize="10" FontWeight="Bold" Click="ClockMinus10_Click" BorderBrush="#C9B070" Margin="0,0,4,0" Theme="{StaticResource ToolBtn}" />
                                                                        <Button Padding="0" MinHeight="0" Content="−1s" Width="40" Height="28" FontSize="10" FontWeight="Bold" Click="ClockMinus1_Click" BorderBrush="#C9B070" Margin="0,0,8,0" Theme="{StaticResource ToolBtn}" />
                                                                        <Button Padding="0" MinHeight="0" Content="+1s" Width="40" Height="28" FontSize="10" FontWeight="Bold" Click="ClockPlus1_Click" BorderBrush="#C9B070" Margin="0,0,4,0" Theme="{StaticResource ToolBtn}" />
                                                                        <Button Padding="0" MinHeight="0" Content="+10s" Width="46" Height="28" FontSize="10" FontWeight="Bold" Click="ClockPlus10_Click" BorderBrush="#C9B070" Theme="{StaticResource ToolBtn}" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                                        <TextBlock Text="SET:" FontSize="9" FontWeight="SemiBold" Foreground="#6B5A00" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                        <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" Width="40" Height="28" Padding="0">
                                                                            <TextBox x:Name="ClockSetMinutesBox" Text="00" FontSize="14" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="3" />
                                                                        </Border>
                                                                        <TextBlock Text=":" FontSize="14" FontWeight="SemiBold" Foreground="#6B5A00" VerticalAlignment="Center" Margin="2,0" />
                                                                        <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" Width="34" Height="28" Padding="0">
                                                                            <TextBox x:Name="ClockSetSecondsBox" Text="00" FontSize="14" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="2" />
                                                                        </Border>
                                                                        <Button Padding="0" MinHeight="0" Content="SET" Width="36" Height="28" FontSize="9" FontWeight="SemiBold" Click="ClockSet_Click" BorderBrush="#6B5A00" Foreground="#D29922" Margin="6,0,0,0" Theme="{StaticResource ToolBtn}" />
                                                                    </StackPanel>
                                                                    <TextBlock x:Name="ClockSetError" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="False" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Expander>
                                                        <Border x:Name="SettingsFinalsCard" Background="Transparent" Padding="0" Margin="0,0,0,8" Focusable="False">
                                                            <CheckBox x:Name="SettingsFinalsToggle" AutomationProperties.Name="Finals mode" AutomationProperties.HelpText="Golden bar styling and time-on after siren in final quarter" Theme="{StaticResource ControlCentre.FinalsToggle}" IsCheckedChanged="Native_SettingsFinalsToggle_Changed" />
                                                        </Border>
                                                        <Border x:Name="SettingsHideTeamNamesCard" Background="Transparent" Padding="0" Margin="0,0,0,8" Focusable="False">
                                                            <CheckBox x:Name="SettingsHideTeamNamesToggle" AutomationProperties.Name="Hide team names" AutomationProperties.HelpText="Removes name panels while keeping professional, digit-safe score sizing" Theme="{StaticResource ControlCentre.NamesToggle}" IsCheckedChanged="Native_SettingsHideTeamNamesToggle_Changed" />
                                                        </Border>
                                                        <Border Background="#0A0806" BorderBrush="#2A2020" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                    <TextBlock Text="🏷" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="QUARTER LABEL" FontSize="12" FontWeight="SemiBold" Foreground="#D29922" Margin="0,0,0,2" />
                                                                        <TextBlock Text="Override the centre quarter/break label shown on the scoreboard right now. Updates live. Resetting restores the default for the current state." FontSize="9" FontWeight="SemiBold" Foreground="#6B5A00" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="QuarterLabelCurrentBox" Grid.Column="0" MaxLength="12" FontSize="13" FontWeight="Bold" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#C9B070" BorderThickness="1" CaretBrush="White" Padding="10,6" TextWrapping="NoWrap" TextChanged="Native_QuarterLabelCurrentBox_TextChanged" />
                                                                    <Button MinHeight="0" x:Name="QuarterLabelCurrentReset" Grid.Column="1" Content="Reset" Width="74" Height="28" FontSize="10" FontWeight="Bold" Click="QuarterLabelCurrentReset_Click" BorderBrush="#C9B070" Margin="6,0,0,0" Theme="{StaticResource ToolBtn}" />
                                                                </Grid>
                                                                <TextBlock x:Name="QuarterLabelCurrentHint" FontSize="9" FontWeight="SemiBold" Foreground="#6B5A00" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="SettingsMatchSectionEndAnchor" IsVisible="False" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="SettingsSection_Keybinds" Tag="keybind keybinds keyboard hotkeys shortcuts toggle clock start pause home away goal behind end quarter" Theme="{StaticResource SettingsSectionSurface}" IsVisible="False">
                                                    <StackPanel>
                                                        <Border Height="1" Margin="0,0,0,14">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                    <GradientStop Color="#00A78BFA" Offset="0" />
                                                                    <GradientStop Color="#30A78BFA" Offset="0.5" />
                                                                    <GradientStop Color="#00A78BFA" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <TextBlock Text="KEYBINDS" FontSize="14" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,0,0,2">

                                                </TextBlock>
                                                            <TextBlock Text="Set your keyboard shortcuts for live control actions" FontSize="9" FontWeight="SemiBold" Foreground="#C4B5FD" />
                                                        </StackPanel>
                                                        <Border Background="#120A20" BorderBrush="#3B2A62" BorderThickness="1" Padding="14">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="120" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Start / Pause Clock" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <Button MinHeight="0" x:Name="KeybindToggleClockButton" Grid.Column="1" Content="Space" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindToggleClockButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                                </Grid>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="120" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Home Goal" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <Button MinHeight="0" x:Name="KeybindHomeGoalButton" Grid.Column="1" Content="A" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindHomeGoalButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                                </Grid>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="120" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Home Behind" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <Button MinHeight="0" x:Name="KeybindHomeBehindButton" Grid.Column="1" Content="S" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindHomeBehindButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                                </Grid>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="120" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Away Goal" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <Button MinHeight="0" x:Name="KeybindAwayGoalButton" Grid.Column="1" Content="K" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindAwayGoalButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                                </Grid>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="120" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Away Behind" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <Button MinHeight="0" x:Name="KeybindAwayBehindButton" Grid.Column="1" Content="L" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindAwayBehindButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                                </Grid>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="120" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="End Quarter" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <Button MinHeight="0" x:Name="KeybindEndQuarterButton" Grid.Column="1" Content="N" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindEndQuarterButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                                </Grid>
                                                                <TextBlock x:Name="KeybindHintText" Text="Click a keybind, then press a key. Esc cancels." Foreground="#A8B0BA" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="SettingsSection_Display" Tag="display appearance layout goal animation broadcast electric cinematic clean classic custom video scorebug theme" Theme="{StaticResource SettingsSectionSurface}">
                                                    <StackPanel>
                                                        <Border Height="1" Margin="0,0,0,14">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                    <GradientStop Color="#0058A6FF" Offset="0" />
                                                                    <GradientStop Color="#3058A6FF" Offset="0.5" />
                                                                    <GradientStop Color="#0058A6FF" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <TextBlock Text="DISPLAY" FontSize="18" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,0,0,2">

                                                </TextBlock>
                                                            <TextBlock Text="Goal animation, public-display clarity and responsive output safeguards" FontSize="12" FontWeight="SemiBold" Foreground="#A9CDEF" />
                                                        </StackPanel>
                                                        <Expander Header="IDLE SCREEN / SCREENSAVER" IsExpanded="True" Margin="0,0,0,10" Theme="{StaticResource SettingsExpander}">
                                                            <Border Background="#0A121E" BorderBrush="#29445F" BorderThickness="1" CornerRadius="8" Padding="14">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="PUBLIC DISPLAY STANDBY" Foreground="#67E8F9" FontSize="11" FontWeight="SemiBold" />
                                                                        <TextBlock Text="Shown before setup and after reset. Use the lightweight sports scene, or choose a club image/video." Foreground="#B8C8D8" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,12,0" />
                                                                        <TextBlock x:Name="ScreensaverMediaStatus" Text="Default animated sports scene" Foreground="#DDEAF5" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,12,0" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <Button Content="CHOOSE IMAGE / VIDEO" Click="ChooseScreensaverMedia_Click" Padding="12,8" Margin="0,0,0,6" BorderBrush="#2F91B8" Foreground="#8DEBFF" Theme="{StaticResource ToolBtn}" />
                                                                        <Button Content="USE DEFAULT" Click="ResetScreensaverMedia_Click" Padding="12,8" BorderBrush="#52647A" Foreground="#D5DFEA" Theme="{StaticResource ToolBtn}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Expander>
                                                        <Expander Header="SCOREBUG LAYOUT" IsExpanded="True" Margin="0,0,0,12" Theme="{StaticResource SettingsExpander}">
                                                            <StackPanel>
                                                                <TextBlock Text="Choose the public-display hierarchy. This is remembered for the next match." Foreground="#9EB0C4" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,9" TextWrapping="Wrap" />
                                                                <UniformGrid Columns="2">
                                                                    <ns5:OperatorActionBorder x:Name="LayoutCardClassic" Cursor="Hand" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="2" CornerRadius="8" Padding="14" Margin="0,0,5,0" PointerReleased="Native_OperatorTile_ClassicLayoutCard_Click">
                                                                        <Grid MinHeight="74">
                                                                            <Border x:Name="LayoutGlowClassic" Opacity="0.12" IsHitTestVisible="False" Background="#58A6FF" />
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="CLASSIC" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                                                                                <TextBlock Text="Weather, wall time and date across the top" Foreground="#AFC1D4" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,24,0" />
                                                                            </StackPanel>
                                                                            <Border x:Name="LayoutCheckClassic" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" CornerRadius="9" Padding="5,2" IsVisible="True">
                                                                                <TextBlock Text="✓" Foreground="#06101D" FontWeight="SemiBold" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </ns5:OperatorActionBorder>
                                                                    <ns5:OperatorActionBorder x:Name="LayoutCardExpanded" Cursor="Hand" Background="#0E0E1A" BorderBrush="#2A2A40" BorderThickness="2" CornerRadius="8" Padding="14" Margin="5,0,0,0" PointerReleased="Native_OperatorTile_ExpandedLayoutCard_Click">
                                                                        <Grid MinHeight="74">
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="DISTANCE" Foreground="#DDE9F5" FontSize="14" FontWeight="SemiBold" />
                                                                                <TextBlock Text="No top bar · larger teams and scores · wall time beside the match clock" Foreground="#AFC1D4" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,24,0" />
                                                                            </StackPanel>
                                                                            <Border x:Name="LayoutCheckExpanded" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" CornerRadius="9" Padding="5,2" IsVisible="False">
                                                                                <TextBlock Text="✓" Foreground="#06101D" FontWeight="SemiBold" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </ns5:OperatorActionBorder>
                                                                </UniformGrid>
                                                                <Grid IsVisible="False">
                                                                    <Border x:Name="LayoutCardRetro">
                                                                        <Grid>
                                                                            <Border x:Name="LayoutCheckRetro" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <Border x:Name="LayoutCardNoLogos">
                                                                        <Grid>
                                                                            <Border x:Name="LayoutCheckNoLogos" />
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Expander>
                                                        <TextBlock Text="GOAL MOMENT" FontSize="13" FontWeight="SemiBold" Foreground="#D2B45D" Margin="0,0,0,3" />
                                                        <TextBlock Text="Five purpose-built motion packages. Select one, then preview it on the live output." FontSize="11" FontWeight="SemiBold" Foreground="#8FA2B7" Margin="0,0,0,10" />
                                                        <UniformGrid Columns="2" Margin="0,0,0,4">
                                                            <ns5:OperatorActionBorder x:Name="AnimCardBroadcast" Cursor="Hand" Background="#0B1726" BorderBrush="#285A86" BorderThickness="1" CornerRadius="8" Margin="0,0,4,4" PointerReleased="Native_OperatorTile_AnimBroadcastCard_Click">
                                                                <Grid MinHeight="96">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="TV" FontFamily="{DynamicResource ControlCentre.Font}" FontSize="24" FontWeight="SemiBold" Foreground="#63B3FF" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                        <TextBlock Text="SIGNAL" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="Layered reveal · dual sweep" FontSize="9" FontWeight="SemiBold" Foreground="#7E9DBB" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                    <Border x:Name="AnimCheckBroadcast" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="True">
                                                                        <TextBlock Text="✓" FontSize="8" FontWeight="SemiBold" Foreground="#1A1400" />
                                                                    </Border>
                                                                </Grid>
                                                            </ns5:OperatorActionBorder>
                                                            <ns5:OperatorActionBorder x:Name="AnimCardElectric" Cursor="Hand" Background="#091C21" BorderBrush="#1D7685" BorderThickness="1" CornerRadius="8" Margin="4,0,0,4" PointerReleased="Native_OperatorTile_AnimElectricCard_Click">
                                                                <Grid MinHeight="96">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="ϟ" FontFamily="{DynamicResource ControlCentre.Font}" FontSize="28" FontWeight="SemiBold" Foreground="#59F3FF" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                                        <TextBlock Text="VOLTAGE" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="Side charge · electric cut" FontSize="9" FontWeight="SemiBold" Foreground="#77AAB2" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                    <Border x:Name="AnimCheckElectric" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                        <TextBlock Text="✓" FontSize="8" FontWeight="SemiBold" Foreground="#1A1400" />
                                                                    </Border>
                                                                </Grid>
                                                            </ns5:OperatorActionBorder>
                                                            <ns5:OperatorActionBorder x:Name="AnimCardCinematic" Cursor="Hand" Background="#171126" BorderBrush="#694A96" BorderThickness="1" CornerRadius="8" Margin="0,4,4,4" PointerReleased="Native_OperatorTile_AnimCinematicCard_Click">
                                                                <Grid MinHeight="96">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="◆" FontFamily="{DynamicResource ControlCentre.Font}" FontSize="25" Foreground="#C6A5FF" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                                        <TextBlock Text="CLUB CINEMA" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="Crest reveal · cinematic bloom" FontSize="9" FontWeight="SemiBold" Foreground="#A48CC2" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                    <Border x:Name="AnimCheckCinematic" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                        <TextBlock Text="✓" FontSize="8" FontWeight="SemiBold" Foreground="#1A1400" />
                                                                    </Border>
                                                                </Grid>
                                                            </ns5:OperatorActionBorder>
                                                            <ns5:OperatorActionBorder x:Name="AnimCardClean" Cursor="Hand" Background="#0B1D18" BorderBrush="#2D765E" BorderThickness="1" CornerRadius="8" Margin="4,4,0,4" PointerReleased="Native_OperatorTile_AnimCleanCard_Click">
                                                                <Grid MinHeight="96">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="●" FontFamily="{DynamicResource ControlCentre.Font}" FontSize="24" Foreground="#68E0B7" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                        <TextBlock Text="CLEAN IMPACT" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="Score-first · fast dissolve" FontSize="9" FontWeight="SemiBold" Foreground="#82AA9C" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                    <Border x:Name="AnimCheckClean" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                        <TextBlock Text="✓" FontSize="8" FontWeight="SemiBold" Foreground="#1A1400" />
                                                                    </Border>
                                                                </Grid>
                                                            </ns5:OperatorActionBorder>
                                                            <ns5:OperatorActionBorder x:Name="AnimCardClassic" Cursor="Hand" Background="#201808" BorderBrush="#826322" BorderThickness="1" CornerRadius="8" Margin="0,4,4,0" PointerReleased="Native_OperatorTile_AnimClassicCard_Click">
                                                                <Grid MinHeight="96">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="88" FontFamily="{DynamicResource ControlCentre.Font}" FontSize="23" FontWeight="SemiBold" Foreground="#FFC857" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                        <TextBlock Text="FLIPBOARD" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="Mechanical steps · lamp reveal" FontSize="9" FontWeight="SemiBold" Foreground="#B19A68" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                    <Border x:Name="AnimCheckClassic" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                        <TextBlock Text="✓" FontSize="8" FontWeight="SemiBold" Foreground="#1A1400" />
                                                                    </Border>
                                                                </Grid>
                                                            </ns5:OperatorActionBorder>
                                                            <ns5:OperatorActionBorder x:Name="AnimCardCustomVideo" Cursor="Hand" Background="#1A1408" BorderBrush="#6B5A00" BorderThickness="2" CornerRadius="8" Margin="4,4,0,0" PointerReleased="Native_OperatorTile_AnimCustomVideoCard_Click">
                                                                <Grid MinHeight="96">
                                                                    <Border x:Name="AnimGlowCustomVideo" Opacity="0.12" IsHitTestVisible="False">
                                                                        <Border.Background>
                                                                            <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                                <GradientStop Color="#D29922" Offset="0" />
                                                                                <GradientStop Color="#00000000" Offset="1" />
                                                                            </RadialGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <TextBlock Text="🎥" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                                                        <TextBlock Text="CUSTOM" FontSize="12" FontWeight="SemiBold" Foreground="#E7B94F" HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <Border x:Name="AnimCheckCustomVideo" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                        <TextBlock Text="✓" FontSize="8" FontWeight="SemiBold" Foreground="#1A1400" />
                                                                    </Border>
                                                                </Grid>
                                                            </ns5:OperatorActionBorder>
                                                        </UniformGrid>
                                                        <Border BorderBrush="#29486D" BorderThickness="1" Background="#0A1320" Padding="16,12" Margin="0,8,0,4" CornerRadius="6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock x:Name="AnimPreviewTitle" Text="TV Signal" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,3" />
                                                                    <TextBlock x:Name="AnimPreviewDesc" Text="Layered television reveal with dual broadcast sweeps." Foreground="#D9C279" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Border BorderBrush="#C9B070" BorderThickness="1" Background="#0C0A04" Padding="6,2" Margin="0,0,6,0">
                                                                            <TextBlock x:Name="AnimPreviewDuration" Text="3.5 SEC" Foreground="#D2B45D" FontSize="11" FontWeight="SemiBold" />
                                                                        </Border>
                                                                        <Border BorderBrush="#C9B070" BorderThickness="1" Background="#0C0A04" Padding="6,2">
                                                                            <TextBlock x:Name="AnimPreviewIntensity" Text="BROADCAST" Foreground="#D2B45D" FontSize="11" FontWeight="SemiBold" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="▶  PREVIEW EFFECT" Click="PreviewSelectedGoalAnimation_Click" FontSize="12" FontWeight="SemiBold" Foreground="#CFE5FF" BorderBrush="#3D6A9D" Background="#10233A" Padding="18,10" Margin="16,0,0,0" VerticalAlignment="Center" Theme="{StaticResource ToolBtn}" />
                                                            </Grid>
                                                        </Border>
                                                        <UniformGrid Columns="3" Margin="0,12,0,0" IsVisible="False">
                                                            <Border Background="#0D1726" BorderBrush="#2E4B6D" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,6,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="SCORE CAPACITY" FontSize="11" FontWeight="SemiBold" Foreground="#8FC5FF" />
                                                                    <TextBlock Text="88  ·  188" FontSize="28" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Foreground="White" Margin="0,4,0,2" />
                                                                    <TextBlock Text="G/B double digits · total triple digits" FontSize="11" FontWeight="SemiBold" Foreground="#9FB0C3" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="#0D1D16" BorderBrush="#2B5C3D" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="3,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="RESPONSIVE OUTPUT" FontSize="11" FontWeight="SemiBold" Foreground="#75D286" />
                                                                    <TextBlock Text="ACTIVE" FontSize="22" FontWeight="SemiBold" Foreground="#B9F3C5" Margin="0,7,0,3" />
                                                                    <TextBlock Text="Panels adapt to window dimensions" FontSize="11" FontWeight="SemiBold" Foreground="#9FB8A8" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="#1C170A" BorderBrush="#67551E" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="6,0,0,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="SMART CONTRAST" FontSize="11" FontWeight="SemiBold" Foreground="#E7C55D" />
                                                                    <TextBlock Text="ACTIVE" FontSize="22" FontWeight="SemiBold" Foreground="#FFF0B5" Margin="0,7,0,3" />
                                                                    <TextBlock Text="Text responds to team colours" FontSize="11" FontWeight="SemiBold" Foreground="#C9B98B" />
                                                                </StackPanel>
                                                            </Border>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="SettingsSection_Overlays" Tag="overlays automatic stats weather break screen quarter probability scoring run live forecast" Theme="{StaticResource SettingsSectionSurface}">
                                                    <StackPanel>
                                                        <Border Height="1" Margin="0,0,0,14">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                    <GradientStop Color="#003FB950" Offset="0" />
                                                                    <GradientStop Color="#303FB950" Offset="0.5" />
                                                                    <GradientStop Color="#003FB950" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <TextBlock Text="OVERLAYS" FontSize="14" FontWeight="SemiBold" Foreground="#3FB950" Margin="0,0,0,2">

                                                </TextBlock>
                                                            <TextBlock Text="Automatic overlays, break screen, and weather" FontSize="9" FontWeight="SemiBold" Foreground="#2A6030" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="AutoOverlaysToggle" IsChecked="True" IsCheckedChanged="Native_AutoOverlaysToggle_Changed" IsVisible="False" />
                                                        <ns5:OperatorActionBorder x:Name="AutoOverlaysCard" Background="#0A1410" BorderBrush="#3FB950" BorderThickness="2" Padding="14" Margin="0,0,0,8" Cursor="Hand" PointerReleased="Native_OperatorTile_AutoOverlaysCard_Click">
                                                            <Grid>
                                                                <Border x:Name="AutoOverlaysGlow" Opacity="0.12" IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                            <GradientStop Color="#3FB950" Offset="0" />
                                                                            <GradientStop Color="#00000000" Offset="1" />
                                                                        </RadialGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel>
                                                                    <TextBlock Text="AUTOMATIC OVERLAYS" FontSize="13" FontWeight="SemiBold" Foreground="#3FB950" Margin="0,0,0,4">

                                                        </TextBlock>
                                                                    <TextBlock Text="Periodic stats, win probability, weather, and scoring run overlays on the scorebug" FontSize="9" FontWeight="SemiBold" Foreground="#2A6030" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <Border x:Name="AutoOverlaysCheck" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#3FB950" Padding="6,3">
                                                                    <TextBlock Text="✓" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                                </Border>
                                                            </Grid>
                                                        </ns5:OperatorActionBorder>
                                                        <Border x:Name="SettingsBreakScreenCard" Background="Transparent" Padding="0" Margin="0,0,0,8" Focusable="False">
                                                            <CheckBox x:Name="SettingsBreakScreenToggle" IsChecked="True" AutomationProperties.Name="Automatic quarter-break screens" AutomationProperties.HelpText="Auto-show summary screen at quarter breaks. Applies at the next quarter end; changing this preference does not start a break or stop an existing rotation." Theme="{StaticResource ControlCentre.QuarterBreakToggle}" IsCheckedChanged="Native_SettingsBreakScreenToggle_Changed" />
                                                        </Border>
                                                        <ns5:OperatorGlassSurface Material="Regular" CornerRadius="26" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Padding="22" Margin="0,0,0,4">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                    <ns2:OperatorSymbol Kind="weather" Width="24" Height="24" Foreground="{DynamicResource ControlCentre.AccentBrush}" Margin="0,0,10,0" />
                                                                    <TextBlock Text="Venue weather" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="Use the town or suburb nearest your ground." FontSize="13" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox x:Name="SettingsWeatherLocation" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="200" FontSize="15" MinHeight="42" VerticalContentAlignment="Center" Theme="{StaticResource SettingsChoice}" />
                                                                    <Button Grid.Column="2" Content="Update" MinWidth="86" MinHeight="42" FontSize="14" Click="ApplyWeatherLocation_Click" Theme="{StaticResource ToolBtn}" />
                                                                </Grid>
                                                                <TextBlock x:Name="WeatherLocationStatus" Text="" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                            </StackPanel>
                                                        </ns5:OperatorGlassSurface>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="SettingsSection_Media" Tag="media logo crop zoom position home away image picture" Theme="{StaticResource SettingsSectionSurface}">
                                                    <StackPanel>
                                                        <Border Height="1" Margin="0,0,0,14">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                    <GradientStop Color="#0058A6FF" Offset="0" />
                                                                    <GradientStop Color="#2058A6FF" Offset="0.5" />
                                                                    <GradientStop Color="#0058A6FF" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <TextBlock Text="MEDIA" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,0,0,2">

                                                </TextBlock>
                                                            <TextBlock Text="Adjust logo crop and positioning" FontSize="9" FontWeight="SemiBold" Foreground="#8FB8E8" />
                                                        </StackPanel>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Padding="8">
                                                                <StackPanel>
                                                                    <TextBlock Text="HOME" Foreground="#7EB4FF" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                                    <Border Height="70" Margin="0,0,0,6" BorderBrush="#1A3A6A" BorderThickness="1" Background="#060A10" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image x:Name="HomeLogoCropPreviewImage" Stretch="Uniform" RenderTransformOrigin="50%,50%" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <TextBlock Text="Zoom" Foreground="#7DA0CA" FontSize="8" />
                                                                    <Slider x:Name="HomeLogoZoomSlider" Minimum="0.8" Maximum="3.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                    <TextBlock Text="X" Foreground="#7DA0CA" FontSize="8" Margin="0,2,0,0" />
                                                                    <Slider x:Name="HomeLogoXSlider" Minimum="-50" Maximum="50" Value="0" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                    <TextBlock Text="Y" Foreground="#7DA0CA" FontSize="8" Margin="0,2,0,0" />
                                                                    <Slider x:Name="HomeLogoYSlider" Minimum="-50" Maximum="50" Value="0" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                    <Button MinHeight="0" Content="Reset Home" Height="24" Margin="0,4,0,0" Click="ResetHomeCrop_Click" FontSize="10" BorderBrush="#1A3A6A" Theme="{StaticResource ToolBtn}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Grid.Column="2" Background="#1A0A0A" BorderBrush="#4A1A1A" BorderThickness="1" Padding="8">
                                                                <StackPanel>
                                                                    <TextBlock Text="AWAY" Foreground="#FF9A9A" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                                    <Border Height="70" Margin="0,0,0,6" BorderBrush="#4A1A1A" BorderThickness="1" Background="#060A10" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image x:Name="AwayLogoCropPreviewImage" Stretch="Uniform" RenderTransformOrigin="50%,50%" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <TextBlock Text="Zoom" Foreground="#523030" FontSize="8" />
                                                                    <Slider x:Name="AwayLogoZoomSlider" Minimum="0.8" Maximum="3.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                    <TextBlock Text="X" Foreground="#523030" FontSize="8" Margin="0,2,0,0" />
                                                                    <Slider x:Name="AwayLogoXSlider" Minimum="-50" Maximum="50" Value="0" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                    <TextBlock Text="Y" Foreground="#523030" FontSize="8" Margin="0,2,0,0" />
                                                                    <Slider x:Name="AwayLogoYSlider" Minimum="-50" Maximum="50" Value="0" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                    <Button MinHeight="0" Content="Reset Away" Height="24" Margin="0,4,0,0" Click="ResetAwayCrop_Click" FontSize="10" BorderBrush="#4A1A1A" Theme="{StaticResource ToolBtn}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock x:Name="LogoCropSummaryText" Foreground="#9CC4F0" FontSize="9" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="SettingsSection_Advanced" Tag="advanced window dimensions width height size cloud remote join code qr reset update version" Theme="{StaticResource SettingsSectionSurface}">
                                                    <StackPanel>
                                                        <Border Height="1" Margin="0,0,0,14">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                    <GradientStop Color="#008B949E" Offset="0" />
                                                                    <GradientStop Color="#208B949E" Offset="0.5" />
                                                                    <GradientStop Color="#008B949E" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <TextBlock Text="ADVANCED" FontSize="14" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,2">

                                                </TextBlock>
                                                            <TextBlock Text="Window dimensions, cloud remote, and reset" FontSize="9" FontWeight="SemiBold" Foreground="#A8B0BA" />
                                                        </StackPanel>
                                                        <Expander Header="WINDOW DIMENSIONS" Theme="{StaticResource SettingsExpander}">
                                                            <StackPanel>
                                                                <Border Background="#09090B" BorderBrush="#1A2A40" BorderThickness="1" Padding="14" Margin="0,0,0,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="20" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <TextBlock Text="WIDTH" FontSize="8" FontWeight="SemiBold" Foreground="#9CC4F0" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                                <ns5:OperatorActionBorder Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Width="32" Height="32" Cursor="Hand" PointerReleased="Native_OperatorTile_WidthMinus_Click">
                                                                                    <TextBlock Text="−" FontSize="16" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </ns5:OperatorActionBorder>
                                                                                <Border Background="#060A10" BorderBrush="#2A4A70" BorderThickness="1" MinWidth="60" Height="44" Padding="0" Margin="4,0">
                                                                                    <TextBox x:Name="WindowWidthBox" Text="386" FontSize="22" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Foreground="#58A6FF" Background="Transparent" BorderThickness="0" CaretBrush="#58A6FF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="5" />
                                                                                </Border>
                                                                                <ns5:OperatorActionBorder Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Width="32" Height="32" Cursor="Hand" PointerReleased="Native_OperatorTile_WidthPlus_Click">
                                                                                    <TextBlock Text="+" FontSize="16" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </ns5:OperatorActionBorder>
                                                                            </StackPanel>
                                                                            <TextBlock Text="px" FontSize="8" Foreground="#7DA0CA" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                                            <TextBlock Text="HEIGHT" FontSize="8" FontWeight="Black" Foreground="#9CC4F0" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                                <ns5:OperatorActionBorder Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Width="32" Height="32" Cursor="Hand" PointerReleased="Native_OperatorTile_HeightMinus_Click">
                                                                                    <TextBlock Text="−" FontSize="16" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </ns5:OperatorActionBorder>
                                                                                <Border Background="#060A10" BorderBrush="#2A4A70" BorderThickness="1" MinWidth="60" Height="44" Padding="0" Margin="4,0">
                                                                                    <TextBox x:Name="WindowHeightBox" Text="193" FontSize="22" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Foreground="#58A6FF" Background="Transparent" BorderThickness="0" CaretBrush="#58A6FF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="5" />
                                                                                </Border>
                                                                                <ns5:OperatorActionBorder Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Width="32" Height="32" Cursor="Hand" PointerReleased="Native_OperatorTile_HeightPlus_Click">
                                                                                    <TextBlock Text="+" FontSize="16" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </ns5:OperatorActionBorder>
                                                                            </StackPanel>
                                                                            <TextBlock Text="px" FontSize="8" Foreground="#7DA0CA" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <Button MinHeight="0" Content="APPLY SIZE" Height="32" FontSize="11" FontWeight="SemiBold" Click="ApplyWindowDimensions_Click" BorderBrush="#1A3A6A" Foreground="#58A6FF" Margin="0,4,0,2" Theme="{StaticResource ToolBtn}" />
                                                                <Button MinHeight="0" Content="RESET TO 386 × 193" Height="30" FontSize="10" FontWeight="SemiBold" Click="ResetWindowDimensions_Click" BorderBrush="#344A64" Foreground="#C5D6E8" Margin="0,2,0,4" Theme="{StaticResource ToolBtn}" />
                                                                <TextBlock x:Name="WindowDimensionsStatus" Text="" Foreground="#8FB8E8" FontSize="10" Margin="0,0,0,12" />
                                                            </StackPanel>
                                                        </Expander>
                                                        <Border x:Name="CloudRemoteCard" Background="#0A1620" BorderBrush="#1A3A6A" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                                                            <StackPanel>
                                                                <TextBlock Text="📱" FontSize="28" HorizontalAlignment="Center" Foreground="#58A6FF" Margin="0,0,0,4" />
                                                                <TextBlock Text="CLOUD REMOTE" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Score from any phone, tablet, or laptop" FontSize="9" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,2,0,8" />
                                                                <TextBlock x:Name="CloudStatusText" Text="Checking configuration…" FontSize="10" FontWeight="SemiBold" Foreground="#B1BAC4" HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" TextAlignment="Center" />
                                                                <StackPanel x:Name="CloudIdleState" IsVisible="False">
                                                                    <Button MinHeight="0" x:Name="CloudStartButton" Content="Start cloud session" Height="32" FontSize="11" FontWeight="SemiBold" Click="StartCloudSession_Click" BorderBrush="#1A3A6A" Foreground="#58A6FF" Theme="{StaticResource ToolBtn}" />
                                                                    <TextBlock Text="A new join code is created each time. Existing sessions stay independent." FontSize="9" Foreground="#6E7B8A" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="CloudDisabledState" IsVisible="False">
                                                                    <Border Background="#1C140A" BorderBrush="#4A3A1A" BorderThickness="1" Padding="10">
                                                                        <StackPanel>
                                                                            <TextBlock Text="Setup required" FontSize="11" FontWeight="Bold" Foreground="#D29922" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                            <TextBlock Text="Place a 'supabase.config.json' file next to the executable, or under %LOCALAPPDATA%\RocheScoreboard\." FontSize="9" Foreground="#C9B070" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4" />
                                                                            <TextBlock Text="See supabase\README.md for the 10-minute setup." FontSize="9" Foreground="#A89060" TextWrapping="Wrap" TextAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel x:Name="CloudLiveState" IsVisible="False">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                                        <Ellipse x:Name="CloudConnectionDot" Width="8" Height="8" Fill="#B1BAC4" VerticalAlignment="Center" />
                                                                        <TextBlock x:Name="CloudConnectionLabel" Text="Connecting…" FontSize="10" FontWeight="Bold" Foreground="#B1BAC4" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="JOIN CODE" FontSize="9" FontWeight="SemiBold" Foreground="#7DA0CA" HorizontalAlignment="Center" />
                                                                    <ns5:OperatorActionBorder Background="#060A10" BorderBrush="#2A4A70" BorderThickness="1" Padding="14,10" Margin="0,4,0,4" Cursor="Hand" PointerReleased="Native_OperatorTile_CopyCloudJoinCode_Click" ToolTip.Tip="Click to copy">
                                                                        <TextBlock x:Name="CloudJoinCodeText" Text="—" FontSize="32" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" Foreground="#58A6FF" HorizontalAlignment="Center" TextAlignment="Center" />
                                                                    </ns5:OperatorActionBorder>
                                                                    <Border Background="#09090B" BorderBrush="#1A3A6A" BorderThickness="1" Padding="8" HorizontalAlignment="Center" Margin="0,8,0,8">
                                                                        <Image x:Name="CloudQrImage" Width="180" Height="180" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                                                                    </Border>
                                                                    <StackPanel x:Name="CloudJoinUrlPanel" IsVisible="False">
                                                                        <TextBlock Text="OR OPEN" FontSize="9" FontWeight="SemiBold" Foreground="#7DA0CA" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                                                        <TextBlock x:Name="CloudJoinUrlText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#9CC4F0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                                                        <Button MinHeight="0" x:Name="CloudCopyUrlButton" Content="Copy URL" Height="26" FontSize="10" FontWeight="Bold" Click="CopyCloudJoinUrl_Click" BorderBrush="#1A3A6A" Foreground="#58A6FF" Margin="0,6,0,0" Theme="{StaticResource ToolBtn}" />
                                                                    </StackPanel>
                                                                    <Button MinHeight="0" x:Name="CloudEndButton" Content="End session" Height="30" FontSize="11" FontWeight="Bold" Click="EndCloudSession_Click" BorderBrush="#3A2020" Foreground="#FF6B6B" Margin="0,12,0,0" Theme="{StaticResource ToolBtn}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <ns5:OperatorActionBorder Background="#1C0A0A" BorderBrush="#4A2020" BorderThickness="1" Padding="14" Cursor="Hand" PointerReleased="Native_OperatorTile_ResetCardSettings_Click">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="⟲" FontSize="28" HorizontalAlignment="Center" Foreground="#FF6B6B" Margin="0,0,0,4" />
                                                                <TextBlock Text="RESET MATCH" FontSize="14" FontWeight="SemiBold" Foreground="#FF6B6B" HorizontalAlignment="Center" />
                                                                <TextBlock Text="Clear all and start over" FontSize="9" Foreground="#E08A8F" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </ns5:OperatorActionBorder>
                                                        <Border Background="#0A1620" BorderBrush="#1A3A6A" BorderThickness="1" Padding="14" Margin="0,12,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="⬆" FontSize="28" HorizontalAlignment="Center" Foreground="#58A6FF" Margin="0,0,0,4" />
                                                                <TextBlock Text="APP UPDATE" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" />
                                                                <TextBlock x:Name="UpdateCurrentVersionText" Text="Current version: …" FontSize="10" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                                <TextBlock x:Name="UpdateStatusText" Text="Click 'Check for updates' to look for a new version." FontSize="11" FontWeight="SemiBold" Foreground="#8A95A3" HorizontalAlignment="Center" Margin="0,4,0,8" TextWrapping="Wrap" TextAlignment="Center" />
                                                                <ProgressBar x:Name="UpdateProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8" Foreground="#58A6FF" Background="#09090B" IsVisible="False" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button MinHeight="0" x:Name="CheckForUpdateButton" Grid.Column="0" Content="Check for updates" Height="30" FontSize="11" FontWeight="Bold" Click="CheckForUpdate_Click" BorderBrush="#1A3A6A" Foreground="#58A6FF" Theme="{StaticResource ToolBtn}" />
                                                                    <Button MinHeight="0" x:Name="InstallUpdateButton" Grid.Column="2" Content="Download &amp; install" Height="30" FontSize="11" FontWeight="Bold" Click="InstallUpdate_Click" BorderBrush="#1A3A24" Foreground="#3FB950" Theme="{StaticResource ToolBtn}" IsVisible="False" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </ns5:OperatorViewport>
        <Border x:Name="ResetOverlay" Background="Transparent" Opacity="1" IsHitTestVisible="False" KeyboardNavigation.TabNavigation="Cycle" SizeChanged="ResetOverlay_SizeChanged" Unloaded="ResetOverlay_Unloaded" ZIndex="50" IsVisible="False">
            <Grid>
                <Border x:Name="ResetBackdrop" Background="#C9080C12" IsHitTestVisible="False" />
                <Grid x:Name="ResetHost" MaxWidth="560" MaxHeight="430" Margin="12" VerticalAlignment="Center">
                    <ns5:OperatorGlassSurface x:Name="ResetSurface" Material="Regular" CornerRadius="28" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="#B3E08A8F" BorderThickness="1" IsHitTestVisible="False" />
                    <Grid x:Name="ResetContent" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="ResetHeader">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False">
                                <Path x:Name="ResetArrow" Data="M8,7 A13,13 0 1 1 3,18 M8,2 L8,8 2,8" Stroke="{DynamicResource ScoreGrid.Brush.DangerForeground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                <Path Data="M17,10 L25,24 9,24 Z" Stroke="{DynamicResource ScoreGrid.Brush.DangerForeground}" StrokeThickness="1.5" StrokeJoin="Round" />
                                <Path x:Name="ResetWarningMark" Data="M17,15 L17,19 M17,21 L17,21.5" Stroke="{DynamicResource ScoreGrid.Brush.DangerForeground}" StrokeThickness="2" StrokeLineCap="Round" />
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Reset this match?" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Start again from Home" FontSize="13" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer x:Name="ResetDetails" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,14,0,16">
                            <StackPanel>
                                <TextBlock x:Name="ResetMatchContext" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ResetPhaseText" FontSize="12" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" Margin="0,5,0,14" TextWrapping="Wrap" />
                                <TextBlock Text="Scores, match events and elapsed time will be cleared, together with this saved recovery. You'll return to Home to start a new match." FontSize="14" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="This action cannot be undone." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ScoreGrid.Brush.DangerForeground}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="ResetContextNotice" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ScoreGrid.Brush.DangerForeground}" Margin="0,12,0,0" TextWrapping="Wrap" Text="The match changed while this decision was open. Cancel and open Reset again to review the current match." IsVisible="False" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid x:Name="ResetActions" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="CancelResetBtn" Content="CANCEL" Height="46" MinHeight="46" FontSize="14" FontWeight="SemiBold" Click="CancelReset_Click" AutomationProperties.Name="Cancel match reset" Background="#303035" BorderBrush="#A8B0BA" Foreground="White" Cursor="Hand" Theme="{StaticResource ToolBtn}" />
                            <Button Grid.Column="2" x:Name="ConfirmResetBtn" Content="RESET" Height="46" MinHeight="46" FontSize="14" FontWeight="SemiBold" Click="ConfirmReset_Click" AutomationProperties.Name="Reset this match and return Home" Background="#9B2C2C" BorderBrush="#F85149" Foreground="White" Cursor="Hand" Theme="{StaticResource PrimaryCommandButton}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="ResizeGripVisual" Width="18" Height="18" Margin="0,0,1,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="TopLeftCorner" ZIndex="300" PointerPressed="Native_ResizeGrip_MouseDown">
            <Border.Theme>
                <ControlTheme TargetType="Border">
                    <Setter Property="Opacity" Value="0.15" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Opacity" Value="0.6" />
                    </Style>
                </ControlTheme>
            </Border.Theme>
            <Path Stroke="#8B949E" StrokeThickness="1.5" Data="M 16,4 L 4,16 M 16,9 L 9,16 M 16,14 L 14,16" />
        </Border>
        <ns5:SetupWizard x:Name="SetupWizardPanel" ZIndex="100" IsVisible="False" />
        <ns5:CricketControlPanel x:Name="CricketControlPanelView" ZIndex="0" IsVisible="False" />
        <ns5:CricketSetupWizard x:Name="CricketSetupWizardPanel" ZIndex="100" IsVisible="False" />
        <ns5:TrainingControlPanel x:Name="TrainingControlPanelView" ZIndex="0" IsVisible="False" />
        <ns5:GlobalSettingsScreen x:Name="GlobalSettingsPanel" ZIndex="150" IsVisible="False" />
        <ns5:SportSelectionScreen x:Name="SportSelectionPanel" ZIndex="200" />
        <ns5:MatchLoadingScreen x:Name="MatchLoadingPanel" ZIndex="300" IsVisible="False" />
        <Grid x:Name="CommandOverlay" SizeChanged="CommandOverlay_SizeChanged" Background="#B5080C12" KeyboardNavigation.TabNavigation="Cycle" ZIndex="900" IsVisible="False" KeyDown="Native_CommandOverlay_KeyDown">
            <Border Background="Transparent" PointerReleased="Native_CommandBackdrop_Click" />
            <Border x:Name="CommandSurface" MaxWidth="650" Margin="18" Padding="22" CornerRadius="24" Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="#6073B9FF" BorderThickness="1" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Close · Esc" Click="CommandClose_Click" MinHeight="38" Padding="12,6" />
                        <TextBlock Text="Find a command" TextWrapping="Wrap" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="CommandSearch" Grid.Row="1" MinHeight="44" Padding="12,9" FontSize="16" AutomationProperties.Name="Search commands" TextChanged="Native_CommandSearch_TextChanged" />
                    <ListBox x:Name="CommandResults" Grid.Row="2" Margin="0,12,0,8" MaxHeight="350" MinHeight="70" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Native_CommandResults_SelectionChanged" />
                    <TextBlock x:Name="CommandHint" Grid.Row="3" Text="↑ ↓ to choose · Enter to run · Esc to close" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="RecoveryOverlay" Background="#D9080C12" KeyboardNavigation.TabNavigation="Cycle" ZIndex="1000" IsVisible="False" />
    </Grid>
</Window>
