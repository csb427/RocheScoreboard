        <ControlTheme x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#B8C7D8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bd" Background="#101722" Padding="8,7" CornerRadius="0" BorderThickness="0,0,1,1" BorderBrush="#2D3B4D">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="PrimaryLabel" Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="Black" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="SecondaryLabel" Text="{TemplateBinding Tag}" Foreground="#71859A" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" IsVisible="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="AccBar" VerticalAlignment="Bottom" Height="4" Opacity="0" Margin="0" CornerRadius="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="#0058A6FF" Offset="0" />
                                        <GradientStop Color="#FF58A6FF" Offset="0.5" />
                                        <GradientStop Color="#0058A6FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:selected /template/ Border#Bd">
                <Setter Property="Background" Value="#17263A" />
