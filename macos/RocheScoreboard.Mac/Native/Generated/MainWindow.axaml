            </Style>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="BorderBrush" Value="#A8B0BA" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#AEB7C4" />
            <Setter Property="Background" Value="#0A0E18" />
            <Setter Property="BorderBrush" Value="#21262D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderToggle" Grid.Row="0" Cursor="Hand" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Padding="12,9" HorizontalContentAlignment="Stretch" Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HB" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                    <TextBlock x:Name="Chev" Grid.Column="1" Text="▾" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                    <ToggleButton.Styles>
                                        <Style Selector="ToggleButton:pointerover /template/ Border#HB">
                                            <Setter Property="Background" Value="#11161E" />
                                        </Style>
                                        <Style Selector="ToggleButton:checked /template/ TextBlock#Chev">
                                            <Setter Property="Text" Value="▴" />
                                        </Style>
                                    </ToggleButton.Styles>
                                </ToggleButton>
                                <Border x:Name="Body" Grid.Row="1" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="12" IsVisible="False">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:expanded /template/ Border#Body">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="SettingsSectionSurface" TargetType="Border">
            <Setter Property="Background" Value="#101824" />
            <Setter Property="BorderBrush" Value="#2B3A4E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.24" OffsetX="-5.51091059616e-16" OffsetY="3" />
                </Setter.Value>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="OutputActionCard" TargetType="Border">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style Selector="^:pointerover">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Panel.ZIndex" Value="20" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" Color="#58A6FF" Opacity="0.55" OffsetX="0" OffsetY="0" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="TickerSlotToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="58" Height="32">
                            <Border x:Name="Track" CornerRadius="16" Background="#17212C" BorderBrush="#526273" BorderThickness="1" />
                            <Border x:Name="Thumb" Width="24" Height="24" CornerRadius="12" Background="#8A99A8" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StateText" Text="OFF" FontSize="8" FontWeight="Black" Foreground="#BEC9D4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Track">
                <Setter Property="BorderBrush" Value="#78B7FF" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#Track">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="12" Color="#58A6FF" Opacity="0.38" OffsetX="0" OffsetY="0" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style Selector="^:pressed /template/ Border#Thumb">
                <Setter Property="Opacity" Value="0.72" />
            </Style>
            <Style Selector="^:checked /template/ Border#Track">
                <Setter Property="Background" Value="#12371D" />
            </Style>
            <Style Selector="^:checked /template/ Border#Track">
                <Setter Property="BorderBrush" Value="#56D36D" />
            </Style>
            <Style Selector="^:checked /template/ Border#Thumb">
                <Setter Property="Background" Value="#75E18A" />
            </Style>
            <Style Selector="^:checked /template/ Border#Thumb">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style Selector="^:checked /template/ Border#Thumb">
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#StateText">
                <Setter Property="Text" Value="ON" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#StateText">
                <Setter Property="Foreground" Value="#D7FFE0" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#StateText">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#StateText">
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.38" />
            </Style>
        </ControlTheme>
    </Window.Resources>
    <Grid Background="{StaticResource ShellBrush}">
        <ScrollViewer x:Name="MainContent" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible" IsVisible="False">
            <Grid MinWidth="760" MinHeight="560">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="MatchStripBorder" Grid.Row="0" Margin="10,8,10,5" CornerRadius="12" BorderBrush="#40546D" BorderThickness="1" MinHeight="72" IsVisible="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#111A26" Offset="0" />
                            <GradientStop Color="#172333" Offset="0.3" />
                            <GradientStop Color="#172333" Offset="0.7" />
                            <GradientStop Color="#111A26" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Border IsHitTestVisible="False" Opacity="0.08" HorizontalAlignment="Center" Width="400">
                            <Border.Background>
                                <RadialGradientBrush Center="50%,60%" RadiusX="60%" RadiusY="120%">
                                    <GradientStop Color="#58A6FF" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border VerticalAlignment="Bottom" Height="1" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#0058A6FF" Offset="0" />
                                    <GradientStop Color="#4058A6FF" Offset="0.35" />
                                    <GradientStop Color="#6058A6FF" Offset="0.5" />
                                    <GradientStop Color="#4058A6FF" Offset="0.65" />
                                    <GradientStop Color="#0058A6FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="16,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StatusBadge" Grid.Column="0" Background="#0A1A10" Padding="11,6" CornerRadius="9" VerticalAlignment="Center">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#1A4A2A" Offset="0" />
                                        <GradientStop Color="#244A34" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#3FB950" Margin="0,0,6,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#3FB950" BlurRadius="8" Opacity="0.6" OffsetX="0" OffsetY="0" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="StatusText" Text="READY" Foreground="#3FB950" FontSize="12" FontWeight="Black" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="HeaderOutputBadge" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Background="#0B1422" BorderBrush="#29486D" BorderThickness="1" CornerRadius="5" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#58A6FF" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#58A6FF" BlurRadius="7" Opacity="0.7" OffsetX="0" OffsetY="0" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="OUTPUT  " Foreground="#AFC0D2" FontSize="11" FontWeight="Black" />
                                    <TextBlock x:Name="HeaderOutputText" Text="Live Scorebug" Foreground="#D7EAFF" FontSize="12" FontWeight="Black" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderQuarterClock" Text="Q1  00:00" Foreground="White" FontSize="28" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#58A6FF" BlurRadius="16" Opacity="0.2" OffsetX="0" OffsetY="0" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock x:Name="LastEventText" Text="" Foreground="#91A5BA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,14,0">
                                <TextBlock x:Name="HeaderShortcutText" Text="KEYS  CTRL+1–4  ·  OUTPUT 1–6" Foreground="#C2CFDC" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="False" />
                                <Border x:Name="EssentialsModeBadge" Background="#102A19" BorderBrush="#3FB950" BorderThickness="1" CornerRadius="9" Padding="8,4" Margin="0,0,7,0">
                                    <TextBlock x:Name="OperatorModeBadgeText" Text="ESSENTIALS" Foreground="#86EFAC" FontSize="9" FontWeight="Black" />
                                </Border>
                                <Button x:Name="GuidedModeButton" Content="ADVANCED TOOLS" Click="GuidedModeButton_Click" Height="32" Padding="10,3" FontSize="10" FontWeight="Black" BorderBrush="#3A5675" Foreground="#CDE4FA" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Show video, presentation and manual overlay tools" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderHomeAbbr" Text="HOM" Foreground="{StaticResource HomeAccentBrush}" FontSize="16" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="HeaderScore" Text="0 – 0" Foreground="White" FontSize="30" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="White" BlurRadius="12" Opacity="0.15" OffsetX="0" OffsetY="0" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock x:Name="HeaderAwayAbbr" Text="AWA" Foreground="{StaticResource AwayAccentBrush}" FontSize="16" FontWeight="Black" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Border Background="#0A0E16" BorderBrush="#2A3850" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderMarginText" Text="" Foreground="#D6E3EF" FontSize="12" FontWeight="Black" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <TabControl x:Name="MainTabControl" Grid.Row="1" Grid.RowSpan="2" Background="#090D14" BorderThickness="0" Padding="0" TabStripPlacement="Top" SelectionChanged="Native_MainTabControl_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#0D131D" BorderBrush="#34465A" BorderThickness="0,0,0,1">
                                    <ItemsPresenter HorizontalAlignment="Stretch" x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </Border>
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.Resources>
                        <ControlTheme TargetType="TabItem" BasedOn="{StaticResource PanelTab}" x:Key="{x:Type TabItem}" />
                    </TabControl.Resources>
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>
                    <TabItem x:Name="MatchControlTab" Header="1  MATCH" Tag="SCORING &amp; CLOCK" ToolTip.Tip="Scoring, clock and match log · Ctrl+1">
                        <Border Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0" Padding="12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.34*" MinWidth="270" MaxWidth="390" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScoringSectionTitle" Text="SCORING" VerticalAlignment="Center" Theme="{StaticResource SectionHead}" />
                                        <Border Grid.Column="1" BorderBrush="#7A8693" BorderThickness="1" Background="#0D1117" Padding="12,4">
                                            <TextBlock x:Name="MatchResultText" Text="" Foreground="{StaticResource TextMidBrush}" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Border x:Name="ControlPanelCountdownPanel" Grid.Row="0" Background="#080E1C" BorderBrush="#1F6FEB" BorderThickness="2" CornerRadius="8" Padding="12,8" IsVisible="False">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18" Color="#1F6FEB" Opacity="0.22" OffsetX="0" OffsetY="0" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⏱" FontSize="14" Foreground="#58A6FF" Margin="0,0,6,0" />
                                                            <TextBlock Text="STOPPAGE&#10;CLOCK" FontSize="11" FontWeight="Black" Foreground="#58A6FF" LineHeight="11" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="ControlPanelCountdownStatusText" Text="" FontSize="10" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,0" IsVisible="False" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" x:Name="ControlPanelCountdownText" Text="20:00" FontSize="54" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="White" VerticalAlignment="Center" Margin="0,-2,0,0">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect BlurRadius="14" Color="#58A6FF" Opacity="0.38" OffsetX="0" OffsetY="0" />
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <WrapPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <Button x:Name="ControlPanelCountdownEditButton" Content="SET TIME" Margin="0,2,5,2" Click="ControlPanelCountdownEditButton_Click" FontWeight="Black" Foreground="#E6EDF3" BorderBrush="#3B82F6" Background="#0F223F" Padding="10,6" Theme="{StaticResource ToolBtn}" />
                                                        <Button x:Name="ControlPanelCountdownCancelEditButton" Content="Cancel" Click="ControlPanelCountdownCancelEditButton_Click" IsVisible="False" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                            <Popup x:Name="ControlPanelCountdownEditPopupHost" PlacementTarget="{Binding ElementName=ControlPanelCountdownPanel}" Placement="Bottom" HorizontalOffset="0" VerticalOffset="4" IsLightDismissEnabled="True" ns3:PopupMotion.Kind="Fade">
                                                <Border x:Name="ControlPanelCountdownEditPopup" Width="330" Background="#0B1324" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="16,14" Opacity="0" RenderTransformOrigin="100%,0%" IsVisible="False">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" port:ProductionNames.Id="ControlPanelCountdownEditPopupScale" />
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="18" Color="#3B82F6" Opacity="0.25" OffsetX="0" OffsetY="0" />
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <TextBlock Text="SET STOPPAGE CLOCK" Foreground="#58A6FF" FontSize="13" FontWeight="Black" />
                                                        <TextBlock Text="Updates only the operator stoppage clock. The scoreboard match clock is unchanged." Foreground="#AAB8CA" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,10" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Border Background="#0A1224" BorderBrush="#2A4F8A" BorderThickness="1" CornerRadius="5" Padding="6,3">
                                                                <TextBox x:Name="ControlPanelCountdownEditMinutesBox" AutomationProperties.Name="Stoppage minutes" Width="56" MaxLength="2" Text="20" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#E6EDF3" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="ControlPanelCountdownEditBox_KeyDown" ToolTip.Tip="Minutes: Up/Down adjusts by 1; Shift adjusts by 10. Enter applies, Escape cancels." />
                                                            </Border>
                                                            <TextBlock Text=":" Foreground="#8FB8E8" FontSize="24" FontWeight="Black" VerticalAlignment="Center" Margin="7,0" />
                                                            <Border Background="#0A1224" BorderBrush="#2A4F8A" BorderThickness="1" CornerRadius="5" Padding="6,3">
                                                                <TextBox x:Name="ControlPanelCountdownEditSecondsBox" AutomationProperties.Name="Stoppage seconds" Width="56" MaxLength="2" Text="00" FontSize="24" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#E6EDF3" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="ControlPanelCountdownEditBox_KeyDown" ToolTip.Tip="Seconds: Up/Down adjusts by 1; Shift adjusts by 10. Enter applies, Escape cancels." />
                                                            </Border>
                                                        </StackPanel>
                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="MINUTES" Foreground="#71839A" FontSize="9" FontWeight="Bold" TextAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="SECONDS" Foreground="#71839A" FontSize="9" FontWeight="Bold" TextAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock x:Name="ControlPanelCountdownEditErrorText" Foreground="#FF7B72" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" IsVisible="False" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                            <Button Content="CANCEL" Click="ControlPanelCountdownCancelEditButton_Click" FontWeight="Black" BorderBrush="#64748B" Padding="10,6" Margin="0,0,6,0" Theme="{StaticResource ToolBtn}" />
                                                            <Button x:Name="ControlPanelCountdownApplyButton" Content="APPLY LIVE" Click="ControlPanelCountdownApplyButton_Click" FontWeight="Black" Foreground="#E6EDF3" BorderBrush="#3B82F6" Background="#0F223F" Padding="12,6" Theme="{StaticResource ToolBtn}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="HomeScoringBorder" Grid.Column="0" BorderBrush="#33579A" BorderThickness="1,4,1,1" Background="#0A1428" Padding="14" CornerRadius="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="12" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="HomeScoringLabel" Text="HOME" Foreground="#9CC8FF" FontSize="13" FontWeight="Black" />
                                                    <TextBlock Grid.Row="1" x:Name="HomeScoreDisplay" Text="0.0.0" Foreground="White" FontSize="58" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" Margin="0,4,0,0" />
                                                    <Grid Grid.Row="3">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="8" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Button x:Name="HomeGoalButton" Grid.Row="0" Click="HomeGoal_Click" BorderBrush="#4D7DE7" Background="#2F63D1" Theme="{StaticResource PrimaryCommandButton}" ToolTip.Tip="Goal (+6 points) — A">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="+6 GOAL" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="HomeGoalShortcutText" Text=" A" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Name="HomeBehindButton" Grid.Row="2" Click="HomeBehind_Click" FontSize="16" BorderBrush="#3A4E66" Background="#1A2636" Theme="{StaticResource PrimaryCommandButton}" ToolTip.Tip="Behind (+1 point) — S">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="+1 BEHIND" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="HomeBehindShortcutText" Text=" S" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="AwayScoringBorder" Grid.Column="2" BorderBrush="#8A3A3A" BorderThickness="1,4,1,1" Background="#1C0A0A" Padding="14" CornerRadius="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="12" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="AwayScoringLabel" Text="AWAY" Foreground="#FFB0B0" FontSize="13" FontWeight="Black" />
                                                    <TextBlock Grid.Row="1" x:Name="AwayScoreDisplay" Text="0.0.0" Foreground="White" FontSize="58" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" Margin="0,4,0,0" />
                                                    <Grid Grid.Row="3">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="8" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Button x:Name="AwayGoalButton" Grid.Row="0" Click="AwayGoal_Click" BorderBrush="#C56F6F" Background="#A63B3B" Theme="{StaticResource PrimaryCommandButton}" ToolTip.Tip="Goal (+6 points) — K">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="+6 GOAL" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="AwayGoalShortcutText" Text=" K" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Name="AwayBehindButton" Grid.Row="2" Click="AwayBehind_Click" FontSize="16" BorderBrush="#5A3A3A" Background="#2A1A1A" Theme="{StaticResource PrimaryCommandButton}" ToolTip.Tip="Behind (+1 point) — L">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="+1 BEHIND" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="AwayBehindShortcutText" Text=" L" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <Border x:Name="StartSwitchWarning" Grid.Row="3" Background="#1E1A00" BorderBrush="#D29922" BorderThickness="1,2,1,1" Padding="10,6" IsVisible="False">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Pressing Start will switch to the live scoreboard" Foreground="#D29922" FontSize="11" FontWeight="Black" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="StartPauseButton" Content="▶ Start" Height="60" FontSize="22" FontWeight="Black" Click="StartPause_Click" Background="#0D3018" BorderBrush="#1A6040" BorderThickness="1.5" Theme="{StaticResource PrimaryCommandButton}" ToolTip.Tip="Start or pause the game clock — Space" />
                                        <Button Grid.Column="2" x:Name="EndQtrButton" Content="End Qtr" Height="60" FontSize="12" FontWeight="Bold" Click="EndQuarter_Click" Background="#21262D" BorderBrush="#D29922" Theme="{StaticResource ToolBtn}" ToolTip.Tip="End the current quarter — Ctrl+E" />
                                        <Button Grid.Column="2" x:Name="ContinueQtrButton" Content="↩ Resume Q" Height="60" FontSize="11" FontWeight="Bold" Click="ContinueQuarter_Click" Background="#1A2A14" BorderBrush="#3A6030" Foreground="#7EE068" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Resume the previous quarter from where it left off — does NOT start the next quarter" IsVisible="False" />
                                        <Button Grid.Column="4" x:Name="UndoButton" Content="UNDO" Height="60" FontSize="12" FontWeight="Bold" Click="Undo_Click" Background="#2A1416" BorderBrush="#E08A8F" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Undo the last score — Ctrl+Z" />
                                    </Grid>
                                    <Button Grid.Row="7" Content="⟲  RESET MATCH" Height="42" FontSize="13" FontWeight="Black" Click="ResetMatch_Click" Background="#2A1416" BorderBrush="#E08A8F" Foreground="#FF6B6B" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Reset the entire match and return to setup" />
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ns4:CloudRemoteLauncher x:Name="ScoringTabCloudLauncher" Grid.Row="0" IsHitTestVisible="False" IsVisible="False" />
                                    <Border x:Name="MatchLogPanel" Grid.Row="2" MinHeight="180" VerticalAlignment="Stretch" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="0" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="12,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="" FontFamily="{fonts:ProductionFont 'Segoe MDL2 Assets'}" FontSize="12" Foreground="#818CF8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="MATCH LOG" FontSize="10" FontWeight="Black" Foreground="#818CF8" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="MatchLogCountBadge" Text="" FontSize="9" FontWeight="Bold" Foreground="#A8B0BA" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="＋ ADD SCORE" Click="AddMatchLogScore_Click" Height="28" Padding="10,3" FontSize="10" FontWeight="Black" Cursor="Hand" Background="#172B22" Foreground="#7EE2A8" BorderBrush="#397653" BorderThickness="1" />
                                                </Grid>
                                            </Border>
                                            <ScrollViewer x:Name="MatchLogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,4">
                                                <StackPanel x:Name="EventList" />
                                            </ScrollViewer>
                                            <TextBlock x:Name="MatchLogEmptyHint" Grid.Row="1" Text="Score events will appear here" Foreground="#7A8693" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <TabItem x:Name="OutputStudioTab" Header="2  OUTPUT" Tag="PRESENTATIONS" ToolTip.Tip="Public screens and live overlays · Ctrl+2">
                        <Border Background="#0A0E18" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Border Opacity="0.06" IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush Center="30%,20%" RadiusX="70%" RadiusY="70%">
                                            <GradientStop Color="#58A6FF" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#00000000" Offset="0.3" />
                                            <GradientStop Color="#40000000" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid Margin="20,16,20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.65*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <StackPanel HorizontalAlignment="Left" Margin="0,0,0,12">
                                                <TextBlock Text="LIVE OUTPUT ROUTER" FontSize="16" FontWeight="Black" Foreground="White" Margin="0,0,0,2">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="#58A6FF" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="One click changes the public screen · active output is always highlighted" FontSize="10" FontWeight="SemiBold" Foreground="#9BB0C6" />
                                            </StackPanel>
                                            <Border Background="#142236" BorderBrush="#3D5F85" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                                <TextBlock x:Name="CurrentDisplayText" Text="ON AIR · LIVE SCOREBUG" Foreground="#9CCBFF" FontSize="11" FontWeight="Black" />
                                            </Border>
                                            <UniformGrid Columns="4" Margin="0,0,0,6">
                                                <Border x:Name="PresCardScorebug" Cursor="Hand" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_PresCardScorebug_Click">
                                                    <Grid MinHeight="106">
                                                        <Border x:Name="PresGlowScorebug" Opacity="0.12" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                    <GradientStop Color="#58A6FF" Offset="0" />
                                                                    <GradientStop Color="#00000000" Offset="1" />
                                                                </RadialGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="LIVE" FontSize="11" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                            <TextBlock Text="SCOREBUG" FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Live overlay" FontSize="10" FontWeight="SemiBold" Foreground="#B9D8FA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            <TextBlock Text="KEY 1" FontSize="10" FontWeight="Black" Foreground="#8FC5FF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border x:Name="PresCheckScorebug" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2">
                                                            <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="PresCardSummary" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_PresCardSummary_Click">
                                                    <Grid MinHeight="106">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="QTR" FontSize="11" FontWeight="Black" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                            <TextBlock Text="BREAKDOWN" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Quarter history" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            <TextBlock Text="KEY 2" FontSize="10" FontWeight="Black" Foreground="#AFA0E8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border x:Name="PresCheckSummary" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                            <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="PresCardWorm" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_PresCardWorm_Click">
                                                    <Grid MinHeight="106">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="FLOW" FontSize="11" FontWeight="Black" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                            <TextBlock Text="MARGIN FLOW" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Lead over time" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            <TextBlock Text="KEY 3" FontSize="10" FontWeight="Black" Foreground="#57D8A9" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border x:Name="PresCheckWorm" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                            <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="PresCardStats" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_PresCardStats_Click">
                                                    <Grid MinHeight="106">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="DATA" FontSize="11" FontWeight="Black" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                            <TextBlock Text="STATS" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Full match stats" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            <TextBlock Text="KEY 4" FontSize="10" FontWeight="Black" Foreground="#E2A52C" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border x:Name="PresCheckStats" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                            <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="PresCardWeather" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_PresCardWeather_Click">
                                                    <Grid MinHeight="106">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="WX" FontSize="11" FontWeight="Black" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                            <TextBlock Text="WEATHER" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Live forecast" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            <TextBlock Text="KEY 5" FontSize="10" FontWeight="Black" Foreground="#58BEEA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border x:Name="PresCheckWeather" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                            <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="PresCardWindow" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_PresCardWindow_Click">
                                                    <Grid MinHeight="106">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock x:Name="WindowToggleIcon" Text="OUT" FontSize="11" FontWeight="Black" Foreground="#F472B6" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                            <TextBlock x:Name="WindowToggleTitle" Text="WINDOW" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                            <Grid HorizontalAlignment="Center" Margin="0,5,0,0" Width="40" Height="20" Cursor="Hand">
                                                                <Border x:Name="WindowToggleTrack" CornerRadius="10" Background="#21262D" BorderBrush="#7A8693" BorderThickness="1" />
                                                                <Border x:Name="WindowToggleThumb" Width="16" Height="16" CornerRadius="8" Background="#6A6A80" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                                                    <Border.RenderTransform>
                                                                        <TranslateTransform X="0" port:ProductionNames.Id="WindowToggleThumbTranslate" />
                                                                    </Border.RenderTransform>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock x:Name="WindowToggleLabel" Text="Open" FontSize="10" FontWeight="Black" Foreground="#A8B8C9" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="PresCardQuarterBreak" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_PresCardQuarterBreak_Click">
                                                    <Grid MinHeight="106">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="BREAK" FontSize="11" FontWeight="Black" Foreground="#F7D878" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                            <TextBlock Text="MATCH CARD" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Teams + totals" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border x:Name="PresCheckQuarterBreak" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                            <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="PresCardScreensaver" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="2" CornerRadius="12" Margin="5" PointerReleased="Native_PresCardScreensaver_Click">
                                                    <Grid MinHeight="106">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="IDLE" FontSize="11" FontWeight="Black" Foreground="#67E8F9" HorizontalAlignment="Center" Margin="0,0,0,7" />
                                                            <TextBlock Text="SCREENSAVER" FontSize="13" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Venue standby" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border x:Name="PresCheckScreensaver" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Opacity="0" IsHitTestVisible="False">
                                                            <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </UniformGrid>
                                            <Border Height="1" Margin="0,6,0,14">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                        <GradientStop Color="#0058A6FF" Offset="0" />
                                                        <GradientStop Color="#3058A6FF" Offset="0.5" />
                                                        <GradientStop Color="#0058A6FF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                <TextBlock Text="LIVE TRIGGERS" FontSize="16" FontWeight="Black" Foreground="White" Margin="0,0,0,2">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="12" Color="#3FB950" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="Manual actions always restore the scorebug and output before firing" FontSize="10" FontWeight="SemiBold" Foreground="#8DA397" />
                                            </StackPanel>
                                            <TextBlock Text="GAME ANALYSIS" FontSize="11" FontWeight="Black" Foreground="#75D286" Margin="3,0,0,6" />
                                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                                <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayStatsBar_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="STATS BAR" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayWinProb_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="🎯" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="WIN PROB" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayLeadChanges_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="↕" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="LEAD CHANGES" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayQtrScores_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="🏁" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="QTR SCORES" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayRecentScores_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="RECENT SCORES" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                            <TextBlock Text="SCORING EVENTS" FontSize="11" FontWeight="Black" Foreground="#E7B94F" Margin="3,0,0,6" />
                                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                                <Border Cursor="Hand" Background="#14100A" BorderBrush="#3A2A10" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayScoringRun_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="🔥" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="SCORING RUN" FontSize="11" FontWeight="Black" Foreground="#E7B94F" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Cursor="Hand" Background="#14100A" BorderBrush="#3A2A10" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayScoreless_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="⏱" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="LAST SCORE" FontSize="11" FontWeight="Black" Foreground="#E7B94F" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Cursor="Hand" Background="#0A1428" BorderBrush="#1A2A44" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayHomeDrought_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="🏠" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="HOME DROUGHT" FontSize="11" FontWeight="Black" Foreground="#9CCBFF" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Cursor="Hand" Background="#1A0A0A" BorderBrush="#3A1A1A" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayAwayDrought_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="✈" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="AWAY DROUGHT" FontSize="11" FontWeight="Black" Foreground="#FFB5B5" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                            <TextBlock Text="DISPLAY" FontSize="11" FontWeight="Black" Foreground="#78B7FF" Margin="3,0,0,6" />
                                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                                <Border Cursor="Hand" Background="#1A1408" BorderBrush="#C9B070" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayWarning_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="5 MIN WARN" FontSize="11" FontWeight="Black" Foreground="#E7B94F" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                            <TextBlock Text="WEATHER &amp; CONDITIONS" FontSize="11" FontWeight="Black" Foreground="#86C8F5" Margin="3,0,0,6" />
                                            <UniformGrid Columns="4" Margin="0,0,0,4">
                                                <Border Cursor="Hand" Background="#06101C" BorderBrush="#14284A" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayWeatherForecast_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="☀" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="FORECAST" FontSize="11" FontWeight="Black" Foreground="#86C8F5" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Cursor="Hand" Background="#06101C" BorderBrush="#14284A" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayWeatherStats_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="🌡" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="WEATHER" FontSize="11" FontWeight="Black" Foreground="#86C8F5" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Cursor="Hand" Background="#06101C" BorderBrush="#14284A" BorderThickness="2" Theme="{StaticResource OutputActionCard}" PointerReleased="Native_OverlayRainForecast_Click">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                        <TextBlock Text="🌧" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <TextBlock Text="RAIN" FontSize="11" FontWeight="Black" Foreground="#86C8F5" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                            <Button x:Name="CancelOverlayButton" Content="CANCEL CURRENT OVERLAY" Height="42" Margin="4,14,4,8" Cursor="Hand" FontSize="11" FontWeight="Black" Foreground="#FFD8D8" Background="#241014" BorderBrush="#A83D4C" BorderThickness="1" Click="CancelCurrentOverlay_Click" Theme="{StaticResource ToolBtn}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border Grid.Column="2" Background="#0A0E18" BorderBrush="#1A2A40" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Border Opacity="0.06" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="50%,15%" RadiusX="60%" RadiusY="50%">
                                                        <GradientStop Color="#3FB950" Offset="0" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid Margin="16,14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                                    <TextBlock Text="ON-AIR TICKER" FontSize="17" FontWeight="Black" Foreground="#67D17B" />
                                                    <TextBlock Text="Type a saved message, then switch it on. Multiple messages rotate automatically." FontSize="11" FontWeight="SemiBold" Foreground="#9ABDA2" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Content="WELCOME" Tag="Welcome to today's match" Click="TickerTemplate_Click" FontSize="9" FontWeight="Black" Padding="8,3" Margin="0,0,5,0" Theme="{StaticResource ToolBtn}" />
                                                        <Button Content="QUARTER BREAK" Tag="Quarter break — play resumes shortly" Click="TickerTemplate_Click" FontSize="9" FontWeight="Black" Padding="8,3" Margin="0,0,5,0" Theme="{StaticResource ToolBtn}" />
                                                        <Button Content="THANK YOU" Tag="Thank you for joining us today" Click="TickerTemplate_Click" FontSize="9" FontWeight="Black" Padding="8,3" Theme="{StaticResource ToolBtn}" />
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Border Background="#0C2112" BorderBrush="#245C31" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,8,0">
                                                            <TextBlock x:Name="TickerMessageCountText" Text="0 ON AIR" FontSize="10" FontWeight="Black" Foreground="#75E18A" />
                                                        </Border>
                                                        <Button x:Name="TickerDisableAllButton" Content="TURN ALL OFF" FontSize="9" FontWeight="Black" Padding="9,3" IsEnabled="False" Margin="0,0,5,0" Click="DisableAllTickerMessages_Click" BorderBrush="#4A5870" Foreground="#DCE5EF" Theme="{StaticResource ToolBtn}" />
                                                        <Button x:Name="TickerUndoDeleteButton" Content="UNDO DELETE" FontSize="9" FontWeight="Black" Padding="9,3" Margin="0,0,5,0" Click="UndoTickerDelete_Click" BorderBrush="#3A6A52" Foreground="#9FE6B7" IsVisible="False" Theme="{StaticResource ToolBtn}" />
                                                        <Button x:Name="TickerClearAllButton" Content="DELETE SAVED" FontSize="9" FontWeight="Black" Padding="9,3" IsEnabled="False" Click="ClearTickerMessages_Click" BorderBrush="#6B3030" Foreground="#FF9999" Theme="{StaticResource ToolBtn}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                                <Border Grid.Row="1" Height="1" Margin="0,0,0,10">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                            <GradientStop Color="#003FB950" Offset="0" />
                                                            <GradientStop Color="#303FB950" Offset="0.5" />
                                                            <GradientStop Color="#003FB950" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border Grid.Row="2" Background="#060A10" BorderBrush="#1A2A3A" BorderThickness="1" Padding="6">
                                                    <Grid>
                                                        <StackPanel x:Name="TickerEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300">
                                                            <TextBlock Text="✦" FontSize="30" Foreground="#3FB950" HorizontalAlignment="Center" />
                                                            <TextBlock Text="NO MESSAGES ON AIR" FontSize="15" FontWeight="Black" Foreground="#DCE7E0" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                                            <TextBlock Text="Choose a quick template or type a short update below. Press Enter to add it instantly." FontSize="12" FontWeight="SemiBold" Foreground="#8FA99A" TextAlignment="Center" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" ZIndex="1">
                                                            <ItemsControl x:Name="MessageList">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,0,6" Padding="8,7" Background="#0A1018" BorderBrush="#1E3050" BorderThickness="1" CornerRadius="6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <ToggleButton Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,10,0" IsCheckedChanged="Native_TickerSlotEnabled_Changed" Theme="{StaticResource TickerSlotToggle}" ToolTip.Tip="Show or hide this message on the public display" />
                                                                                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" Background="#060A10" Foreground="#E6EDF3" BorderBrush="#1E3050" CaretBrush="White" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,6,0" MaxLength="140" TextChanged="Native_MessageItem_TextChanged" />
                                                                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                                    <Button Width="32" Height="30" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Click="PickItemTextColor_Click" Tag="{Binding}" Background="{Binding TextBrush}" ToolTip.Tip="Text colour" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="3" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                    <Button Width="42" Height="30" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Click="PickItemHighlightColor_Click" Tag="{Binding}" Background="{Binding HighlightBrush}" ToolTip.Tip="Highlight colour · right-click to remove" PointerReleased="Native_ClearItemHighlightColor_Click" />
                                                                                </StackPanel>
                                                                                <Button Grid.Column="4" Content="×" Width="34" Height="34" FontSize="16" FontWeight="Black" Click="RemoveMessageItem_Click" Tag="{Binding}" BorderBrush="#3A1A1A" VerticalAlignment="Center" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Clear this preset slot" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="3" Margin="0" IsVisible="False">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                        <TextBlock Text="QUICK ADD" FontSize="11" FontWeight="Black" Foreground="#A8BBAE" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <Button Content="WELCOME" Tag="Welcome to today's match" Click="TickerTemplate_Click" FontSize="10" FontWeight="Black" Padding="8,3" Margin="0,0,5,0" Theme="{StaticResource ToolBtn}" />
                                                        <Button Content="QUARTER BREAK" Tag="Quarter break — play resumes shortly" Click="TickerTemplate_Click" FontSize="10" FontWeight="Black" Padding="8,3" Margin="0,0,5,0" Theme="{StaticResource ToolBtn}" />
                                                        <Button Content="THANK YOU" Tag="Thank you for joining us today" Click="TickerTemplate_Click" FontSize="10" FontWeight="Black" Padding="8,3" Theme="{StaticResource ToolBtn}" />
                                                    </StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="NewMessageBox" FontSize="13" MaxLength="140" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" CaretBrush="White" Padding="10,7" VerticalContentAlignment="Center" Margin="0,0,6,0" KeyDown="NewMessageBox_KeyDown" TextChanged="Native_NewMessageBox_TextChanged" ToolTip.Tip="Ticker message — maximum 140 characters" />
                                                        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="TEXT" FontSize="10" FontWeight="Bold" Foreground="#A9BDD2" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                            <Button x:Name="NewMessageTextColorBtn" Width="40" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Background="White" Click="PickNewTextColor_Click" ToolTip.Tip="Click to choose text colour for the new message" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="HIGHLIGHT" FontSize="10" FontWeight="Bold" Foreground="#A9BDD2" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                            <Button x:Name="NewMessageHighlightColorBtn" Width="56" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1" Background="Transparent" Click="PickNewHighlightColor_Click" PointerReleased="Native_ClearNewHighlightColor_Click" ToolTip.Tip="Click to choose highlight colour. Right-click to clear (no highlight)." />
                                                        </StackPanel>
                                                        <Button Grid.Column="3" Content="+" Width="34" Height="40" FontSize="14" FontWeight="Black" Click="AddMessage_Click" BorderBrush="#1A3A24" VerticalAlignment="Bottom" Theme="{StaticResource ToolBtn}" />
                                                    </Grid>
                                                    <TextBlock x:Name="TickerCharacterCountText" Text="0 / 140 · ENTER TO ADD" FontSize="10" FontWeight="SemiBold" Foreground="#738497" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <TabItem x:Name="MediaDeskTab" Header="3  MEDIA" Tag="VIDEO &amp; TICKER" ToolTip.Tip="Video playback and ticker messages · Ctrl+3">
                        <Border Background="#0A0E18" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Border Opacity="0.06" IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush Center="30%,20%" RadiusX="70%" RadiusY="70%">
                                            <GradientStop Color="#58A6FF" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid Margin="24,18,24,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                        <TextBlock Text="VIDEO PLAYBACK" FontSize="18" FontWeight="Black" Foreground="#58A6FF">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="14" Color="#58A6FF" Opacity="0.35" OffsetX="0" OffsetY="0" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="Upload, preview and broadcast custom video clips to the scoreboard window." FontSize="12" FontWeight="SemiBold" Foreground="#A9CCF2" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#0D1424" BorderBrush="#1F2A44" BorderThickness="1" Padding="18">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="MEDIA · CONTROL CENTRE" Foreground="#78B7FF" FontSize="12" FontWeight="Black" Margin="0,0,0,8" />
                                                <Border Background="#0A0E18" BorderBrush="#6F86A8" BorderThickness="1" Padding="14" Margin="0,0,0,18">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="VideoTabFilePathText" Text="No file selected" Foreground="#9CC4F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="1" Content="📁 Browse" Width="100" Height="30" Click="VideoTabBrowse_Click" Margin="10,0,0,0" BorderBrush="#6F86A8" FontWeight="Bold" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Pick a video or image file. It is auto-loaded into the scoreboard player." />
                                                        </Grid>
                                                        <TextBlock x:Name="VideoTabFileMetaText" Text="Supported: mp4, mov, mkv, webm, avi, wmv, m4v, ts, mpg, mpeg, 3gp, flv, png, jpg, jpeg, bmp, gif, tif, tiff, webp and other Windows-supported formats." Foreground="#8FB8E8" FontSize="11" Margin="0,8,0,12" TextWrapping="Wrap" />
                                                        <Button x:Name="VideoTabShowOnScoreboardButton" Content="🖥  Show on Scoreboard" Height="38" FontSize="13" FontWeight="Black" Click="VideoTabShowOnScoreboard_Click" IsEnabled="False" BorderBrush="#6F86A8" Margin="0,0,0,8" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Take over the scoreboard output with this video." />
                                                        <Button x:Name="VideoTabPlayPauseButton" Content="▶  Play" Height="40" FontSize="13" FontWeight="Black" Click="VideoTabPlayPause_Click" IsEnabled="False" BorderBrush="#1F7A3F" Background="#0E2A18" Foreground="#7FE0A0" Theme="{StaticResource ToolBtn}" />
                                                        <Button x:Name="VideoTabRestartButton" Content="⟲  Restart" Height="30" FontSize="11" FontWeight="Bold" Click="VideoTabRestart_Click" Margin="0,8,0,0" IsEnabled="False" BorderBrush="#6F86A8" Theme="{StaticResource ToolBtn}" />
                                                        <Button x:Name="VideoTabUnloadButton" Content="✕  Unload Video" Height="30" FontSize="11" FontWeight="Bold" Click="VideoTabUnload_Click" Margin="0,8,0,0" IsEnabled="False" BorderBrush="#5A2A2A" Background="#2A1212" Foreground="#E08080" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Stop playback, clear the current video, and return the scoreboard to its previous screen." />
                                                        <TextBlock x:Name="VideoTabStatusText" Text="No video loaded." Foreground="#7FE0A0" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="VideoTabApplyButton" Click="VideoTabApply_Click" IsEnabled="False" IsVisible="False" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2" Background="#000000" BorderBrush="#1F2A44" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Rectangle x:Name="VideoTabLiveMirror" Stretch="Uniform" />
                                                <Grid x:Name="VideoTabPreviewPlaceholder">
                                                    <Border Background="#0D1424" />
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="🎬" FontSize="56" HorizontalAlignment="Center" Foreground="#6F86A8" />
                                                        <TextBlock Text="PREVIEW" FontSize="14" FontWeight="Black" Foreground="#8FB8E8" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                        <TextBlock Text="Open the scoreboard window to see a live mirror here." FontSize="12" Foreground="#A9CCF2" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#A0000000" Padding="8,4" Margin="8">
                                                    <StackPanel>
                                                        <TextBlock x:Name="VideoTabPreviewBadge" Text="LIVE · MIRRORING SCOREBOARD" Foreground="#78B7FF" FontSize="11" FontWeight="Black" />
                                                        <TextBlock x:Name="VideoTabTelemetryText" Text="" Foreground="#7FE0A0" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                        <TextBlock x:Name="VideoTabDiagnosticText" Text="" Foreground="#E8D08A" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="320" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Border Grid.Row="1" Background="#0A0E18" BorderBrush="#1F2A44" BorderThickness="0,1,0,0" Padding="12,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="VideoTabCurrentTimeText" Grid.Column="0" Text="0:00" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="42" />
                                                        <Slider x:Name="VideoTabSeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" SmallChange="1" LargeChange="5" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="#FF0000" Background="#2A2A40" Thumb.DragStarted="VideoTabSeek_DragStarted" Thumb.DragCompleted="VideoTabSeek_DragCompleted" ValueChanged="VideoTabSeek_ValueChanged" PointerReleased="Native_VideoTabSeek_PreviewMouseLeftButtonUp" />
                                                        <TextBlock x:Name="VideoTabDurationText" Grid.Column="2" Text="0:00" Foreground="#8B97A8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right" />
                                                    </Grid>
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="SPEED" Foreground="#B8D7F6" FontSize="11" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <ComboBox x:Name="VideoTabSpeedCombo" Width="78" Height="26" Background="#0D1424" BorderBrush="#6F86A8" Foreground="#E6EDF3" SelectionChanged="Native_VideoTabSpeed_Changed">
                                                                <ComboBoxItem Content="0.25x" Tag="0.25" />
                                                                <ComboBoxItem Content="0.5x" Tag="0.5" />
                                                                <ComboBoxItem Content="0.75x" Tag="0.75" />
                                                                <ComboBoxItem Content="Normal" Tag="1.0" IsSelected="True" />
                                                                <ComboBoxItem Content="1.25x" Tag="1.25" />
                                                                <ComboBoxItem Content="1.5x" Tag="1.5" />
                                                                <ComboBoxItem Content="1.75x" Tag="1.75" />
                                                                <ComboBoxItem Content="2x" Tag="2.0" />
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" />
                                                        <Button x:Name="VideoTabMuteButton" Grid.Column="2" Content="🔊" Width="34" Height="26" FontSize="14" Click="VideoTabMute_Click" BorderBrush="#6F86A8" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Mute / unmute scoreboard audio" />
                                                        <Slider x:Name="VideoTabVolumeSlider" Grid.Column="3" Minimum="0" Maximum="1" Value="1" Width="100" Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="VideoTabVolume_Changed" ToolTip.Tip="Scoreboard volume" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <TabItem x:Name="MatchSetupTab" Header="4  SETUP" Tag="TEAMS &amp; OPTIONS" ToolTip.Tip="Teams, match options and app settings · Ctrl+4">
                        <Border Background="#0A0E18" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Border Opacity="0.05" IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush Center="70%,20%" RadiusX="60%" RadiusY="60%">
                                            <GradientStop Color="#3FB950" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#00000000" Offset="0.3" />
                                            <GradientStop Color="#30000000" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <RadioButton x:Name="ClockModeCountUp" IsChecked="True" GroupName="ClockMode" IsCheckedChanged="Native_ClockMode_Changed" IsVisible="False" />
                                <RadioButton x:Name="ClockModeCountdown" GroupName="ClockMode" IsCheckedChanged="Native_ClockMode_Changed" IsVisible="False" />
                                <RadioButton x:Name="LayoutClassicRadio" GroupName="LayoutChoice" IsChecked="True" IsCheckedChanged="Native_LayoutRadio_Changed" IsVisible="False" />
                                <RadioButton x:Name="LayoutExpandedRadio" GroupName="LayoutChoice" IsCheckedChanged="Native_LayoutRadio_Changed" IsVisible="False" />
                                <RadioButton x:Name="LayoutRetroRadio" GroupName="LayoutChoice" IsCheckedChanged="Native_LayoutRadio_Changed" IsVisible="False" />
                                <RadioButton x:Name="LayoutNoLogosRadio" GroupName="LayoutChoice" IsCheckedChanged="Native_LayoutRadio_Changed" IsVisible="False" />
                                <RadioButton x:Name="AnimBroadcastRadio" GroupName="AnimChoice" IsChecked="True" IsCheckedChanged="Native_AnimationRadio_Changed" IsVisible="False" />
                                <RadioButton x:Name="AnimElectricRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed" IsVisible="False" />
                                <RadioButton x:Name="AnimCinematicRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed" IsVisible="False" />
                                <RadioButton x:Name="AnimCleanRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed" IsVisible="False" />
                                <RadioButton x:Name="AnimClassicRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed" IsVisible="False" />
                                <RadioButton x:Name="AnimCustomVideoRadio" GroupName="AnimChoice" IsCheckedChanged="Native_AnimationRadio_Changed" IsVisible="False" />
                                <CheckBox x:Name="SettingsShowControlPanelCountdown" IsChecked="True" IsVisible="False" />
                                <TextBlock x:Name="HomeLogoPathText" IsVisible="False" />
                                <TextBlock x:Name="AwayLogoPathText" IsVisible="False" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="214" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="14" BorderBrush="#304158" BorderThickness="0,0,1,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#152238" Offset="0" />
                                                <GradientStop Color="#0E1726" Offset="0.55" />
                                                <GradientStop Color="#161B25" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="SettingsHeaderTitle" Text="LIVE MATCH SETTINGS" Foreground="#F2F6FC" FontSize="18" FontWeight="Black" />
                                                <TextBlock x:Name="SettingsHeaderSubtitle" Text="AFL match, controls and output" Foreground="#9FB0C6" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,14,0,0">
                                                <Border x:Name="SettingsNavBtn_Teams" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" PointerReleased="Native_SettingsNav_Teams_Click">
                                                    <TextBlock Text="MATCH" FontSize="10" FontWeight="Black" Foreground="#58A6FF" />
                                                </Border>
                                                <Border x:Name="SettingsNavBtn_Keybinds" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" PointerReleased="Native_SettingsNav_Keybinds_Click">
                                                    <TextBlock Text="CONTROLS" FontSize="10" FontWeight="Black" Foreground="#A78BFA" />
                                                </Border>
                                                <Border x:Name="SettingsNavBtn_Display" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" PointerReleased="Native_SettingsNav_Display_Click">
                                                    <TextBlock Text="SCOREBOARD" FontSize="10" FontWeight="Black" Foreground="#58A6FF" />
                                                </Border>
                                                <Border x:Name="SettingsNavBtn_Overlays" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" PointerReleased="Native_SettingsNav_Overlays_Click">
                                                    <TextBlock Text="AUTOMATION" FontSize="10" FontWeight="Black" Foreground="#3FB950" />
                                                </Border>
                                                <Border x:Name="SettingsNavBtn_Media" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" PointerReleased="Native_SettingsNav_Media_Click">
                                                    <TextBlock Text="ASSETS" FontSize="10" FontWeight="Black" Foreground="#58A6FF" />
                                                </Border>
                                                <Border x:Name="SettingsNavBtn_Advanced" CornerRadius="6" Padding="12,10" Margin="0" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" PointerReleased="Native_SettingsNav_Advanced_Click">
                                                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Black" Foreground="#8B949E" />
                                                </Border>
                                            </StackPanel>
                                            <Border x:Name="SettingsSearchHost" Grid.Row="1" Background="#090F19" BorderBrush="#52647A" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,12,0,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBox x:Name="SettingsSearchBox" Grid.Column="1" Background="Transparent" Foreground="#E6EDF3" CaretBrush="#58A6FF" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center" TextChanged="Native_SettingsSearch_TextChanged" ToolTip.Tip="Search all settings (Ctrl+F)" />
                                                    <TextBlock x:Name="SettingsSearchPlaceholder" Grid.Column="1" Text="Search settings…" FontSize="11" Foreground="#A8B0BA" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,0,0" />
                                                    <Border x:Name="SettingsSearchClear" Grid.Column="2" Padding="4,0,0,0" Cursor="Hand" IsVisible="False" PointerReleased="Native_SettingsSearchClear_Click">
                                                        <TextBlock Text="✕" FontSize="11" Foreground="#8B949E" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="SettingsEssentialsHint" Grid.Row="3" Text="Specialist controls are hidden. Use Advanced Tools when you need automation, media or system settings." Foreground="#8FB8A0" FontSize="9" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,12,2,0" IsVisible="False" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="SettingsNoResults" Grid.Column="1" Background="Transparent" IsVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Foreground="#7A8693" Margin="0,40,0,8" />
                                            <TextBlock x:Name="SettingsNoResultsText" Text="No settings match your search" FontSize="13" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" />
                                            <TextBlock Text="Try a different keyword or clear the filter" FontSize="10" Foreground="#A8B0BA" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" Margin="14,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <Border x:Name="SettingsSection_Teams" Tag="teams team home away name abbreviation colour color logo primary secondary jumper" Theme="{StaticResource SettingsSectionSurface}">
                                                <StackPanel>
                                                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                        <TextBlock Text="TEAMS" FontSize="14" FontWeight="Black" Foreground="#58A6FF" Margin="0,0,0,2">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="12" Color="#58A6FF" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="Edit team names, abbreviations, colours, and logos" FontSize="9" FontWeight="SemiBold" Foreground="#8FB8E8" />
                                                    </StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1,2,1,1" Padding="14,10">
                                                            <Grid>
                                                                <Border Opacity="0.06" IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <RadialGradientBrush Center="50%,30%" RadiusX="60%" RadiusY="50%">
                                                                            <GradientStop Color="#58A6FF" Offset="0" />
                                                                            <GradientStop Color="#00000000" Offset="1" />
                                                                        </RadialGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel>
                                                                    <Border Background="#1A3A6A" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                                        <TextBlock Text="HOME TEAM" Foreground="#7EB4FF" FontSize="10" FontWeight="Black" />
                                                                    </Border>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="8" />
                                                                            <ColumnDefinition Width="70" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox x:Name="HomeNameBox" Text="Home Team" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="10,7" VerticalContentAlignment="Center" TextChanged="Native_TeamSettings_TextChanged" />
                                                                        <TextBox x:Name="HomeAbbrBox" Grid.Column="2" Text="HOM" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="6,7" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="4" TextChanged="Native_TeamSettings_TextChanged" />
                                                                    </Grid>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBox x:Name="HomeColorBox" Width="66" Text="#0A2A6A" FontSize="10" VerticalContentAlignment="Center" Margin="0,0,3,0" IsVisible="False" />
                                                                        <Border x:Name="HomeColorPreview" Width="30" Height="28" Background="#0A2A6A" BorderBrush="#7DA0CA" BorderThickness="1" Cursor="Hand" PointerReleased="Native_PickHomeColor_Click" />
                                                                        <Border Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_DropperHomeColor_Click">
                                                                            <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBox x:Name="HomeSecondaryColorBox" Width="66" Text="#FFFFFF" FontSize="10" VerticalContentAlignment="Center" IsVisible="False" />
                                                                        <Border x:Name="HomeSecondaryColorPreview" Width="30" Height="28" Background="#FFFFFF" BorderBrush="#7DA0CA" BorderThickness="1" Cursor="Hand" Margin="8,0,0,0" PointerReleased="Native_PickHomeSecondaryColor_Click" />
                                                                        <Border Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_DropperHomeSecondaryColor_Click">
                                                                            <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBlock Text="Primary" Foreground="#7DA0CA" FontSize="8" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                        <TextBlock Text="/ Text" Foreground="#7DA0CA" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                        <Button Content="📂 Logo" Height="26" FontSize="10" FontWeight="Bold" Click="BrowseHomeLogo_Click" BorderBrush="#1A3A6A" Padding="8,0" Theme="{StaticResource ToolBtn}" />
                                                                        <Button Content="✕" Width="26" Height="26" FontSize="10" FontWeight="Bold" Click="ClearHomeLogo_Click" BorderBrush="#3A2020" Margin="4,0,0,0" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Remove logo" />
                                                                        <TextBlock x:Name="HomeLogoStatusText" Text="" Foreground="#7DA0CA" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Column="2" Background="#1A0A0A" BorderBrush="#6A1A1A" BorderThickness="1,2,1,1" Padding="14,10">
                                                            <Grid>
                                                                <Border Opacity="0.06" IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <RadialGradientBrush Center="50%,30%" RadiusX="60%" RadiusY="50%">
                                                                            <GradientStop Color="#FF6B6B" Offset="0" />
                                                                            <GradientStop Color="#00000000" Offset="1" />
                                                                        </RadialGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel>
                                                                    <Border Background="#4A1A1A" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                                        <TextBlock Text="AWAY TEAM" Foreground="#FF9A9A" FontSize="10" FontWeight="Black" />
                                                                    </Border>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="8" />
                                                                            <ColumnDefinition Width="70" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox x:Name="AwayNameBox" Text="Away Team" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="10,7" VerticalContentAlignment="Center" TextChanged="Native_TeamSettings_TextChanged" />
                                                                        <TextBox x:Name="AwayAbbrBox" Grid.Column="2" Text="AWA" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="6,7" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="4" TextChanged="Native_TeamSettings_TextChanged" />
                                                                    </Grid>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBox x:Name="AwayColorBox" Width="66" Text="#7A1A1A" FontSize="10" VerticalContentAlignment="Center" Margin="0,0,3,0" IsVisible="False" />
                                                                        <Border x:Name="AwayColorPreview" Width="30" Height="28" Background="#7A1A1A" BorderBrush="#7DA0CA" BorderThickness="1" Cursor="Hand" PointerReleased="Native_PickAwayColor_Click" />
                                                                        <Border Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_DropperAwayColor_Click">
                                                                            <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBox x:Name="AwaySecondaryColorBox" Width="66" Text="#FFFFFF" FontSize="10" VerticalContentAlignment="Center" IsVisible="False" />
                                                                        <Border x:Name="AwaySecondaryColorPreview" Width="30" Height="28" Background="#FFFFFF" BorderBrush="#7DA0CA" BorderThickness="1" Cursor="Hand" Margin="8,0,0,0" PointerReleased="Native_PickAwaySecondaryColor_Click" />
                                                                        <Border Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" Margin="3,0,0,0" PointerReleased="Native_DropperAwaySecondaryColor_Click">
                                                                            <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBlock Text="Primary" Foreground="#523030" FontSize="8" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                        <TextBlock Text="/ Text" Foreground="#523030" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                        <Button Content="📂 Logo" Height="26" FontSize="10" FontWeight="Bold" Click="BrowseAwayLogo_Click" BorderBrush="#4A1A1A" Padding="8,0" Theme="{StaticResource ToolBtn}" />
                                                                        <Button Content="✕" Width="26" Height="26" FontSize="10" FontWeight="Bold" Click="ClearAwayLogo_Click" BorderBrush="#3A2020" Margin="4,0,0,0" Theme="{StaticResource ToolBtn}" ToolTip.Tip="Remove logo" />
                                                                        <TextBlock x:Name="AwayLogoStatusText" Text="" Foreground="#523030" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="SettingsSection_Match" Tag="match clock countdown count up quarter duration minutes seconds finals timer time siren adjust set quarter labels custom break ht qt ft override" Theme="{StaticResource SettingsSectionSurface}">
                                                <StackPanel>
                                                    <Border Height="1" Margin="0,0,0,14">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="#00D29922" Offset="0" />
                                                                <GradientStop Color="#30D29922" Offset="0.5" />
                                                                <GradientStop Color="#00D29922" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                        <TextBlock Text="MATCH" FontSize="14" FontWeight="Black" Foreground="#D29922" Margin="0,0,0,2">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="12" Color="#D29922" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="Choose the scoreboard clock. Stoppage time is a separate operator tool." FontSize="9" FontWeight="SemiBold" Foreground="#C9A74A" />
                                                    </StackPanel>
                                                    <Grid Margin="0,0,0,8" Height="100">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border x:Name="SettingsCountUpCard" Grid.Column="0" Cursor="Hand" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="2" PointerReleased="Native_SettingsCountUpCard_Click">
                                                            <Grid>
                                                                <Border x:Name="SettingsCountUpGlow" Opacity="0.12" IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                            <GradientStop Color="#58A6FF" Offset="0" />
                                                                            <GradientStop Color="#00000000" Offset="1" />
                                                                        </RadialGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="▲" FontSize="26" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center">
                                                                        <TextBlock.Effect>
                                                                            <DropShadowEffect BlurRadius="10" Color="#58A6FF" Opacity="0.5" OffsetX="0" OffsetY="0" />
                                                                        </TextBlock.Effect>
                                                                    </TextBlock>
                                                                    <TextBlock Text="COUNT UP" FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                                <Border x:Name="SettingsCountUpCheck" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="6,3">
                                                                    <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="SettingsCountdownCard" Grid.Column="2" Cursor="Hand" Background="#0E0C08" BorderBrush="#C9B070" BorderThickness="1" PointerReleased="Native_SettingsCountdownCard_Click">
                                                            <Grid>
                                                                <Border x:Name="SettingsCountdownGlow" Opacity="0" IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                            <GradientStop Color="#D29922" Offset="0" />
                                                                            <GradientStop Color="#00000000" Offset="1" />
                                                                        </RadialGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="▼" FontSize="26" FontWeight="Black" Foreground="#6B5A00" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="COUNTDOWN" FontSize="14" FontWeight="Black" Foreground="#8A7A50" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                                <Border x:Name="SettingsCountdownCheck" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="6,3" IsVisible="False">
                                                                    <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="#1A1400" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                    <Border x:Name="SettingsControlPanelCountdownOptionCard" Margin="0,0,0,8" Padding="14,10" Background="#10161D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12" Cursor="Hand" Opacity="0" RenderTransformOrigin="50%,50%" IsVisible="False" PointerReleased="Native_SettingsControlPanelCountdownOptionCard_Click">
                                                        <Border.RenderTransform>
                                                            <TransformGroup>
                                                                <TranslateTransform Y="18" port:ProductionNames.Id="SettingsControlPanelCountdownCardTranslate" />
                                                                <ScaleTransform ScaleX="0.97" ScaleY="0.97" port:ProductionNames.Id="SettingsControlPanelCountdownCardScale" />
                                                            </TransformGroup>
                                                        </Border.RenderTransform>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <TextBlock Text="⏱" FontSize="16" Foreground="#58A6FF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <TextBlock Text="Show stoppage clock in Match tab" Foreground="White" FontSize="14" FontWeight="Black" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="Independent operator countdown for count-up games. It never changes the scoreboard clock." Foreground="#C9D1D9" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0" HorizontalAlignment="Center">
                                                                <Border x:Name="SettingsControlPanelCountdownToggleTrack" Width="50" Height="26" CornerRadius="13" Background="#1F6FEB">
                                                                    <Ellipse x:Name="SettingsControlPanelCountdownToggleThumb" Width="20" Height="20" Fill="White" Margin="3,3,0,3" HorizontalAlignment="Left">
                                                                        <Ellipse.RenderTransform>
                                                                            <TranslateTransform X="24" port:ProductionNames.Id="SettingsControlPanelCountdownThumbTranslate" />
                                                                        </Ellipse.RenderTransform>
                                                                    </Ellipse>
                                                                </Border>
                                                                <TextBlock x:Name="SettingsControlPanelCountdownToggleLabel" Text="ON" Foreground="#58A6FF" FontSize="9" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel x:Name="QuarterDurationPanel" Margin="0,0,0,8" IsVisible="False">
                                                        <Border Background="#0C0A04" BorderBrush="#C9B070" BorderThickness="1" Padding="14">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="SCOREBOARD COUNTDOWN START" FontSize="9" FontWeight="Black" Foreground="#8A7A40" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <Border Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" PointerReleased="Native_SettingsMinutesMinus_Click">
                                                                        <TextBlock Text="−" FontSize="18" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" MinWidth="56" Height="52" Padding="0" Margin="6,0">
                                                                        <TextBox x:Name="QuarterMinutesBox" Text="20" FontSize="30" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="3" KeyDown="QuarterDurationBox_KeyDown">
                                                                            <TextBox.Effect>
                                                                                <DropShadowEffect BlurRadius="10" Color="#D29922" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                                            </TextBox.Effect>
                                                                        </TextBox>
                                                                    </Border>
                                                                    <Border Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" PointerReleased="Native_SettingsMinutesPlus_Click">
                                                                        <TextBlock Text="+" FontSize="18" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Text=":" FontSize="30" FontWeight="Black" Foreground="#6B5A00" VerticalAlignment="Center" Margin="8,0" />
                                                                    <Border Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" PointerReleased="Native_SettingsSecondsMinus_Click">
                                                                        <TextBlock Text="−" FontSize="18" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" MinWidth="56" Height="52" Padding="0" Margin="6,0">
                                                                        <TextBox x:Name="QuarterSecondsBox" Text="00" FontSize="30" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="2" KeyDown="QuarterDurationBox_KeyDown">
                                                                            <TextBox.Effect>
                                                                                <DropShadowEffect BlurRadius="10" Color="#D29922" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                                            </TextBox.Effect>
                                                                        </TextBox>
                                                                    </Border>
                                                                    <Border Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" PointerReleased="Native_SettingsSecondsPlus_Click">
                                                                        <TextBlock Text="+" FontSize="18" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                                    <TextBlock Text="MINUTES" FontSize="8" FontWeight="SemiBold" Foreground="#6B5A00" Width="128" TextAlignment="Center" />
                                                                    <TextBlock Text="SECONDS" FontSize="8" FontWeight="SemiBold" Foreground="#6B5A00" Width="128" TextAlignment="Center" Margin="16,0,0,0" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ClockStatusText" Text="Count Up · Stopped · 00:00" Foreground="#D29922" FontSize="10" Margin="0,0,0,8" />
                                                    <Border Height="0" Margin="0" Opacity="0" IsHitTestVisible="False" IsVisible="False" />
                                                    <Expander Header="CORRECT SCOREBOARD CLOCK" Theme="{StaticResource SettingsExpander}">
                                                        <Border Background="#0C0A04" BorderBrush="#C9B070" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <TextBlock Text="LIVE SCOREBOARD CLOCK" FontSize="9" FontWeight="Black" Foreground="#8A7A40" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                                <TextBlock Text="Only changes the quarter clock shown on the scoreboard. Edit stoppage time from STOPPAGE CLOCK in the Match tab." FontSize="9" Foreground="#A68F56" TextWrapping="Wrap" TextAlignment="Center" Margin="4,0,4,8" />
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <Button Content="−10s" Width="46" Height="28" FontSize="10" FontWeight="Bold" Click="ClockMinus10_Click" BorderBrush="#C9B070" Margin="0,0,4,0" Theme="{StaticResource ToolBtn}" />
                                                                    <Button Content="−1s" Width="40" Height="28" FontSize="10" FontWeight="Bold" Click="ClockMinus1_Click" BorderBrush="#C9B070" Margin="0,0,8,0" Theme="{StaticResource ToolBtn}" />
                                                                    <Button Content="+1s" Width="40" Height="28" FontSize="10" FontWeight="Bold" Click="ClockPlus1_Click" BorderBrush="#C9B070" Margin="0,0,4,0" Theme="{StaticResource ToolBtn}" />
                                                                    <Button Content="+10s" Width="46" Height="28" FontSize="10" FontWeight="Bold" Click="ClockPlus10_Click" BorderBrush="#C9B070" Theme="{StaticResource ToolBtn}" />
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                                    <TextBlock Text="SET:" FontSize="9" FontWeight="Black" Foreground="#6B5A00" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" Width="40" Height="28" Padding="0">
                                                                        <TextBox x:Name="ClockSetMinutesBox" Text="00" FontSize="14" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="3" />
                                                                    </Border>
                                                                    <TextBlock Text=":" FontSize="14" FontWeight="Black" Foreground="#6B5A00" VerticalAlignment="Center" Margin="2,0" />
                                                                    <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" Width="34" Height="28" Padding="0">
                                                                        <TextBox x:Name="ClockSetSecondsBox" Text="00" FontSize="14" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="2" />
                                                                    </Border>
                                                                    <Button Content="SET" Width="36" Height="28" FontSize="9" FontWeight="Black" Click="ClockSet_Click" BorderBrush="#6B5A00" Foreground="#D29922" Margin="6,0,0,0" Theme="{StaticResource ToolBtn}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Expander>
                                                    <CheckBox x:Name="SettingsFinalsToggle" IsCheckedChanged="Native_SettingsFinalsToggle_Changed" IsVisible="False" />
                                                    <Border x:Name="SettingsFinalsCard" Background="#0A0806" BorderBrush="#2A2020" BorderThickness="1" Padding="14" Margin="0,0,0,8" Cursor="Hand" PointerReleased="Native_SettingsFinalsCard_Click">
                                                        <Grid>
                                                            <Border x:Name="SettingsFinalsGlow" Opacity="0" IsHitTestVisible="False">
                                                                <Border.Background>
                                                                    <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                        <GradientStop Color="#D4A017" Offset="0" />
                                                                        <GradientStop Color="#00000000" Offset="1" />
                                                                    </RadialGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="★" FontSize="22" FontFamily="{fonts:ProductionFont 'Bahnschrift'}" FontWeight="Black" Foreground="#D8B84F" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock x:Name="SettingsFinalsTitle" Text="FINALS MODE" FontSize="13" FontWeight="Black" Foreground="#5A4A20" Margin="0,0,0,2" />
                                                                    <TextBlock Text="Golden bar styling and time-on after siren in final quarter" FontSize="9" FontWeight="SemiBold" Foreground="#C9B070" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                <Grid Width="44" Height="24">
                                                                    <Border x:Name="SettingsFinalsTrack" CornerRadius="12" Background="#1A1610" BorderBrush="#C9B070" BorderThickness="1" />
                                                                    <Border x:Name="SettingsFinalsThumb" Width="18" Height="18" CornerRadius="9" Background="#5A4A20" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <CheckBox x:Name="SettingsHideTeamNamesToggle" IsCheckedChanged="Native_SettingsHideTeamNamesToggle_Changed" IsVisible="False" />
                                                    <Border x:Name="SettingsHideTeamNamesCard" Background="#080A12" BorderBrush="#1C2030" BorderThickness="1" Padding="14" Margin="0,0,0,8" Cursor="Hand" PointerReleased="Native_SettingsHideTeamNamesCard_Click">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🔠" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock x:Name="SettingsHideTeamNamesTitle" Text="HIDE TEAM NAMES" FontSize="13" FontWeight="Black" Foreground="#4A5A70" Margin="0,0,0,2" />
                                                                    <TextBlock Text="Removes name panels while keeping professional, digit-safe score sizing" FontSize="9" FontWeight="SemiBold" Foreground="#A8B8CC" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                <Grid Width="44" Height="24">
                                                                    <Border x:Name="SettingsHideTeamNamesTrack" CornerRadius="12" Background="#131620" BorderBrush="#2A3040" BorderThickness="1" />
                                                                    <Border x:Name="SettingsHideTeamNamesThumb" Width="18" Height="18" CornerRadius="9" Background="#3A4050" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Border Background="#0A0806" BorderBrush="#2A2020" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                <TextBlock Text="🏷" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="QUARTER LABEL" FontSize="12" FontWeight="Black" Foreground="#D29922" Margin="0,0,0,2" />
                                                                    <TextBlock Text="Override the centre quarter/break label shown on the scoreboard right now. Updates live. Resetting restores the default for the current state." FontSize="9" FontWeight="SemiBold" Foreground="#6B5A00" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Grid Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="QuarterLabelCurrentBox" Grid.Column="0" MaxLength="12" FontSize="13" FontWeight="Bold" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#C9B070" BorderThickness="1" CaretBrush="White" Padding="10,6" TextWrapping="NoWrap" TextChanged="Native_QuarterLabelCurrentBox_TextChanged" />
                                                                <Button x:Name="QuarterLabelCurrentReset" Grid.Column="1" Content="Reset" Width="74" Height="28" FontSize="10" FontWeight="Bold" Click="QuarterLabelCurrentReset_Click" BorderBrush="#C9B070" Margin="6,0,0,0" Theme="{StaticResource ToolBtn}" />
                                                            </Grid>
                                                            <TextBlock x:Name="QuarterLabelCurrentHint" FontSize="9" FontWeight="SemiBold" Foreground="#6B5A00" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="SettingsMatchSectionEndAnchor" IsVisible="False" />
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="SettingsSection_Keybinds" Tag="keybind keybinds keyboard hotkeys shortcuts toggle clock start pause home away goal behind end quarter" Theme="{StaticResource SettingsSectionSurface}" IsVisible="False">
                                                <StackPanel>
                                                    <Border Height="1" Margin="0,0,0,14">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="#00A78BFA" Offset="0" />
                                                                <GradientStop Color="#30A78BFA" Offset="0.5" />
                                                                <GradientStop Color="#00A78BFA" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                        <TextBlock Text="KEYBINDS" FontSize="14" FontWeight="Black" Foreground="#A78BFA" Margin="0,0,0,2">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="12" Color="#A78BFA" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="Set your keyboard shortcuts for live control actions" FontSize="9" FontWeight="SemiBold" Foreground="#C4B5FD" />
                                                    </StackPanel>
                                                    <Border Background="#120A20" BorderBrush="#3B2A62" BorderThickness="1" Padding="14">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Start / Pause Clock" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button x:Name="KeybindToggleClockButton" Grid.Column="1" Content="Space" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindToggleClockButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                            </Grid>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Home Goal" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button x:Name="KeybindHomeGoalButton" Grid.Column="1" Content="A" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindHomeGoalButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                            </Grid>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Home Behind" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button x:Name="KeybindHomeBehindButton" Grid.Column="1" Content="S" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindHomeBehindButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                            </Grid>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Away Goal" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button x:Name="KeybindAwayGoalButton" Grid.Column="1" Content="K" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindAwayGoalButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                            </Grid>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Away Behind" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button x:Name="KeybindAwayBehindButton" Grid.Column="1" Content="L" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindAwayBehindButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                            </Grid>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="End Quarter" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button x:Name="KeybindEndQuarterButton" Grid.Column="1" Content="N" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindEndQuarterButton_Click" BorderBrush="#7C3AED" Foreground="#C4B5FD" Theme="{StaticResource ToolBtn}" />
                                                            </Grid>
                                                            <TextBlock x:Name="KeybindHintText" Text="Click a keybind, then press any key. Esc cancels." Foreground="#A8B0BA" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="SettingsSection_Display" Tag="display appearance layout goal animation broadcast electric cinematic clean classic custom video scorebug theme" Theme="{StaticResource SettingsSectionSurface}">
                                                <StackPanel>
                                                    <Border Height="1" Margin="0,0,0,14">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="#0058A6FF" Offset="0" />
                                                                <GradientStop Color="#3058A6FF" Offset="0.5" />
                                                                <GradientStop Color="#0058A6FF" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                        <TextBlock Text="DISPLAY" FontSize="18" FontWeight="Black" Foreground="#58A6FF" Margin="0,0,0,2">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="12" Color="#58A6FF" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="Goal animation, public-display clarity and responsive output safeguards" FontSize="12" FontWeight="SemiBold" Foreground="#A9CDEF" />
                                                    </StackPanel>
                                                    <Expander Header="IDLE SCREEN / SCREENSAVER" IsExpanded="True" Margin="0,0,0,10" Theme="{StaticResource SettingsExpander}">
                                                        <Border Background="#0A121E" BorderBrush="#29445F" BorderThickness="1" CornerRadius="8" Padding="14">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="PUBLIC DISPLAY STANDBY" Foreground="#67E8F9" FontSize="11" FontWeight="Black" />
                                                                    <TextBlock Text="Shown before setup and after reset. Use the lightweight sports scene, or choose a club image/video." Foreground="#B8C8D8" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,12,0" />
                                                                    <TextBlock x:Name="ScreensaverMediaStatus" Text="Default animated sports scene" Foreground="#DDEAF5" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,12,0" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <Button Content="CHOOSE IMAGE / VIDEO" Click="ChooseScreensaverMedia_Click" Padding="12,8" Margin="0,0,0,6" BorderBrush="#2F91B8" Foreground="#8DEBFF" Theme="{StaticResource ToolBtn}" />
                                                                    <Button Content="USE DEFAULT" Click="ResetScreensaverMedia_Click" Padding="12,8" BorderBrush="#52647A" Foreground="#D5DFEA" Theme="{StaticResource ToolBtn}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Expander>
                                                    <Expander Header="SCOREBUG LAYOUT" IsExpanded="True" Margin="0,0,0,12" Theme="{StaticResource SettingsExpander}">
                                                        <StackPanel>
                                                            <TextBlock Text="Choose the public-display hierarchy. This is remembered for the next match." Foreground="#9EB0C4" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,9" TextWrapping="Wrap" />
                                                            <UniformGrid Columns="2">
                                                                <Border x:Name="LayoutCardClassic" Cursor="Hand" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="2" CornerRadius="8" Padding="14" Margin="0,0,5,0" PointerReleased="Native_ClassicLayoutCard_Click">
                                                                    <Grid MinHeight="74">
                                                                        <Border x:Name="LayoutGlowClassic" Opacity="0.12" IsHitTestVisible="False" Background="#58A6FF" />
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="CLASSIC" Foreground="White" FontSize="14" FontWeight="Black" />
                                                                            <TextBlock Text="Weather, wall time and date across the top" Foreground="#AFC1D4" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,24,0" />
                                                                        </StackPanel>
                                                                        <Border x:Name="LayoutCheckClassic" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" CornerRadius="9" Padding="5,2" IsVisible="True">
                                                                            <TextBlock Text="✓" Foreground="#06101D" FontWeight="Black" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <Border x:Name="LayoutCardExpanded" Cursor="Hand" Background="#0E0E1A" BorderBrush="#2A2A40" BorderThickness="2" CornerRadius="8" Padding="14" Margin="5,0,0,0" PointerReleased="Native_ExpandedLayoutCard_Click">
                                                                    <Grid MinHeight="74">
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="DISTANCE" Foreground="#DDE9F5" FontSize="14" FontWeight="Black" />
                                                                            <TextBlock Text="No top bar · larger teams and scores · wall time beside the match clock" Foreground="#AFC1D4" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,24,0" />
                                                                        </StackPanel>
                                                                        <Border x:Name="LayoutCheckExpanded" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" CornerRadius="9" Padding="5,2" IsVisible="False">
                                                                            <TextBlock Text="✓" Foreground="#06101D" FontWeight="Black" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </UniformGrid>
                                                            <Grid IsVisible="False">
                                                                <Border x:Name="LayoutCardRetro">
                                                                    <Grid>
                                                                        <Border x:Name="LayoutCheckRetro" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border x:Name="LayoutCardNoLogos">
                                                                    <Grid>
                                                                        <Border x:Name="LayoutCheckNoLogos" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                    <TextBlock Text="GOAL MOMENT" FontSize="13" FontWeight="Black" Foreground="#D2B45D" Margin="0,0,0,3" />
                                                    <TextBlock Text="Five purpose-built motion packages. Select one, then preview it on the live output." FontSize="11" FontWeight="SemiBold" Foreground="#8FA2B7" Margin="0,0,0,10" />
                                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                                        <Border x:Name="AnimCardBroadcast" Cursor="Hand" Background="#0B1726" BorderBrush="#285A86" BorderThickness="1" CornerRadius="8" Margin="0,0,4,4" PointerReleased="Native_AnimBroadcastCard_Click">
                                                            <Grid MinHeight="96">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="TV" FontFamily="{fonts:ProductionFont 'Arial'}" FontSize="24" FontWeight="Black" Foreground="#63B3FF" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                    <TextBlock Text="SIGNAL" FontSize="13" FontWeight="Black" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="Layered reveal · dual sweep" FontSize="9" FontWeight="SemiBold" Foreground="#7E9DBB" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                                <Border x:Name="AnimCheckBroadcast" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="True">
                                                                    <TextBlock Text="✓" FontSize="8" FontWeight="Black" Foreground="#1A1400" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="AnimCardElectric" Cursor="Hand" Background="#091C21" BorderBrush="#1D7685" BorderThickness="1" CornerRadius="8" Margin="4,0,0,4" PointerReleased="Native_AnimElectricCard_Click">
                                                            <Grid MinHeight="96">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="ϟ" FontFamily="{fonts:ProductionFont 'Arial'}" FontSize="28" FontWeight="Black" Foreground="#59F3FF" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                                    <TextBlock Text="VOLTAGE" FontSize="13" FontWeight="Black" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="Side charge · electric cut" FontSize="9" FontWeight="SemiBold" Foreground="#77AAB2" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                                <Border x:Name="AnimCheckElectric" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                    <TextBlock Text="✓" FontSize="8" FontWeight="Black" Foreground="#1A1400" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="AnimCardCinematic" Cursor="Hand" Background="#171126" BorderBrush="#694A96" BorderThickness="1" CornerRadius="8" Margin="0,4,4,4" PointerReleased="Native_AnimCinematicCard_Click">
                                                            <Grid MinHeight="96">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="◆" FontFamily="{fonts:ProductionFont 'Arial'}" FontSize="25" Foreground="#C6A5FF" HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                                    <TextBlock Text="CLUB CINEMA" FontSize="13" FontWeight="Black" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="Crest reveal · cinematic bloom" FontSize="9" FontWeight="SemiBold" Foreground="#A48CC2" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                                <Border x:Name="AnimCheckCinematic" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                    <TextBlock Text="✓" FontSize="8" FontWeight="Black" Foreground="#1A1400" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="AnimCardClean" Cursor="Hand" Background="#0B1D18" BorderBrush="#2D765E" BorderThickness="1" CornerRadius="8" Margin="4,4,0,4" PointerReleased="Native_AnimCleanCard_Click">
                                                            <Grid MinHeight="96">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="●" FontFamily="{fonts:ProductionFont 'Arial'}" FontSize="24" Foreground="#68E0B7" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                    <TextBlock Text="CLEAN IMPACT" FontSize="13" FontWeight="Black" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="Score-first · fast dissolve" FontSize="9" FontWeight="SemiBold" Foreground="#82AA9C" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                                <Border x:Name="AnimCheckClean" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                    <TextBlock Text="✓" FontSize="8" FontWeight="Black" Foreground="#1A1400" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="AnimCardClassic" Cursor="Hand" Background="#201808" BorderBrush="#826322" BorderThickness="1" CornerRadius="8" Margin="0,4,4,0" PointerReleased="Native_AnimClassicCard_Click">
                                                            <Grid MinHeight="96">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="88" FontFamily="{fonts:ProductionFont 'Consolas'}" FontSize="23" FontWeight="Black" Foreground="#FFC857" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                    <TextBlock Text="FLIPBOARD" FontSize="13" FontWeight="Black" Foreground="#E6EDF3" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="Mechanical steps · lamp reveal" FontSize="9" FontWeight="SemiBold" Foreground="#B19A68" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                                <Border x:Name="AnimCheckClassic" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                    <TextBlock Text="✓" FontSize="8" FontWeight="Black" Foreground="#1A1400" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="AnimCardCustomVideo" Cursor="Hand" Background="#1A1408" BorderBrush="#6B5A00" BorderThickness="2" CornerRadius="8" Margin="4,4,0,0" PointerReleased="Native_AnimCustomVideoCard_Click">
                                                            <Grid MinHeight="96">
                                                                <Border x:Name="AnimGlowCustomVideo" Opacity="0.12" IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                            <GradientStop Color="#D29922" Offset="0" />
                                                                            <GradientStop Color="#00000000" Offset="1" />
                                                                        </RadialGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="🎥" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                                                    <TextBlock Text="CUSTOM" FontSize="12" FontWeight="Black" Foreground="#E7B94F" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                                <Border x:Name="AnimCheckCustomVideo" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="4,2" IsVisible="False">
                                                                    <TextBlock Text="✓" FontSize="8" FontWeight="Black" Foreground="#1A1400" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </UniformGrid>
                                                    <Border BorderBrush="#29486D" BorderThickness="1" Background="#0A1320" Padding="16,12" Margin="0,8,0,4" CornerRadius="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock x:Name="AnimPreviewTitle" Text="TV Signal" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,3" />
                                                                <TextBlock x:Name="AnimPreviewDesc" Text="Layered television reveal with dual broadcast sweeps." Foreground="#D9C279" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border BorderBrush="#C9B070" BorderThickness="1" Background="#0C0A04" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock x:Name="AnimPreviewDuration" Text="3.5 SEC" Foreground="#D2B45D" FontSize="11" FontWeight="Black" />
                                                                    </Border>
                                                                    <Border BorderBrush="#C9B070" BorderThickness="1" Background="#0C0A04" Padding="6,2">
                                                                        <TextBlock x:Name="AnimPreviewIntensity" Text="BROADCAST" Foreground="#D2B45D" FontSize="11" FontWeight="Black" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="▶  PREVIEW EFFECT" Click="PreviewSelectedGoalAnimation_Click" FontSize="12" FontWeight="Black" Foreground="#CFE5FF" BorderBrush="#3D6A9D" Background="#10233A" Padding="18,10" Margin="16,0,0,0" VerticalAlignment="Center" Theme="{StaticResource ToolBtn}" />
                                                        </Grid>
                                                    </Border>
                                                    <UniformGrid Columns="3" Margin="0,12,0,0" IsVisible="False">
                                                        <Border Background="#0D1726" BorderBrush="#2E4B6D" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,6,0">
                                                            <StackPanel>
                                                                <TextBlock Text="SCORE CAPACITY" FontSize="11" FontWeight="Black" Foreground="#8FC5FF" />
                                                                <TextBlock Text="88  ·  188" FontSize="28" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Arial'}" Foreground="White" Margin="0,4,0,2" />
                                                                <TextBlock Text="G/B double digits · total triple digits" FontSize="11" FontWeight="SemiBold" Foreground="#9FB0C3" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#0D1D16" BorderBrush="#2B5C3D" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="3,0">
                                                            <StackPanel>
                                                                <TextBlock Text="RESPONSIVE OUTPUT" FontSize="11" FontWeight="Black" Foreground="#75D286" />
                                                                <TextBlock Text="ACTIVE" FontSize="22" FontWeight="Black" Foreground="#B9F3C5" Margin="0,7,0,3" />
                                                                <TextBlock Text="Panels adapt to window dimensions" FontSize="11" FontWeight="SemiBold" Foreground="#9FB8A8" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#1C170A" BorderBrush="#67551E" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="6,0,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="SMART CONTRAST" FontSize="11" FontWeight="Black" Foreground="#E7C55D" />
                                                                <TextBlock Text="ACTIVE" FontSize="22" FontWeight="Black" Foreground="#FFF0B5" Margin="0,7,0,3" />
                                                                <TextBlock Text="Text responds to team colours" FontSize="11" FontWeight="SemiBold" Foreground="#C9B98B" />
                                                            </StackPanel>
                                                        </Border>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="SettingsSection_Overlays" Tag="overlays automatic stats weather break screen quarter probability scoring run live forecast" Theme="{StaticResource SettingsSectionSurface}">
                                                <StackPanel>
                                                    <Border Height="1" Margin="0,0,0,14">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="#003FB950" Offset="0" />
                                                                <GradientStop Color="#303FB950" Offset="0.5" />
                                                                <GradientStop Color="#003FB950" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                        <TextBlock Text="OVERLAYS" FontSize="14" FontWeight="Black" Foreground="#3FB950" Margin="0,0,0,2">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="12" Color="#3FB950" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="Automatic overlays, break screen, and weather" FontSize="9" FontWeight="SemiBold" Foreground="#2A6030" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="AutoOverlaysToggle" IsChecked="True" IsCheckedChanged="Native_AutoOverlaysToggle_Changed" IsVisible="False" />
                                                    <Border x:Name="AutoOverlaysCard" Background="#0A1410" BorderBrush="#3FB950" BorderThickness="2" Padding="14" Margin="0,0,0,8" Cursor="Hand" PointerReleased="Native_AutoOverlaysCard_Click">
                                                        <Grid>
                                                            <Border x:Name="AutoOverlaysGlow" Opacity="0.12" IsHitTestVisible="False">
                                                                <Border.Background>
                                                                    <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                        <GradientStop Color="#3FB950" Offset="0" />
                                                                        <GradientStop Color="#00000000" Offset="1" />
                                                                    </RadialGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel>
                                                                <TextBlock Text="AUTOMATIC OVERLAYS" FontSize="13" FontWeight="Black" Foreground="#3FB950" Margin="0,0,0,4">
                                                                    <TextBlock.Effect>
                                                                        <DropShadowEffect BlurRadius="10" Color="#3FB950" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                                    </TextBlock.Effect>
                                                                </TextBlock>
                                                                <TextBlock Text="Periodic stats, win probability, weather, and scoring run overlays on the scorebug" FontSize="9" FontWeight="SemiBold" Foreground="#2A6030" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border x:Name="AutoOverlaysCheck" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#3FB950" Padding="6,3">
                                                                <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <CheckBox x:Name="SettingsBreakScreenToggle" IsChecked="True" IsCheckedChanged="Native_SettingsBreakScreenToggle_Changed" IsVisible="False" />
                                                    <Border x:Name="SettingsBreakScreenCard" Background="#060A14" BorderBrush="#1A2A50" BorderThickness="1" Padding="14" Margin="0,0,0,8" Cursor="Hand" PointerReleased="Native_SettingsBreakScreenCard_Click">
                                                        <Grid>
                                                            <Border x:Name="SettingsBreakScreenGlow" Opacity="0.10" IsHitTestVisible="False">
                                                                <Border.Background>
                                                                    <RadialGradientBrush Center="50%,50%" RadiusX="60%" RadiusY="60%">
                                                                        <GradientStop Color="#58A6FF" Offset="0" />
                                                                        <GradientStop Color="#00000000" Offset="1" />
                                                                    </RadialGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="⏸" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock x:Name="SettingsBreakScreenTitle" Text="QUARTER BREAK SCREEN" FontSize="13" FontWeight="Black" Foreground="#58A6FF" Margin="0,0,0,2" />
                                                                    <TextBlock Text="Auto-show summary screen at quarter breaks" FontSize="9" FontWeight="SemiBold" Foreground="#2A4A70" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                <Grid Width="44" Height="24">
                                                                    <Border x:Name="SettingsBreakScreenTrack" CornerRadius="12" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="1" />
                                                                    <Border x:Name="SettingsBreakScreenThumb" Width="18" Height="18" CornerRadius="9" Background="#58A6FF" HorizontalAlignment="Right" Margin="0,0,3,0" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Border Background="#080E1A" BorderBrush="#1A3060" BorderThickness="1" Padding="14" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Border Opacity="0.06" IsHitTestVisible="False">
                                                                <Border.Background>
                                                                    <RadialGradientBrush Center="50%,40%" RadiusX="50%" RadiusY="50%">
                                                                        <GradientStop Color="#58A6FF" Offset="0" />
                                                                        <GradientStop Color="#00000000" Offset="1" />
                                                                    </RadialGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                    <TextBlock Text="☁" FontSize="20" FontFamily="{fonts:ProductionFont 'Segoe UI Symbol'}" Foreground="#8AC5FF" Margin="0,0,8,0" />
                                                                    <TextBlock Text="LIVE WEATHER" FontSize="13" FontWeight="Black" Foreground="#58A6FF" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox x:Name="SettingsWeatherLocation" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="200" FontSize="12" Foreground="White" Background="#060A10" BorderBrush="#2A4A70" Padding="8,5" VerticalContentAlignment="Center" />
                                                                    <Button Grid.Column="2" Content="Apply" Width="60" Height="30" FontSize="11" FontWeight="Bold" Click="ApplyWeatherLocation_Click" BorderBrush="#1A3060" Theme="{StaticResource ToolBtn}" />
                                                                </Grid>
                                                                <TextBlock x:Name="WeatherLocationStatus" Text="" Foreground="#8FB8E8" FontSize="11" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="SettingsSection_Media" Tag="media logo crop zoom position home away image picture" Theme="{StaticResource SettingsSectionSurface}">
                                                <StackPanel>
                                                    <Border Height="1" Margin="0,0,0,14">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="#0058A6FF" Offset="0" />
                                                                <GradientStop Color="#2058A6FF" Offset="0.5" />
                                                                <GradientStop Color="#0058A6FF" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                        <TextBlock Text="MEDIA" FontSize="14" FontWeight="Black" Foreground="#58A6FF" Margin="0,0,0,2">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="12" Color="#58A6FF" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="Adjust logo crop and positioning" FontSize="9" FontWeight="SemiBold" Foreground="#8FB8E8" />
                                                    </StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Padding="8">
                                                            <StackPanel>
                                                                <TextBlock Text="HOME" Foreground="#7EB4FF" FontSize="9" FontWeight="Black" Margin="0,0,0,4" />
                                                                <Border Height="70" Margin="0,0,0,6" BorderBrush="#1A3A6A" BorderThickness="1" Background="#060A10" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Image x:Name="HomeLogoCropPreviewImage" Stretch="Uniform" RenderTransformOrigin="50%,50%" />
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="Zoom" Foreground="#7DA0CA" FontSize="8" />
                                                                <Slider x:Name="HomeLogoZoomSlider" Minimum="0.8" Maximum="3.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                <TextBlock Text="X" Foreground="#7DA0CA" FontSize="8" Margin="0,2,0,0" />
                                                                <Slider x:Name="HomeLogoXSlider" Minimum="-50" Maximum="50" Value="0" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                <TextBlock Text="Y" Foreground="#7DA0CA" FontSize="8" Margin="0,2,0,0" />
                                                                <Slider x:Name="HomeLogoYSlider" Minimum="-50" Maximum="50" Value="0" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                <Button Content="Reset Home" Height="24" Margin="0,4,0,0" Click="ResetHomeCrop_Click" FontSize="10" BorderBrush="#1A3A6A" Theme="{StaticResource ToolBtn}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="2" Background="#1A0A0A" BorderBrush="#4A1A1A" BorderThickness="1" Padding="8">
                                                            <StackPanel>
                                                                <TextBlock Text="AWAY" Foreground="#FF9A9A" FontSize="9" FontWeight="Black" Margin="0,0,0,4" />
                                                                <Border Height="70" Margin="0,0,0,6" BorderBrush="#4A1A1A" BorderThickness="1" Background="#060A10" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Image x:Name="AwayLogoCropPreviewImage" Stretch="Uniform" RenderTransformOrigin="50%,50%" />
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="Zoom" Foreground="#523030" FontSize="8" />
                                                                <Slider x:Name="AwayLogoZoomSlider" Minimum="0.8" Maximum="3.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                <TextBlock Text="X" Foreground="#523030" FontSize="8" Margin="0,2,0,0" />
                                                                <Slider x:Name="AwayLogoXSlider" Minimum="-50" Maximum="50" Value="0" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                <TextBlock Text="Y" Foreground="#523030" FontSize="8" Margin="0,2,0,0" />
                                                                <Slider x:Name="AwayLogoYSlider" Minimum="-50" Maximum="50" Value="0" ValueChanged="LogoCropSlider_ValueChanged" />
                                                                <Button Content="Reset Away" Height="24" Margin="0,4,0,0" Click="ResetAwayCrop_Click" FontSize="10" BorderBrush="#4A1A1A" Theme="{StaticResource ToolBtn}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock x:Name="LogoCropSummaryText" Foreground="#9CC4F0" FontSize="9" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="SettingsSection_Advanced" Tag="advanced window dimensions width height size cloud remote join code qr reset update version" Theme="{StaticResource SettingsSectionSurface}">
                                                <StackPanel>
                                                    <Border Height="1" Margin="0,0,0,14">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="#008B949E" Offset="0" />
                                                                <GradientStop Color="#208B949E" Offset="0.5" />
                                                                <GradientStop Color="#008B949E" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                        <TextBlock Text="ADVANCED" FontSize="14" FontWeight="Black" Foreground="#8B949E" Margin="0,0,0,2">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="12" Color="#8B949E" Opacity="0.3" OffsetX="0" OffsetY="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="Window dimensions, cloud remote, and reset" FontSize="9" FontWeight="SemiBold" Foreground="#A8B0BA" />
                                                    </StackPanel>
                                                    <Expander Header="WINDOW DIMENSIONS" Theme="{StaticResource SettingsExpander}">
                                                        <StackPanel>
                                                            <Border Background="#0A0E18" BorderBrush="#1A2A40" BorderThickness="1" Padding="14" Margin="0,0,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="20" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel HorizontalAlignment="Center">
                                                                        <TextBlock Text="WIDTH" FontSize="8" FontWeight="Black" Foreground="#9CC4F0" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                            <Border Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Width="32" Height="32" Cursor="Hand" PointerReleased="Native_WidthMinus_Click">
                                                                                <TextBlock Text="−" FontSize="16" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <Border Background="#060A10" BorderBrush="#2A4A70" BorderThickness="1" MinWidth="60" Height="44" Padding="0" Margin="4,0">
                                                                                <TextBox x:Name="WindowWidthBox" Text="386" FontSize="22" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#58A6FF" Background="Transparent" BorderThickness="0" CaretBrush="#58A6FF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="5" />
                                                                            </Border>
                                                                            <Border Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Width="32" Height="32" Cursor="Hand" PointerReleased="Native_WidthPlus_Click">
                                                                                <TextBlock Text="+" FontSize="16" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="px" FontSize="8" Foreground="#7DA0CA" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                                        <TextBlock Text="HEIGHT" FontSize="8" FontWeight="Black" Foreground="#9CC4F0" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                            <Border Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Width="32" Height="32" Cursor="Hand" PointerReleased="Native_HeightMinus_Click">
                                                                                <TextBlock Text="−" FontSize="16" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <Border Background="#060A10" BorderBrush="#2A4A70" BorderThickness="1" MinWidth="60" Height="44" Padding="0" Margin="4,0">
                                                                                <TextBox x:Name="WindowHeightBox" Text="193" FontSize="22" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#58A6FF" Background="Transparent" BorderThickness="0" CaretBrush="#58A6FF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="5" />
                                                                            </Border>
                                                                            <Border Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1" Width="32" Height="32" Cursor="Hand" PointerReleased="Native_HeightPlus_Click">
                                                                                <TextBlock Text="+" FontSize="16" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="px" FontSize="8" Foreground="#7DA0CA" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <Button Content="APPLY SIZE" Height="32" FontSize="11" FontWeight="Black" Click="ApplyWindowDimensions_Click" BorderBrush="#1A3A6A" Foreground="#58A6FF" Margin="0,4,0,2" Theme="{StaticResource ToolBtn}" />
                                                            <Button Content="RESET TO 386 × 193" Height="30" FontSize="10" FontWeight="Black" Click="ResetWindowDimensions_Click" BorderBrush="#344A64" Foreground="#C5D6E8" Margin="0,2,0,4" Theme="{StaticResource ToolBtn}" />
                                                            <TextBlock x:Name="WindowDimensionsStatus" Text="" Foreground="#8FB8E8" FontSize="10" Margin="0,0,0,12" />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Border x:Name="CloudRemoteCard" Background="#0A1620" BorderBrush="#1A3A6A" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                                                        <StackPanel>
                                                            <TextBlock Text="📱" FontSize="28" HorizontalAlignment="Center" Foreground="#58A6FF" Margin="0,0,0,4" />
                                                            <TextBlock Text="CLOUD REMOTE" FontSize="14" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Score from any phone, tablet, or laptop" FontSize="9" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,2,0,8" />
                                                            <TextBlock x:Name="CloudStatusText" Text="Checking configuration…" FontSize="10" FontWeight="SemiBold" Foreground="#B1BAC4" HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" TextAlignment="Center" />
                                                            <StackPanel x:Name="CloudIdleState" IsVisible="False">
                                                                <Button x:Name="CloudStartButton" Content="Start cloud session" Height="32" FontSize="11" FontWeight="Black" Click="StartCloudSession_Click" BorderBrush="#1A3A6A" Foreground="#58A6FF" Theme="{StaticResource ToolBtn}" />
                                                                <TextBlock Text="A new join code is created each time. Existing sessions stay independent." FontSize="9" Foreground="#6E7B8A" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
                                                            </StackPanel>
                                                            <StackPanel x:Name="CloudDisabledState" IsVisible="False">
                                                                <Border Background="#1C140A" BorderBrush="#4A3A1A" BorderThickness="1" Padding="10">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Setup required" FontSize="11" FontWeight="Bold" Foreground="#D29922" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                        <TextBlock Text="Place a 'supabase.config.json' file next to the executable, or under %LOCALAPPDATA%\RocheScoreboard\." FontSize="9" Foreground="#C9B070" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4" />
                                                                        <TextBlock Text="See supabase\README.md for the 10-minute setup." FontSize="9" Foreground="#A89060" TextWrapping="Wrap" TextAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel x:Name="CloudLiveState" IsVisible="False">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                                    <Ellipse x:Name="CloudConnectionDot" Width="8" Height="8" Fill="#B1BAC4" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="CloudConnectionLabel" Text="Connecting…" FontSize="10" FontWeight="Bold" Foreground="#B1BAC4" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="JOIN CODE" FontSize="9" FontWeight="Black" Foreground="#7DA0CA" HorizontalAlignment="Center" />
                                                                <Border Background="#060A10" BorderBrush="#2A4A70" BorderThickness="1" Padding="14,10" Margin="0,4,0,4" Cursor="Hand" PointerReleased="Native_CopyCloudJoinCode_Click" ToolTip.Tip="Click to copy">
                                                                    <TextBlock x:Name="CloudJoinCodeText" Text="—" FontSize="32" FontWeight="Black" FontFamily="{fonts:ProductionFont 'Consolas'}" Foreground="#58A6FF" HorizontalAlignment="Center" TextAlignment="Center" />
                                                                </Border>
                                                                <Border Background="#0D1117" BorderBrush="#1A3A6A" BorderThickness="1" Padding="8" HorizontalAlignment="Center" Margin="0,8,0,8">
                                                                    <Image x:Name="CloudQrImage" Width="180" Height="180" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                                                                </Border>
                                                                <StackPanel x:Name="CloudJoinUrlPanel" IsVisible="False">
                                                                    <TextBlock Text="OR OPEN" FontSize="9" FontWeight="Black" Foreground="#7DA0CA" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                                                    <TextBlock x:Name="CloudJoinUrlText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#9CC4F0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                                                    <Button x:Name="CloudCopyUrlButton" Content="Copy URL" Height="26" FontSize="10" FontWeight="Bold" Click="CopyCloudJoinUrl_Click" BorderBrush="#1A3A6A" Foreground="#58A6FF" Margin="0,6,0,0" Theme="{StaticResource ToolBtn}" />
                                                                </StackPanel>
                                                                <Button x:Name="CloudEndButton" Content="End session" Height="30" FontSize="11" FontWeight="Bold" Click="EndCloudSession_Click" BorderBrush="#3A2020" Foreground="#FF6B6B" Margin="0,12,0,0" Theme="{StaticResource ToolBtn}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#1C0A0A" BorderBrush="#4A2020" BorderThickness="1" Padding="14" Cursor="Hand" PointerReleased="Native_ResetCardSettings_Click">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="⟲" FontSize="28" HorizontalAlignment="Center" Foreground="#FF6B6B" Margin="0,0,0,4" />
                                                            <TextBlock Text="RESET MATCH" FontSize="14" FontWeight="Black" Foreground="#FF6B6B" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Clear all and start over" FontSize="9" Foreground="#E08A8F" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#0A1620" BorderBrush="#1A3A6A" BorderThickness="1" Padding="14" Margin="0,12,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="⬆" FontSize="28" HorizontalAlignment="Center" Foreground="#58A6FF" Margin="0,0,0,4" />
                                                            <TextBlock Text="APP UPDATE" FontSize="14" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="UpdateCurrentVersionText" Text="Current version: …" FontSize="10" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                            <TextBlock x:Name="UpdateStatusText" Text="Click 'Check for updates' to look for a new version." FontSize="11" FontWeight="SemiBold" Foreground="#8A95A3" HorizontalAlignment="Center" Margin="0,4,0,8" TextWrapping="Wrap" TextAlignment="Center" />
                                                            <ProgressBar x:Name="UpdateProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8" Foreground="#58A6FF" Background="#0D1117" IsVisible="False" />
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button x:Name="CheckForUpdateButton" Grid.Column="0" Content="Check for updates" Height="30" FontSize="11" FontWeight="Bold" Click="CheckForUpdate_Click" BorderBrush="#1A3A6A" Foreground="#58A6FF" Theme="{StaticResource ToolBtn}" />
                                                                <Button x:Name="InstallUpdateButton" Grid.Column="2" Content="Download &amp; install" Height="30" FontSize="11" FontWeight="Bold" Click="InstallUpdate_Click" BorderBrush="#1A3A24" Foreground="#3FB950" Theme="{StaticResource ToolBtn}" IsVisible="False" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
        <Border x:Name="ResetOverlay" Background="#CC000000" Opacity="0" ZIndex="50" IsVisible="False">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#0D1117" BorderBrush="#E08A8F" BorderThickness="2" Padding="0" MinWidth="500" MaxWidth="560">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F85149" Height="4" />
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="40,32,40,0">
                            <TextBlock Text="⚠" FontSize="48" HorizontalAlignment="Center" Foreground="#F85149" Margin="0,0,0,12" />
                            <TextBlock Text="RESET MATCH" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" TextAlignment="Center" Margin="40,14,40,0" FontSize="13" Foreground="#C9D1D9" TextWrapping="Wrap" LineHeight="20">
                            All scores, events, and clock data will be permanently cleared. You'll return to the sport selection screen to start a new match.
                        </TextBlock>
                        <Border Grid.Row="3" Margin="40,18,40,0" Background="#1C0A0A" BorderBrush="#4A2020" BorderThickness="1" Padding="14,10">
                            <TextBlock Text="This action cannot be undone." FontSize="12" FontWeight="Bold" Foreground="#FF9A9A" HorizontalAlignment="Center" />
                        </Border>
                        <Grid Grid.Row="4" Margin="40,24,40,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="CancelResetBtn" Content="CANCEL" Height="46" FontSize="14" FontWeight="Black" Click="CancelReset_Click" Background="#21262D" BorderBrush="#A8B0BA" Foreground="White" Cursor="Hand" Theme="{StaticResource ToolBtn}" />
                            <Button Grid.Column="2" x:Name="ConfirmResetBtn" Content="RESET" Height="46" FontSize="14" FontWeight="Black" Click="ConfirmReset_Click" Background="#9B2C2C" BorderBrush="#F85149" Foreground="White" Cursor="Hand" Theme="{StaticResource PrimaryCommandButton}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="ResizeGripVisual" Width="18" Height="18" Margin="0,0,1,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="TopLeftCorner" ZIndex="300" PointerPressed="Native_ResizeGrip_MouseDown">
            <Border.Theme>
                <ControlTheme TargetType="Border">
                    <Setter Property="Opacity" Value="0.15" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Opacity" Value="0.6" />
                    </Style>
                </ControlTheme>
            </Border.Theme>
            <Path Stroke="#8B949E" StrokeThickness="1.5" Data="M 16,4 L 4,16 M 16,9 L 9,16 M 16,14 L 14,16" />
        </Border>
        <ns4:SetupWizard x:Name="SetupWizardPanel" ZIndex="100" IsVisible="False" />
        <ns4:CricketControlPanel x:Name="CricketControlPanelView" ZIndex="0" IsVisible="False" />
        <ns4:CricketSetupWizard x:Name="CricketSetupWizardPanel" ZIndex="100" IsVisible="False" />
        <ns4:TrainingControlPanel x:Name="TrainingControlPanelView" ZIndex="0" IsVisible="False" />
        <ns4:GlobalSettingsScreen x:Name="GlobalSettingsPanel" ZIndex="150" IsVisible="False" />
        <ns4:SportSelectionScreen x:Name="SportSelectionPanel" ZIndex="200" />
        <ns4:MatchLoadingScreen x:Name="MatchLoadingPanel" ZIndex="300" IsVisible="False" />
    </Grid>
</Window>
