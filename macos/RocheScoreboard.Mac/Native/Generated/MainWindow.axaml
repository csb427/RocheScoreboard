                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="Padding" Value="12,7" />
                <Style Selector="^:checked">
                    <Setter Property="Background" Value="#25405F" />
                </Style>
                <Style Selector="^:checked">
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </ControlTheme>
            <ControlTheme x:Key="SettingsExpander" TargetType="Expander">
                <Setter Property="motion:DisclosureMotion.Enabled" Value="True" />
                <Setter Property="Foreground" Value="#AEB7C4" />
                <Setter Property="Background" Value="#09090B" />
                <Setter Property="BorderBrush" Value="#303035" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Black" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
