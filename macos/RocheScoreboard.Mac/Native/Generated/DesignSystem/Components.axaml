                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="checkBorder" Width="20" Height="20" Background="{DynamicResource ScoreGrid.Brush.Surface}" BorderBrush="{DynamicResource ScoreGrid.Brush.ControlBorder}" BorderThickness="{DynamicResource ScoreGrid.BorderWidth.Default}" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="checkMark" Text="" FontFamily="{fonts:ProductionFont 'Segoe UI Symbol'}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
