            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="radioBorder" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource ScoreGrid.Brush.ControlBorder}" StrokeThickness="{DynamicResource ScoreGrid.StrokeWidth.Default}" Fill="{DynamicResource ScoreGrid.Brush.Surface}" />
                            <Ellipse x:Name="radioCheck" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ScoreGrid.Brush.BrandPrimary}" IsVisible="False" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:checked /template/ Ellipse#radioBorder">
            <Setter Property="Stroke" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
        </Style>
