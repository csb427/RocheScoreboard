    <ControlTheme x:Key="ScoreGrid.ComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ScoreGrid.BorderWidth.Default}" />
        <Setter Property="Height" Value="{DynamicResource ScoreGrid.Height.ControlDefault}" />
        <Setter Property="Padding" Value="{DynamicResource ScoreGrid.Padding.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource ScoreGrid.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ScoreGrid.FontSize14}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggleButton" Grid.Column="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ScoreGrid.CornerRadius.Default}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            <TextBlock Grid.Column="1" Text="" FontFamily="{fonts:ProductionFont 'Segoe UI Symbol'}" FontSize="12" Foreground="{DynamicResource ScoreGrid.Brush.TextSecondary}" VerticalAlignment="Center" Margin="8,0,12,0" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=toggleButton}" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" port:ProductionNames.TemplateId="popup" ns3:PopupMotion.Kind="Slide">
                            <Border Background="{DynamicResource ScoreGrid.Brush.Surface}" BorderBrush="{DynamicResource ScoreGrid.Brush.ControlBorder}" BorderThickness="1" CornerRadius="{DynamicResource ScoreGrid.CornerRadius.Default}" MinWidth="{Binding ActualWidth, ElementName=toggleButton}" MaxHeight="200">
                                <ScrollViewer>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerTheme">
            <Setter.Value>
                <ControlTheme TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.TextPrimary}" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style Selector="^:pointerover /template/ Border#itemBorder">
                        <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.SurfaceSubtle}" />
                    </Style>
                    <Style Selector="^:selected /template/ Border#itemBorder">
                        <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.AccentBackground}" />
                    </Style>
                    <Style Selector="^:selected">
                        <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.AccentForeground}" />
                    </Style>
                </ControlTheme>
            </Setter.Value>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
        </Style>
        <Style Selector="^:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.Focus}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.DisabledSurface}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.DisabledForeground}" />
        </Style>
