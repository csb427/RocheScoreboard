    <ControlTheme x:Key="PanelTab" TargetType="TabItem">
        <Setter Property="native:NativeToolTipPolicy.Enabled" Value="{Binding Path=(motion:OperatorGuidance.ShowHints), RelativeSource={RelativeSource Self}}" />
        <Setter Property="motion:OperatorControlMotion.Enabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ControlCentre.SecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ControlCentre.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="TabHitTarget" Background="Transparent" MinWidth="44" Height="64" Margin="1,0">
                        <Grid x:Name="PART_Surface" RenderTransformOrigin="50%,50%">
                            <Grid.RenderTransform>
                                <ScaleTransform port:ProductionNames.TemplateId="TbSc" />
                            </Grid.RenderTransform>
                            <Border x:Name="ActionGlow" CornerRadius="28" Background="White" Opacity="0" IsHitTestVisible="False" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5,0">
                                <ns1:OperatorSymbol Kind="{TemplateBinding Header}" IsActive="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ControlCentre.TabLabel}}" Foreground="{TemplateBinding Foreground}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <Border x:Name="FocusFrame" CornerRadius="28" BorderBrush="{DynamicResource ControlCentre.TextBrush}" BorderThickness="2" IsHitTestVisible="False" IsVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource ControlCentre.TabSelectedInkBrush}" />
        </Style>
        <Style Selector="^:focus:focus-visible /template/ Border#FocusFrame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value=".4" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="OperatorTabs" TargetType="TabControl">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource PanelTab}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
