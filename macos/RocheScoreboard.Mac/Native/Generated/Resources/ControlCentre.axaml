                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <ns6:OperatorGlassSurface x:Name="Frame" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="12">
                                        <TextBlock Text="⌄" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,4" />
                                    </ns6:OperatorGlassSurface>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:pointerover /template/ glass|OperatorGlassSurface#Frame">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlCentre.AccentBrush}" />
                                </Style>
                                <Style Selector="ToggleButton:checked /template/ glass|OperatorGlassSurface#Frame">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlCentre.AccentBrush}" />
                                </Style>
                            </ToggleButton.Styles>
                        </ToggleButton>
                        <ContentPresenter x:Name="SelectionLabel" Margin="12,5,36,5" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <TextBox MinHeight="0" Padding="0" x:Name="PART_EditableTextBox" Margin="10,4,36,4" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}" VerticalContentAlignment="Center" IsReadOnly="False" IsVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" ns3:PopupMotion.Kind="None">
                            <ns6:OperatorGlassSurface GlassSource="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                <ScrollViewer>
                                    <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Contained" />
                                </ScrollViewer>
                            </ns6:OperatorGlassSurface>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^[IsEditable=True] /template/ TextBox#PART_EditableTextBox">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[IsEditable=True] /template/ ContentPresenter#SelectionLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:focus-within:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlCentre.TextBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="ComboBox" BasedOn="{StaticResource SettingsChoice}" x:Key="{x:Type ComboBox}" />
    <ControlTheme x:Key="ControlCentre.RangeTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Fill" Height="6" Background="{TemplateBinding Background}" CornerRadius="3" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^[Tag=vertical] /template/ Border#Fill">
            <Setter Property="Height" Value="NaN" />
        </Style>
        <Style Selector="^[Tag=vertical] /template/ Border#Fill">
            <Setter Property="Width" Value="6" />
        </Style>
        <Style Selector="^[Tag=vertical] /template/ Border#Fill">
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="^[Tag=vertical] /template/ Border#Fill">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="Slider" x:Key="{x:Type Slider}">
        <Setter Property="motion:OperatorSliderMotion.Enabled" Value="True" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource ControlCentre.AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlCentre.RaisedBrush}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Margin="5,3">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Command="{x:Static native:NativeRangeCommands.DecreaseLarge}" Background="{TemplateBinding Foreground}" x:Name="PART_DecreaseButton" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Slider}}" Theme="{StaticResource ControlCentre.RangeTrack}" />
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderHandle" Width="28" Height="28">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Border x:Name="Grip" Width="24" Height="24" CornerRadius="12" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" RenderTransformOrigin="50%,50%">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                            <GradientStop Color="#FFFFFF" Offset="0" />
                                                            <GradientStop Color="#D9E2EF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.RenderTransform>
                                                        <ScaleTransform port:ProductionNames.TemplateId="PART_GripScale" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                    <Thumb.Styles>
                                        <Style Selector="Thumb:focus-within /template/ Border#Grip">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ControlCentre.TextBrush}" />
                                        </Style>
                                        <Style Selector="Thumb:focus-within /template/ Border#Grip">
                                            <Setter Property="BorderThickness" Value="2" />
                                        </Style>
                                    </Thumb.Styles>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton Command="{x:Static native:NativeRangeCommands.IncreaseLarge}" Background="{TemplateBinding Background}" x:Name="PART_IncreaseButton" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Slider}}" Theme="{StaticResource ControlCentre.RangeTrack}" />
                            </Track.IncreaseButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value=".4" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="ContextMenu" x:Key="{x:Type ContextMenu}">
        <Setter Property="motion:OperatorMenuMotion.Enabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ControlCentre.TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ControlCentre.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinWidth" Value="224" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Decorator>
                        <ns6:OperatorGlassSurface x:Name="PART_MenuSurface" GlassSource="{Binding PlacementTarget, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Padding="7" CornerRadius="26">
                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Cycle" />
                            </ScrollViewer>
                        </ns6:OperatorGlassSurface>
                    </Decorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
    <ControlTheme TargetType="MenuItem" x:Key="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource ControlCentre.TextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border CornerRadius="16" x:Name="ItemSurface" Background="Transparent" Padding="10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ns1:OperatorSymbol x:Name="Check" Kind="check" Width="17" Height="17" VerticalAlignment="Center" IsActive="{TemplateBinding IsChecked}" Foreground="{TemplateBinding Foreground}" IsVisible="False" />
                                <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="Center" ContentTemplate="{TemplateBinding HeaderTemplate}" Content="{TemplateBinding Header}" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGesture}" FontSize="12" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="CommandIcon" Grid.Column="3" Content="{TemplateBinding Icon}" Width="21" Height="21" Margin="12,0,0,0" VerticalAlignment="Center" ContentTemplate="{TemplateBinding HeaderTemplate}" IsVisible="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                <TextBlock x:Name="Arrow" Grid.Column="4" Text="›" FontSize="22" Margin="12,0,0,0" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" IsVisible="False" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubMenuOpen}" Placement="Right" Focusable="False">
                            <ns6:OperatorGlassSurface Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Padding="7" CornerRadius="24">
                                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Cycle" />
                                </ScrollViewer>
                            </ns6:OperatorGlassSurface>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:selected /template/ Border#ItemSurface">
            <Setter Property="Background" Value="{DynamicResource ControlCentre.SelectionBrush}" />
        </Style>
        <Style Selector="^:checked /template/ motion|OperatorSymbol#Check">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Setter Property="native:NativeMenuFlags.Enabled" Value="True" />
        <Style Selector="^[(native|NativeMenuFlags.HasItems)=True] /template/ TextBlock#Arrow">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value=".4" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="Separator" x:Key="{x:Type Separator}">
        <Setter Property="Margin" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource ControlCentre.BorderBrush}" Opacity=".6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
    <ControlTheme TargetType="ScrollBar" x:Key="{x:Type ScrollBar}">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="2">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{Binding Orientation,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static native:NativeOrientation.VerticalReverse}}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton x:Name="PART_DecreaseButton" Command="{x:Static native:NativeRangeCommands.PageUpCommand}" Opacity="0" Focusable="False" port:ProductionNames.TemplateId="PageBefore" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb x:Name="Handle" MinHeight="22" MinWidth="4">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#A8A8AE" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton x:Name="PART_IncreaseButton" Command="{x:Static native:NativeRangeCommands.PageDownCommand}" Opacity="0" Focusable="False" port:ProductionNames.TemplateId="PageAfter" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
                            </Track.IncreaseButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^[Orientation=Horizontal] /template/ Track#PART_Track">
            <Setter Property="IsDirectionReversed" Value="False" />
        </Style>
        <Style Selector="^[Orientation=Horizontal] /template/ Thumb#Handle">
            <Setter Property="MinHeight" Value="4" />
        </Style>
        <Style Selector="^[Orientation=Horizontal] /template/ Thumb#Handle">
            <Setter Property="MinWidth" Value="22" />
        </Style>
        <Style Selector="^[Orientation=Horizontal] /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Command" Value="{x:Static native:NativeRangeCommands.PageLeftCommand}" />
        </Style>
        <Style Selector="^[Orientation=Horizontal] /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Command" Value="{x:Static native:NativeRangeCommands.PageRightCommand}" />
        </Style>
        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="Width" Value="NaN" />
        </Style>
        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="Height" Value="10" />
        </Style>
        <Style Selector="^[(motion|ScrollActivity.Active)=True]">
            <Setter Property="Opacity" Value=".85" />
        </Style>
        <Style Selector="^[(motion|ScrollActivity.Active)=False]">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="ToolTip" x:Key="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{DynamicResource ControlCentre.ActionTextBrush}" />
        <Setter Property="Background" Value="#303035" />
        <Setter Property="BorderBrush" Value="#65656B" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <ns6:OperatorGlassSurface GlassSource="{Binding PlacementTarget, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </ns6:OperatorGlassSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
    <ControlTheme TargetType="ListBox" BasedOn="{StaticResource Native.Base.ListBox}" x:Key="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource ControlCentre.SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ControlCentre.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlCentre.BorderBrush}" />
    </ControlTheme>
    <ControlTheme TargetType="ListBoxItem" x:Key="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource ControlCentre.TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="12" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Row">
            <Setter Property="Background" Value="{DynamicResource ControlCentre.RaisedBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#Row">
            <Setter Property="Background" Value="{DynamicResource ControlCentre.SelectionBrush}" />
        </Style>
        <Style Selector="^:focus:focus-visible /template/ Border#Row">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlCentre.TextBrush}" />
        </Style>
        <Style Selector="^:focus:focus-visible /template/ Border#Row">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="SettingsSegment" TargetType="RadioButton">
        <Setter Property="motion:CricketActionMotion.Enabled" Value="False" />
        <Setter Property="motion:OperatorControlMotion.Enabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ControlCentre.TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ControlCentre.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlCentre.BodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid RenderTransformOrigin="50%,50%">
                            <Grid.RenderTransform>
                                <ScaleTransform port:ProductionNames.TemplateId="TbSc" />
                            </Grid.RenderTransform>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                        <Border x:Name="FocusFrame" BorderBrush="{DynamicResource ControlCentre.TextBrush}" BorderThickness="2" CornerRadius="22" IsHitTestVisible="False" IsVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:focus:focus-visible /template/ Border#FocusFrame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value=".4" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="SettingsPower" TargetType="CheckBox" BasedOn="{StaticResource SettingsToggle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="PowerBody" Width="50" Height="42" CornerRadius="15" Background="{DynamicResource ControlCentre.RaisedBrush}" RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <ScaleTransform port:ProductionNames.TemplateId="TbSc" />
                            </Border.RenderTransform>
                            <ns1:OperatorSymbol Kind="power" Width="25" Height="25" Foreground="{DynamicResource ControlCentre.TextBrush}" />
                        </Border>
                        <Border x:Name="PowerFocus" Width="54" Height="46" CornerRadius="17" BorderBrush="{DynamicResource ControlCentre.TextBrush}" BorderThickness="2" IsHitTestVisible="False" IsVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:checked /template/ Border#PowerBody">
            <Setter Property="Background" Value="#23784B" />
        </Style>
        <Style Selector="^:focus:focus-visible /template/ Border#PowerFocus">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value=".4" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="SettingsCommand" TargetType="RadioButton" BasedOn="{StaticResource SettingsTile}">
        <Setter Property="motion:OperatorChoiceMotion.Enabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid RenderTransformOrigin="50%,50%">
                            <Grid.RenderTransform>
                                <ScaleTransform port:ProductionNames.TemplateId="TbSc" />
                            </Grid.RenderTransform>
                            <ns6:OperatorGlassSurface x:Name="ChoiceSurface" CornerRadius="23" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" />
                            <ns1:OperatorChoiceSurface Progress="{Binding Path=(motion:OperatorChoiceMotion.Progress), RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Fill="{DynamicResource ControlCentre.TextBrush}" Opacity="{Binding Path=(motion:OperatorChoiceMotion.Progress), RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False" />
                        </Grid>
                        <Border x:Name="FocusFrame" CornerRadius="23" BorderThickness="2" BorderBrush="{DynamicResource ControlCentre.TextBrush}" IsHitTestVisible="False" IsVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:focus:focus-visible /template/ Border#FocusFrame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:checked /template/ glass|OperatorGlassSurface#ChoiceSurface">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlCentre.TextBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value=".4" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="SettingsRole" TargetType="CheckBox" BasedOn="{StaticResource SettingsToggle}">
        <Setter Property="Background" Value="{DynamicResource ControlCentre.SurfaceBrush}" />
        <Setter Property="motion:OperatorChoiceMotion.Enabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid RenderTransformOrigin="50%,50%">
                            <Grid.RenderTransform>
                                <ScaleTransform port:ProductionNames.TemplateId="TbSc" />
                            </Grid.RenderTransform>
                            <ns6:OperatorGlassSurface x:Name="ChoiceSurface" CornerRadius="23" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" />
                            <ns1:OperatorChoiceSurface x:Name="RoleFill" Progress="{Binding Path=(motion:OperatorChoiceMotion.Progress), RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Fill="{DynamicResource ControlCentre.TextBrush}" Opacity="{Binding Path=(motion:OperatorChoiceMotion.Progress), RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False" />
                        </Grid>
                        <Border x:Name="FocusFrame" CornerRadius="23" BorderThickness="2" BorderBrush="{DynamicResource ControlCentre.TextBrush}" IsHitTestVisible="False" IsVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^:focus:focus-visible /template/ Border#FocusFrame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{DynamicResource ControlCentre.SelectedTextBrush}" />
        </Style>
        <Style Selector="^:checked /template/ glass|OperatorGlassSurface#ChoiceSurface">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlCentre.TextBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value=".4" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
