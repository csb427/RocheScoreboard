                        <ContentPresenter x:Name="PART_SelectedContentHost" Margin="0,0,0,6" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                        <ns6:OperatorGlassSurface x:Name="PART_OperatorDock" Grid.Row="1" CornerRadius="36" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="#486886A6" BorderThickness="1" Padding="5" Margin="12,4,12,12" HorizontalAlignment="Stretch" MinWidth="0" MaxWidth="600">
                            <Grid>
                                <ns1:OperatorSelectionLens x:Name="PART_OperatorLens" />
                                <ItemsPresenter KeyboardNavigation.TabIndex="0" x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Grid>
                        </ns6:OperatorGlassSurface>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
