<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Compile the Windows application's authoritative engines directly. No forked rules. -->
  <ItemGroup>
    <Compile Include="../../Roche_Scoreboard/Models/*.cs" Exclude="../../Roche_Scoreboard/Models/MarqueeMessage.cs;../../Roche_Scoreboard/Models/SetupResult.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../Roche_Scoreboard/Services/AflGoalRunDetector.cs" Link="Services/AflGoalRunDetector.cs" />
    <Compile Include="../../Roche_Scoreboard/Services/AflDroughtCalculator.cs" Link="Services/AflDroughtCalculator.cs" />
    <Compile Include="../../Roche_Scoreboard/Services/AtomicFile.cs" Link="Services/AtomicFile.cs" />
    <InternalsVisibleTo Include="RocheScoreboard.Mac" />
    <InternalsVisibleTo Include="RocheScoreboard.Mac.Tests" />
  </ItemGroup>
</Project>
