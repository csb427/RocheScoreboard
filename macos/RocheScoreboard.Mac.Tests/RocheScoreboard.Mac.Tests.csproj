<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants Condition="'$(ROCHE_NATIVE_MEDIA)' == '1'">$(DefineConstants);ROCHE_NATIVE_MEDIA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RocheScoreboard.Mac/RocheScoreboard.Mac.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <Content Include="Fixtures/test-pattern.mp4" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Roche_Scoreboard/Views/ScorebugControl.xaml" Link="ProductionReferences/ScorebugControl.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../Roche_Scoreboard/Services/CricketConditionsChecks.cs" Link="ProductionChecks/CricketConditionsChecks.cs" />
    <Compile Include="../../Roche_Scoreboard/Services/CricketDeliveryRuleChecks.cs" Link="ProductionChecks/CricketDeliveryRuleChecks.cs" />
    <Compile Include="../../Roche_Scoreboard/Services/CricketOverAndStrikeChecks.cs" Link="ProductionChecks/CricketOverAndStrikeChecks.cs" />
    <Compile Include="../../Roche_Scoreboard/Services/CricketWorkflowChecks.cs" Link="ProductionChecks/CricketWorkflowChecks.cs" />
    <Compile Include="../../Roche_Scoreboard/Services/CricketDeliveryLogChecks.cs" Link="ProductionChecks/CricketDeliveryLogChecks.cs" />
    <Compile Include="../../Roche_Scoreboard/Services/CricketTossChecks.cs" Link="ProductionChecks/CricketTossChecks.cs" />
  </ItemGroup>
</Project>
