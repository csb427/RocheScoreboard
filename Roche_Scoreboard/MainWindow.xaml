<Window x:Class="Roche_Scoreboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Roche_Scoreboard.Views"
        Title="Roche Scoreboard v4.1.2"
        Height="1050"
        Width="1550"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="Manual"
        Background="#0D1117">

    <Window.Resources>
        <!-- ═══════════════════════════════════ -->
        <!-- COLOUR SYSTEM — broadcast console   -->
        <!-- ═══════════════════════════════════ -->
        <SolidColorBrush x:Key="ShellBrush" Color="#0D1117"/>
        <SolidColorBrush x:Key="RegionBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="RegionAltBrush" Color="#1C2128"/>
        <SolidColorBrush x:Key="RegionEdgeBrush" Color="#7A8693"/>
        <SolidColorBrush x:Key="SectionEdgeBrush" Color="#7A8693"/>
        <SolidColorBrush x:Key="TextStrongBrush" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextMidBrush" Color="#8B949E"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#A8B0BA"/>
        <SolidColorBrush x:Key="HomeAccentBrush" Color="#58A6FF"/>
        <SolidColorBrush x:Key="AwayAccentBrush" Color="#F85149"/>
        <SolidColorBrush x:Key="LiveBrush" Color="#3FB950"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#D29922"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF"/>

        <!-- ── Section heading — uppercase, tracked ── -->
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ── Primary command button — scoring, with high-energy reward motion ── -->
        <Style x:Key="PrimaryCommandButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="Lift" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="Glow" Background="#A858A6FF" CornerRadius="3" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Opacity="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.42"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" From="0.9" To="1.08" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.55" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" From="0.9" To="1.08" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.55" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" From="1" To="-2" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:0.24"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tool button — compact, punchy hover/click reward ── -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#7A8693"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="TbSc" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="TbLift" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="Glow" Background="#6C8FB5FF" CornerRadius="2" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Opacity="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TbSc" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TbSc" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TbLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.26" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TbSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TbSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TbLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.17"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7A8693"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A8B0BA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161B22"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TbSc" Storyboard.TargetProperty="ScaleX" From="0.92" To="1.07" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TbSc" Storyboard.TargetProperty="ScaleY" From="0.92" To="1.07" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TbLift" Storyboard.TargetProperty="Y" From="1" To="-1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:0.24"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" From="0.72" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Responsive operator navigation dock ── -->
        <Style x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#B8C7D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="62"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="#101722" Padding="8,7"
                                    CornerRadius="0" BorderThickness="0,0,1,1" BorderBrush="#2D3B4D">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="PrimaryLabel" Text="{TemplateBinding Header}"
                                                   Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="Black" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="SecondaryLabel" Text="{TemplateBinding Tag}"
                                                   Foreground="#71859A" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="AccBar" VerticalAlignment="Bottom" Height="4"
                                    Opacity="0" Margin="0" CornerRadius="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0058A6FF" Offset="0"/>
                                        <GradientStop Color="#FF58A6FF" Offset="0.5"/>
                                        <GradientStop Color="#0058A6FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="SecondaryLabel" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17263A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7058A6FF"/>
                                <Setter TargetName="AccBar" Property="Opacity" Value="1"/>
                                <Setter TargetName="PrimaryLabel" Property="Foreground" Value="White"/>
                                <Setter TargetName="SecondaryLabel" Property="Foreground" Value="#A9D3FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#182230"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58708C"/>
                                <Setter TargetName="PrimaryLabel" Property="Foreground" Value="#EAF5FF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PrimaryLabel" Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1B2B40"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Layout/animation radio selector with hover animation ── -->
        <Style x:Key="LayoutRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMidBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#1C2128" BorderBrush="#7A8693" BorderThickness="1" Padding="12,7"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="RbSc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21262D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A8B0BA"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RbSc" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RbSc" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RbSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RbSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Settings progressive-disclosure expander ── -->
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#AEB7C4"/>
            <Setter Property="Background" Value="#0A0E18"/>
            <Setter Property="BorderBrush" Value="#21262D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderToggle" Grid.Row="0" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0" Padding="12,9" HorizontalContentAlignment="Stretch"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HB" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                                      VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Chev" Grid.Column="1" Text="▾" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HB" Property="Background" Value="#11161E"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chev" Property="Text" Value="▴"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </ToggleButton>
                                <Border x:Name="Body" Grid.Row="1" Visibility="Collapsed" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="12">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified settings surface: one readable, elevated card per category. -->
        <Style x:Key="SettingsSectionSurface" TargetType="Border">
            <Setter Property="Background" Value="#101824"/>
            <Setter Property="BorderBrush" Value="#2B3A4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.24"/>
                </Setter.Value>
            </Setter>
        </Style>
        </Window.Resources>

    <Grid Background="{StaticResource ShellBrush}">
        <!-- ══════════════════════════════════════════ -->
        <!-- MAIN CONTENT — live match command surface  -->
        <!-- ══════════════════════════════════════════ -->
        <Grid x:Name="MainContent" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ PERSISTENT MATCH STRIP — cinematic broadcast header ═══ -->
            <Border x:Name="MatchStripBorder" Grid.Row="0" Margin="10,8,10,5" CornerRadius="12"
                    BorderBrush="#40546D" BorderThickness="1" Visibility="Visible" MinHeight="72">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#111A26" Offset="0"/>
                        <GradientStop Color="#172333" Offset="0.3"/>
                        <GradientStop Color="#172333" Offset="0.7"/>
                        <GradientStop Color="#111A26" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Subtle ambient glow behind centre clock -->
                    <Border IsHitTestVisible="False" Opacity="0.08" HorizontalAlignment="Center" Width="400">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.6" RadiusX="0.6" RadiusY="1.2">
                                <GradientStop Color="#58A6FF" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Bottom accent line -->
                    <Border VerticalAlignment="Bottom" Height="1" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0058A6FF" Offset="0"/>
                                <GradientStop Color="#4058A6FF" Offset="0.35"/>
                                <GradientStop Color="#6058A6FF" Offset="0.5"/>
                                <GradientStop Color="#4058A6FF" Offset="0.65"/>
                                <GradientStop Color="#0058A6FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="16,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Status badge -->
                        <Border x:Name="StatusBadge" Grid.Column="0" Background="#0A1A10" Padding="11,6" CornerRadius="9" VerticalAlignment="Center">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A4A2A" Offset="0"/>
                                    <GradientStop Color="#244A34" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#3FB950" Margin="0,0,6,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#3FB950" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="StatusText" Text="READY" Foreground="#3FB950" FontSize="12" FontWeight="Black"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="HeaderOutputBadge" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="14,0,0,0" Background="#0B1422" BorderBrush="#29486D" BorderThickness="1" CornerRadius="5" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#58A6FF" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Effect><DropShadowEffect Color="#58A6FF" BlurRadius="7" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="OUTPUT  " Foreground="#AFC0D2" FontSize="11" FontWeight="Black"/>
                                <TextBlock x:Name="HeaderOutputText" Text="Live Scorebug" Foreground="#D7EAFF" FontSize="12" FontWeight="Black"/>
                            </StackPanel>
                        </Border>

                        <!-- Centre: Clock + last event -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderQuarterClock" Text="Q1  00:00" Foreground="White" FontSize="28" FontWeight="Black" FontFamily="Arial" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#58A6FF" BlurRadius="16" ShadowDepth="0" Opacity="0.2"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="LastEventText" Text="" Foreground="#91A5BA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="HeaderShortcutText" Grid.Column="3" Text="KEYS  CTRL+1–4  ·  OUTPUT 1–6" Foreground="#C2CFDC" FontSize="11" FontWeight="Bold" Visibility="Collapsed"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <!-- Right: Score readout -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderHomeAbbr" Text="HOM" Foreground="{StaticResource HomeAccentBrush}" FontSize="16" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="HeaderScore" Text="0 – 0" Foreground="White" FontSize="30" FontWeight="Black" FontFamily="Arial" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.15"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="HeaderAwayAbbr" Text="AWA" Foreground="{StaticResource AwayAccentBrush}" FontSize="16" FontWeight="Black" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Border Background="#0A0E16" BorderBrush="#2A3850" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderMarginText" Text="" Foreground="#D6E3EF" FontSize="12" FontWeight="Black"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══ TAB BAR — broadcast channel selector ═══ -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Grid.RowSpan="2" Background="#090D14" BorderThickness="0" Padding="0" TabStripPlacement="Top" SelectionChanged="MainTabControl_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- The stock WPF template hosts headers in a
                                 desired-width TabPanel. A stretching
                                 ItemsPresenter lets the UniformGrid below own
                                 the complete horizontal strip. -->
                            <Border Grid.Row="0" Background="#0D131D" BorderBrush="#34465A" BorderThickness="0,0,0,1">
                                <ItemsPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource PanelTab}"/>
                </TabControl.Resources>
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>

                <!-- ══════════════════════════════════════════ -->
                <!-- TAB 1: SCORING &amp; CLOCK — the heart    -->
                <!-- ══════════════════════════════════════════ -->
                <TabItem x:Name="MatchControlTab" Header="MATCH" Tag="SCORING &amp; CLOCK">
                    <Border Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0" Padding="12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.34*" MinWidth="270" MaxWidth="390"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: Scoring controls — command deck -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Scoring header with match result -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SCORING" Style="{StaticResource SectionHead}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" BorderBrush="#7A8693" BorderThickness="1" Background="#0D1117" Padding="12,4">
                                        <TextBlock x:Name="MatchResultText" Text="" Foreground="{StaticResource TextMidBrush}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <!-- Scoring panels — top-level stoppage countdown + team command zones -->
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Border x:Name="ControlPanelCountdownPanel" Grid.Row="0" Background="#080E1C" BorderBrush="#1F6FEB" BorderThickness="2" CornerRadius="6" Padding="14,10" Visibility="Collapsed">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#1F6FEB" Opacity="0.22"/>
                                            </Border.Effect>
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x23F1;" FontSize="14" Foreground="#58A6FF" Margin="0,0,6,0"/>
                                                    <TextBlock Text="COUNTDOWN&#x0a;TIMER" FontSize="11" FontWeight="Black" Foreground="#58A6FF" LineHeight="11"/>
                                                </StackPanel>
                                                <TextBlock x:Name="ControlPanelCountdownStatusText" Text="" FontSize="10" FontWeight="SemiBold" Foreground="#C9D1D9" Margin="0,0,0,0" Visibility="Collapsed"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" x:Name="ControlPanelCountdownText" Text="20:00" FontSize="54" FontWeight="Black" FontFamily="Consolas" Foreground="White" VerticalAlignment="Center" Margin="0,-2,0,0">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#58A6FF" Opacity="0.38"/>
                                                </TextBlock.Effect>
                                            </TextBlock>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button x:Name="ControlPanelCountdownEditButton" Content="&#x270E; Edit" Margin="0,0,6,0" Click="ControlPanelCountdownEditButton_Click" Style="{StaticResource ToolBtn}" FontWeight="Black" Foreground="#E6EDF3" BorderBrush="#3B82F6" Background="#0F223F" Padding="12,6"/>
                                                <Button x:Name="ControlPanelCountdownCancelEditButton" Content="✕ Cancel" Margin="0,0,6,0" Click="ControlPanelCountdownCancelEditButton_Click" Style="{StaticResource ToolBtn}" FontWeight="Black" Foreground="#E6EDF3" BorderBrush="#64748B" Background="#1F2937" Padding="12,6" Visibility="Collapsed"/>
                                                <Button x:Name="ControlPanelCountdownResetButton" Content="&#x21BA; Reset" Margin="0" Click="ControlPanelCountdownResetButton_Click" Style="{StaticResource ToolBtn}" FontWeight="Black" Foreground="#E6EDF3" BorderBrush="#3FB950" Background="#102A19" Padding="12,6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Popup x:Name="ControlPanelCountdownEditPopupHost"
                                           PlacementTarget="{Binding ElementName=ControlPanelCountdownPanel}"
                                           Placement="Bottom"
                                           HorizontalOffset="0"
                                           VerticalOffset="4"
                                           AllowsTransparency="True"
                                           StaysOpen="False"
                                           PopupAnimation="Fade">
                                        <Border x:Name="ControlPanelCountdownEditPopup" Background="#0B1324" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="12,10" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="1,0">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="ControlPanelCountdownEditPopupScale" ScaleX="0.96" ScaleY="0.96"/>
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#3B82F6" Opacity="0.25"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#0A1224" BorderBrush="#2A4F8A" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                                    <TextBox x:Name="ControlPanelCountdownEditMinutesBox" Width="34" MaxLength="2" Text="20" FontSize="14" FontWeight="Black" FontFamily="Consolas" Foreground="#E6EDF3" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text=":" Foreground="#8FB8E8" FontSize="14" FontWeight="Black" VerticalAlignment="Center"/>
                                                <Border Grid.Column="4" Background="#0A1224" BorderBrush="#2A4F8A" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                                    <TextBox x:Name="ControlPanelCountdownEditSecondsBox" Width="34" MaxLength="2" Text="00" FontSize="14" FontWeight="Black" FontFamily="Consolas" Foreground="#E6EDF3" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                </Border>
                                                <Button Grid.Column="6" x:Name="ControlPanelCountdownApplyButton" Content="Apply" Click="ControlPanelCountdownApplyButton_Click" Style="{StaticResource ToolBtn}" FontWeight="Black" Foreground="#E6EDF3" BorderBrush="#3B82F6" Background="#0F223F" Padding="10,6"/>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- HOME scoring zone — thick top accent -->
                                        <Border x:Name="HomeScoringBorder" Grid.Column="0" BorderBrush="#33579A" BorderThickness="1,4,1,1" Background="#0A1428" Padding="14" CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock x:Name="HomeScoringLabel" Text="HOME" Foreground="#9CC8FF" FontSize="13" FontWeight="Black"/>
                                                <TextBlock Grid.Row="1" x:Name="HomeScoreDisplay" Text="0.0.0" Foreground="White" FontSize="58" FontWeight="Black" FontFamily="Bahnschrift" Margin="0,4,0,0"/>

                                                <Grid Grid.Row="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="8"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Button x:Name="HomeGoalButton" Grid.Row="0" Click="HomeGoal_Click" Style="{StaticResource PrimaryCommandButton}" ToolTip="Goal (+6 points) — A" BorderBrush="#4D7DE7" Background="#2F63D1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="+6 GOAL" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="HomeGoalShortcutText" Text=" A" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="HomeBehindButton" Grid.Row="2" Click="HomeBehind_Click" Style="{StaticResource PrimaryCommandButton}" FontSize="16" ToolTip="Behind (+1 point) — S" BorderBrush="#3A4E66" Background="#1A2636">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="+1 BEHIND" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="HomeBehindShortcutText" Text=" S" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- AWAY scoring zone — thick top accent -->
                                        <Border x:Name="AwayScoringBorder" Grid.Column="2" BorderBrush="#8A3A3A" BorderThickness="1,4,1,1" Background="#1C0A0A" Padding="14" CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock x:Name="AwayScoringLabel" Text="AWAY" Foreground="#FFB0B0" FontSize="13" FontWeight="Black"/>
                                                <TextBlock Grid.Row="1" x:Name="AwayScoreDisplay" Text="0.0.0" Foreground="White" FontSize="58" FontWeight="Black" FontFamily="Bahnschrift" Margin="0,4,0,0"/>

                                                <Grid Grid.Row="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="8"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Button x:Name="AwayGoalButton" Grid.Row="0" Click="AwayGoal_Click" Style="{StaticResource PrimaryCommandButton}" ToolTip="Goal (+6 points) — K" BorderBrush="#C56F6F" Background="#A63B3B">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="+6 GOAL" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="AwayGoalShortcutText" Text=" K" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="AwayBehindButton" Grid.Row="2" Click="AwayBehind_Click" Style="{StaticResource PrimaryCommandButton}" FontSize="16" ToolTip="Behind (+1 point) — L" BorderBrush="#5A3A3A" Background="#2A1A1A">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="+1 BEHIND" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="AwayBehindShortcutText" Text=" L" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- Warning banner — amber accent -->
                                <Border x:Name="StartSwitchWarning" Grid.Row="3" Background="#1E1A00" BorderBrush="#D29922" BorderThickness="1,2,1,1" Padding="10,6" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Pressing Start will switch to the live scoreboard" Foreground="#D29922" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Clock controls — amber accent zone, grouped tight -->
                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" x:Name="StartPauseButton" Content="▶ Start" Height="60" FontSize="22" FontWeight="Black" Click="StartPause_Click"
                                            Background="#0D3018" BorderBrush="#1A6040" BorderThickness="1.5" Style="{StaticResource PrimaryCommandButton}"
                                            ToolTip="Start or pause the game clock — Space"/>
                                    <Button Grid.Column="2" x:Name="EndQtrButton" Content="End Qtr" Height="60" FontSize="12" FontWeight="Bold" Click="EndQuarter_Click" Style="{StaticResource ToolBtn}" ToolTip="End the current quarter — Ctrl+E"
                                            Background="#21262D" BorderBrush="#D29922"/>
                                    <Button Grid.Column="2" x:Name="ContinueQtrButton" Content="↩ Resume Q" Height="60" FontSize="11" FontWeight="Bold" Click="ContinueQuarter_Click"
                                            Style="{StaticResource ToolBtn}" ToolTip="Resume the previous quarter from where it left off — does NOT start the next quarter"
                                            Background="#1A2A14" BorderBrush="#3A6030" Foreground="#7EE068" Visibility="Collapsed"/>
                                    <Button Grid.Column="4" x:Name="UndoButton" Content="UNDO" Height="60" FontSize="12" FontWeight="Bold" Click="Undo_Click" Style="{StaticResource ToolBtn}" ToolTip="Undo the last score — Ctrl+Z"
                                            Background="#2A1416" BorderBrush="#E08A8F"/>
                                </Grid>

                                <!-- Reset Match — danger zone, prominent but not dominant -->
                                <Button Grid.Row="7" Content="⟲  RESET MATCH" Height="42" FontSize="13" FontWeight="Black" Click="ResetMatch_Click"
                                        Style="{StaticResource ToolBtn}" ToolTip="Reset the entire match and return to setup"
                                        Background="#2A1416" BorderBrush="#E08A8F" Foreground="#FF6B6B"/>
                            </Grid>

                            <!-- RIGHT: cloud remote launcher + event log -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <views:CloudRemoteLauncher x:Name="ScoringTabCloudLauncher" Grid.Row="0"/>

                                <Border Grid.Row="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header bar -->
                                        <Border Grid.Row="0" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#818CF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="MATCH LOG" FontSize="10" FontWeight="Black" Foreground="#818CF8" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="MatchLogCountBadge" Text="" FontSize="9" FontWeight="Bold" Foreground="#A8B0BA" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Scrollable event list -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,4">
                                            <StackPanel x:Name="EventList"/>
                                        </ScrollViewer>

                                        <!-- Empty state hint -->
                                        <TextBlock x:Name="MatchLogEmptyHint" Grid.Row="1" Text="Score events will appear here"
                                                   Foreground="#7A8693" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ══════════════════════════════════════════ -->
                <!-- TAB 2: DISPLAY & MESSAGES — cinematic      -->
                <!-- ══════════════════════════════════════════ -->
                <TabItem x:Name="OutputStudioTab" Header="OUTPUT" Tag="PRESENTATIONS">
                    <Border Background="#0A0E18" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <!-- Ambient background glow -->
                            <Border Opacity="0.06" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.3,0.2" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#58A6FF" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Vignette -->
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#00000000" Offset="0.3"/>
                                        <GradientStop Color="#40000000" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.65*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ══════ LEFT: Presentation + Overlays ══════ -->
                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <!-- ── PRESENTATION MODE ── -->
                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="LIVE OUTPUT ROUTER" FontSize="16" FontWeight="Black" Foreground="White" Margin="0,0,0,2">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#58A6FF" Opacity="0.3"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="One click changes the public screen · active output is always highlighted" FontSize="10" FontWeight="SemiBold" Foreground="#9BB0C6"/>
                                        </StackPanel>

                                        <Border Background="#142236" BorderBrush="#3D5F85" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                            <TextBlock x:Name="CurrentDisplayText" Text="ON AIR · LIVE SCOREBUG" Foreground="#9CCBFF" FontSize="11" FontWeight="Black"/>
                                        </Border>

                                        <!-- Balanced 3×2 matrix: larger hit targets, no orphaned row or dead cells. -->
                                        <UniformGrid Columns="3" Margin="0,0,0,6">
                                            <!-- Scorebug -->
                                            <Border x:Name="PresCardScorebug" Cursor="Hand" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="2" CornerRadius="12" Margin="5" MouseLeftButtonUp="PresCardScorebug_Click">
                                                <Grid MinHeight="106">
                                                    <Border x:Name="PresGlowScorebug" Opacity="0.12" IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                                                <GradientStop Color="#58A6FF" Offset="0"/>
                                                                <GradientStop Color="#00000000" Offset="1"/>
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="LIVE" FontSize="11" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                                        <TextBlock Text="SCOREBUG" FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Live overlay" FontSize="10" FontWeight="SemiBold" Foreground="#B9D8FA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        <TextBlock Text="KEY 1" FontSize="10" FontWeight="Black" Foreground="#8FC5FF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border x:Name="PresCheckScorebug" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2">
                                                        <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <!-- Summary -->
                                            <Border x:Name="PresCardSummary" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="1" CornerRadius="12" Margin="5" MouseLeftButtonUp="PresCardSummary_Click">
                                                <Grid MinHeight="106">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="QTR" FontSize="11" FontWeight="Black" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                                        <TextBlock Text="BREAKDOWN" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Quarter history" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        <TextBlock Text="KEY 2" FontSize="10" FontWeight="Black" Foreground="#AFA0E8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border x:Name="PresCheckSummary" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Visibility="Collapsed">
                                                        <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <!-- Worm -->
                                            <Border x:Name="PresCardWorm" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="1" CornerRadius="12" Margin="5" MouseLeftButtonUp="PresCardWorm_Click">
                                                <Grid MinHeight="106">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="FLOW" FontSize="11" FontWeight="Black" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                                        <TextBlock Text="MARGIN FLOW" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Lead over time" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        <TextBlock Text="KEY 3" FontSize="10" FontWeight="Black" Foreground="#57D8A9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border x:Name="PresCheckWorm" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Visibility="Collapsed">
                                                        <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <!-- Stats -->
                                            <Border x:Name="PresCardStats" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="1" CornerRadius="12" Margin="5" MouseLeftButtonUp="PresCardStats_Click">
                                                <Grid MinHeight="106">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="DATA" FontSize="11" FontWeight="Black" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                                        <TextBlock Text="STATS" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Full match stats" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        <TextBlock Text="KEY 4" FontSize="10" FontWeight="Black" Foreground="#E2A52C" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border x:Name="PresCheckStats" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Visibility="Collapsed">
                                                        <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <!-- Weather -->
                                            <Border x:Name="PresCardWeather" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="1" CornerRadius="12" Margin="5" MouseLeftButtonUp="PresCardWeather_Click">
                                                <Grid MinHeight="106">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="WX" FontSize="11" FontWeight="Black" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                                        <TextBlock Text="WEATHER" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Live forecast" FontSize="10" FontWeight="SemiBold" Foreground="#91A5BA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        <TextBlock Text="KEY 5" FontSize="10" FontWeight="Black" Foreground="#58BEEA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border x:Name="PresCheckWeather" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="5,2" Visibility="Collapsed">
                                                        <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <!-- Window Toggle -->
                                            <Border x:Name="PresCardWindow" Cursor="Hand" Background="#101721" BorderBrush="#304055" BorderThickness="1" CornerRadius="12" Margin="5" MouseLeftButtonUp="PresCardWindow_Click">
                                                <Grid MinHeight="106">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="WindowToggleIcon" Text="OUT" FontSize="11" FontWeight="Black" Foreground="#F472B6" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                                        <TextBlock x:Name="WindowToggleTitle" Text="WINDOW" FontSize="14" FontWeight="Black" Foreground="#D5DFEA" HorizontalAlignment="Center"/>
                                                        <!-- Toggle pill indicator -->
                                                        <Grid HorizontalAlignment="Center" Margin="0,5,0,0" Width="40" Height="20" Cursor="Hand">
                                                            <Border x:Name="WindowToggleTrack" CornerRadius="10" Background="#21262D" BorderBrush="#7A8693" BorderThickness="1"/>
                                                            <Border x:Name="WindowToggleThumb" Width="16" Height="16" CornerRadius="8" Background="#6A6A80" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                                                <Border.RenderTransform>
                                                                    <TranslateTransform x:Name="WindowToggleThumbTranslate" X="0"/>
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock x:Name="WindowToggleLabel" Text="Open" FontSize="10" FontWeight="Black" Foreground="#A8B8C9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </UniformGrid>

                                        <!-- ── OVERLAYS ── -->
                                        <Border Height="1" Margin="0,6,0,14">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0058A6FF" Offset="0"/>
                                                    <GradientStop Color="#3058A6FF" Offset="0.5"/>
                                                    <GradientStop Color="#0058A6FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Text="LIVE TRIGGERS" FontSize="16" FontWeight="Black" Foreground="White" Margin="0,0,0,2">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#3FB950" Opacity="0.3"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="Manual actions always restore the scorebug and output before firing" FontSize="10" FontWeight="SemiBold" Foreground="#8DA397"/>
                                        </StackPanel>

                                        <!-- ── GAME ANALYSIS ── -->
                                        <TextBlock Text="GAME ANALYSIS" FontSize="11" FontWeight="Black" Foreground="#75D286" Margin="3,0,0,6"/>
                                        <UniformGrid Columns="5" Margin="0,0,0,10">
                                            <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayStatsBar_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="STATS BAR" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayWinProb_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="🎯" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="WIN PROB" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayLeadChanges_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="↕" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="LEAD CHANGES" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayQtrScores_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="🏁" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="QTR SCORES" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Cursor="Hand" Background="#081A0E" BorderBrush="#1A4028" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayRecentScores_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="RECENT SCORES" FontSize="11" FontWeight="Black" Foreground="#75D286" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- ── SCORING EVENTS ── -->
                                        <TextBlock Text="SCORING EVENTS" FontSize="11" FontWeight="Black" Foreground="#E7B94F" Margin="3,0,0,6"/>
                                        <UniformGrid Columns="4" Margin="0,0,0,10">
                                            <Border Cursor="Hand" Background="#14100A" BorderBrush="#3A2A10" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayScoringRun_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="🔥" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="SCORING RUN" FontSize="11" FontWeight="Black" Foreground="#E7B94F" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Cursor="Hand" Background="#14100A" BorderBrush="#3A2A10" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayScoreless_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="⏱" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="LAST SCORE" FontSize="11" FontWeight="Black" Foreground="#E7B94F" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Cursor="Hand" Background="#0A1428" BorderBrush="#1A2A44" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayHomeDrought_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="🏠" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="HOME DROUGHT" FontSize="11" FontWeight="Black" Foreground="#9CCBFF" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Cursor="Hand" Background="#1A0A0A" BorderBrush="#3A1A1A" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayAwayDrought_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="✈" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="AWAY DROUGHT" FontSize="11" FontWeight="Black" Foreground="#FFB5B5" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- ── DISPLAY ── -->
                                        <TextBlock Text="DISPLAY" FontSize="11" FontWeight="Black" Foreground="#78B7FF" Margin="3,0,0,6"/>
                                        <UniformGrid Columns="4" Margin="0,0,0,10">
                                            <Border Cursor="Hand" Background="#1A1408" BorderBrush="#C9B070" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayWarning_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="5 MIN WARN" FontSize="11" FontWeight="Black" Foreground="#E7B94F" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- ── WEATHER &amp; CONDITIONS ── -->
                                        <TextBlock Text="WEATHER &amp; CONDITIONS" FontSize="11" FontWeight="Black" Foreground="#86C8F5" Margin="3,0,0,6"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,4">
                                            <Border Cursor="Hand" Background="#06101C" BorderBrush="#14284A" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayWeatherForecast_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="☀" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="FORECAST" FontSize="11" FontWeight="Black" Foreground="#86C8F5" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Cursor="Hand" Background="#06101C" BorderBrush="#14284A" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayWeatherStats_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="🌡" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="WEATHER" FontSize="11" FontWeight="Black" Foreground="#86C8F5" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Cursor="Hand" Background="#06101C" BorderBrush="#14284A" BorderThickness="1" Margin="3" MouseLeftButtonUp="OverlayRainForecast_Click">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,10">
                                                    <TextBlock Text="🌧" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                    <TextBlock Text="RAIN" FontSize="11" FontWeight="Black" Foreground="#86C8F5" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- ══════ RIGHT: Messages ══════ -->
                                <Border Grid.Column="2" Background="#0A0E18" BorderBrush="#1A2A40" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Border Opacity="0.06" IsHitTestVisible="False">
                                            <Border.Background>
                                                <RadialGradientBrush Center="0.5,0.15" RadiusX="0.6" RadiusY="0.5">
                                                    <GradientStop Color="#3FB950" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Grid Margin="16,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Section header -->
                                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="▣" FontSize="28" FontFamily="Bahnschrift" FontWeight="Black"
                                                           Foreground="#67D17B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="TICKER MESSAGES" FontSize="16" FontWeight="Black" Foreground="#3FB950" HorizontalAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#3FB950" Opacity="0.4"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="Broadcast concise updates across the live bottom bar" FontSize="11" FontWeight="SemiBold" Foreground="#78B985" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0">
                                                    <Border Background="#0C2112" BorderBrush="#245C31" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,8,0">
                                                        <TextBlock x:Name="TickerMessageCountText" Text="0 ON AIR" FontSize="10" FontWeight="Black" Foreground="#75E18A"/>
                                                    </Border>
                                                    <Button x:Name="TickerClearAllButton" Content="CLEAR ALL" FontSize="10" FontWeight="Black" Padding="10,3" IsEnabled="False"
                                                            Click="ClearTickerMessages_Click" Style="{StaticResource ToolBtn}" BorderBrush="#6B3030" Foreground="#FF9999"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Row="1" Height="1" Margin="0,0,0,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#003FB950" Offset="0"/>
                                                        <GradientStop Color="#303FB950" Offset="0.5"/>
                                                        <GradientStop Color="#003FB950" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- Message list -->
                                            <Border Grid.Row="2" Background="#060A10" BorderBrush="#1A2A3A" BorderThickness="1" Padding="6">
                                                <Grid>
                                                    <StackPanel x:Name="TickerEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300">
                                                        <TextBlock Text="✦" FontSize="30" Foreground="#3FB950" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="NO MESSAGES ON AIR" FontSize="15" FontWeight="Black" Foreground="#DCE7E0" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                                        <TextBlock Text="Choose a quick template or type a short update below. Press Enter to add it instantly." FontSize="12" FontWeight="SemiBold" Foreground="#8FA99A" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Panel.ZIndex="1">
                                                    <ItemsControl x:Name="MessageList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,6" Padding="8,6" Background="#0A1018" BorderBrush="#1E3050" BorderThickness="1" CornerRadius="3">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <!-- Preview row -->
                                                                        <Border Grid.Row="0" Grid.ColumnSpan="4" CornerRadius="2" Padding="6,3" Margin="0,0,0,4"
                                                                                Background="{Binding HighlightBrush}">
                                                                            <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{Binding TextBrush}"/>
                                                                        </Border>

                                                                        <!-- Edit row: text + colour pickers + remove -->
                                                                        <TextBox Grid.Row="1" Grid.Column="0"
                                                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontSize="12" Background="#060A10" Foreground="#E6EDF3"
                                                                                 BorderBrush="#1E3050" CaretBrush="White"
                                                                                 Padding="6,4" VerticalContentAlignment="Center"
                                                                                 Margin="0,0,6,0"
                                                                                 TextChanged="MessageItem_TextChanged"/>

                                                                        <!-- Text colour picker -->
                                                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="TEXT" FontSize="8" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                                                            <Button Width="34" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1"
                                                                                    Click="PickItemTextColor_Click" Tag="{Binding}"
                                                                                    ToolTip="Click to choose text colour"
                                                                                    Background="{Binding TextBrush}"/>
                                                                        </StackPanel>

                                                                        <!-- Highlight colour picker -->
                                                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="HIGHLIGHT" FontSize="8" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                                                            <Button Width="50" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1"
                                                                                    Click="PickItemHighlightColor_Click" Tag="{Binding}"
                                                                                    ToolTip="Click to choose highlight colour. Right-click to clear."
                                                                                    MouseRightButtonUp="ClearItemHighlightColor_Click"
                                                                                    Background="{Binding HighlightBrush}"/>
                                                                        </StackPanel>

                                                                        <Button Grid.Row="1" Grid.Column="3"
                                                                                Content="✕" Width="30" Height="40" FontSize="12" FontWeight="Black"
                                                                                Click="RemoveMessageItem_Click" Tag="{Binding}"
                                                                                Style="{StaticResource ToolBtn}" BorderBrush="#3A1A1A"
                                                                                VerticalAlignment="Bottom"
                                                                                ToolTip="Remove this message"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                </Grid>
                                            </Border>

                                            <!-- Add controls (text + colour pickers + add) -->
                                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                    <TextBlock Text="QUICK ADD" FontSize="11" FontWeight="Black" Foreground="#A8BBAE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Content="WELCOME" Tag="Welcome to today's match" Click="TickerTemplate_Click" FontSize="10" FontWeight="Black" Padding="8,3" Margin="0,0,5,0" Style="{StaticResource ToolBtn}"/>
                                                    <Button Content="QUARTER BREAK" Tag="Quarter break — play resumes shortly" Click="TickerTemplate_Click" FontSize="10" FontWeight="Black" Padding="8,3" Margin="0,0,5,0" Style="{StaticResource ToolBtn}"/>
                                                    <Button Content="THANK YOU" Tag="Thank you for joining us today" Click="TickerTemplate_Click" FontSize="10" FontWeight="Black" Padding="8,3" Style="{StaticResource ToolBtn}"/>
                                                </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="NewMessageBox" FontSize="13" MaxLength="140" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" CaretBrush="White" Padding="10,7" VerticalContentAlignment="Center" Margin="0,0,6,0" KeyDown="NewMessageBox_KeyDown" TextChanged="NewMessageBox_TextChanged" ToolTip="Ticker message — maximum 140 characters"/>

                                                <!-- New text colour picker -->
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="TEXT" FontSize="10" FontWeight="Bold" Foreground="#A9BDD2" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                                    <Button x:Name="NewMessageTextColorBtn" Width="40" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1"
                                                            Background="White"
                                                            Click="PickNewTextColor_Click"
                                                            ToolTip="Click to choose text colour for the new message"/>
                                                </StackPanel>

                                                <!-- New highlight colour picker -->
                                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="HIGHLIGHT" FontSize="10" FontWeight="Bold" Foreground="#A9BDD2" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                                    <Button x:Name="NewMessageHighlightColorBtn" Width="56" Height="22" Padding="0" BorderBrush="#1E3050" BorderThickness="1"
                                                            Background="Transparent"
                                                            Click="PickNewHighlightColor_Click"
                                                            MouseRightButtonUp="ClearNewHighlightColor_Click"
                                                            ToolTip="Click to choose highlight colour. Right-click to clear (no highlight)."/>
                                                </StackPanel>

                                                <Button Grid.Column="3" Content="+" Width="34" Height="40" FontSize="14" FontWeight="Black" Click="AddMessage_Click" Style="{StaticResource ToolBtn}" BorderBrush="#1A3A24" VerticalAlignment="Bottom"/>
                                            </Grid>
                                                <TextBlock x:Name="TickerCharacterCountText" Text="0 / 140 · ENTER TO ADD" FontSize="10" FontWeight="SemiBold" Foreground="#738497" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ══════════════════════════════════════════ -->
                <!-- TAB 3: VIDEO — dedicated MP4 upload + preview -->
                <!-- ══════════════════════════════════════════ -->
                <TabItem x:Name="MediaDeskTab" Header="MEDIA" Tag="VIDEO &amp; TICKER">
                    <Border Background="#0A0E18" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Border Opacity="0.06" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.3,0.2" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#58A6FF" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Margin="24,18,24,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                    <TextBlock Text="VIDEO PLAYBACK" FontSize="18" FontWeight="Black" Foreground="#58A6FF">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#58A6FF" Opacity="0.35"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="Upload, preview and broadcast custom video clips to the scoreboard window." FontSize="12" FontWeight="SemiBold" Foreground="#A9CCF2" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- LEFT: Controls -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#0D1424" BorderBrush="#1F2A44" BorderThickness="1" Padding="18">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- Media Control Centre — single, linear workflow:
                                                 Browse loads the file into the scoreboard player (paused on
                                                 frame 0), then Show on Scoreboard hands the output over to
                                                 the LibVLC surface. Play/Restart drive both the preview and
                                                 the scoreboard simultaneously. -->
                                            <TextBlock Text="MEDIA · CONTROL CENTRE" Foreground="#78B7FF" FontSize="12" FontWeight="Black" Margin="0,0,0,8"/>
                                            <Border Background="#0A0E18" BorderBrush="#6F86A8" BorderThickness="1" Padding="14" Margin="0,0,0,18">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="VideoTabFilePathText" Text="No file selected" Foreground="#9CC4F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="1" Content="📁 Browse" Width="100" Height="30" Click="VideoTabBrowse_Click" Style="{StaticResource ToolBtn}" Margin="10,0,0,0" BorderBrush="#6F86A8" FontWeight="Bold" ToolTip="Pick a video or image file. It is auto-loaded into the scoreboard player."/>
                                                    </Grid>
                                                    <TextBlock x:Name="VideoTabFileMetaText" Text="Supported: mp4, mov, mkv, webm, avi, wmv, m4v, ts, mpg, mpeg, 3gp, flv, png, jpg, jpeg, bmp, gif, tif, tiff, webp and other Windows-supported formats." Foreground="#8FB8E8" FontSize="11" Margin="0,8,0,12" TextWrapping="Wrap"/>

                                                    <Button x:Name="VideoTabShowOnScoreboardButton" Content="🖥  Show on Scoreboard" Height="38" FontSize="13" FontWeight="Black" Click="VideoTabShowOnScoreboard_Click" Style="{StaticResource ToolBtn}" IsEnabled="False" BorderBrush="#6F86A8" Margin="0,0,0,8" ToolTip="Take over the scoreboard output with this video."/>
                                                    <Button x:Name="VideoTabPlayPauseButton" Content="▶  Play" Height="40" FontSize="13" FontWeight="Black" Click="VideoTabPlayPause_Click" Style="{StaticResource ToolBtn}" IsEnabled="False" BorderBrush="#1F7A3F" Background="#0E2A18" Foreground="#7FE0A0"/>
                                                    <Button x:Name="VideoTabRestartButton" Content="⟲  Restart" Height="30" FontSize="11" FontWeight="Bold" Click="VideoTabRestart_Click" Style="{StaticResource ToolBtn}" Margin="0,8,0,0" IsEnabled="False" BorderBrush="#6F86A8"/>
                                                    <Button x:Name="VideoTabUnloadButton" Content="✕  Unload Video" Height="30" FontSize="11" FontWeight="Bold" Click="VideoTabUnload_Click" Style="{StaticResource ToolBtn}" Margin="0,8,0,0" IsEnabled="False" BorderBrush="#5A2A2A" Background="#2A1212" Foreground="#E08080" ToolTip="Stop playback, clear the current video, and return the scoreboard to its previous screen."/>
                                                    <TextBlock x:Name="VideoTabStatusText" Text="No video loaded." Foreground="#7FE0A0" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Hidden retained for backward compatibility with code-behind that still references this control. -->
                                            <Button x:Name="VideoTabApplyButton" Visibility="Collapsed" Click="VideoTabApply_Click" IsEnabled="False"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- RIGHT: Preview -->
                                <Border Grid.Row="1" Grid.Column="2" Background="#000000" BorderBrush="#1F2A44" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Video surface -->
                                        <Grid Grid.Row="0">
                                            <!-- Live mirror of the actual scoreboard output window. Bound at
                                                 runtime to a VisualBrush of _displayContainer so this preview
                                                 always shows whatever is currently on the scoreboard (scorebug,
                                                 break, scoreworm, stats, weather). LibVLC's native HWND is the
                                                 only surface a VisualBrush can't capture, so during video
                                                 takeover we fall back to the local MediaElement layered on top. -->
                                            <Rectangle x:Name="VideoTabLiveMirror" Stretch="Uniform"/>

                                            <!-- Checkerboard placeholder (shown only when the scoreboard window
                                                 isn't open yet — nothing to mirror). -->
                                            <Grid x:Name="VideoTabPreviewPlaceholder">
                                                <Border Background="#0D1424"/>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="🎬" FontSize="56" HorizontalAlignment="Center" Foreground="#6F86A8"/>
                                                    <TextBlock Text="PREVIEW" FontSize="14" FontWeight="Black" Foreground="#8FB8E8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                    <TextBlock Text="Open the scoreboard window to see a live mirror here." FontSize="12" Foreground="#A9CCF2" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- The local MediaElement preview was retired: it ran a second
                                                 decoder in parallel with LibVLC and was the last remaining
                                                 source of double-decode lag. The live VisualBrush mirror
                                                 above now shows the actual scoreboard output, and seek /
                                                 time / speed controls drive the LibVLC surface directly. -->
                                            <!-- Preview overlay info -->
                                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#A0000000" Padding="8,4" Margin="8">
                                                <StackPanel>
                                                    <TextBlock x:Name="VideoTabPreviewBadge" Text="LIVE · MIRRORING SCOREBOARD" Foreground="#78B7FF" FontSize="11" FontWeight="Black"/>
                                                    <TextBlock x:Name="VideoTabTelemetryText" Text="" Foreground="#7FE0A0" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    <TextBlock x:Name="VideoTabDiagnosticText" Text="" Foreground="#E8D08A" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="320"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- YouTube-style control strip -->
                                        <Border Grid.Row="1" Background="#0A0E18" BorderBrush="#1F2A44" BorderThickness="0,1,0,0" Padding="12,8">
                                            <StackPanel>
                                                <!-- Seek bar with hover/scrub support -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="VideoTabCurrentTimeText" Grid.Column="0" Text="0:00" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="42"/>
                                                    <Slider x:Name="VideoTabSeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="#FF0000" Background="#2A2A40" Thumb.DragStarted="VideoTabSeek_DragStarted" Thumb.DragCompleted="VideoTabSeek_DragCompleted" PreviewMouseLeftButtonUp="VideoTabSeek_PreviewMouseLeftButtonUp" ValueChanged="VideoTabSeek_ValueChanged"/>
                                                    <TextBlock x:Name="VideoTabDurationText" Grid.Column="2" Text="0:00" Foreground="#8B97A8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"/>
                                                </Grid>

                                                <!-- Bottom row: speed + volume -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Speed dropdown -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="SPEED" Foreground="#B8D7F6" FontSize="11" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <ComboBox x:Name="VideoTabSpeedCombo" Width="78" Height="26" SelectionChanged="VideoTabSpeed_Changed" Background="#0D1424" BorderBrush="#6F86A8" Foreground="#E6EDF3">
                                                            <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                                            <ComboBoxItem Content="0.5x"  Tag="0.5"/>
                                                            <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                                            <ComboBoxItem Content="Normal" Tag="1.0" IsSelected="True"/>
                                                            <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                                            <ComboBoxItem Content="1.5x"  Tag="1.5"/>
                                                            <ComboBoxItem Content="1.75x" Tag="1.75"/>
                                                            <ComboBoxItem Content="2x"    Tag="2.0"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Spacer -->
                                                    <Border Grid.Column="1"/>

                                                    <!-- Mute -->
                                                    <Button x:Name="VideoTabMuteButton" Grid.Column="2" Content="🔊" Width="34" Height="26" FontSize="14" Click="VideoTabMute_Click" Style="{StaticResource ToolBtn}" BorderBrush="#6F86A8" ToolTip="Mute / unmute scoreboard audio"/>

                                                    <!-- Volume -->
                                                    <Slider x:Name="VideoTabVolumeSlider" Grid.Column="3" Minimum="0" Maximum="1" Value="1" Width="100" Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="VideoTabVolume_Changed" ToolTip="Scoreboard volume"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ══════════════════════════════════════════ -->
                <!-- TAB 4: SETTINGS — cinematic full-screen     -->
                <!-- ══════════════════════════════════════════ -->
                <TabItem x:Name="MatchSetupTab" Header="SETUP" Tag="TEAMS &amp; OPTIONS">
                    <Border Background="#0A0E18" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <!-- Ambient glow -->
                            <Border Opacity="0.05" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.7,0.2" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#3FB950" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#00000000" Offset="0.3"/>
                                        <GradientStop Color="#30000000" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Hidden backing radio buttons -->
                            <RadioButton x:Name="ClockModeCountUp" IsChecked="True" GroupName="ClockMode" Checked="ClockMode_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="ClockModeCountdown" GroupName="ClockMode" Checked="ClockMode_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="LayoutClassicRadio" GroupName="LayoutChoice" IsChecked="True" Checked="LayoutRadio_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="LayoutExpandedRadio" GroupName="LayoutChoice" Checked="LayoutRadio_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="LayoutRetroRadio" GroupName="LayoutChoice" Checked="LayoutRadio_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="LayoutNoLogosRadio" GroupName="LayoutChoice" Checked="LayoutRadio_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="AnimBroadcastRadio" GroupName="AnimChoice" IsChecked="True" Checked="AnimationRadio_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="AnimElectricRadio" GroupName="AnimChoice" Checked="AnimationRadio_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="AnimCinematicRadio" GroupName="AnimChoice" Checked="AnimationRadio_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="AnimCleanRadio" GroupName="AnimChoice" Checked="AnimationRadio_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="AnimClassicRadio" GroupName="AnimChoice" Checked="AnimationRadio_Changed" Visibility="Collapsed"/>
                            <RadioButton x:Name="AnimCustomVideoRadio" GroupName="AnimChoice" Checked="AnimationRadio_Changed" Visibility="Collapsed"/>
                            <!-- Hidden backing controls -->
                            <CheckBox x:Name="SettingsShowControlPanelCountdown" IsChecked="True" Visibility="Collapsed"/>
                            <TextBlock x:Name="HomeLogoPathText" Visibility="Collapsed"/>
                            <TextBlock x:Name="AwayLogoPathText" Visibility="Collapsed"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="214"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ═══ NAVIGATION + SEARCH ═══ -->
                                <Border Grid.Column="0" Padding="14" BorderBrush="#304158" BorderThickness="0,0,1,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#152238" Offset="0"/>
                                            <GradientStop Color="#0E1726" Offset="0.55"/>
                                            <GradientStop Color="#161B25" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                            <TextBlock Text="SETTINGS CENTRE" Foreground="#F2F6FC" FontSize="18" FontWeight="Black"/>
                                            <TextBlock Text="Match, workflow and output" Foreground="#9FB0C6" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Category filter pills -->
                                        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,14,0,0">
                                            <Border x:Name="SettingsNavBtn_Teams" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" MouseLeftButtonUp="SettingsNav_Teams_Click">
                                                <TextBlock Text="TEAMS" FontSize="10" FontWeight="Black" Foreground="#58A6FF"/>
                                            </Border>
                                            <Border x:Name="SettingsNavBtn_Match" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" MouseLeftButtonUp="SettingsNav_Match_Click">
                                                <TextBlock Text="MATCH" FontSize="10" FontWeight="Black" Foreground="#D29922"/>
                                            </Border>
                                            <Border x:Name="SettingsNavBtn_Keybinds" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" MouseLeftButtonUp="SettingsNav_Keybinds_Click">
                                                <TextBlock Text="KEYBINDS" FontSize="10" FontWeight="Black" Foreground="#A78BFA"/>
                                            </Border>
                                            <Border x:Name="SettingsNavBtn_Display" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" MouseLeftButtonUp="SettingsNav_Display_Click">
                                                <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="Black" Foreground="#58A6FF"/>
                                            </Border>
                                            <Border x:Name="SettingsNavBtn_Overlays" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" MouseLeftButtonUp="SettingsNav_Overlays_Click">
                                                <TextBlock Text="OVERLAYS" FontSize="10" FontWeight="Black" Foreground="#3FB950"/>
                                            </Border>
                                            <Border x:Name="SettingsNavBtn_Media" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" MouseLeftButtonUp="SettingsNav_Media_Click">
                                                <TextBlock Text="MEDIA" FontSize="10" FontWeight="Black" Foreground="#58A6FF"/>
                                            </Border>
                                            <Border x:Name="SettingsNavBtn_Advanced" CornerRadius="6" Padding="12,10" Margin="0" Cursor="Hand" Background="#0A101A" BorderBrush="#2B3A4E" BorderThickness="1" MouseLeftButtonUp="SettingsNav_Advanced_Click">
                                                <TextBlock Text="ADVANCED" FontSize="10" FontWeight="Black" Foreground="#8B949E"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Search box -->
                                        <Border Grid.Row="1" Background="#090F19" BorderBrush="#52647A" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,12,0,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="SettingsSearchBox" Grid.Column="1" Background="Transparent" Foreground="#E6EDF3" CaretBrush="#58A6FF" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center" TextChanged="SettingsSearch_TextChanged" ToolTip="Search all settings (Ctrl+F)"/>
                                                <TextBlock x:Name="SettingsSearchPlaceholder" Grid.Column="1" Text="Search settings…" FontSize="11" Foreground="#A8B0BA" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                                <Border x:Name="SettingsSearchClear" Grid.Column="2" Padding="4,0,0,0" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonUp="SettingsSearchClear_Click">
                                                    <TextBlock Text="✕" FontSize="11" Foreground="#8B949E"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- ═══ EMPTY-STATE WHEN SEARCH MATCHES NOTHING ═══ -->
                                <Border x:Name="SettingsNoResults" Grid.Column="1" Visibility="Collapsed" Background="Transparent">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Foreground="#7A8693" Margin="0,40,0,8"/>
                                        <TextBlock x:Name="SettingsNoResultsText" Text="No settings match your search" FontSize="13" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Try a different keyword or clear the filter" FontSize="10" Foreground="#A8B0BA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ SCROLLABLE SETTINGS CONTENT ═══ -->
                                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" Margin="14,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel HorizontalAlignment="Stretch">

                                    <!-- ══════════════════════════════════════ -->
                                    <!-- SECTION 1: TEAMS                      -->
                                    <!-- ══════════════════════════════════════ -->
                                    <Border x:Name="SettingsSection_Teams" Style="{StaticResource SettingsSectionSurface}" Tag="teams team home away name abbreviation colour color logo primary secondary jumper">
                                        <StackPanel>
                                            <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                <TextBlock Text="TEAMS" FontSize="14" FontWeight="Black" Foreground="#58A6FF" Margin="0,0,0,2">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#58A6FF" Opacity="0.3"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="Edit team names, abbreviations, colours, and logos" FontSize="9" FontWeight="SemiBold" Foreground="#8FB8E8"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Home team card -->
                                                <Border Grid.Column="0" Background="#0A1628" BorderBrush="#1A3A6A" BorderThickness="1,2,1,1" Padding="14,10">
                                                    <Grid>
                                                        <Border Opacity="0.06" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <RadialGradientBrush Center="0.5,0.3" RadiusX="0.6" RadiusY="0.5">
                                                                    <GradientStop Color="#58A6FF" Offset="0"/>
                                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                                </RadialGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel>
                                                            <Border Background="#1A3A6A" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                                <TextBlock Text="HOME TEAM" Foreground="#7EB4FF" FontSize="10" FontWeight="Black"/>
                                                            </Border>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="HomeNameBox" Text="Home Team" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="10,7" VerticalContentAlignment="Center" TextChanged="TeamSettings_TextChanged"/>
                                                                <TextBox x:Name="HomeAbbrBox" Grid.Column="2" Text="HOM" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="6,7" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="4" TextChanged="TeamSettings_TextChanged"/>
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox x:Name="HomeColorBox" Width="66" Text="#0A2A6A" FontSize="10" VerticalContentAlignment="Center" Margin="0,0,3,0" Visibility="Collapsed"/>
                                                                <Border x:Name="HomeColorPreview" Width="30" Height="28" Background="#0A2A6A" BorderBrush="#7DA0CA" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="PickHomeColor_Click"/>
                                                                <Border Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="DropperHomeColor_Click" Margin="3,0,0,0">
                                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBox x:Name="HomeSecondaryColorBox" Width="66" Text="#FFFFFF" FontSize="10" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                                                                <Border x:Name="HomeSecondaryColorPreview" Width="30" Height="28" Background="#FFFFFF" BorderBrush="#7DA0CA" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="PickHomeSecondaryColor_Click" Margin="8,0,0,0"/>
                                                                <Border Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="DropperHomeSecondaryColor_Click" Margin="3,0,0,0">
                                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="Primary" Foreground="#7DA0CA" FontSize="8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                <TextBlock Text="/ Text" Foreground="#7DA0CA" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <Button Content="📂 Logo" Height="26" FontSize="10" FontWeight="Bold" Click="BrowseHomeLogo_Click" Style="{StaticResource ToolBtn}" BorderBrush="#1A3A6A" Padding="8,0"/>
                                                                <Button Content="✕" Width="26" Height="26" FontSize="10" FontWeight="Bold" Click="ClearHomeLogo_Click" Style="{StaticResource ToolBtn}" BorderBrush="#3A2020" Margin="4,0,0,0" ToolTip="Remove logo"/>
                                                                <TextBlock x:Name="HomeLogoStatusText" Text="" Foreground="#7DA0CA" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Away team card -->
                                                <Border Grid.Column="2" Background="#1A0A0A" BorderBrush="#6A1A1A" BorderThickness="1,2,1,1" Padding="14,10">
                                                    <Grid>
                                                        <Border Opacity="0.06" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <RadialGradientBrush Center="0.5,0.3" RadiusX="0.6" RadiusY="0.5">
                                                                    <GradientStop Color="#FF6B6B" Offset="0"/>
                                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                                </RadialGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel>
                                                            <Border Background="#4A1A1A" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                                <TextBlock Text="AWAY TEAM" Foreground="#FF9A9A" FontSize="10" FontWeight="Black"/>
                                                            </Border>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="70"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="AwayNameBox" Text="Away Team" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="10,7" VerticalContentAlignment="Center" TextChanged="TeamSettings_TextChanged"/>
                                                                <TextBox x:Name="AwayAbbrBox" Grid.Column="2" Text="AWA" FontSize="12" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#1E3050" BorderThickness="1" CaretBrush="White" Padding="6,7" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="4" TextChanged="TeamSettings_TextChanged"/>
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox x:Name="AwayColorBox" Width="66" Text="#7A1A1A" FontSize="10" VerticalContentAlignment="Center" Margin="0,0,3,0" Visibility="Collapsed"/>
                                                                <Border x:Name="AwayColorPreview" Width="30" Height="28" Background="#7A1A1A" BorderBrush="#7DA0CA" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="PickAwayColor_Click"/>
                                                                <Border Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="DropperAwayColor_Click" Margin="3,0,0,0">
                                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBox x:Name="AwaySecondaryColorBox" Width="66" Text="#FFFFFF" FontSize="10" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                                                                <Border x:Name="AwaySecondaryColorPreview" Width="30" Height="28" Background="#FFFFFF" BorderBrush="#7DA0CA" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="PickAwaySecondaryColor_Click" Margin="8,0,0,0"/>
                                                                <Border Width="28" Height="28" Background="#141C2A" BorderBrush="#6F86A8" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="DropperAwaySecondaryColor_Click" Margin="3,0,0,0">
                                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="Primary" Foreground="#523030" FontSize="8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                <TextBlock Text="/ Text" Foreground="#523030" FontSize="8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <Button Content="📂 Logo" Height="26" FontSize="10" FontWeight="Bold" Click="BrowseAwayLogo_Click" Style="{StaticResource ToolBtn}" BorderBrush="#4A1A1A" Padding="8,0"/>
                                                                <Button Content="✕" Width="26" Height="26" FontSize="10" FontWeight="Bold" Click="ClearAwayLogo_Click" Style="{StaticResource ToolBtn}" BorderBrush="#3A2020" Margin="4,0,0,0" ToolTip="Remove logo"/>
                                                                <TextBlock x:Name="AwayLogoStatusText" Text="" Foreground="#523030" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ══════════════════════════════════════ -->
                                    <!-- SECTION 2: MATCH                      -->
                                    <!-- ══════════════════════════════════════ -->
                                    <Border x:Name="SettingsSection_Match" Style="{StaticResource SettingsSectionSurface}" Tag="match clock countdown count up quarter duration minutes seconds finals timer time siren adjust set quarter labels custom break ht qt ft override">
                                        <StackPanel>
                                            <Border Height="1" Margin="0,0,0,14">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00D29922" Offset="0"/>
                                                        <GradientStop Color="#30D29922" Offset="0.5"/>
                                                        <GradientStop Color="#00D29922" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                <TextBlock Text="MATCH" FontSize="14" FontWeight="Black" Foreground="#D29922" Margin="0,0,0,2">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#D29922" Opacity="0.3"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="Clock mode, quarter duration, and finals settings" FontSize="9" FontWeight="SemiBold" Foreground="#C9A74A"/>
                                            </StackPanel>

                                            <!-- Clock mode cards -->
                                            <Grid Margin="0,0,0,8" Height="100">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Count Up card -->
                                                <Border x:Name="SettingsCountUpCard" Grid.Column="0" Cursor="Hand" Background="#0A1628" BorderBrush="#58A6FF" BorderThickness="2" MouseLeftButtonUp="SettingsCountUpCard_Click">
                                                    <Grid>
                                                        <Border x:Name="SettingsCountUpGlow" Opacity="0.12" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                                                    <GradientStop Color="#58A6FF" Offset="0"/>
                                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                                </RadialGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="▲" FontSize="26" FontWeight="Black" Foreground="#58A6FF" HorizontalAlignment="Center">
                                                                <TextBlock.Effect>
                                                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#58A6FF" Opacity="0.5"/>
                                                                </TextBlock.Effect>
                                                            </TextBlock>
                                                            <TextBlock Text="COUNT UP" FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Border x:Name="SettingsCountUpCheck" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#58A6FF" Padding="6,3">
                                                            <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Countdown card -->
                                                <Border x:Name="SettingsCountdownCard" Grid.Column="2" Cursor="Hand" Background="#0E0C08" BorderBrush="#C9B070" BorderThickness="1" MouseLeftButtonUp="SettingsCountdownCard_Click">
                                                    <Grid>
                                                        <Border x:Name="SettingsCountdownGlow" Opacity="0" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                                                    <GradientStop Color="#D29922" Offset="0"/>
                                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                                </RadialGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="▼" FontSize="26" FontWeight="Black" Foreground="#6B5A00" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="COUNTDOWN" FontSize="14" FontWeight="Black" Foreground="#8A7A50" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Border x:Name="SettingsCountdownCheck" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D29922" Padding="6,3" Visibility="Collapsed">
                                                            <TextBlock Text="✓" FontSize="9" FontWeight="Black" Foreground="#1A1400"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <Border x:Name="SettingsControlPanelCountdownOptionCard"
                                                    Margin="0,0,0,8" Padding="14,10"
                                                    Background="#10161D" BorderBrush="#30363D" BorderThickness="1"
                                                    CornerRadius="12" Cursor="Hand" Visibility="Collapsed" Opacity="0"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    MouseLeftButtonUp="SettingsControlPanelCountdownOptionCard_Click">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <TranslateTransform x:Name="SettingsControlPanelCountdownCardTranslate" Y="18"/>
                                                        <ScaleTransform x:Name="SettingsControlPanelCountdownCardScale" ScaleX="0.97" ScaleY="0.97"/>
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="&#x23F1;" FontSize="16" Foreground="#58A6FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Timing stoppages too?" Foreground="White" FontSize="14" FontWeight="Black" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Show a separate countdown timer in the control panel." Foreground="#C9D1D9" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0" HorizontalAlignment="Center">
                                                        <Border x:Name="SettingsControlPanelCountdownToggleTrack" Width="50" Height="26" CornerRadius="13" Background="#1F6FEB">
                                                            <Ellipse x:Name="SettingsControlPanelCountdownToggleThumb" Width="20" Height="20" Fill="White" Margin="3,3,0,3" HorizontalAlignment="Left">
                                                                <Ellipse.RenderTransform>
                                                                    <TranslateTransform x:Name="SettingsControlPanelCountdownThumbTranslate" X="24"/>
                                                                </Ellipse.RenderTransform>
                                                            </Ellipse>
                                                        </Border>
                                                        <TextBlock x:Name="SettingsControlPanelCountdownToggleLabel" Text="ON" Foreground="#58A6FF" FontSize="9" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Quarter duration panel -->
                                            <StackPanel x:Name="QuarterDurationPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                                <Border Background="#0C0A04" BorderBrush="#C9B070" BorderThickness="1" Padding="14">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="QUARTER LENGTH" FontSize="9" FontWeight="Black" Foreground="#8A7A40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Border Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" MouseLeftButtonUp="SettingsMinutesMinus_Click">
                                                                <TextBlock Text="−" FontSize="18" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" MinWidth="56" Height="52" Padding="0" Margin="6,0">
                                                                <TextBox x:Name="QuarterMinutesBox" Text="20" FontSize="30" FontWeight="Black" FontFamily="Consolas" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="3" KeyDown="QuarterDurationBox_KeyDown">
                                                                    <TextBox.Effect>
                                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#D29922" Opacity="0.3"/>
                                                                    </TextBox.Effect>
                                                                </TextBox>
                                                            </Border>
                                                            <Border Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" MouseLeftButtonUp="SettingsMinutesPlus_Click">
                                                                <TextBlock Text="+" FontSize="18" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text=":" FontSize="30" FontWeight="Black" Foreground="#6B5A00" VerticalAlignment="Center" Margin="8,0"/>
                                                            <Border Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" MouseLeftButtonUp="SettingsSecondsMinus_Click">
                                                                <TextBlock Text="−" FontSize="18" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" MinWidth="56" Height="52" Padding="0" Margin="6,0">
                                                                <TextBox x:Name="QuarterSecondsBox" Text="00" FontSize="30" FontWeight="Black" FontFamily="Consolas" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="2" KeyDown="QuarterDurationBox_KeyDown">
                                                                    <TextBox.Effect>
                                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#D29922" Opacity="0.3"/>
                                                                    </TextBox.Effect>
                                                                </TextBox>
                                                            </Border>
                                                            <Border Background="#141008" BorderBrush="#C9B070" BorderThickness="1" Width="36" Height="36" Cursor="Hand" MouseLeftButtonUp="SettingsSecondsPlus_Click">
                                                                <TextBlock Text="+" FontSize="18" FontWeight="Black" Foreground="#D29922" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                            <TextBlock Text="MINUTES" FontSize="8" FontWeight="SemiBold" Foreground="#6B5A00" Width="128" TextAlignment="Center"/>
                                                            <TextBlock Text="SECONDS" FontSize="8" FontWeight="SemiBold" Foreground="#6B5A00" Width="128" TextAlignment="Center" Margin="16,0,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="ClockStatusText" Text="Count Up · Stopped · 00:00" Foreground="#D29922" FontSize="10" Margin="0,0,0,8"/>

											<Border Visibility="Collapsed" Height="0" Margin="0" Opacity="0" IsHitTestVisible="False"/>
                                            <!-- Live clock adjustment -->
                                            <Expander Style="{StaticResource SettingsExpander}" Header="ADJUST CLOCK MID-MATCH">
                                            <Border Background="#0C0A04" BorderBrush="#C9B070" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="ADJUST CLOCK" FontSize="9" FontWeight="Black" Foreground="#8A7A40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="−10s" Width="46" Height="28" FontSize="10" FontWeight="Bold" Click="ClockMinus10_Click" Style="{StaticResource ToolBtn}" BorderBrush="#C9B070" Margin="0,0,4,0"/>
                                                        <Button Content="−1s" Width="40" Height="28" FontSize="10" FontWeight="Bold" Click="ClockMinus1_Click" Style="{StaticResource ToolBtn}" BorderBrush="#C9B070" Margin="0,0,8,0"/>
                                                        <Button Content="+1s" Width="40" Height="28" FontSize="10" FontWeight="Bold" Click="ClockPlus1_Click" Style="{StaticResource ToolBtn}" BorderBrush="#C9B070" Margin="0,0,4,0"/>
                                                        <Button Content="+10s" Width="46" Height="28" FontSize="10" FontWeight="Bold" Click="ClockPlus10_Click" Style="{StaticResource ToolBtn}" BorderBrush="#C9B070"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                        <TextBlock Text="SET:" FontSize="9" FontWeight="Black" Foreground="#6B5A00" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" Width="40" Height="28" Padding="0">
                                                            <TextBox x:Name="ClockSetMinutesBox" Text="00" FontSize="14" FontWeight="Black" FontFamily="Consolas" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="3"/>
                                                        </Border>
                                                        <TextBlock Text=":" FontSize="14" FontWeight="Black" Foreground="#6B5A00" VerticalAlignment="Center" Margin="2,0"/>
                                                        <Border Background="#0A0804" BorderBrush="#6B5A00" BorderThickness="1" Width="34" Height="28" Padding="0">
                                                            <TextBox x:Name="ClockSetSecondsBox" Text="00" FontSize="14" FontWeight="Black" FontFamily="Consolas" Foreground="#D29922" Background="Transparent" BorderThickness="0" CaretBrush="#D29922" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="2"/>
                                                        </Border>
                                                        <Button Content="SET" Width="36" Height="28" FontSize="9" FontWeight="Black" Click="ClockSet_Click" Style="{StaticResource ToolBtn}" BorderBrush="#6B5A00" Foreground="#D29922" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            </Expander>

                                            <!-- Finals mode -->
                                            <CheckBox x:Name="SettingsFinalsToggle" Checked="SettingsFinalsToggle_Changed" Unchecked="SettingsFinalsToggle_Changed" Visibility="Collapsed"/>
                                            <Border x:Name="SettingsFinalsCard" Background="#0A0806" BorderBrush="#2A2020" BorderThickness="1" Padding="14" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="SettingsFinalsCard_Click">
                                                <Grid>
                                                    <Border x:Name="SettingsFinalsGlow" Opacity="0" IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                                                <GradientStop Color="#D4A017" Offset="0"/>
                                                                <GradientStop Color="#00000000" Offset="1"/>
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="★" FontSize="22" FontFamily="Bahnschrift" FontWeight="Black"
                                                                   Foreground="#D8B84F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="SettingsFinalsTitle" Text="FINALS MODE" FontSize="13" FontWeight="Black" Foreground="#5A4A20" Margin="0,0,0,2"/>
                                                            <TextBlock Text="Golden bar styling and time-on after siren in final quarter" FontSize="9" FontWeight="SemiBold" Foreground="#C9B070" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <Grid Width="44" Height="24">
                                                            <Border x:Name="SettingsFinalsTrack" CornerRadius="12" Background="#1A1610" BorderBrush="#C9B070" BorderThickness="1"/>
                                                            <Border x:Name="SettingsFinalsThumb" Width="18" Height="18" CornerRadius="9" Background="#5A4A20" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Hide team name panels -->
                                            <CheckBox x:Name="SettingsHideTeamNamesToggle" Checked="SettingsHideTeamNamesToggle_Changed" Unchecked="SettingsHideTeamNamesToggle_Changed" Visibility="Collapsed"/>
                                            <Border x:Name="SettingsHideTeamNamesCard" Background="#080A12" BorderBrush="#1C2030" BorderThickness="1" Padding="14" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="SettingsHideTeamNamesCard_Click">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔠" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="SettingsHideTeamNamesTitle" Text="HIDE TEAM NAMES" FontSize="13" FontWeight="Black" Foreground="#4A5A70" Margin="0,0,0,2"/>
                                                            <TextBlock Text="Removes name panels while keeping professional, digit-safe score sizing" FontSize="9" FontWeight="SemiBold" Foreground="#A8B8CC" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <Grid Width="44" Height="24">
                                                            <Border x:Name="SettingsHideTeamNamesTrack" CornerRadius="12" Background="#131620" BorderBrush="#2A3040" BorderThickness="1"/>
                                                            <Border x:Name="SettingsHideTeamNamesThumb" Width="18" Height="18" CornerRadius="9" Background="#3A4050" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Custom current-label override -->
                                            <Border Background="#0A0806" BorderBrush="#2A2020" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="🏷" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="QUARTER LABEL" FontSize="12" FontWeight="Black" Foreground="#D29922" Margin="0,0,0,2"/>
                                                            <TextBlock Text="Override the centre quarter/break label shown on the scoreboard right now. Updates live. Resetting restores the default for the current state." FontSize="9" FontWeight="SemiBold" Foreground="#6B5A00" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="QuarterLabelCurrentBox" Grid.Column="0" MaxLength="12" FontSize="13" FontWeight="Bold" Background="#0A1018" Foreground="#E6EDF3" BorderBrush="#C9B070" BorderThickness="1" CaretBrush="White" Padding="10,6" TextChanged="QuarterLabelCurrentBox_TextChanged" TextWrapping="NoWrap"/>
                                                        <Button x:Name="QuarterLabelCurrentReset" Grid.Column="1" Content="Reset" Width="74" Height="28" FontSize="10" FontWeight="Bold" Click="QuarterLabelCurrentReset_Click" Style="{StaticResource ToolBtn}" BorderBrush="#C9B070" Margin="6,0,0,0"/>
                                                    </Grid>
                                                    <TextBlock x:Name="QuarterLabelCurrentHint" FontSize="9" FontWeight="SemiBold" Foreground="#6B5A00" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- Sentinel: closing tags below preserved by anchor replacement -->
                                            <Border Visibility="Collapsed" x:Name="SettingsMatchSectionEndAnchor"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ══════════════════════════════════════ -->
                                    <!-- SECTION 3: KEYBINDS                   -->
                                    <!-- ══════════════════════════════════════ -->
                                    <Border x:Name="SettingsSection_Keybinds" Style="{StaticResource SettingsSectionSurface}" Tag="keybind keybinds keyboard hotkeys shortcuts toggle clock start pause home away goal behind end quarter" Visibility="Collapsed">
                                        <StackPanel>
                                            <Border Height="1" Margin="0,0,0,14">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00A78BFA" Offset="0"/>
                                                        <GradientStop Color="#30A78BFA" Offset="0.5"/>
                                                        <GradientStop Color="#00A78BFA" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <StackPanel HorizontalAlignment="Left" Margin="0,0,0,10">
                                                <TextBlock Text="KEYBINDS" FontSize="14" FontWeight="Black" Foreground="#A78BFA" Margin="0,0,0,2">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#A78BFA" Opacity="0.3"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="Set your keyboard shortcuts for live control actions" FontSize="9" FontWeight="SemiBold" Foreground="#C4B5FD"/>
                                            </StackPanel>

                                            <Border Background="#120A20" BorderBrush="#3B2A62" BorderThickness="1" Padding="14">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Start / Pause Clock" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Button x:Name="KeybindToggleClockButton" Grid.Column="1" Content="Space" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindToggleClockButton_Click" Style="{StaticResource ToolBtn}" BorderBrush="#7C3AED" Foreground="#C4B5FD"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Home Goal" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Button x:Name="KeybindHomeGoalButton" Grid.Column="1" Content="A" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindHomeGoalButton_Click" Style="{StaticResource ToolBtn}" BorderBrush="#7C3AED" Foreground="#C4B5FD"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Home Behind" Foreground="#E6EDF3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Button x:Name="KeybindHomeBehindButton" Grid.Column="1" Content="S" Height="28" FontSize="11" FontWeight="Bold" Click="KeybindHomeBehindButton_Click" Style="{StaticResource ToolBtn}" BorderBrush="#7C3AED" Foreground="#C4B5FD"/>
                                                    </Grid>
