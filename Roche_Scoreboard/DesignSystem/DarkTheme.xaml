<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SCORE GRID DARK THEME                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── Brand Colors (same as Light) ─── -->
    <Color x:Key="ScoreGrid.Color.BrandPrimary">#0A57FF</Color>
    <Color x:Key="ScoreGrid.Color.BrandHover">#0849D8</Color>
    <Color x:Key="ScoreGrid.Color.BrandPressed">#073CB1</Color>

    <!-- ─── Backgrounds ─── -->
    <Color x:Key="ScoreGrid.Color.Background">#0D1117</Color>
    <Color x:Key="ScoreGrid.Color.Surface">#161B22</Color>
    <Color x:Key="ScoreGrid.Color.SurfaceSubtle">#1C2128</Color>

    <!-- ─── Borders ─── -->
    <Color x:Key="ScoreGrid.Color.Border">#30363D</Color>
    <Color x:Key="ScoreGrid.Color.DecorativeBorder">#30363D</Color>
    <Color x:Key="ScoreGrid.Color.ControlBorder">#70839A</Color>

    <!-- ─── Text ─── -->
    <Color x:Key="ScoreGrid.Color.TextPrimary">#E6EDF3</Color>
    <Color x:Key="ScoreGrid.Color.TextSecondary">#A8B0BA</Color>

    <!-- ─── Semantic States (same base colors) ─── -->
    <Color x:Key="ScoreGrid.Color.Success">#22C88A</Color>
    <Color x:Key="ScoreGrid.Color.Warning">#FFB020</Color>
    <Color x:Key="ScoreGrid.Color.Danger">#E53935</Color>
    <Color x:Key="ScoreGrid.Color.Focus">#9CCBFF</Color>

    <!-- ─── Semantic State Backgrounds (darker adaptations) ─── -->
    <Color x:Key="ScoreGrid.Color.SuccessBackground">#0D3329</Color>
    <Color x:Key="ScoreGrid.Color.WarningBackground">#3D2E0D</Color>
    <Color x:Key="ScoreGrid.Color.DangerBackground">#3D1312</Color>
    <Color x:Key="ScoreGrid.Color.AccentBackground">#0A1D3D</Color>

    <!-- ─── Semantic State Foregrounds (brighter for dark backgrounds) ─── -->
    <Color x:Key="ScoreGrid.Color.SuccessForeground">#4EE5AE</Color>
    <Color x:Key="ScoreGrid.Color.WarningForeground">#FFD166</Color>
    <Color x:Key="ScoreGrid.Color.DangerForeground">#FF6B6B</Color>
    <Color x:Key="ScoreGrid.Color.AccentForeground">#5E9FFF</Color>

    <!-- ─── Disabled States ─── -->
    <Color x:Key="ScoreGrid.Color.DisabledSurface">#162944</Color>
    <Color x:Key="ScoreGrid.Color.DisabledForeground">#5E6B7D</Color>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SEMANTIC BRUSHES (DynamicResource targets for runtime theme switch) -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="ScoreGrid.Brush.BrandPrimary" Color="{StaticResource ScoreGrid.Color.BrandPrimary}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.BrandHover" Color="{StaticResource ScoreGrid.Color.BrandHover}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.BrandPressed" Color="{StaticResource ScoreGrid.Color.BrandPressed}" />

    <SolidColorBrush x:Key="ScoreGrid.Brush.Background" Color="{StaticResource ScoreGrid.Color.Background}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.Surface" Color="{StaticResource ScoreGrid.Color.Surface}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.SurfaceSubtle" Color="{StaticResource ScoreGrid.Color.SurfaceSubtle}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.Border" Color="{StaticResource ScoreGrid.Color.Border}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.DecorativeBorder" Color="{StaticResource ScoreGrid.Color.DecorativeBorder}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.ControlBorder" Color="{StaticResource ScoreGrid.Color.ControlBorder}" />

    <SolidColorBrush x:Key="ScoreGrid.Brush.TextPrimary" Color="{StaticResource ScoreGrid.Color.TextPrimary}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.TextSecondary" Color="{StaticResource ScoreGrid.Color.TextSecondary}" />

    <SolidColorBrush x:Key="ScoreGrid.Brush.Success" Color="{StaticResource ScoreGrid.Color.Success}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.Warning" Color="{StaticResource ScoreGrid.Color.Warning}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.Danger" Color="{StaticResource ScoreGrid.Color.Danger}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.Focus" Color="{StaticResource ScoreGrid.Color.Focus}" />

    <SolidColorBrush x:Key="ScoreGrid.Brush.SuccessBackground" Color="{StaticResource ScoreGrid.Color.SuccessBackground}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.WarningBackground" Color="{StaticResource ScoreGrid.Color.WarningBackground}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.DangerBackground" Color="{StaticResource ScoreGrid.Color.DangerBackground}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.AccentBackground" Color="{StaticResource ScoreGrid.Color.AccentBackground}" />

    <SolidColorBrush x:Key="ScoreGrid.Brush.SuccessForeground" Color="{StaticResource ScoreGrid.Color.SuccessForeground}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.WarningForeground" Color="{StaticResource ScoreGrid.Color.WarningForeground}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.DangerForeground" Color="{StaticResource ScoreGrid.Color.DangerForeground}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.AccentForeground" Color="{StaticResource ScoreGrid.Color.AccentForeground}" />

    <SolidColorBrush x:Key="ScoreGrid.Brush.DisabledSurface" Color="{StaticResource ScoreGrid.Color.DisabledSurface}" />
    <SolidColorBrush x:Key="ScoreGrid.Brush.DisabledForeground" Color="{StaticResource ScoreGrid.Color.DisabledForeground}" />

</ResourceDictionary>
