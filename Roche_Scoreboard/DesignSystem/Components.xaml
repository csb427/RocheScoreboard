<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SCORE GRID COMPONENTS — Core Control Styles & Templates             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── Button: Primary ─── -->
    <Style x:Key="ScoreGrid.Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{DynamicResource ScoreGrid.Height.ControlDefault}" />
        <Setter Property="Padding" Value="{DynamicResource ScoreGrid.Padding.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource ScoreGrid.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ScoreGrid.FontSize14}" />
        <Setter Property="FontWeight" Value="{DynamicResource ScoreGrid.FontWeight.SemiBold}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ScoreGrid.CornerRadius.Default}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ScoreGrid.Brush.BrandHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ScoreGrid.Brush.BrandPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.Focus}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="{DynamicResource ScoreGrid.BorderWidth.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ScoreGrid.Brush.DisabledSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── Button: Secondary ─── -->
    <Style x:Key="ScoreGrid.Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ScoreGrid.BorderWidth.Default}" />
        <Setter Property="Height" Value="{DynamicResource ScoreGrid.Height.ControlDefault}" />
        <Setter Property="Padding" Value="{DynamicResource ScoreGrid.Padding.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource ScoreGrid.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ScoreGrid.FontSize14}" />
        <Setter Property="FontWeight" Value="{DynamicResource ScoreGrid.FontWeight.SemiBold}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ScoreGrid.CornerRadius.Default}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ScoreGrid.Brush.SurfaceSubtle}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ScoreGrid.Brush.Border}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.Focus}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="{DynamicResource ScoreGrid.BorderWidth.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ScoreGrid.Brush.DisabledSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── Button: Danger ─── -->
    <Style x:Key="ScoreGrid.Button.Danger" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.Danger}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{DynamicResource ScoreGrid.Height.ControlDefault}" />
        <Setter Property="Padding" Value="{DynamicResource ScoreGrid.Padding.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource ScoreGrid.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ScoreGrid.FontSize14}" />
        <Setter Property="FontWeight" Value="{DynamicResource ScoreGrid.FontWeight.SemiBold}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ScoreGrid.CornerRadius.Default}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#C62828" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#B71C1C" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.Focus}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="{DynamicResource ScoreGrid.BorderWidth.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ScoreGrid.Brush.DisabledSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── TextBox ─── -->
    <Style x:Key="ScoreGrid.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ScoreGrid.BorderWidth.Default}" />
        <Setter Property="Height" Value="{DynamicResource ScoreGrid.Height.ControlDefault}" />
        <Setter Property="Padding" Value="{DynamicResource ScoreGrid.Padding.ControlSmall}" />
        <Setter Property="FontFamily" Value="{DynamicResource ScoreGrid.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ScoreGrid.FontSize14}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="focusRing"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource ScoreGrid.CornerRadius.Default}" />
                        <Border x:Name="border"
                                Margin="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ScoreGrid.CornerRadius.Default}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="focusRing" Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ScoreGrid.Brush.DisabledSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── CheckBox ─── -->
    <Style x:Key="ScoreGrid.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource ScoreGrid.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ScoreGrid.FontSize14}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="checkBorder"
                                Width="20" Height="20"
                                Background="{DynamicResource ScoreGrid.Brush.Surface}"
                                BorderBrush="{DynamicResource ScoreGrid.Brush.ControlBorder}"
                                BorderThickness="{DynamicResource ScoreGrid.BorderWidth.Default}"
                                CornerRadius="4"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="checkMark"
                                       Text="&#xE10B;"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkBorder" Property="Background" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.Focus}" />
                            <Setter TargetName="checkBorder" Property="BorderThickness" Value="{DynamicResource ScoreGrid.BorderWidth.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="checkBorder" Property="Background" Value="{DynamicResource ScoreGrid.Brush.DisabledSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── RadioButton ─── -->
    <Style x:Key="ScoreGrid.RadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource ScoreGrid.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ScoreGrid.FontSize14}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="radioBorder"
                                     Width="20"
                                     Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stroke="{DynamicResource ScoreGrid.Brush.ControlBorder}"
                                     StrokeThickness="{DynamicResource ScoreGrid.StrokeWidth.Default}"
                                     Fill="{DynamicResource ScoreGrid.Brush.Surface}" />
                            <Ellipse x:Name="radioCheck"
                                     Width="10"
                                     Height="10"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource ScoreGrid.Brush.BrandPrimary}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="radioBorder" Property="Stroke" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
                            <Setter TargetName="radioCheck" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="radioBorder" Property="Stroke" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="radioBorder" Property="Stroke" Value="{DynamicResource ScoreGrid.Brush.Focus}" />
                            <Setter TargetName="radioBorder" Property="StrokeThickness" Value="{DynamicResource ScoreGrid.StrokeWidth.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="radioBorder" Property="Fill" Value="{DynamicResource ScoreGrid.Brush.DisabledSurface}" />
                            <Setter TargetName="radioCheck" Property="Fill" Value="{DynamicResource ScoreGrid.Brush.DisabledForeground}" />
                            <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─── ComboBox ─── -->
    <Style x:Key="ScoreGrid.ComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ScoreGrid.BorderWidth.Default}" />
        <Setter Property="Height" Value="{DynamicResource ScoreGrid.Height.ControlDefault}" />
        <Setter Property="Padding" Value="{DynamicResource ScoreGrid.Padding.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource ScoreGrid.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ScoreGrid.FontSize14}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggleButton"
                                      Grid.Column="0"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource ScoreGrid.CornerRadius.Default}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              Content="{TemplateBinding Content}"
                                                              Margin="12,0,0,0"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1"
                                                       Text="&#xE70D;"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ScoreGrid.Brush.TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,12,0" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="contentPresenter"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,32,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False" />
                        <Popup x:Name="popup"
                               PlacementTarget="{Binding ElementName=toggleButton}"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource ScoreGrid.Brush.Surface}"
                                    BorderBrush="{DynamicResource ScoreGrid.Brush.ControlBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ScoreGrid.CornerRadius.Default}"
                                    MinWidth="{Binding ActualWidth, ElementName=toggleButton}"
                                    MaxHeight="200">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.BrandPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ScoreGrid.Brush.Focus}" />
                            <Setter Property="BorderThickness" Value="{DynamicResource ScoreGrid.BorderWidth.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ScoreGrid.Brush.DisabledSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.TextPrimary}" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBorder"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ScoreGrid.Brush.SurfaceSubtle}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ScoreGrid.Brush.AccentBackground}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ScoreGrid.Brush.AccentForeground}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

    
  