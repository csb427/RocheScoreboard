<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SCORE GRID COMFORTABLE DENSITY                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── Control Heights ─── -->
    <sys:Double x:Key="ScoreGrid.Height.ControlDefault">36</sys:Double>
    <sys:Double x:Key="ScoreGrid.Height.ControlImportant">44</sys:Double>
    <sys:Double x:Key="ScoreGrid.Height.ControlCompact">28</sys:Double>

    <!-- ─── Content Padding ─── -->
    <Thickness x:Key="ScoreGrid.Padding.Control">12,8</Thickness>
    <Thickness x:Key="ScoreGrid.Padding.ControlSmall">8,4</Thickness>
    <Thickness x:Key="ScoreGrid.Padding.Content">16</Thickness>
    <Thickness x:Key="ScoreGrid.Padding.Card">24</Thickness>

</ResourceDictionary>
