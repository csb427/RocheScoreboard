<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SCORE GRID DESIGN TOKENS — Invariant Constants                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─── Spacing Scale (4px system) ─── -->
    <sys:Double x:Key="ScoreGrid.Spacing4">4</sys:Double>
    <sys:Double x:Key="ScoreGrid.Spacing8">8</sys:Double>
    <sys:Double x:Key="ScoreGrid.Spacing12">12</sys:Double>
    <sys:Double x:Key="ScoreGrid.Spacing16">16</sys:Double>
    <sys:Double x:Key="ScoreGrid.Spacing24">24</sys:Double>
    <sys:Double x:Key="ScoreGrid.Spacing32">32</sys:Double>

    <!-- ─── Corner Radii ─── -->
    <CornerRadius x:Key="ScoreGrid.CornerRadius.Small">4</CornerRadius>
    <CornerRadius x:Key="ScoreGrid.CornerRadius.Default">8</CornerRadius>
    <CornerRadius x:Key="ScoreGrid.CornerRadius.Large">12</CornerRadius>

    <!-- ─── Border Widths ─── -->
    <Thickness x:Key="ScoreGrid.BorderWidth.Default">1</Thickness>
    <Thickness x:Key="ScoreGrid.BorderWidth.Focus">2</Thickness>
    <sys:Double x:Key="ScoreGrid.StrokeWidth.Default">1</sys:Double>
    <sys:Double x:Key="ScoreGrid.StrokeWidth.Focus">2</sys:Double>

    <!-- ─── Font Families ─── -->
    <FontFamily x:Key="ScoreGrid.FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="ScoreGrid.MonoFontFamily">Consolas</FontFamily>

    <!-- ─── Font Sizes ─── -->
    <sys:Double x:Key="ScoreGrid.FontSize10">10</sys:Double>
    <sys:Double x:Key="ScoreGrid.FontSize12">12</sys:Double>
    <sys:Double x:Key="ScoreGrid.FontSize14">14</sys:Double>
    <sys:Double x:Key="ScoreGrid.FontSize16">16</sys:Double>
    <sys:Double x:Key="ScoreGrid.FontSize18">18</sys:Double>
    <sys:Double x:Key="ScoreGrid.FontSize22">22</sys:Double>
    <sys:Double x:Key="ScoreGrid.FontSize28">28</sys:Double>
    <sys:Double x:Key="ScoreGrid.FontSize36">36</sys:Double>

    <!-- ─── Font Weights ─── -->
    <FontWeight x:Key="ScoreGrid.FontWeight.Light">Light</FontWeight>
    <FontWeight x:Key="ScoreGrid.FontWeight.Regular">Regular</FontWeight>
    <FontWeight x:Key="ScoreGrid.FontWeight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="ScoreGrid.FontWeight.Bold">Bold</FontWeight>

    <!-- ─── Icon Sizes ─── -->
    <sys:Double x:Key="ScoreGrid.IconSize16">16</sys:Double>
    <sys:Double x:Key="ScoreGrid.IconSize20">20</sys:Double>
    <sys:Double x:Key="ScoreGrid.IconSize24">24</sys:Double>

</ResourceDictionary>
