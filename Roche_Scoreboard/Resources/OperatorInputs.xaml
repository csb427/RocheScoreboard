<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:Roche_Scoreboard.Services">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsControls.xaml"/><ResourceDictionary Source="CricketActions.xaml"/><ResourceDictionary Source="OperatorControls.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style TargetType="Button" BasedOn="{StaticResource CricketActionButton}"><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="8,4"/></Style>
 <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsToggle}"><Setter Property="MinHeight" Value="28"/><Setter Property="Foreground" Value="#F0F6FC"/></Style>
 <Style TargetType="RadioButton" BasedOn="{StaticResource SettingsTile}"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="6,4"/><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="Background" Value="#182638"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#234A6A"/></Trigger></Style.Triggers></Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource SettingsInput}"><Setter Property="Padding" Value="4,2"/><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="Background" Value="#0E1722"/><Setter Property="BorderBrush" Value="#617B95"/></Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsChoice}"><Setter Property="MinHeight" Value="28"/><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="Background" Value="#152231"/></Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="#152231"/><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="BorderBrush" Value="#6D8BAA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="13"/></Style>
 <Style TargetType="Slider"><Setter Property="MinHeight" Value="24"/><Setter Property="Foreground" Value="#82C9FF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
 <Grid Background="Transparent" Margin="5,3"><Border x:Name="Rail" Height="4" Background="#33465B" VerticalAlignment="Center" CornerRadius="2"/>
 <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
 <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
 <Track.Thumb><Thumb x:Name="SliderHandle" Width="14" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#82C9FF" BorderBrush="#DAF0FF" BorderThickness="1" CornerRadius="4"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#C7E8FF"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
 <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
 </Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Vertical"><Setter TargetName="Rail" Property="Height" Value="Auto"/><Setter TargetName="Rail" Property="Width" Value="4"/><Setter TargetName="SliderHandle" Property="Width" Value="18"/><Setter TargetName="SliderHandle" Property="Height" Value="14"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TabControl" BasedOn="{StaticResource OperatorTabs}"><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="ItemContainerStyle" Value="{StaticResource PanelTab}"/></Style>
 <Style TargetType="TabItem" BasedOn="{StaticResource PanelTab}"/>
 <Style TargetType="ListBox"><Setter Property="Background" Value="#0E1722"/><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="BorderBrush" Value="#617B95"/></Style>
 <Style TargetType="Expander"><Setter Property="motion:DisclosureMotion.Enabled" Value="True"/><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="Background" Value="#132031"/><Setter Property="BorderBrush" Value="#33465B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
 <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}"><StackPanel>
 <ToggleButton IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Background="Transparent" MinHeight="36" HorizontalContentAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Header" Padding="10,7" Background="{TemplateBinding Background}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="{TemplateBinding Foreground}" Margin="12,0,0,0"/><ContentPresenter Content="{TemplateBinding Content}" RecognizesAccessKey="True"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Header" Property="Background" Value="#22384E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Header" Property="BorderBrush" Value="#BCE2FF"/><Setter TargetName="Header" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
 <Border x:Name="Body" Visibility="Collapsed" Padding="10"><ContentPresenter/></Border></StackPanel></Border>
 <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ContextMenu"><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><AdornerDecorator><Border Background="#152231" BorderBrush="#617B95" BorderThickness="1" Padding="4" CornerRadius="5"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></AdornerDecorator></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="MinHeight" Value="30"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
 <Grid><Border x:Name="ItemSurface" Background="Transparent" Padding="9,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Check" Text="✓" Visibility="Hidden" Foreground="{TemplateBinding Foreground}"/><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/><TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Margin="14,0,0,0" Foreground="{TemplateBinding Foreground}" Visibility="Collapsed"/></Grid></Border>
 <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False"><Border Background="#152231" BorderBrush="#617B95" BorderThickness="1" Padding="4"><ItemsPresenter/></Border></Popup></Grid>
 <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#29445F"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
