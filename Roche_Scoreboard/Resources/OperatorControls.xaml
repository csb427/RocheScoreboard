<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:Roche_Scoreboard.Services">
        <!-- ═══════════════════════════════════ -->
        <!-- COLOUR SYSTEM — broadcast console   -->
        <!-- ═══════════════════════════════════ -->
        <SolidColorBrush x:Key="ShellBrush" Color="#0D1117"/>
        <SolidColorBrush x:Key="RegionBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="RegionAltBrush" Color="#1C2128"/>
        <SolidColorBrush x:Key="RegionEdgeBrush" Color="#7A8693"/>
        <SolidColorBrush x:Key="SectionEdgeBrush" Color="#7A8693"/>
        <SolidColorBrush x:Key="TextStrongBrush" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextMidBrush" Color="#8B949E"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#A8B0BA"/>
        <SolidColorBrush x:Key="HomeAccentBrush" Color="#58A6FF"/>
        <SolidColorBrush x:Key="AwayAccentBrush" Color="#F85149"/>
        <SolidColorBrush x:Key="LiveBrush" Color="#3FB950"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#D29922"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF"/>

        <!-- ── Section heading — uppercase, tracked ── -->
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ── Primary command button — scoring, with high-energy reward motion ── -->
        <Style x:Key="PrimaryCommandButton" TargetType="Button"><Setter Property="motion:CricketActionMotion.Enabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="TbSc" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="TbLift" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="ActionGlow" Background="#A858A6FF" CornerRadius="3" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Opacity="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#BCE2FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                <Setter TargetName="ActionGlow" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tool button — compact, punchy hover/click reward ── -->
        <Style x:Key="ToolBtn" TargetType="Button"><Setter Property="motion:CricketActionMotion.Enabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#7A8693"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="TbSc" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="TbLift" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="ActionGlow" Background="#6C8FB5FF" CornerRadius="2" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Opacity="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#BCE2FF"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7A8693"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A8B0BA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161B22"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Responsive operator navigation dock ── -->
        <Style x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#B8C7D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="62"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="#101722" Padding="8,7"
                                    CornerRadius="0" BorderThickness="0,0,1,1" BorderBrush="#2D3B4D">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="PrimaryLabel" Text="{TemplateBinding Header}"
                                                   Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="Black" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="SecondaryLabel" Text="{TemplateBinding Tag}"
                                                   Foreground="#71859A" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="AccBar" VerticalAlignment="Bottom" Height="4"
                                    Opacity="0" Margin="0" CornerRadius="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0058A6FF" Offset="0"/>
                                        <GradientStop Color="#FF58A6FF" Offset="0.5"/>
                                        <GradientStop Color="#0058A6FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="SecondaryLabel" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17263A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7058A6FF"/>
                                <Setter TargetName="AccBar" Property="Opacity" Value="1"/>
                                <Setter TargetName="PrimaryLabel" Property="Foreground" Value="White"/>
                                <Setter TargetName="SecondaryLabel" Property="Foreground" Value="#A9D3FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#182230"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58708C"/>
                                <Setter TargetName="PrimaryLabel" Property="Foreground" Value="#EAF5FF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PrimaryLabel" Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1B2B40"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<Style x:Key="SettingsSectionSurface" TargetType="Border">
            <Setter Property="Background" Value="#101824"/>
            <Setter Property="BorderBrush" Value="#2B3A4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.24"/>
                </Setter.Value>
            </Setter>
        </Style>
<Style x:Key="OutputActionCard" TargetType="Border">
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Panel.ZIndex" Value="20"/>
                    <Setter Property="Effect">
                        <Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#58A6FF" Opacity="0.55"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
<Style x:Key="OperatorPresentationButton" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
<Setter Property="MinHeight" Value="106"/><Setter Property="Height" Value="Auto"/><Setter Property="FontSize" Value="16"/><Setter Property="Background" Value="#101721"/><Setter Property="BorderBrush" Value="#304055"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Margin" Value="4"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Border x:Name="Surface" Style="{StaticResource OutputActionCard}" CornerRadius="12" Margin="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
<ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8CC8FF"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<!-- The exact AFL full-width navigation host, shared with other sports. -->
<Style x:Key="OperatorTabs" TargetType="TabControl">
<Setter Property="Background" Value="#090D14"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
<Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1" HorizontalAlignment="Stretch"/></ItemsPanelTemplate></Setter.Value></Setter>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
<Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="#0D131D" BorderBrush="#34465A" BorderThickness="0,0,0,1"><ItemsPresenter HorizontalAlignment="Stretch"/></Border>
<ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
</Grid></ControlTemplate></Setter.Value></Setter>
</Style>
</ResourceDictionary>
