<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 19041+ TFM enables the WinRT APIs used by the display and media stack. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- App identity -->
    <AssemblyName>Roche Scoreboard</AssemblyName>
    <AssemblyTitle>Roche Scoreboard</AssemblyTitle>
    <Product>Roche Scoreboard</Product>
    <Description>AFL and Cricket broadcast scoreboard application</Description>
    <Version>4.1.3</Version>

    <!-- App icon (taskbar, File Explorer, title bar) -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Release as a conventional, self-contained WPF folder. A multi-file
         publish avoids native single-file extraction and lets LibVLC keep its
         native libraries and plugin tree in their required relative paths. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- 3.10 separates UWP/WinUI from the core package. Earlier 3.9.7.1
         pulled Microsoft.WindowsAppSDK into this WPF app and generated a
         duplicate SessionHandleIPCProxyStub.dll activation-manifest entry. -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.0" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.5" />
    <PackageReference Include="Supabase" Version="1.1.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <!--
    LibVLCSharp's native loader requires libvlc.dll, libvlccore.dll and the
    plugins folder to remain as loose files under libvlc\win-x64\. This target
    guarantees those native files are included in the self-contained publish
    folder that is distributed as a zip.
  -->
  <Target Name="CopyLibVlcNativesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_LibVlcNativeFiles Include="$(OutDir)libvlc\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibVlcNativeFiles)" DestinationFiles="@(_LibVlcNativeFiles->'$(PublishDir)libvlc\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
