<UserControl x:Class="Roche_Scoreboard.Views.ScorebugControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="707">

    <UserControl.Resources>
        <SolidColorBrush x:Key="HomeTeamBrush" Color="#0A2A6A"/>
        <SolidColorBrush x:Key="AwayTeamBrush" Color="#7A1A1A"/>
        <SolidColorBrush x:Key="HomeLogoDarkBrush" Color="#081F50"/>
        <SolidColorBrush x:Key="AwayLogoDarkBrush" Color="#5D1414"/>
    </UserControl.Resources>

    <UserControl.Background>
        <LinearGradientBrush x:Name="TeamGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0A2A6A" Offset="0.0"/>
            <GradientStop Color="#101827" Offset="0.5"/>
            <GradientStop Color="#7A1A1A" Offset="1.0"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid>
    <!-- ======================== CLASSIC LAYOUT (deprecated — kept hidden for code-behind compatibility) ======================== -->
    <Grid x:Name="ClassicLayout" Visibility="Collapsed">

        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#020614" Offset="0.0"/>
                    <GradientStop Color="#060D2E" Offset="0.5"/>
                    <GradientStop Color="#0A1648" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock x:Name="TopTimeText" Text="1:26 PM" Foreground="White" FontWeight="Black" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Border>

        <!-- Stats bar -->
        <Border x:Name="StatsBarBorder" Grid.Row="1" Height="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#060D2E" Offset="0.0"/>
                    <GradientStop Color="#0E1E5C" Offset="0.5"/>
                    <GradientStop Color="#060D2E" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid x:Name="StatsBarContent" Margin="10,0,10,0" Opacity="1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="StatsBarContentTranslate" X="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                    <TextBlock x:Name="StatsHomeValueText" Text="0" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Viewbox>
                <Border Grid.Column="1" CornerRadius="0" Background="#18FFFFFF" Margin="6,10,6,10" VerticalAlignment="Stretch" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="StatsBarHomeCol" Width="*"/>
                            <ColumnDefinition x:Name="StatsBarAwayCol" Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="0">
                            <Border.Background>
                                <SolidColorBrush x:Name="StatsHomeBarBrush" Color="#4488FF"/>
                            </Border.Background>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="0">
                            <Border.Background>
                                <SolidColorBrush x:Name="StatsAwayBarBrush" Color="#FF6644"/>
                            </Border.Background>
                        </Border>
                        <Viewbox Grid.ColumnSpan="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="4,1,4,1">
                            <TextBlock x:Name="StatsLabelText" Text="SCORING SHOTS" Foreground="White" FontSize="16" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Viewbox>
                    </Grid>
                </Border>
                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                    <TextBlock x:Name="StatsAwayValueText" Text="0" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- Scoreless timer bar -->
        <Border x:Name="ScorelessBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0B1120" Offset="0.0"/>
                    <GradientStop Color="#1E293B" Offset="0.5"/>
                    <GradientStop Color="#0B1120" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TIME SINCE LAST SCORE" Foreground="#CBD5E1" FontSize="15" FontWeight="Black" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="ScorelessTimeText" Text="10:00" Foreground="White" FontSize="26" FontWeight="Black" FontFamily="Stolzl Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Scoring run bar: team-owned momentum story, not a generic ticker. -->
        <Border x:Name="ScoringRunBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="6">
            <Border.Background>
                <LinearGradientBrush x:Name="ScoringRunGradient" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#021A05" Offset="0.0"/>
                    <GradientStop Color="#0A3D12" Offset="0.5"/>
                    <GradientStop Color="#021A05" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="12,2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#4ADE80"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ScoringRunLabelText" Text="HOME SCORING RUN" Foreground="White" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScoringRunDetailText" Text="4 SCORES · 06:12" Foreground="#D1D5DB" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="3" x:Name="ScoringRunValueText" Text="20–0" Foreground="White" FontSize="30" FontWeight="Black" FontFamily="Stolzl Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Team scoring drought bar -->
        <Border x:Name="TeamDroughtBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="7">
            <Border.Background>
                <LinearGradientBrush x:Name="TeamDroughtGradient" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A0A02" Offset="0.0"/>
                    <GradientStop Color="#3D1503" Offset="0.5"/>
                    <GradientStop Color="#1A0A02" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TeamDroughtLabelText" Text="HOME SCORELESS" Foreground="#F59E0B" FontSize="15" FontWeight="Black" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TeamDroughtTimeText" Text="08:30" Foreground="White" FontSize="26" FontWeight="Black" FontFamily="Stolzl Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Lead changes bar -->
        <Border x:Name="LeadChangesBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0A0520" Offset="0.0"/>
                    <GradientStop Color="#1A0E40" Offset="0.5"/>
                    <GradientStop Color="#0A0520" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="LeadChangesLabelText" Text="LEAD CHANGES" Foreground="#C084FC" FontSize="15" FontWeight="Black" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="LeadChangesValueText" Text="7" Foreground="#E9D5FF" FontSize="30" FontWeight="Black" FontFamily="Stolzl Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Win probability bar -->
        <Border x:Name="WinProbBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="9">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#06061A" Offset="0.0"/>
                    <GradientStop Color="#0C1230" Offset="0.5"/>
                    <GradientStop Color="#06061A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="10,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <!-- Home pct -->
                <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                    <TextBlock x:Name="WinProbHomePctText" Text="50%" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                </Viewbox>
                <!-- Split bar -->
                <Grid Grid.Column="1" Margin="6,8">
                    <Border CornerRadius="0" Background="#18FFFFFF" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="WinProbHomeCol" Width="50*"/>
                                <ColumnDefinition x:Name="WinProbAwayCol" Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="0">
                                <Border.Background><SolidColorBrush x:Name="WinProbHomeBarBrush" Color="#4488FF"/></Border.Background>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="0">
                                <Border.Background><SolidColorBrush x:Name="WinProbAwayBarBrush" Color="#FF6644"/></Border.Background>
                            </Border>
                            <Viewbox Grid.ColumnSpan="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="4,1">
                                <TextBlock x:Name="WinProbLabelText" Text="WIN PROBABILITY" Foreground="White" FontSize="16" FontWeight="Black" HorizontalAlignment="Center">
                                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.8"/></TextBlock.Effect>
                                </TextBlock>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
                <!-- Away pct -->
                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                    <TextBlock x:Name="WinProbAwayPctText" Text="50%" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- Home row -->
        <Grid Grid.Row="2" ClipToBounds="True">
            <Grid x:Name="HomeRowGrid" Background="{StaticResource HomeTeamBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" x:Name="HomeLogoContainer" Width="{Binding ActualHeight, ElementName=HomeRowGrid}" ClipToBounds="True">
                    <Border x:Name="HomeLogoSquare" Background="Transparent"/>
                    <Image x:Name="HomeLogoImage" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HomeLogoFallbackText" Text="HOM" Foreground="#DADADA" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="HomeNameText" Grid.Column="1" Text="XAVIER" Foreground="#FFFFFFFF" FontFamily="Stolzl Bold" FontSize="200" FontWeight="Black" FontStretch="Normal" FontStyle="Normal" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
                    <TextBlock.LayoutTransform>
                        <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
                <Border x:Name="HomeGoalsContainer" Grid.Column="2" Width="0" ClipToBounds="True">
                    <TextBlock x:Name="HomeGoalsText" Text="26" Foreground="White" FontFamily="Arial" FontSize="48" FontWeight="Black" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="HomeGoalsFlip"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>
                <Border x:Name="HomeBehindsContainer" Grid.Column="3" Width="0" ClipToBounds="True">
                    <TextBlock x:Name="HomeBehindsText" Text="8" Foreground="White" FontFamily="Arial" FontSize="48" FontWeight="Black" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="HomeBehindsFlip"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>
                <Border x:Name="HomeTotalBorder" Grid.Column="4" Background="#40000000" MinWidth="160" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="HomeTotalText" Text="126" Foreground="White" FontFamily="Arial" FontSize="80" FontWeight="Black" TextOptions.TextFormattingMode="Display" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="HomeTotalFlip"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <Border x:Name="HomeSwipeOverlay" Panel.ZIndex="20" IsHitTestVisible="False" Opacity="0">
                            <Border.Background><SolidColorBrush x:Name="HomeSwipeBg" Color="#FFFFFF"/></Border.Background>
                            <Border.RenderTransform><TranslateTransform x:Name="HomeSwipeTranslate"/></Border.RenderTransform>
                            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="5,2">
                                <TextBlock x:Name="HomeSwipeText" Text="+6" FontFamily="Arial" FontSize="100" FontWeight="Black" TextAlignment="Center">
                                    <TextBlock.Foreground><SolidColorBrush x:Name="HomeSwipeFg" Color="#0A2A6A"/></TextBlock.Foreground>
                                </TextBlock>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <!-- Score glow layer (Broadcast/Clean/Electric styles) -->
            <Border x:Name="HomeScoreGlow" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Right" Width="320" CornerRadius="0">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.9">
                        <GradientStop Color="#600A2A6A" Offset="0"/>
                        <GradientStop Color="#000A2A6A" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <!-- Edge glow (Electric style) -->
            <Rectangle x:Name="HomeEdgeGlow" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Goal/Behind overlay -->
            <Border x:Name="HomeOverlay" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
                <Border.Background>
                    <SolidColorBrush Color="#0A2A6A" x:Name="HomeOverlayBg"/>
                </Border.Background>
                <Grid>
                    <Rectangle x:Name="HomeGradientBar" Width="2000" Height="300" HorizontalAlignment="Left" Opacity="0.6">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" x:Name="HomeGradientBarBrush">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#FFD700" Offset="0.15"/>
                                <GradientStop Color="#FF6B00" Offset="0.3"/>
                                <GradientStop Color="#FF0080" Offset="0.45"/>
                                <GradientStop Color="#8000FF" Offset="0.6"/>
                                <GradientStop Color="#00BFFF" Offset="0.75"/>
                                <GradientStop Color="#00FF88" Offset="0.9"/>
                                <GradientStop Color="#FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="HomeGradientScroll" X="-1400"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="HomeShimmer" Width="120" Opacity="0" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="HomeShimmerScroll" X="-200"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,6">
                        <TextBlock x:Name="HomeOverlayText" Text="GOAL!" Foreground="White" FontSize="72" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="White" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <!-- Away row -->
        <Grid Grid.Row="3" ClipToBounds="True">
            <Grid x:Name="AwayRowGrid" Background="{StaticResource AwayTeamBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" x:Name="AwayLogoContainer" Width="{Binding ActualHeight, ElementName=AwayRowGrid}" ClipToBounds="True">
                    <Border x:Name="AwayLogoSquare" Background="Transparent"/>
                    <Image x:Name="AwayLogoImage" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AwayLogoFallbackText" Text="AWA" Foreground="#DADADA" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="AwayNameText" Grid.Column="1" Text="ST KEVINS" Foreground="#FFFFFFFF" FontFamily="Stolzl Bold" FontSize="200" FontWeight="Black" FontStretch="Normal" FontStyle="Normal" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
                    <TextBlock.LayoutTransform>
                        <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
                <Border x:Name="AwayGoalsContainer" Grid.Column="2" Width="0" ClipToBounds="True">
                    <TextBlock x:Name="AwayGoalsText" Text="26" Foreground="White" FontFamily="Arial" FontSize="48" FontWeight="Black" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="AwayGoalsFlip"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>
                <Border x:Name="AwayBehindsContainer" Grid.Column="3" Width="0" ClipToBounds="True">
                    <TextBlock x:Name="AwayBehindsText" Text="8" Foreground="White" FontFamily="Arial" FontSize="48" FontWeight="Black" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="AwayBehindsFlip"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>
                <Border x:Name="AwayTotalBorder" Grid.Column="4" Background="#40000000" MinWidth="160" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="AwayTotalText" Text="126" Foreground="White" FontFamily="Arial" FontSize="80" FontWeight="Black" TextOptions.TextFormattingMode="Display" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="AwayTotalFlip"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <Border x:Name="AwaySwipeOverlay" Panel.ZIndex="20" IsHitTestVisible="False" Opacity="0">
                            <Border.Background><SolidColorBrush x:Name="AwaySwipeBg" Color="#FFFFFF"/></Border.Background>
                            <Border.RenderTransform><TranslateTransform x:Name="AwaySwipeTranslate"/></Border.RenderTransform>
                            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="5,2">
                                <TextBlock x:Name="AwaySwipeText" Text="+6" FontFamily="Arial" FontSize="100" FontWeight="Black" TextAlignment="Center">
                                    <TextBlock.Foreground><SolidColorBrush x:Name="AwaySwipeFg" Color="#7A1A1A"/></TextBlock.Foreground>
                                </TextBlock>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <!-- Score glow layer (Broadcast/Clean/Electric styles) -->
            <Border x:Name="AwayScoreGlow" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Right" Width="320" CornerRadius="0">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.9">
                        <GradientStop Color="#607A1A1A" Offset="0"/>
                        <GradientStop Color="#007A1A1A" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <!-- Edge glow (Electric style) -->
            <Rectangle x:Name="AwayEdgeGlow" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Border x:Name="AwayOverlay" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
                <Border.Background>
                    <SolidColorBrush Color="#7A1A1A" x:Name="AwayOverlayBg"/>
                </Border.Background>
                <Grid>
                    <Rectangle x:Name="AwayGradientBar" Width="2000" Height="300" HorizontalAlignment="Left" Opacity="0.6">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" x:Name="AwayGradientBarBrush">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#FFD700" Offset="0.15"/>
                                <GradientStop Color="#FF6B00" Offset="0.3"/>
                                <GradientStop Color="#FF0080" Offset="0.45"/>
                                <GradientStop Color="#8000FF" Offset="0.6"/>
                                <GradientStop Color="#00BFFF" Offset="0.75"/>
                                <GradientStop Color="#00FF88" Offset="0.9"/>
                                <GradientStop Color="#FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AwayGradientScroll" X="-1400"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="AwayShimmer" Width="120" Opacity="0" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AwayShimmerScroll" X="-200"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,6">
                        <TextBlock x:Name="AwayOverlayText" Text="GOAL!" Foreground="White" FontSize="72" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="White" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="4" Background="#08103A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240*" MinWidth="160"/>
                <ColumnDefinition Width="760*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#060D2E" Offset="0.0"/>
                            <GradientStop Color="#0E1E5C" Offset="0.5"/>
                            <GradientStop Color="#162878" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,8">
                            <Grid Width="100">
                                <TextBlock x:Name="QuarterNumberText" Text="Q3" Foreground="White" FontFamily="Stolzl Bold" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="QuarterNumberTextScale" ScaleX="1" ScaleY="1"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Viewbox>
                        <Border Grid.Column="1" Width="1" Background="#3355AAFF" VerticalAlignment="Stretch" Margin="0,8"/>
                        <Viewbox Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,8">
                            <Grid Width="130">
                                <TextBlock x:Name="ClockText" Text="12:36" Foreground="White" FontFamily="Stolzl Bold" FontWeight="Bold" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="ClockTextScale" ScaleX="1" ScaleY="1"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- 5-minute alert overlay (covers ONLY the quarter+clock panel).
                     Redesigned broadcast-style hazard alert: deep red vignette,
                     animated diagonal hazard stripes top + bottom, pulsing
                     border glow, scanline shimmer, italic-skewed letter host. -->
                <Border x:Name="WarningOverlay" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="100" ClipToBounds="True">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.95" RadiusY="1.15">
                            <GradientStop Color="#FFE0001E" Offset="0.0"/>
                            <GradientStop Color="#FFA80018" Offset="0.45"/>
                            <GradientStop Color="#FF38000A" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Caution stripes: rendered full-rect, then masked to thin
                             top + bottom bands by the vertical OpacityMask so the
                             middle text area stays clean and readable. -->
                        <Rectangle x:Name="WarningStripesRect" Opacity="0.85" IsHitTestVisible="False"
                                   Width="2400" HorizontalAlignment="Left">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Stretch="None"
                                              Viewport="0,0,56,56" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#FF1A0000">
                                            <GeometryDrawing.Geometry>
                                                <PathGeometry Figures="M 0,28 L 28,0 L 56,0 L 0,56 Z M 28,56 L 56,28 L 56,56 Z"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFFFF" Offset="0.00"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.16"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.22"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.78"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.84"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="WarningStripesTranslate" X="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- Thin accent lines under each caution band -->
                        <Border Height="2" VerticalAlignment="Top" Margin="0,18,0,0" Background="#FFFFB020" Opacity="0.85" IsHitTestVisible="False"/>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="0,0,0,18" Background="#FFFFB020" Opacity="0.85" IsHitTestVisible="False"/>

                        <!-- Scanline shimmer: thin bright bar that sweeps across. -->
                        <Rectangle x:Name="WarningScanline" IsHitTestVisible="False"
                                   Width="80" HorizontalAlignment="Left" Opacity="0.0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#80FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="WarningScanlineTranslate" X="-80"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- Pulsing red glow border -->
                        <Border x:Name="WarningGlowBorder" Opacity="0" BorderThickness="5" CornerRadius="0" BorderBrush="#FFFF2A40">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#FF2A40" Opacity="1.0"/>
                            </Border.Effect>
                        </Border>

                        <!-- Letter host with italic skew + heartbeat scale -->
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,2">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <SkewTransform x:Name="WarningLetterSkew" AngleX="-8" AngleY="0"/>
                                        <ScaleTransform x:Name="WarningLetterPulse" ScaleX="1" ScaleY="1"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <StackPanel x:Name="WarningLetterHost" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Viewbox>

                        <!-- White entry flash sits on top, faded in/out by code. -->
                        <Rectangle x:Name="WarningFlash" Fill="White" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="1" Background="#08103A" ClipToBounds="True">
                <Canvas x:Name="MarqueeCanvas">
                    <Rectangle x:Name="MarqueeHighlight" Visibility="Collapsed" Fill="Transparent">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="MarqueeHighlightTranslate"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock x:Name="MarqueeText" Text="" Foreground="White" FontSize="52" FontWeight="Bold">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="MarqueeTranslate"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </Border>
        </Grid>
    </Grid>

    <!-- ======================== MAIN LAYOUT (flexible, no Viewbox, no stretching) ======================== -->
    <Grid x:Name="ExpandedLayout" Background="#0B1228">

        <Grid.RowDefinitions>
            <!-- Heights are proportional to the 960x540 design. The information bar is
                 deliberately substantial enough to be read from the far side of a ground;
                 the score rows surrender a little vertical whitespace to make room for it.
                 so the bars scale down correctly when the output window shrinks instead of
                 staying fixed at the text size. MinHeights keep them readable on large windows. -->
            <RowDefinition x:Name="ExpTopInfoRow" Height="58*" MinHeight="28"/>    <!-- top info bar (weather | time | date) -->
            <RowDefinition Height="Auto"/>                  <!-- overlay drop-down area (pushes content below) -->
            <RowDefinition Height="482*"/>                  <!-- main content -->
            <RowDefinition x:Name="ExpBottomBarRow" Height="0"/>    <!-- bottom message bar: collapsed by default, only shown when marquee messages exist or compact-clock mode is active -->
        </Grid.RowDefinitions>

        <!-- ============ TOP INFO BAR (weather | time | date) ============ -->
        <Border Grid.Row="0" Panel.ZIndex="0" ClipToBounds="True" BorderThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#020614" Offset="0.0"/>
                    <GradientStop Color="#060D2E" Offset="0.5"/>
                    <GradientStop Color="#0A1648" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Each cell uses a DownOnly Viewbox so the FontSize=30 text scales
                     down cleanly when the output window (and therefore the top bar
                     row) shrinks below the natural text size. -->
                <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,2,4,2">
                    <TextBlock x:Name="ExpTopWeatherText" Text="--°C"
                               Foreground="White" FontFamily="Stolzl Bold" FontSize="52" FontWeight="Black"
                               HorizontalAlignment="Left" TextAlignment="Left"/>
                </Viewbox>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2">
                    <TextBlock x:Name="ExpTopClockText" Text="--:--"
                               Foreground="#FFFFFF" FontFamily="Stolzl Bold" FontSize="52" FontWeight="Black"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </Viewbox>
                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,2,8,2">
                    <TextBlock x:Name="ExpTopDateText" Text="---"
                               Foreground="White" FontFamily="Stolzl Bold" FontSize="52" FontWeight="Black"
                               HorizontalAlignment="Right" TextAlignment="Right"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- Bottom message bar - slides up + fades in when triggered -->
        <Border x:Name="ExpBottomBarBorder" Grid.Row="3" Panel.ZIndex="0" ClipToBounds="True" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ExpBottomBarSlide" Y="40"/>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#020614" Offset="0.0"/>
                    <GradientStop Color="#060D2E" Offset="0.5"/>
                    <GradientStop Color="#0A1648" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Canvas x:Name="ExpMarqueeCanvas" ClipToBounds="True">
                    <Rectangle x:Name="ExpMarqueeHighlight" Visibility="Collapsed" Fill="Transparent">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ExpMarqueeHighlightTranslate"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock x:Name="ExpMarqueeText" Text="" Foreground="White" FontFamily="Stolzl Bold" FontSize="44" FontWeight="Bold">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="ExpMarqueeTranslate"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
                <!-- Compact quarter+clock bar shown in place of the marquee when the
                     output window becomes too square to keep the dedicated left
                     clock column. Hidden by default; toggled in code-behind based
                     on the current aspect ratio of ExpandedLayout. -->
                <Grid x:Name="ExpCompactClockBar" Visibility="Collapsed" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="6,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="ExpCompactQuarterText" Text="1ST" Foreground="White" FontFamily="Stolzl Bold" FontSize="60" FontWeight="Bold"/>
                    </Viewbox>
                    <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="6,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ExpCompactClockText" Text="14:37" Foreground="White" FontFamily="Stolzl Bold" FontSize="60" FontWeight="Bold"/>
                    </Viewbox>
                </Grid>
            </Grid>
        </Border>

        <!-- Overlay bars (drop over top message bar) -->
        <Border x:Name="ExpStatsBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="5" BorderThickness="0" Background="#0D1117">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#F0C040" Opacity="0.45"/>
            </Border.Effect>
            <Grid x:Name="ExpStatsBarContent" Margin="12,2" Opacity="1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExpStatsBarContentTranslate" X="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ExpStatsHomeValueColumn" Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ExpStatsAwayValueColumn" Width="70"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                    <TextBlock x:Name="ExpStatsHomeValueText" Text="0" Foreground="White" FontSize="38" FontWeight="Black"/>
                </Viewbox>
                <Grid Grid.Column="1" Margin="6,4">
                    <Border CornerRadius="0" Background="#18FFFFFF" VerticalAlignment="Stretch" ClipToBounds="True" BorderThickness="1" BorderBrush="#55FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ExpStatsBarHomeCol" Width="*"/>
                                <ColumnDefinition x:Name="ExpStatsBarAwayCol" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="0">
                                <Border.Background><SolidColorBrush x:Name="ExpStatsHomeBarBrush" Color="#4488FF"/></Border.Background>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="0">
                                <Border.Background><SolidColorBrush x:Name="ExpStatsAwayBarBrush" Color="#FF6644"/></Border.Background>
                            </Border>
                            <Viewbox Grid.ColumnSpan="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="10,3">
                                <TextBlock x:Name="ExpStatsLabelText" Text="SCORING SHOTS" Foreground="White" Background="#E607101A"
                                           Padding="8,2" FontFamily="Stolzl Bold" FontSize="36" FontWeight="Black">
                                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.9"/></TextBlock.Effect>
                                </TextBlock>
                            </Viewbox>
                        </Grid>
                    </Border>
                    <!-- Hidden compatibility label (kept for any code-behind references) -->
                    <TextBlock x:Name="ExpStatsInsideLabelText" Visibility="Collapsed" Text="SCORING SHOTS"/>
                </Grid>
                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                    <TextBlock x:Name="ExpStatsAwayValueText" Text="0" Foreground="White" FontSize="38" FontWeight="Black"/>
                </Viewbox>
            </Grid>
        </Border>

        <Border x:Name="ExpScorelessBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="6" BorderThickness="0" Background="#0D1117">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#F0C040" Opacity="0.45"/>
            </Border.Effect>
            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="12,2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="TIME SINCE LAST SCORE" Foreground="White" FontFamily="Stolzl Bold" FontSize="28" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="ExpScorelessTimeText" Text="10:00" Foreground="#FFD54A" FontFamily="Stolzl Bold" FontSize="38" FontWeight="Black" VerticalAlignment="Center"/>
                </Grid>
            </Viewbox>
        </Border>

        <Border x:Name="ExpScoringRunBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="7" BorderThickness="0,0,0,1" BorderBrush="#55FFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#F0C040" Opacity="0.45"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush x:Name="ExpScoringRunGradient" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#07111B" Offset="0"/>
                    <GradientStop Color="#122334" Offset="0.62"/>
                    <GradientStop Color="#07111B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid x:Name="ExpScoringRunContent" Margin="14,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" x:Name="ExpScoringRunAccent" Background="#4ADE80"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock x:Name="ExpScoringRunLabelText" Text="HOME SCORING RUN" Foreground="White" FontFamily="Stolzl Bold" FontSize="30" FontWeight="Black"/>
                    </Viewbox>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <TextBlock x:Name="ExpScoringRunDetailText" Text="4 SCORES · 06:12" Foreground="#DCE5EF" FontFamily="Stolzl Bold" FontSize="19" FontWeight="SemiBold"/>
                    </Viewbox>
                </StackPanel>
                <Viewbox Grid.Column="3" Stretch="Uniform" StretchDirection="DownOnly" Margin="18,0,0,0">
                    <TextBlock x:Name="ExpScoringRunValueText" Text="20–0" Foreground="White" FontSize="52" FontWeight="Black" FontFamily="Stolzl Bold"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- Recent scores uses the same shared drop-down row as every other
             informational overlay. It never moves or hides the live score cells. -->
        <Border x:Name="ExpRecentScoresBarBorder" Grid.Row="1" Height="0" ClipToBounds="True"
                Panel.ZIndex="16" BorderThickness="0,0,0,1" BorderBrush="#667A8DA6" Background="#07111B">
            <Grid x:Name="ExpRecentScoresContent" Margin="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="ExpRecentScoresSpacerColumn" Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ExpRecentScoresHeader" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ExpRecentScoresRecentText" Text="RECENT" Foreground="#8FA5BC" FontFamily="Stolzl Bold" FontSize="17" FontWeight="Black"/>
                    <TextBlock x:Name="ExpRecentScoresTitleText" Text="SCORES" Foreground="White" FontFamily="Stolzl Bold" FontSize="23" FontWeight="Black"/>
                </StackPanel>
                <UniformGrid Grid.Column="2" x:Name="ExpRecentScoresCards" Rows="1" Columns="3"/>
            </Grid>
        </Border>

        <Border x:Name="ExpTeamDroughtBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="8" BorderThickness="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#F0C040" Opacity="0.45"/>
            </Border.Effect>
            <Border.Background>
                <SolidColorBrush x:Name="ExpTeamDroughtGradient" Color="#0D1117"/>
            </Border.Background>
            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="12,2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ExpTeamDroughtLabelText" Text="HOME SCORELESS" Foreground="White" FontFamily="Stolzl Bold" FontSize="28" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="ExpTeamDroughtTimeText" Text="08:30" Foreground="#FFD54A" FontSize="38" FontWeight="Black" FontFamily="Stolzl Bold" VerticalAlignment="Center"/>
                </Grid>
            </Viewbox>
        </Border>

        <!-- Lead changes bar (expanded) -->
        <Border x:Name="ExpLeadChangesBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="9" BorderThickness="0" Background="#0D1117">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#F0C040" Opacity="0.45"/>
            </Border.Effect>
            <!-- Viewbox wrapper so the bar's content scales down to fit when the
                 scorebug is small (e.g. ~400x200). Inner grid uses Auto sizing
                 because the Viewbox measures children with unconstrained size. -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="16,2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ExpLeadChangesLabelText" Text="LEAD CHANGES" Foreground="#C084FC" FontSize="32" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ExpLeadChangesValueText" Text="7" Foreground="White" FontSize="56" FontWeight="Black" FontFamily="Stolzl Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
            </Viewbox>
        </Border>

        <!-- Win probability bar (expanded) -->
        <Border x:Name="ExpWinProbBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="10" BorderThickness="0" Background="#0D1117">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#F0C040" Opacity="0.45"/>
            </Border.Effect>
            <Grid x:Name="ExpWinProbContent" Margin="12,2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ExpWinProbHomeValueColumn" Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ExpWinProbAwayValueColumn" Width="70"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                    <TextBlock x:Name="ExpWinProbHomePctText" Text="50%" Foreground="White" FontSize="38" FontWeight="Black"/>
                </Viewbox>
                <Grid Grid.Column="1" Margin="6,4">
                    <Border CornerRadius="0" Background="#18FFFFFF" VerticalAlignment="Stretch" ClipToBounds="True" BorderThickness="1" BorderBrush="#55FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ExpWinProbHomeCol" Width="50*"/>
                                <ColumnDefinition x:Name="ExpWinProbAwayCol" Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="0">
                                <Border.Background><SolidColorBrush x:Name="ExpWinProbHomeBarBrush" Color="#4488FF"/></Border.Background>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="0">
                                <Border.Background><SolidColorBrush x:Name="ExpWinProbAwayBarBrush" Color="#FF6644"/></Border.Background>
                            </Border>
                            <Viewbox Grid.ColumnSpan="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="10,3">
                                <TextBlock x:Name="ExpWinProbInsideLabelText" Text="WIN PROBABILITY" Foreground="White" Background="#E607101A"
                                           Padding="8,2" FontFamily="Stolzl Bold" FontSize="36" FontWeight="Black">
                                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.9"/></TextBlock.Effect>
                                </TextBlock>
                            </Viewbox>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ExpWinProbLabelText" Visibility="Collapsed" Text="WIN PROBABILITY"/>
                </Grid>
                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
                    <TextBlock x:Name="ExpWinProbAwayPctText" Text="50%" Foreground="White" FontSize="38" FontWeight="Black"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- ============ WEATHER OVERLAYS (compact, drops from top bar) ============ -->
        <!-- Designed for ~386x193 output; uses Stretch=Both Viewbox so the
             content scales to the bar's height while keeping a balanced layout. -->

        <!-- Current Weather (label + big temp + feels-like + min/max) -->
        <Border x:Name="ExpWeatherStatsBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="12" BorderThickness="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#3B82F6" Opacity="0.55"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#040A1F" Offset="0.0"/>
                    <GradientStop Color="#0B1B3F" Offset="0.5"/>
                    <GradientStop Color="#040A1F" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="12,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Label block (left) -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="WEATHER" Foreground="#B9D8FF" FontFamily="Stolzl Bold" FontSize="18" FontWeight="Black"/>
                    <TextBlock x:Name="ExpWeatherStatsDesc" Text="" Foreground="#E2E8F0" FontFamily="Stolzl Bold" FontSize="14" FontWeight="Black"/>
                </StackPanel>
                <!-- Icon + temperature (centre-left) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="ExpWeatherStatsIcon" Text="☀" Foreground="White" FontSize="30" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ExpWeatherStatsTemp" Text="--°" Foreground="White" FontFamily="Stolzl Bold" FontSize="34" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Spacer -->
                <Grid Grid.Column="2"/>
                <!-- Stats grid (right): three labelled tiles, evenly spaced -->
                <Grid Grid.Column="3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="FEELS" Foreground="#D6E3EF" FontFamily="Stolzl Bold" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ExpWeatherStatsFeels" Text="--°" Foreground="White" FontFamily="Stolzl Bold" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="MIN" Foreground="#8FC5FF" FontFamily="Stolzl Bold" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ExpWeatherStatsMin" Text="--°" Foreground="White" FontFamily="Stolzl Bold" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="MAX" Foreground="#FF9999" FontFamily="Stolzl Bold" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ExpWeatherStatsMax" Text="--°" Foreground="White" FontFamily="Stolzl Bold" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Hourly Forecast (label + 4 compact tiles: time / icon / temp) -->
        <Border x:Name="ExpForecastBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="13" BorderThickness="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#22D3EE" Opacity="0.55"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#031819" Offset="0.0"/>
                    <GradientStop Color="#0A2F33" Offset="0.5"/>
                    <GradientStop Color="#031819" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="12,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="FORECAST" Foreground="#A5F3FC" FontFamily="Stolzl Bold" FontSize="18" FontWeight="Black"/>
                    <TextBlock Text="NEXT 4 HRS" Foreground="#E2E8F0" FontFamily="Stolzl Bold" FontSize="14" FontWeight="Black"/>
                </StackPanel>
                <UniformGrid Grid.Column="1" x:Name="ExpForecastTiles" Rows="1" Columns="4"/>
            </Grid>
        </Border>

        <!-- Rain Probability (label + bars showing % per upcoming hour) -->
        <Border x:Name="ExpRainBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="14" BorderThickness="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#38BDF8" Opacity="0.55"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#020A1F" Offset="0.0"/>
                    <GradientStop Color="#06203F" Offset="0.5"/>
                    <GradientStop Color="#020A1F" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="12,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="RAIN" Foreground="#BAE6FD" FontFamily="Stolzl Bold" FontSize="18" FontWeight="Black"/>
                    <TextBlock Text="NEXT 4 HRS" Foreground="#E2E8F0" FontFamily="Stolzl Bold" FontSize="14" FontWeight="Black"/>
                </StackPanel>
                <UniformGrid Grid.Column="1" x:Name="ExpRainBars" Rows="1" Columns="4" Margin="4,0,4,0"/>
                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                    <TextBlock x:Name="ExpRainPeakValue" Text="--%" Foreground="White" FontFamily="Stolzl Bold" FontSize="28" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="PEAK" Foreground="#E2E8F0" FontFamily="Stolzl Bold" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scores this quarter (drops from the top bar; pushes content below) -->
        <Border x:Name="ExpQuarterScoresBarBorder" Grid.Row="1" Height="0" ClipToBounds="True" Panel.ZIndex="11" BorderThickness="0" Background="#0D1117">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#F0C040" Opacity="0.45"/>
            </Border.Effect>
            <!-- A deliberately simple distance-first summary: team abbreviation plus
                 one large quarter total per side. Goals/behinds remain in the live
                 scorebug below; repeating them here produced six undersized boxes. -->
            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="1,1"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     MaxWidth="{Binding ActualWidth, ElementName=ExpQuarterScoresBarBorder}">
            <Grid Margin="10,3" VerticalAlignment="Center" MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="7*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="4,0,0,4" Padding="10,2">
                        <Border.Background><SolidColorBrush x:Name="ExpQuarterScoresHomeGoalsBg" Color="#0A2A6A"/></Border.Background>
                        <Border.BorderBrush><SolidColorBrush x:Name="ExpQuarterScoresHomeGoalsBorder" Color="#5A8AFF"/></Border.BorderBrush>
                        <TextBlock x:Name="ExpQuarterScoresHomeNameText" Text="HOM" FontFamily="Stolzl Bold" FontSize="36" FontWeight="Black"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Border>
                    <Border x:Name="ExpQuarterScoresHomeTotalBox" Grid.Column="1" CornerRadius="0,4,4,0" BorderThickness="0" Padding="12,0">
                        <Border.Background><SolidColorBrush x:Name="ExpQuarterScoresHomeTotalBg" Color="#0A2A6A"/></Border.Background>
                        <Border.BorderBrush><SolidColorBrush x:Name="ExpQuarterScoresHomeTotalBorder" Color="#FFFFFF"/></Border.BorderBrush>
                        <TextBlock x:Name="ExpQuarterScoresHomeTotalText" Text="0" FontFamily="Stolzl Bold" FontSize="66" FontWeight="Black"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.7"/></TextBlock.Effect>
                        </TextBlock>
                    </Border>
                </Grid>
                <!-- Compatibility elements retain the public overlay contract without
                     spending presentation space on duplicate goals/behinds. -->
                <StackPanel Visibility="Collapsed">
                    <Border x:Name="ExpQuarterScoresHomeGoalsBox"><TextBlock x:Name="ExpQuarterScoresHomeGoalsText"/></Border>
                    <Border x:Name="ExpQuarterScoresHomeBehindsBox"><Border.Background><SolidColorBrush x:Name="ExpQuarterScoresHomeBehindsBg" Color="#0A2A6A"/></Border.Background><Border.BorderBrush><SolidColorBrush x:Name="ExpQuarterScoresHomeBehindsBorder" Color="#5A8AFF"/></Border.BorderBrush><TextBlock x:Name="ExpQuarterScoresHomeBehindsText"/></Border>
                </StackPanel>
                <!-- Centre title -->
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                    <TextBlock x:Name="ExpQuarterScoresQtrLabelText" Text="Q1" FontFamily="Stolzl Bold" FontSize="18" FontWeight="Black" Foreground="#F5CE64" HorizontalAlignment="Center"/>
                    <TextBlock Text="SCORE" FontFamily="Stolzl Bold" FontSize="36" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#FBBF24" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    </StackPanel>
                </Viewbox>
                <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ExpQuarterScoresAwayTotalBox" Grid.Column="0" CornerRadius="4,0,0,4" BorderThickness="0" Padding="12,0">
                        <Border.Background><SolidColorBrush x:Name="ExpQuarterScoresAwayTotalBg" Color="#7A1A1A"/></Border.Background>
                        <Border.BorderBrush><SolidColorBrush x:Name="ExpQuarterScoresAwayTotalBorder" Color="#FFFFFF"/></Border.BorderBrush>
                        <TextBlock x:Name="ExpQuarterScoresAwayTotalText" Text="0" FontFamily="Stolzl Bold" FontSize="66" FontWeight="Black"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.7"/></TextBlock.Effect>
                        </TextBlock>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="0,4,4,0" Padding="10,2">
                        <Border.Background><SolidColorBrush x:Name="ExpQuarterScoresAwayGoalsBg" Color="#7A1A1A"/></Border.Background>
                        <Border.BorderBrush><SolidColorBrush x:Name="ExpQuarterScoresAwayGoalsBorder" Color="#FF6644"/></Border.BorderBrush>
                        <TextBlock x:Name="ExpQuarterScoresAwayNameText" Text="AWA" FontFamily="Stolzl Bold" FontSize="36" FontWeight="Black"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Border>
                </Grid>
                <StackPanel Visibility="Collapsed">
                    <Border x:Name="ExpQuarterScoresAwayGoalsBox"><TextBlock x:Name="ExpQuarterScoresAwayGoalsText"/></Border>
                    <Border x:Name="ExpQuarterScoresAwayBehindsBox"><Border.Background><SolidColorBrush x:Name="ExpQuarterScoresAwayBehindsBg" Color="#7A1A1A"/></Border.Background><Border.BorderBrush><SolidColorBrush x:Name="ExpQuarterScoresAwayBehindsBorder" Color="#FF6644"/></Border.BorderBrush><TextBlock x:Name="ExpQuarterScoresAwayBehindsText"/></Border>
                </StackPanel>
            </Grid>
            </Viewbox>
        </Border>

        <!-- Dedicated five-minute warning. It occupies the shared overlay row so the
             live quarter and clock remain visible while the alert slides down. -->
        <Border x:Name="ExpWarningBanner" Grid.Row="1" Height="0" Opacity="0"
                IsHitTestVisible="False" Panel.ZIndex="250" ClipToBounds="True"
                BorderThickness="0,1,0,1" BorderBrush="#FFFFC44D"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ExpWarningBannerSlide" Y="-64"/>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF3B0710" Offset="0"/>
                    <GradientStop Color="#FFD51B22" Offset="0.22"/>
                    <GradientStop Color="#FFF05A24" Offset="0.5"/>
                    <GradientStop Color="#FFD51B22" Offset="0.78"/>
                    <GradientStop Color="#FF3B0710" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Rectangle Width="2400" HorizontalAlignment="Left" Opacity="0.55">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Stretch="None" Viewport="0,0,56,56" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#55100000">
                                    <GeometryDrawing.Geometry>
                                        <PathGeometry Figures="M 0,28 L 28,0 L 56,0 L 0,56 Z M 28,56 L 56,28 L 56,56 Z"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.28"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.72"/>
                            <GradientStop Color="#FFFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ExpWarningBannerStripesTranslate"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Border x:Name="ExpWarningBannerGlowBorder" BorderThickness="2,0" BorderBrush="#FFFFD36B" Opacity="0"/>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="22,4">
                    <StackPanel x:Name="ExpWarningBannerLetterHost" Orientation="Vertical"
                                HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="ExpWarningBannerLetterPulse"/>
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </Viewbox>
                <Rectangle x:Name="ExpWarningBannerScanline" Width="110" HorizontalAlignment="Left"
                           Opacity="0" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#AAFFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ExpWarningBannerScanlineTranslate" X="-110"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="ExpWarningBannerFlash" Fill="White" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Legacy compact warning retained for the deprecated classic layout. -->

        <!-- Main content: Clock | Logo column | Score column (broadcast style matching reference image) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExpClockColumn" Width="225*" MinWidth="80"/>    <!-- black quarter / clock panel -->
                <ColumnDefinition x:Name="ExpLogoColumn" Width="165*" MinWidth="50"/>    <!-- logo column -->
                <ColumnDefinition x:Name="ExpScoresColumn" Width="610*"/>                <!-- scores column (split home/away) -->
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT: BLACK QUARTER + CLOCK PANEL ============ -->
            <Grid x:Name="ExpClockPanel" Grid.Column="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="ExpClockPanelGradTop" Color="#1A1F2E" Offset="0.0"/>
                        <GradientStop x:Name="ExpClockPanelGradMid" Color="#0A0D14" Offset="0.5"/>
                        <GradientStop x:Name="ExpClockPanelGradBot" Color="#000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="ExpClockQuarterSurface" Grid.Row="0" Background="#121A2A" Opacity="0.72"/>
                <Border x:Name="ExpClockTimerSurface" Grid.Row="1" Background="#020409" Opacity="0.38"/>
                <!-- One shared fit keeps quarter and timer at an identical visual
                     size. Condensed Arial preserves the larger compact treatment
                     without letting the five-character timer crowd the column. -->
                <Viewbox Grid.RowSpan="2" Stretch="Uniform" StretchDirection="DownOnly"
                         Margin="3,5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="ExpQuarterNumberText" Text="1ST" Foreground="White"
                                   FontFamily="Arial" FontSize="120" FontWeight="Black" FontStretch="Condensed"
                                   HorizontalAlignment="Center" TextAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                   SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextHintingMode="Fixed" TextOptions.TextRenderingMode="ClearType">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="ExpQuarterNumberTextScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Border x:Name="ExpClockDivider" Height="2" Margin="18,6" Background="#70FFFFFF" SnapsToDevicePixels="True"/>
                        <TextBlock x:Name="ExpClockText" Text="14:37" Foreground="White"
                                   FontFamily="Arial" FontSize="120" FontWeight="Black" FontStretch="Condensed"
                                   HorizontalAlignment="Center" TextAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                   SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextHintingMode="Fixed" TextOptions.TextRenderingMode="ClearType">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="ExpClockTextScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Viewbox>
                <!-- Hidden wall-clock (kept for code-behind compatibility) -->
                <TextBlock x:Name="ExpTopTimeText" Visibility="Collapsed" Text="1:26 PM"/>

                <!-- 5-minute alert overlay (covers only the quarter+clock panel).
                     Redesigned broadcast-style hazard alert mirroring the
                     compact overlay: vignette, scrolling hazard stripes,
                     scanline shimmer, pulsing border glow, italic-skewed
                     heartbeat text, white entry flash. -->
                <Border x:Name="ExpWarningOverlay" Grid.RowSpan="2" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="100" ClipToBounds="True" BorderThickness="0">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.95" RadiusY="1.15">
                            <GradientStop Color="#FFE0001E" Offset="0.0"/>
                            <GradientStop Color="#FFA80018" Offset="0.45"/>
                            <GradientStop Color="#FF38000A" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Rectangle x:Name="ExpWarningStripesRect" Opacity="0.85" IsHitTestVisible="False"
                                   Width="2400" HorizontalAlignment="Left">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Stretch="None"
                                              Viewport="0,0,56,56" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#FF1A0000">
                                            <GeometryDrawing.Geometry>
                                                <PathGeometry Figures="M 0,28 L 28,0 L 56,0 L 0,56 Z M 28,56 L 56,28 L 56,56 Z"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFFFF" Offset="0.00"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.14"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.20"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.80"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.86"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ExpWarningStripesTranslate" X="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Border Height="3" VerticalAlignment="Top" Margin="0,28,0,0" Background="#FFFFB020" Opacity="0.9" IsHitTestVisible="False"/>
                        <Border Height="3" VerticalAlignment="Bottom" Margin="0,0,0,28" Background="#FFFFB020" Opacity="0.9" IsHitTestVisible="False"/>

                        <Rectangle x:Name="ExpWarningScanline" IsHitTestVisible="False"
                                   Width="120" HorizontalAlignment="Left" Opacity="0.0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#80FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ExpWarningScanlineTranslate" X="-120"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Border x:Name="ExpWarningGlowBorder" Opacity="0" BorderThickness="7" BorderBrush="#FFFF2A40">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="44" ShadowDepth="0" Color="#FF2A40" Opacity="1.0"/>
                            </Border.Effect>
                        </Border>

                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,6">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <SkewTransform x:Name="ExpWarningLetterSkew" AngleX="-8" AngleY="0"/>
                                        <ScaleTransform x:Name="ExpWarningLetterPulse" ScaleX="1" ScaleY="1"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <StackPanel x:Name="ExpWarningLetterHost" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Viewbox>

                        <Rectangle x:Name="ExpWarningFlash" Fill="White" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ MIDDLE: LOGO COLUMN (HOME TOP / AWAY BOTTOM) ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 3D separator bar on right edge separating logo column from score/team panel -->
                <Rectangle Grid.RowSpan="2" HorizontalAlignment="Right" Width="3" IsHitTestVisible="False" Panel.ZIndex="50">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#55000000" Offset="0"/>
                            <GradientStop Color="#66FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Home logo cell -->
                <Border x:Name="ExpHomeLogoCell" Grid.Row="0" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="ExpHomeLogoCellGradStart" Color="#5C2118" Offset="0.0"/>
                            <GradientStop x:Name="ExpHomeLogoCellGradEnd" Color="#C9483B" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <!-- Compatibility brush (kept for code-behind that still assigns .Color). -->
                    <Border.Resources>
                        <SolidColorBrush x:Key="ExpHomeLogoCellBrushKey" Color="#C9483B"/>
                    </Border.Resources>
                    <Grid x:Name="ExpHomeLogoHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="6">
                        <Border x:Name="ExpHomeLogoSquare" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{Binding Color, Source={StaticResource HomeLogoDarkBrush}}" Offset="0"/>
                                    <GradientStop Color="{Binding Color, Source={StaticResource HomeTeamBrush}}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="ExpHomeLogoFallback" Text="HOM" Foreground="#EEEEEE" FontWeight="Black" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="ExpHomeLogoImage" Stretch="Uniform" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Away logo cell -->
                <Border x:Name="ExpAwayLogoCell" Grid.Row="1" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="ExpAwayLogoCellGradStart" Color="#5C470A" Offset="0.0"/>
                            <GradientStop x:Name="ExpAwayLogoCellGradEnd" Color="#B68F12" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Resources>
                        <SolidColorBrush x:Key="ExpAwayLogoCellBrushKey" Color="#B68F12"/>
                    </Border.Resources>
                    <Grid x:Name="ExpAwayLogoHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="6">
                        <Border x:Name="ExpAwayLogoSquare" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{Binding Color, Source={StaticResource AwayLogoDarkBrush}}" Offset="0"/>
                                    <GradientStop Color="{Binding Color, Source={StaticResource AwayTeamBrush}}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="ExpAwayLogoFallback" Text="AWA" Foreground="#EEEEEE" FontWeight="Black" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="ExpAwayLogoImage" Stretch="Uniform" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ RIGHT: SCORES COLUMN ============ -->
            <!-- ClipToBounds disabled so the goal overlay + score swipe can visually extend
                 left across the logo column when a goal preset plays. -->
            <Grid Grid.Column="2" ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== HOME SCORE PANEL ===== -->
                <Grid Grid.Row="0" x:Name="ExpHomePanel" ClipToBounds="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="ExpHomePanelGradStart" Color="#C9483B" Offset="0.0"/>
                            <GradientStop x:Name="ExpHomePanelGradEnd" Color="#5C2118" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.Resources>
                        <SolidColorBrush x:Key="ExpHomePanelBrushKey" Color="#C9483B"/>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ExpHomeNameRow" Height="1.3*"/>   <!-- team name -->
                        <RowDefinition x:Name="ExpHomeScoreRow" Height="2.4*"/>  <!-- score cells -->
                    </Grid.RowDefinitions>
                    <!-- Top-light gradient overlay for 3D look -->
                    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Team name header. Stretch=Uniform with Both, filling the
                         entire row, so the name is always as big as possible
                         within the team-name row regardless of scorebug size. -->
                    <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both" Margin="2,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Viewbox.RenderTransform><TranslateTransform x:Name="ExpHomeNameSlide"/></Viewbox.RenderTransform>
                        <TextBlock x:Name="ExpHomeNameText" Text="OLD XAVIERIANS" Foreground="White" FontFamily="Stolzl Bold" FontSize="56" FontWeight="Black" TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Viewbox>

                    <!-- Separator bar between team name row and score cells -->
                    <Rectangle x:Name="ExpHomeNameSeparator" Grid.Row="0" VerticalAlignment="Bottom" Height="3" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#55000000" Offset="0"/>
                                <GradientStop Color="#66FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Score cells: Goals | Behinds | Total (transparent, sharing panel gradient).
                         G/B columns widened to 1.25* so two-digit scores (e.g. "12", "15") render at
                         full size without the Viewbox shrinking them. Total stays widest (2.2*) and
                         dominates via larger font weight / size. -->
                    <Grid x:Name="ExpHomeScoreGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="2.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Goals -->
                        <Grid x:Name="ExpHomeGoalsCell" Grid.Column="0" Margin="4" ClipToBounds="True">
                            <Grid.RenderTransform><TranslateTransform x:Name="ExpHomeGoalsSlide"/></Grid.RenderTransform>
                            <TextBlock x:Name="ExpHomeGoalsText" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="White" FontFamily="Arial" FontStretch="Normal" FontSize="72" FontWeight="Bold" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                                <TextBlock.RenderTransform><TranslateTransform x:Name="ExpHomeGoalsFlip"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>

                        <!-- 3D separator bar -->
                        <Rectangle x:Name="ExpHomeGoalsBehindsSep" Grid.Column="1" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#55000000" Offset="0"/>
                                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Behinds -->
                        <Grid x:Name="ExpHomeBehindsCell" Grid.Column="2" Margin="4" ClipToBounds="True">
                            <Grid.RenderTransform><TranslateTransform x:Name="ExpHomeBehindsSlide"/></Grid.RenderTransform>
                            <TextBlock x:Name="ExpHomeBehindsText" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="White" FontFamily="Arial" FontStretch="Normal" FontSize="72" FontWeight="Bold" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                                <TextBlock.RenderTransform><TranslateTransform x:Name="ExpHomeBehindsFlip"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>

                        <!-- 3D separator bar -->
                        <Rectangle x:Name="ExpHomeBehindsTotalSep" Grid.Column="3" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#55000000" Offset="0"/>
                                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Total -->
                        <Grid x:Name="ExpHomeTotalCell" Grid.Column="4" ClipToBounds="True">
                            <Grid.RenderTransform><TranslateTransform x:Name="ExpHomeTotalSlide"/></Grid.RenderTransform>
                                <TextBlock x:Name="ExpHomeTotalText" Text="0" Margin="2,1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="White" FontFamily="Arial" FontStretch="Normal" FontSize="104" FontWeight="Black" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5"/>
                                    </TextBlock.Effect>
                                    <TextBlock.RenderTransform><TranslateTransform x:Name="ExpHomeTotalFlip"/></TextBlock.RenderTransform>
                                </TextBlock>
                            <!-- Score-change swipe overlay (shows +1 / +6 in team primary on team secondary) -->
                            <Border x:Name="ExpHomeSwipeOverlay" IsHitTestVisible="False" Opacity="0"
                                    Panel.ZIndex="100" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <SolidColorBrush x:Name="ExpHomeSwipeBg" Color="#FFFFFF"/>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ExpHomeSwipeTranslate" Y="0"/>
                                </Border.RenderTransform>
                                <!-- Direct foreground layer: unlike the previous Viewbox child this
                                     remains measurable while its parent is translated off-screen. -->
                                <TextBlock x:Name="ExpHomeSwipeText" Text="+6" FontFamily="Arial"
                                           FontSize="96" FontWeight="Black" FontStretch="Normal"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextHintingMode="Fixed" Panel.ZIndex="101">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush x:Name="ExpHomeSwipeFg" Color="#0A2A6A"/>
                                    </TextBlock.Foreground>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="270" Color="#99000000" Opacity="0.75"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Score glow layer (expanded) -->
                <Border Grid.Row="0" x:Name="ExpHomeScoreGlow" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="280">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="0.8" RadiusY="0.6">
                                <GradientStop Color="#600A2A6A" Offset="0"/>
                                <GradientStop Color="#000A2A6A" Offset="1"/>
                            </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Edge glow (expanded) -->
                <Rectangle Grid.Row="0" x:Name="ExpHomeEdgeGlow" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Expanded goal overlay (home) — broadcast style. Negative left margin
                     stretches it across the logo column too. -->
                <Border Grid.Row="0" x:Name="ExpHomeOverlay" Margin="-240,0,0,0" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
                    <Border.Background><SolidColorBrush x:Name="ExpHomeOverlayBg" Color="#0A2A6A"/></Border.Background>
                    <Grid>
                        <!-- Horizontal colour sweep bar -->
                        <Rectangle x:Name="ExpHomeGradBar" Width="2000" HorizontalAlignment="Left" Opacity="0.55">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" x:Name="ExpHomeGradBarBrush">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#FFD700" Offset="0.15"/>
                                    <GradientStop Color="#FF6B00" Offset="0.3"/>
                                    <GradientStop Color="#FF0080" Offset="0.45"/>
                                    <GradientStop Color="#8000FF" Offset="0.6"/>
                                    <GradientStop Color="#00BFFF" Offset="0.75"/>
                                    <GradientStop Color="#00FF88" Offset="0.9"/>
                                    <GradientStop Color="#FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ExpHomeGradScroll" X="-2000"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- Shimmer pass -->
                        <Rectangle x:Name="ExpHomeShimmer" Width="180" Opacity="0" HorizontalAlignment="Left">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="ExpHomeShimmerScroll" X="-250"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- GOAL! text -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,12">
                            <TextBlock x:Name="ExpHomeOverlayText" Text="GOAL!" Foreground="White" FontSize="100" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="ExpHomeOverlayGlow" BlurRadius="40" ShadowDepth="0" Color="White" Opacity="0.9"/>
                                </TextBlock.Effect>
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="ExpHomeOverlayScale" ScaleX="0" ScaleY="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Viewbox>
                    </Grid>
                </Border>
                    <!-- ===== AWAY SCORE PANEL ===== -->
                    <Grid Grid.Row="1" x:Name="ExpAwayPanel" ClipToBounds="True">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="ExpAwayPanelGradStart" Color="#B68F12" Offset="0.0"/>
                                <GradientStop x:Name="ExpAwayPanelGradEnd" Color="#5C470A" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.Resources>
                            <SolidColorBrush x:Key="ExpAwayPanelBrushKey" Color="#B68F12"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ExpAwayNameRow" Height="1.3*"/>
                            <RowDefinition x:Name="ExpAwayScoreRow" Height="2.4*"/>
                        </Grid.RowDefinitions>
                        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Team name header. Fills the row so the name is always
                             as big as possible within the team-name row. -->
                        <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both" Margin="2,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Viewbox.RenderTransform><TranslateTransform x:Name="ExpAwayNameSlide"/></Viewbox.RenderTransform>
                            <TextBlock x:Name="ExpAwayNameText" Text="OLD CAULFIELD" Foreground="White" FontFamily="Stolzl Bold" FontSize="56" FontWeight="Black" TextAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Viewbox>

                        <!-- Separator bar between team name row and score cells -->
                        <Rectangle x:Name="ExpAwayNameSeparator" Grid.Row="0" VerticalAlignment="Bottom" Height="3" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#55000000" Offset="0"/>
                                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Score cells: Goals | Behinds | Total. G/B widened to fit 2-digit scores; total stays dominant. -->
                        <Grid x:Name="ExpAwayScoreGrid" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="ExpAwayGoalsCell" Grid.Column="0" Margin="4" ClipToBounds="True">
                                <Grid.RenderTransform><TranslateTransform x:Name="ExpAwayGoalsSlide"/></Grid.RenderTransform>
                                <TextBlock x:Name="ExpAwayGoalsText" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="White" FontFamily="Arial" FontStretch="Normal" FontSize="72" FontWeight="Bold" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                                    <TextBlock.RenderTransform><TranslateTransform x:Name="ExpAwayGoalsFlip"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>

                            <Rectangle x:Name="ExpAwayGoalsBehindsSep" Grid.Column="1" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#55000000" Offset="0"/>
                                        <GradientStop Color="#66FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid x:Name="ExpAwayBehindsCell" Grid.Column="2" Margin="4" ClipToBounds="True">
                                <Grid.RenderTransform><TranslateTransform x:Name="ExpAwayBehindsSlide"/></Grid.RenderTransform>
                                <TextBlock x:Name="ExpAwayBehindsText" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="White" FontFamily="Arial" FontStretch="Normal" FontSize="72" FontWeight="Bold" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                                    <TextBlock.RenderTransform><TranslateTransform x:Name="ExpAwayBehindsFlip"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>

                            <Rectangle x:Name="ExpAwayBehindsTotalSep" Grid.Column="3" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#55000000" Offset="0"/>
                                        <GradientStop Color="#66FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid x:Name="ExpAwayTotalCell" Grid.Column="4" ClipToBounds="True">
                                <Grid.RenderTransform><TranslateTransform x:Name="ExpAwayTotalSlide"/></Grid.RenderTransform>
                                    <TextBlock x:Name="ExpAwayTotalText" Text="0" Margin="2,1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#A8C8F0" FontFamily="Arial" FontStretch="Normal" FontSize="104" FontWeight="Black" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5"/>
                                        </TextBlock.Effect>
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="ExpAwayTotalFlip"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                <Border x:Name="ExpAwaySwipeOverlay" IsHitTestVisible="False" Opacity="0"
                                        Panel.ZIndex="100" SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="ExpAwaySwipeBg" Color="#FFFFFF"/>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ExpAwaySwipeTranslate" Y="0"/>
                                    </Border.RenderTransform>
                                    <TextBlock x:Name="ExpAwaySwipeText" Text="+6" FontFamily="Arial"
                                               FontSize="96" FontWeight="Black" FontStretch="Normal"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextHintingMode="Fixed" Panel.ZIndex="101">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush x:Name="ExpAwaySwipeFg" Color="#7A1A1A"/>
                                        </TextBlock.Foreground>
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="270" Color="#99000000" Opacity="0.75"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Away score glow -->
                    <Border Grid.Row="1" x:Name="ExpAwayScoreGlow" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="280">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="0.8" RadiusY="0.6">
                                <GradientStop Color="#607A1A1A" Offset="0"/>
                                <GradientStop Color="#007A1A1A" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Rectangle Grid.Row="1" x:Name="ExpAwayEdgeGlow" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="4">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border Grid.Row="1" x:Name="ExpAwayOverlay" Margin="-240,0,0,0" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
                        <Border.Background><SolidColorBrush x:Name="ExpAwayOverlayBg" Color="#7A1A1A"/></Border.Background>
                        <Grid>
                            <Rectangle x:Name="ExpAwayGradBar" Width="2000" HorizontalAlignment="Left" Opacity="0.55">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" x:Name="ExpAwayGradBarBrush">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#FFD700" Offset="0.15"/>
                                        <GradientStop Color="#FF6B00" Offset="0.3"/>
                                        <GradientStop Color="#FF0080" Offset="0.45"/>
                                        <GradientStop Color="#8000FF" Offset="0.6"/>
                                        <GradientStop Color="#00BFFF" Offset="0.75"/>
                                        <GradientStop Color="#00FF88" Offset="0.9"/>
                                        <GradientStop Color="#FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="ExpAwayGradScroll" X="-2000"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="ExpAwayShimmer" Width="180" Opacity="0" HorizontalAlignment="Left">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="ExpAwayShimmerScroll" X="-250"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,12">
                                <TextBlock x:Name="ExpAwayOverlayText" Text="GOAL!" Foreground="White" FontSize="100" FontWeight="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.Effect>
                                        <DropShadowEffect x:Name="ExpAwayOverlayGlow" BlurRadius="40" ShadowDepth="0" Color="White" Opacity="0.9"/>
                                    </TextBlock.Effect>
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="ExpAwayOverlayScale" ScaleX="0" ScaleY="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

                                    <!-- ===== GOAL TAKEOVER (expanded) — REMOVED =====
                                         Per-team overlays (`ExpHomeOverlay` / `ExpAwayOverlay`)
                                         handle goal presentation scoped to the scoring team's
                                         panel; a full-scorebug takeover layer is intentionally
                                         not used here so animations stay within the team's row. -->
                                                 </Grid>
                                             </Grid>

</UserControl>
