<UserControl x:Class="Roche_Scoreboard.Views.CricketDeliveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:Roche_Scoreboard.Views"
        xmlns:design="clr-namespace:Roche_Scoreboard.Services" design:OperatorDesign.IsEnabled="True"
        Background="Transparent" Foreground="#FAFAFC" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15"
        KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/OperatorControls.xaml"/>
        <ResourceDictionary Source="../Resources/SettingsControls.xaml"/>
        <ResourceDictionary Source="../Resources/CricketActions.xaml"/>
        <ResourceDictionary Source="../Resources/ControlCentre.xaml"/>
    </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="ScoreGrid.Brush.TextPrimary" Color="#E6EDF3"/><SolidColorBrush x:Key="ScoreGrid.Brush.TextSecondary" Color="#B6B6C0"/>
        <SolidColorBrush x:Key="ScoreGrid.Brush.Surface" Color="#19191C"/><SolidColorBrush x:Key="ScoreGrid.Brush.SurfaceSubtle" Color="#29292D"/>
        <SolidColorBrush x:Key="ScoreGrid.Brush.ControlBorder" Color="#53535C"/><SolidColorBrush x:Key="ScoreGrid.Brush.AccentBackground" Color="#283D52"/>
        <SolidColorBrush x:Key="ScoreGrid.Brush.AccentForeground" Color="#A9D3FF"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsChoice}"><Setter Property="Margin" Value="0,5,0,14"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource SettingsInput}"><Setter Property="FontSize" Value="24"/><Setter Property="MinHeight" Value="46"/></Style>
        <Style x:Key="FieldTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#B6B6C0"/></Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid x:Name="EntryLayout" Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <glass:OperatorGlassSurface x:Name="TeamHeader" Material="Opaque" Height="96" Margin="0,0,0,16" Padding="16,12" CornerRadius="22" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid><Image x:Name="TeamLogo" Stretch="UniformToFill" Opacity=".09" IsHitTestVisible="False"/>
                <StackPanel><TextBlock x:Name="Heading" Text="EDIT DELIVERY" FontSize="25" FontWeight="Bold"/>
                    <TextBlock x:Name="ContextText" Foreground="#B6B6C0" FontSize="14" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Button Content="×" ToolTip="Cancel delivery" Click="Cancel_Click" Style="{StaticResource ToolBtn}" Width="32" Height="32" MinHeight="0" Padding="0" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#29292D"/>
            </Grid>
        </glass:OperatorGlassSurface>
        <ScrollViewer x:Name="EntryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="2,0,8,0">
                <TextBlock x:Name="TypeLabel" Text="SCORE TYPE" Style="{StaticResource FieldTitle}"/>
                <ComboBox x:Name="TypeChoice" SelectionChanged="Details_Changed"/>
                <StackPanel x:Name="WicketOptions">
                    <TextBlock x:Name="FreeHitEntryHint" Visibility="Collapsed" Text="FREE HIT · Only run out, obstructing field or hit ball twice can be recorded." Foreground="#FFD980" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="WicketRuleHint" Visibility="Collapsed" Text="This dismissal does not apply to the selected outcome. Choose an available dismissal or change the delivery outcome below." Foreground="#FFD980" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="HOW OUT" Style="{StaticResource FieldTitle}"/><ComboBox x:Name="DismissalChoice" Visibility="Collapsed" SelectionChanged="Details_Changed"/><WrapPanel x:Name="DismissalTiles" Margin="0,6,0,14"/>
                    <TextBlock Text="DISMISSED BATTER" Style="{StaticResource FieldTitle}"/><ComboBox x:Name="DismissedChoice" Visibility="Collapsed" SelectionChanged="Details_Changed"/><WrapPanel x:Name="DismissedTiles" Margin="0,6,0,4"/><TextBlock x:Name="DismissedBatterHint" Text="Only the striker can be dismissed this way." Foreground="#F0CB78" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel x:Name="FielderOptions"><TextBlock Text="FIELDER (OPTIONAL)" Style="{StaticResource FieldTitle}"/><ComboBox x:Name="FielderChoice" SelectionChanged="Details_Changed"/><WrapPanel x:Name="FielderTiles" Visibility="Collapsed" Margin="0,6,0,14"/></StackPanel>
                </StackPanel>
                <StackPanel x:Name="RunOutOptions" Visibility="Collapsed"><TextBlock Text="DELIVERY OUTCOME" Style="{StaticResource FieldTitle}"/>
                    <ComboBox x:Name="RunOutChoice" Visibility="Collapsed" SelectionChanged="Details_Changed"/>
                    <UniformGrid x:Name="RunOutSourceTiles" Columns="3" Margin="0,6,0,12">
                        <Button Content="OFF THE BAT" Tag="0" Click="RunOutSource_Click" Style="{StaticResource ToolBtn}" MinHeight="44" Margin="0,0,4,4"/>
                        <Button Content="WIDE" Tag="1" Click="RunOutSource_Click" Style="{StaticResource ToolBtn}" MinHeight="44" Margin="0,0,4,4"/>
                        <Button Content="NO-BALL" Tag="2" Click="RunOutSource_Click" Style="{StaticResource ToolBtn}" MinHeight="44" Margin="0,0,4,4"/>
                        <Button Content="BYES" Tag="3" Click="RunOutSource_Click" Style="{StaticResource ToolBtn}" MinHeight="44" Margin="0,0,4,4"/>
                        <Button Content="LEG-BYES" Tag="4" Click="RunOutSource_Click" Style="{StaticResource ToolBtn}" MinHeight="44" Margin="0,0,4,4"/>
                    </UniformGrid>
                    <StackPanel x:Name="RunOutCrossingOptions">
                        <TextBlock Text="ON THE UNFINISHED RUN" Style="{StaticResource FieldTitle}" Margin="0,4,0,6"/>
                        <RadioButton x:Name="RunOutNotCrossed" Content="Batters had not crossed" IsChecked="True" GroupName="RunOutCrossing" Checked="RunOutCrossing_Changed" MinHeight="36"/>
                        <RadioButton x:Name="RunOutCrossed" Content="Batters had crossed" GroupName="RunOutCrossing" Checked="RunOutCrossing_Changed" MinHeight="36"/>
                        <TextBlock Text="Use umpire-confirmed runs and positions. If obstruction prevented a catch, use original ends and no completed runs. Otherwise choose whether the batters crossed. The preview includes the end of the over." TextWrapping="Wrap" Foreground="#B6B6C0" FontSize="13" Margin="0,4,0,12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="NoBallOptions"><TextBlock Text="NO-BALL RUNS CAME FROM" Style="{StaticResource FieldTitle}"/>
                    <ComboBox x:Name="NoBallChoice" Visibility="Collapsed" SelectionChanged="Details_Changed"/>
<UniformGrid Columns="3" Margin="0,6,0,14">
<Button x:Name="BatRunsTile" Content="RUNS" Tag="0" Click="Source_Click" Style="{StaticResource ToolBtn}" Height="52" MinHeight="0" Margin="4"/>
<Button x:Name="ByesTile" Content="BYES" Tag="1" Click="Source_Click" Style="{StaticResource ToolBtn}" Height="52" MinHeight="0" Margin="4"/>
<Button x:Name="LegByesTile" Content="LEG BYES" Tag="2" Click="Source_Click" Style="{StaticResource ToolBtn}" Height="52" MinHeight="0" Margin="4"/>
</UniformGrid>
                </StackPanel>
                <StackPanel x:Name="RunOptions"><TextBlock x:Name="RunsLabel" Text="RUNS" Style="{StaticResource FieldTitle}"/>
                    <UniformGrid x:Name="RunsTiles" Columns="4" Margin="0,6,0,8">
<Button Content="0" Tag="0" Click="RunsTile_Click" Style="{StaticResource ToolBtn}" Height="48" MinHeight="0" Margin="4"/>
<Button Content="1" Tag="1" Click="RunsTile_Click" Style="{StaticResource ToolBtn}" Height="48" MinHeight="0" Margin="4"/>
<Button Content="2" Tag="2" Click="RunsTile_Click" Style="{StaticResource ToolBtn}" Height="48" MinHeight="0" Margin="4"/>
<Button Content="3" Tag="3" Click="RunsTile_Click" Style="{StaticResource ToolBtn}" Height="48" MinHeight="0" Margin="4"/>
<Button Content="4" Tag="4" Click="RunsTile_Click" Style="{StaticResource ToolBtn}" Height="48" MinHeight="0" Margin="4"/>
<Button Content="5" Tag="5" Click="RunsTile_Click" Style="{StaticResource ToolBtn}" Height="48" MinHeight="0" Margin="4"/>
<Button Content="6" Tag="6" Click="RunsTile_Click" Style="{StaticResource ToolBtn}" Height="48" MinHeight="0" Margin="4"/>
<Button x:Name="CustomRunsButton" Content="CUSTOM" Click="CustomRuns_Click" Style="{StaticResource ToolBtn}" Height="48" MinHeight="0" Margin="4"/>
</UniformGrid>
<TextBox x:Name="RunsBox" Visibility="Collapsed" Text="0" MaxLength="3" Margin="0,5,0,5" TextChanged="Runs_Changed"/>
                    <TextBlock x:Name="RunExplanation" Foreground="#B6B6C0" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>
                </StackPanel>
                <StackPanel x:Name="ActorOptions">
                    <TextBlock Text="BATTER ON STRIKE" Style="{StaticResource FieldTitle}"/><ComboBox x:Name="BatterChoice" Visibility="Collapsed" SelectionChanged="Batter_Changed"/><WrapPanel x:Name="BatterTiles" Margin="0,6,0,14"/>
                    <TextBlock Text="BOWLER" Style="{StaticResource FieldTitle}"/><ComboBox x:Name="BowlerChoice" SelectionChanged="Details_Changed"/><WrapPanel x:Name="BowlerTiles" Visibility="Collapsed" Margin="0,6,0,14"/>
                </StackPanel>
                <StackPanel x:Name="CorrectionOptions" Visibility="Collapsed">
                    <TextBlock Text="UPDATE STRIKE FOR LATER BALLS?" Style="{StaticResource FieldTitle}"/>
                    <ComboBox x:Name="ScopeChoice" SelectionChanged="Details_Changed"/>
                    <CheckBox x:Name="RestOfOverBowler" Content="Apply bowler to the rest of this over" Style="{StaticResource SettingsToggle}" Margin="0,0,0,12"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="EntryFooter" Grid.Row="2"><Border CornerRadius="18" x:Name="PreviewPanel" Background="#222226" BorderBrush="#44444B" BorderThickness="1" Padding="14,10" Margin="0,10,0,10"><TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="18" FontWeight="Bold"/></Border><TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#FFB1B1" TextWrapping="Wrap" Margin="0,6"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Content="CANCEL" Click="Cancel_Click" Height="48" MinHeight="0" Padding="12,0" Style="{StaticResource ToolBtn}"/>
                <Button x:Name="ApplyButton" Foreground="White" Grid.Column="2" Content="APPLY CORRECTION" Height="48" MinHeight="0" Padding="12,0" Style="{StaticResource PrimaryCommandButton}" Click="Apply_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
