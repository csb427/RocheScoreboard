<Window x:Class="Roche_Scoreboard.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:design="clr-namespace:Roche_Scoreboard.Services" design:OperatorDesign.IsEnabled="True"
        Title="Roche Scoreboard update"
        Width="680" Height="560" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="False" Background="#09090B" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="30"/></shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/ControlCentre.xaml"/></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="PanelBrush" Color="#19191C"/>
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#29292D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#44444B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#B6B6C0"/>
        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource ControlCentre.Button}">
            <Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ControlCentre.PrimaryButton}">
            <Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="UpdateProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/><Setter Property="Foreground" Value="#4EA3FF"/>
            <Setter Property="Background" Value="#111113"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary></Window.Resources>

    <glass:OperatorGlassSurface x:Name="DialogShell" Material="Regular" GlassSource="{Binding Owner.Content, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="#68FFFFFF" BorderThickness="1" CornerRadius="30">
        <Grid Margin="24,20,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SOFTWARE UPDATE" Foreground="#69B7FF" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="A newer scoreboard is ready" Foreground="#F7FAFC" FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Download, verify and restart without changing your saved matches or preferences."
                               Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource DialogButton}" Width="42" Height="42"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Padding="0" Content="×" FontSize="23" ToolTip="Remind me later" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#19191C" BorderBrush="#44444B" BorderThickness="1" CornerRadius="16" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="INSTALLED" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentVersionText" Text="4.1.2" Foreground="#C8D5E3" FontFamily="Segoe UI Variable, Segoe UI" FontSize="24" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="1" Text="→" Foreground="#69B7FF" FontSize="25" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#29292D" BorderBrush="#4EA3FF" BorderThickness="1" CornerRadius="16" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="AVAILABLE" Foreground="#9CCBFF" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="NewVersionText" Text="4.1.3" Foreground="#F7FAFC" FontFamily="Segoe UI Variable, Segoe UI" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#10261F" BorderBrush="#2A6A50" BorderThickness="1" CornerRadius="12" Padding="9,5">
                    <TextBlock x:Name="IntegrityText" Text="SHA-256 verified" Foreground="#83E0AE" FontSize="13" FontWeight="SemiBold"/>
                </Border>
                <Border Grid.Column="2" Background="#19191C" BorderBrush="#44444B" BorderThickness="1" CornerRadius="12" Padding="9,5">
                    <TextBlock x:Name="PackageSizeText" Text="Windows x64 package" Foreground="#C8D5E3" FontSize="13" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Border Grid.Row="3" Margin="0,14,0,0" Background="#19191C" BorderBrush="#3D3D44" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Background="#242428">
                        <TextBlock Text="RELEASE NOTES" Foreground="#9CCBFF" FontSize="12" FontWeight="Bold" Margin="14,9"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
                        <TextBlock x:Name="ReleaseNotesText" Foreground="#D5E0EB" FontSize="15" LineHeight="19"
                                   TextWrapping="Wrap" Text="Stability and usability improvements."/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="ProgressPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,14,0,0"
                    Background="#19191C" BorderBrush="#44444B" BorderThickness="1" CornerRadius="16" Padding="14,11">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressText" Text="Preparing update…" Foreground="#F7FAFC" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="0%" Foreground="#9CCBFF" FontFamily="Segoe UI Variable, Segoe UI" FontWeight="Bold"/>
                    </Grid>
                    <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0"
                                 Style="{StaticResource UpdateProgressStyle}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ProgressDetailText" Text="Nothing has been installed yet."
                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="5" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ViewReleaseButton" Grid.Column="0" Style="{StaticResource DialogButton}"
                        Content="View release" MinWidth="120" Click="ViewRelease_Click"/>
                <Button x:Name="SkipButton" Grid.Column="2" Style="{StaticResource DialogButton}"
                        Content="Remind me later" Click="Skip_Click" IsCancel="True"/>
                <Button x:Name="UpdateButton" Grid.Column="4" Style="{StaticResource PrimaryButton}"
                        Content="Download and restart  →" MinWidth="205" Click="Update_Click" IsDefault="True"/>
            </Grid>
        </Grid>
    </glass:OperatorGlassSurface>
</Window>
