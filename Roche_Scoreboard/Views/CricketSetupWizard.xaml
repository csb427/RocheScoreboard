                                                <TextBlock Text="▣" FontSize="28" FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="SemiBold" Foreground="#67D17B" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Ticker messages" FontSize="20" FontWeight="SemiBold" Foreground="#3FB950" HorizontalAlignment="Center" />
                                                <TextBlock Text="Scroll across the bottom bar during the game" FontSize="12" FontWeight="SemiBold" Foreground="#2A6030" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border Grid.Row="1" Height="1" Margin="0,0,0,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#003FB950" Offset="0" />
                                                        <GradientStop Color="#303FB950" Offset="0.5" />
                                                        <GradientStop Color="#003FB950" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Grid.Row="2" Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" Padding="8" CornerRadius="16">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="SetupMessageList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#111113" BorderBrush="#3A3A40" BorderThickness="1" Padding="8,6" Margin="0,0,0,6" CornerRadius="3">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Border Grid.Row="0" Grid.ColumnSpan="4" CornerRadius="2" Padding="6,3" Margin="0,0,0,4" Background="{Binding HighlightBrush}">
                                                                            <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding TextBrush}" />
                                                                        </Border>
                                                                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Background="#060A10" Foreground="#E6EDF3" BorderBrush="#3A3A40" CaretBrush="White" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                                                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="TEXT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                            <Button Width="34" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickItemTextColor_Click" Tag="{Binding}" ToolTip="Click to choose text colour" Background="{Binding TextBrush}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="HIGHLIGHT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                                            <Button Width="50" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickItemHighlightColor_Click" Tag="{Binding}" ToolTip="Click to choose highlight colour. Right-click to clear." MouseRightButtonUp="SetupClearItemHighlightColor_Click" Background="{Binding HighlightBrush}" />
                                                                        </StackPanel>
                                                                        <Button Grid.Row="1" Grid.Column="3" Content="✕" Width="30" Height="40" FontSize="12" FontWeight="SemiBold" Click="SetupRemoveMessageItem_Click" Tag="{Binding}" Background="#3A1A1A" Foreground="#E6EDF3" BorderBrush="#3A1A1A" VerticalAlignment="Bottom" ToolTip="Remove this message" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="SetupNewMessageBox" Style="{StaticResource WizardField}" Margin="0,0,6,0" KeyDown="SetupNewMessageBox_KeyDown" />
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="TEXT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                    <Button x:Name="SetupNewMessageTextColorBtn" Width="34" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickNewTextColor_Click" ToolTip="Choose text colour for new messages" Background="White" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="HIGHLIGHT" FontSize="12" FontWeight="Bold" Foreground="#6E7B8A" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                                    <Button x:Name="SetupNewMessageHighlightColorBtn" Width="50" Height="22" Padding="0" BorderBrush="#3A3A40" BorderThickness="1" Click="SetupPickNewHighlightColor_Click" MouseRightButtonUp="SetupClearNewHighlightColor_Click" ToolTip="Choose highlight colour. Right-click to clear." Background="Transparent" />
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="Add" Height="30" Click="SetupAddMessage_Click" Style="{StaticResource SmallBtn}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </layout:OperatorGlassSurface>
                            </StackPanel>
                            <Grid Visibility="Collapsed" IsHitTestVisible="False">
                                <Grid>
                                    <Border x:Name="MsgGlow" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.2" RadiusX="0.5" RadiusY="0.4">
                                                <GradientStop Color="#203FB950" Offset="0" />
                                                <GradientStop Color="#083FB950" Offset="0.6" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#00000000" Offset="0.3" />
                                                <GradientStop Color="#30000000" Offset="1.0" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Margin="0,10,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1" layout:WizardPair.MinimumColumnWidth="330">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" CornerRadius="16">
                                                <Grid>
                                                    <Border x:Name="WeatherGlowBg" Opacity="0.08" IsHitTestVisible="False" Visibility="Collapsed">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="0.5,0.4" RadiusX="0.5" RadiusY="0.5">
                                                                <GradientStop Color="#58A6FF" Offset="0" />
                                                                <GradientStop Color="#00000000" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="☁" FontFamily="Segoe UI Symbol" Foreground="#8CCBFF" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect Color="#58A6FF" BlurRadius="0" ShadowDepth="0" Opacity="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="LIVE WEATHER" FontSize="22" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Location for real-time conditions" FontSize="10" FontWeight="SemiBold" Foreground="#3A6090" HorizontalAlignment="Center" Margin="0,6,0,14" />
                                                        <Border Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" MinWidth="260" Padding="4" CornerRadius="16">
                                            </Border>
                                                        <TextBlock Text="TOSS RESULT (OPTIONAL)" Visibility="Collapsed" FontSize="13" FontWeight="Bold" Foreground="#9CCBFF" Margin="0,18,0,6" />
                                                        <ComboBox x:Name="TossWinnerChoice" Visibility="Collapsed" Style="{StaticResource DarkCombo}" SelectedIndex="0" MinWidth="260">
                                                            <ComboBoxItem Content="Not recorded" />
                                                            <ComboBoxItem Content="Home team won" />
                                                            <ComboBoxItem Content="Away team won" />
                                                        </ComboBox>
                                                        <ComboBox x:Name="TossDecisionChoice" Visibility="Collapsed" Style="{StaticResource DarkCombo}" SelectedIndex="0" MinWidth="260" Margin="0,8,0,0">
                                                            <ComboBoxItem Content="Elected to bat" />
                                                            <ComboBoxItem Content="Elected to bowl" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Visibility="Collapsed" IsHitTestVisible="False">
                    <Border Opacity="0.006" IsHitTestVisible="False">
                        <Border.Background>
                            <VisualBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute" Viewbox="0,0,40,40" ViewboxUnits="Absolute">
                                <VisualBrush.Visual>
                                    <Canvas Width="40" Height="40">
                                        <Line X1="0" Y1="40" X2="40" Y2="0" Stroke="White" StrokeThickness="1" />
                                    </Canvas>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="BgGlow" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.3" RadiusX="0.7" RadiusY="0.7">
                                <GradientStop Color="#2058A6FF" Offset="0" />
                                <GradientStop Color="#0858A6FF" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border ClipToBounds="True" IsHitTestVisible="False" Opacity="0.04">
                        <Border Width="200" HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="BeamTranslate" X="-300" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#30FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse Width="6" Height="6" Fill="#1858A6FF" Canvas.Left="60" Canvas.Top="80">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" Fill="#1258A6FF" Canvas.Left="180" Canvas.Top="200">
                            <Ellipse.Effect>
                                <BlurEffect Radius="4" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="#2058A6FF" Canvas.Left="300" Canvas.Top="120">
                            <Ellipse.Effect>
                                <BlurEffect Radius="2" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="#1558A6FF" Canvas.Left="420" Canvas.Top="350">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="5" Height="5" Fill="#1858A6FF" Canvas.Left="550" Canvas.Top="50">
                            <Ellipse.Effect>
                                <BlurEffect Radius="2" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="7" Height="7" Fill="#10FF6B6B" Canvas.Left="650" Canvas.Top="280">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="9" Height="9" Fill="#10FF6B6B" Canvas.Left="750" Canvas.Top="100">
                            <Ellipse.Effect>
                                <BlurEffect Radius="4" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#00000000" Offset="0.3" />
                                <GradientStop Color="#60000000" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Viewbox VerticalAlignment="Top" Margin="12,78,12,0" Panel.ZIndex="11" Stretch="Uniform" StretchDirection="DownOnly" Height="36">
        </Viewbox>
                    <Border x:Name="BottomAccent" VerticalAlignment="Bottom" Height="3" Panel.ZIndex="11" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#58A6FF" Offset="0" />
                                <GradientStop Color="#1AFFFFFF" Offset="0.5" />
                                <GradientStop Color="#FF6B6B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="FlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="20" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </layout:WizardViewport>
        <layout:OperatorGlassSurface x:Name="HeaderPanel" Material="Regular" CornerRadius="28" Margin="16,12,16,8" Padding="14,10" Opacity="1" Grid.Row="0" MaxWidth="1440">
            <Border.RenderTransform>
                <TranslateTransform x:Name="HeaderTranslate" Y="-30" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <motion:OperatorSymbol Kind="cricket" Width="28" Height="28" Foreground="{DynamicResource ControlCentre.TextBrush}" Margin="0,0,12,0" />
                    <TextBlock x:Name="HeaderTitle" Text="Set up cricket" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center" Grid.Column="1" />
                    <TextBlock Text="1 of 4" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" x:Name="WizardStepCounter" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
                <layout:OperatorSegmentedPanel x:Name="StepIndicator" Rows="1" Grid.Row="1" Height="62" Margin="0,8,0,0" Opacity="1">
                    <layout:OperatorSegmentedPanel.RenderTransform>
                        <TranslateTransform x:Name="StepIndicatorTranslate" Y="-20" />
                    </layout:OperatorSegmentedPanel.RenderTransform>
                    <RadioButton x:Name="SportStepNavigation" Visibility="Collapsed" Click="GoToSportStep_Click" GroupName="UnifiedSetupStepsCricketSetupWizard" Style="{StaticResource SettingsSegment}" Padding="4,6" MinHeight="0" Height="60" ToolTip="Choose AFL (footy) or cricket"><StackPanel VerticalAlignment="Center"><motion:OperatorSymbol Kind="sport" Width="23" Height="23" Margin="0,0,0,3" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Sport" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                    <RadioButton x:Name="Step1Navigation" Click="GoToStep1_Click" GroupName="WizardSteps" Style="{StaticResource SettingsSegment}" Padding="4,6" MinHeight="0" Height="60" ToolTip="Go to teams">
                        <StackPanel VerticalAlignment="Center">
                            <motion:OperatorSymbol Kind="team" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step1Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step1Label" Text="Teams" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step1Dot" Width="36" Height="36" CornerRadius="18" Background="#58A6FF" BorderBrush="#58A6FF" BorderThickness="2" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="Step1Glow" Color="#58A6FF" BlurRadius="0" ShadowDepth="0" Opacity="0" />
                                </Border.Effect>
                                <TextBlock Text="1" Foreground="{DynamicResource ControlCentre.TextBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Step2Navigation" Click="GoToStep2_Click" GroupName="WizardSteps" Style="{StaticResource SettingsSegment}" Padding="4,6" MinHeight="0" Height="60" ToolTip="Go to players">
                        <StackPanel VerticalAlignment="Center">
                            <motion:OperatorSymbol Kind="players" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step2Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step2Label" Text="Players" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step2Dot" Width="36" Height="36" CornerRadius="18" Background="#242427" BorderBrush="#3A3A40" BorderThickness="2" Visibility="Collapsed">
                                <TextBlock Text="2" Foreground="#8E8E98" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Step3Navigation" Click="GoToStep3_Click" GroupName="WizardSteps" Style="{StaticResource SettingsSegment}" Padding="4,6" MinHeight="0" Height="60" ToolTip="Go to format">
                        <StackPanel VerticalAlignment="Center">
                            <motion:OperatorSymbol Kind="format" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step3Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step3Label" Text="Format" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step3Dot" Width="36" Height="36" CornerRadius="18" Background="#242427" BorderBrush="#3A3A40" BorderThickness="2" Visibility="Collapsed">
                                <TextBlock Text="3" Foreground="#8E8E98" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Step4Navigation" Click="GoToStep4_Click" GroupName="WizardSteps" Style="{StaticResource SettingsSegment}" Padding="4,6" MinHeight="0" Height="60" ToolTip="Go to options">
                        <StackPanel VerticalAlignment="Center">
                            <motion:OperatorSymbol Kind="sliders" Width="23" Height="23" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" x:Name="Step4Symbol" Margin="0,0,0,3" />
                            <TextBlock x:Name="Step4Label" Text="Options" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border x:Name="Step4Dot" Width="36" Height="36" CornerRadius="18" Background="#242427" BorderBrush="#3A3A40" BorderThickness="2" Visibility="Collapsed">
                                <TextBlock Text="4" Foreground="#8E8E98" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </layout:OperatorSegmentedPanel>
            </Grid>
        </layout:OperatorGlassSurface>
        <layout:OperatorGlassSurface Material="Regular" CornerRadius="26" Padding="8,4" Margin="16,6,16,12" MaxWidth="680" Grid.Row="2">
            <Grid x:Name="NavBar" Grid.Row="0" Height="52" Panel.ZIndex="10" Opacity="1" Margin="0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="NavBarTranslate" Y="30" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Cursor="Hand" Visibility="Collapsed" Click="Back_Click" RenderTransformOrigin="0.5,0.5" Padding="12,0" MinWidth="0" Height="44" VerticalAlignment="Center" Style="{StaticResource ToolBtn}" MinHeight="0">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="BackBtnScale" />
                    </Button.RenderTransform>
                    <TextBlock Text="Back" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="CancelSetupButton" Grid.Column="1" Visibility="Collapsed" Content="Cancel" Click="CancelSetup_Click" Style="{StaticResource ToolBtn}" Height="44" MinWidth="0" MinHeight="0" Padding="8,0" Margin="6,0" AutomationProperties.Name="Cancel setup and return to Home"/>
                <Button x:Name="NextButton" Grid.Column="2" Cursor="Hand" Click="Next_Click" RenderTransformOrigin="0.5,0.5" Padding="12,0" MinWidth="0" Height="44" VerticalAlignment="Center" Style="{StaticResource PrimaryCommandButton}" MinHeight="0">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="NextBtnScale" />
                    </Button.RenderTransform>
                    <TextBlock x:Name="NextButtonText" Text="NEXT →" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </layout:OperatorGlassSurface>
    </Grid>
</UserControl>
