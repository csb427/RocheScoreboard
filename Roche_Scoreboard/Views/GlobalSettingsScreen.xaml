<UserControl x:Class="Roche_Scoreboard.Views.GlobalSettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#080C12">
    <Grid>
        <Border Opacity="0.08" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.25" RadiusX="0.65" RadiusY="0.6">
                    <GradientStop Color="#58A6FF" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="GLOBAL SETTINGS" FontSize="30" FontWeight="Black" Foreground="#E6EDF3"/>
                <TextBlock Text="Choose app-wide settings that apply across sports." Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#B1BAC4"/>
            </StackPanel>

            <UniformGrid Grid.Row="2" Rows="2" Columns="3" Margin="0,2,0,0">
                <Button Content="KEYBINDS" Tag="keybinds" Margin="6" Height="96" FontSize="16" FontWeight="Black" Click="CategoryButton_Click" Background="#171D26" Foreground="#E6EDF3" BorderBrush="#A78BFA" BorderThickness="1.5"/>
                <Button Content="APPEARANCE" Tag="display" Margin="6" Height="96" FontSize="16" FontWeight="Black" Click="CategoryButton_Click" Background="#171D26" Foreground="#E6EDF3" BorderBrush="#58A6FF" BorderThickness="1.5"/>
                <Button Content="OVERLAYS" Tag="overlays" Margin="6" Height="96" FontSize="16" FontWeight="Black" Click="CategoryButton_Click" Background="#171D26" Foreground="#E6EDF3" BorderBrush="#58A6FF" BorderThickness="1.5"/>
                <Button Content="MEDIA" Tag="media" Margin="6" Height="96" FontSize="16" FontWeight="Black" Click="CategoryButton_Click" Background="#171D26" Foreground="#E6EDF3" BorderBrush="#58A6FF" BorderThickness="1.5"/>
                <Button Content="ADVANCED" Tag="advanced" Margin="6" Height="96" FontSize="16" FontWeight="Black" Click="CategoryButton_Click" Background="#171D26" Foreground="#E6EDF3" BorderBrush="#58A6FF" BorderThickness="1.5"/>
            </UniformGrid>

            <Border Grid.Row="3" Margin="6,14,6,0" Padding="14,12" Background="#121A24" BorderBrush="#2F3F52" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SMART STARTUP" FontSize="12" FontWeight="Black" Foreground="#58A6FF" VerticalAlignment="Center"/>
                    <ComboBox x:Name="StartupModeCombo" Grid.Column="2" SelectionChanged="StartupModeCombo_SelectionChanged" Background="#0B1320" Foreground="#E6EDF3" BorderBrush="#2F3F52" BorderThickness="1" Padding="8,4" MinWidth="320"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                <Button Content="← Back to Sports" Width="180" Height="36" FontWeight="Bold" Click="BackButton_Click" Background="#1A2330" Foreground="#E6EDF3" BorderBrush="#2F3F52" BorderThickness="1"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>