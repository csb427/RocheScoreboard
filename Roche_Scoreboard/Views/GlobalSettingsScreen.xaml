<UserControl x:Class="Roche_Scoreboard.Views.GlobalSettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#080C12">
    <UserControl.Resources>
        <Style x:Key="SettingsLaunchButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF2FC"/>
            <Setter Property="Background" Value="#131D2B"/>
            <Setter Property="BorderBrush" Value="#38506A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="11" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter/>
                                <Border x:Name="Flash" Background="#3258A6FF" Opacity="0" IsHitTestVisible="False" CornerRadius="9"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#1B2B40"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#75B7FF"/>
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value><DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#58A6FF" Opacity="0.34"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#0B111B"/>
                                <Setter TargetName="Flash" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FFF0A8"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border Opacity="0.18" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.25" RadiusX="0.65" RadiusY="0.6">
                    <GradientStop Color="#58A6FF" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="48,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="22,18" CornerRadius="12" BorderBrush="#31445C" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18263A" Offset="0"/>
                        <GradientStop Color="#101823" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="GLOBAL SETTINGS" FontSize="30" FontWeight="Black" Foreground="#F2F7FD"/>
                    <TextBlock Text="App-wide preferences and shortcuts that stay consistent across every sport." Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#AABBD0"/>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="2" Rows="1" Columns="5" Margin="-6,2,-6,0">
                <Button Tag="keybinds" Margin="6" Click="CategoryButton_Click" Style="{StaticResource SettingsLaunchButton}" BorderBrush="#A78BFA">
                    <StackPanel><TextBlock Text="⌨  KEYBINDS" FontSize="17" FontWeight="Black"/><TextBlock Text="Scoring and clock shortcuts" Foreground="#9EACC0" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                </Button>
                <Button Tag="display" Margin="6" Click="CategoryButton_Click" Style="{StaticResource SettingsLaunchButton}" BorderBrush="#58A6FF">
                    <StackPanel><TextBlock Text="◫  APPEARANCE" FontSize="17" FontWeight="Black"/><TextBlock Text="Layouts, themes and animations" Foreground="#9EACC0" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                </Button>
                <Button Tag="overlays" Margin="6" Click="CategoryButton_Click" Style="{StaticResource SettingsLaunchButton}" BorderBrush="#3FB950">
                    <StackPanel><TextBlock Text="✦  OVERLAYS" FontSize="17" FontWeight="Black"/><TextBlock Text="Automatic match storytelling" Foreground="#9EACC0" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                </Button>
                <Button Tag="media" Margin="6" Click="CategoryButton_Click" Style="{StaticResource SettingsLaunchButton}" BorderBrush="#22D3EE">
                    <StackPanel><TextBlock Text="▶  MEDIA" FontSize="17" FontWeight="Black"/><TextBlock Text="Logos, crops and video" Foreground="#9EACC0" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                </Button>
                <Button Tag="advanced" Margin="6" Click="CategoryButton_Click" Style="{StaticResource SettingsLaunchButton}" BorderBrush="#8B949E">
                    <StackPanel><TextBlock Text="⚙  ADVANCED" FontSize="17" FontWeight="Black"/><TextBlock Text="Windows, cloud and recovery" Foreground="#9EACC0" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                </Button>
            </UniformGrid>

            <Border Grid.Row="3" Margin="0,16,0,0" Padding="18,15" Background="#111C29" BorderBrush="#3A5068" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SMART STARTUP" FontSize="12" FontWeight="Black" Foreground="#58A6FF" VerticalAlignment="Center"/>
                    <ComboBox x:Name="StartupModeCombo" Grid.Column="2" SelectionChanged="StartupModeCombo_SelectionChanged" Background="#0B1320" Foreground="#E6EDF3" BorderBrush="#2F3F52" BorderThickness="1" Padding="8,4" MinWidth="320"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                <Button Content="←  Back to sports" Width="190" Height="42" FontWeight="Bold" Click="BackButton_Click" Style="{StaticResource SettingsLaunchButton}" Padding="12,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
