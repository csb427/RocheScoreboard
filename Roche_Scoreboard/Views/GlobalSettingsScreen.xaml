<UserControl x:Class="Roche_Scoreboard.Views.GlobalSettingsScreen"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Roche_Scoreboard.Views" xmlns:motion="clr-namespace:Roche_Scoreboard.Services"
 Background="Transparent" SizeChanged="Settings_SizeChanged" motion:OperatorDesign.IsEnabled="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Resources/OperatorControls.xaml"/><ResourceDictionary Source="../Resources/SettingsControls.xaml"/><ResourceDictionary Source="../Resources/ControlCentre.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsChoice}"/>
 <Style TargetType="TextBox" BasedOn="{StaticResource SettingsInput}"/>
 <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsToggle}"/>
 <Style x:Key="GlobalSettingsCard" TargetType="Border" BasedOn="{StaticResource SettingsSectionSurface}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,20"/><Setter Property="CornerRadius" Value="22"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style x:Key="PreferenceName" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource ControlCentre.BodySize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource ControlCentre.TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="PreferenceDetail" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource ControlCentre.CaptionSize}"/><Setter Property="Foreground" Value="{DynamicResource ControlCentre.SecondaryTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,18,0"/></Style>
 <Style x:Key="GroupCaption" TargetType="TextBlock" BasedOn="{StaticResource PreferenceName}"><Setter Property="FontSize" Value="19"/><Setter Property="Margin" Value="20,18,20,10"/></Style>
 <Style x:Key="PreferenceDivider" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Margin" Value="20,0"/><Setter Property="Background" Value="{DynamicResource ControlCentre.BorderBrush}"/><Setter Property="Opacity" Value=".45"/></Style>
 <Style x:Key="SettingsLaunchButton" TargetType="Button" BasedOn="{StaticResource ControlCentre.Button}"/>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <local:OperatorGlassSurface Material="Regular" CornerRadius="24" Padding="4" Margin="18,12,18,0" MaxWidth="560" HorizontalAlignment="Stretch"><local:OperatorSegmentedPanel Rows="1" AllowScrubbing="True">
  <RadioButton x:Name="GeneralSettingsTab" Content="General" Tag="general" GroupName="SettingsScope" Style="{StaticResource SettingsSegment}" IsChecked="True" Checked="SettingsScope_Checked"/>
  <RadioButton x:Name="CricketSettingsScopeTab" Content="Cricket" Tag="cricket" GroupName="SettingsScope" Style="{StaticResource SettingsSegment}" Checked="SettingsScope_Checked"/>
  <RadioButton x:Name="AflSettingsTab" Content="AFL" Tag="afl" GroupName="SettingsScope" Style="{StaticResource SettingsSegment}" Checked="SettingsScope_Checked"/>
 </local:OperatorSegmentedPanel></local:OperatorGlassSurface>
 <local:SettingsWorkspace x:Name="SettingsWorkspace" Grid.Row="1" Heading="Settings" Subtitle="Set up the operator interface and shared output defaults.">
  <Border x:Name="AppearanceSection" Tag="APPEARANCE|theme light dark density compact comfortable" Style="{StaticResource GlobalSettingsCard}"><StackPanel>
   <TextBlock Text="Appearance" Style="{StaticResource GroupCaption}"/>
   <Grid x:Name="AppearanceFieldsGrid" Margin="20,12,20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Interface theme" Style="{StaticResource PreferenceName}"/><TextBlock Text="Choose how the control panel looks." Style="{StaticResource PreferenceDetail}"/></StackPanel>
    <local:OperatorGlassSurface x:Name="ThemeChoicePanel" Grid.Column="1" Material="Regular" CornerRadius="22" Padding="4" Width="270"><local:OperatorSegmentedPanel Rows="1" AllowScrubbing="True"><RadioButton x:Name="LightThemeTile" AutomationProperties.Name="Light" Tag="theme:0" GroupName="AppTheme" Style="{StaticResource SettingsSegment}" Checked="PreferenceTile_Checked"><StackPanel Orientation="Horizontal"><motion:OperatorSymbol Kind="light" Width="18" Height="18" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Light" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton x:Name="DarkThemeTile" AutomationProperties.Name="Dark" Tag="theme:1" GroupName="AppTheme" Style="{StaticResource SettingsSegment}" Checked="PreferenceTile_Checked"><StackPanel Orientation="Horizontal"><motion:OperatorSymbol Kind="dark" Width="18" Height="18" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Dark" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/></StackPanel></RadioButton></local:OperatorSegmentedPanel></local:OperatorGlassSurface>
   </Grid><Border Style="{StaticResource PreferenceDivider}"/>
   <Grid x:Name="DensityFieldPanel" Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Interface density" Style="{StaticResource PreferenceName}"/><TextBlock Text="Change text size and control spacing together." Style="{StaticResource PreferenceDetail}"/></StackPanel>
    <local:OperatorGlassSurface x:Name="DensityChoicePanel" Grid.Column="1" Material="Regular" CornerRadius="22" Padding="4" Width="270"><local:OperatorSegmentedPanel Rows="1" AllowScrubbing="True"><RadioButton x:Name="ComfortableTile" AutomationProperties.Name="Comfortable" Tag="density:0" GroupName="Density" Style="{StaticResource SettingsSegment}" Checked="PreferenceTile_Checked"><StackPanel Orientation="Horizontal"><motion:OperatorSymbol Kind="comfortable" Width="18" Height="18" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Comfortable" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton x:Name="CompactTile" AutomationProperties.Name="Compact" Tag="density:1" GroupName="Density" Style="{StaticResource SettingsSegment}" Checked="PreferenceTile_Checked"><StackPanel Orientation="Horizontal"><motion:OperatorSymbol Kind="compact" Width="18" Height="18" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Compact" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/></StackPanel></RadioButton></local:OperatorSegmentedPanel></local:OperatorGlassSurface>
   </Grid>
   <ComboBox Visibility="Collapsed" x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged"/><ComboBox Visibility="Collapsed" x:Name="DensityCombo" SelectionChanged="DensityCombo_SelectionChanged"/>
  </StackPanel></Border>
  <Border Tag="APPEARANCE|glass material transparency motion animations accessibility" Style="{StaticResource GlobalSettingsCard}"><StackPanel>
   <TextBlock Text="Materials &amp; motion" Style="{StaticResource GroupCaption}"/>
   <Grid Margin="20,12,20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><motion:OperatorSymbol Kind="display" Width="26" Height="26" Foreground="#87CAFF" IsActive="{Binding IsChecked, ElementName=GlassMaterialToggle}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Liquid glass" Style="{StaticResource PreferenceName}"/><TextBlock Text="Depth, lens highlights and translucent navigation. Turn off for solid surfaces." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="GlassMaterialToggle" Grid.Column="2" Width="60" Content="" AutomationProperties.Name="Liquid glass operator surfaces" Checked="InteractionPreference_Changed" Unchecked="InteractionPreference_Changed"/></Grid>
   <Border Style="{StaticResource PreferenceDivider}"/>
   <Grid Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><motion:OperatorSymbol Kind="automation" Width="25" Height="25" Foreground="#E6BE73" IsActive="{Binding IsChecked, ElementName=ReducedMotionToggle}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Reduce motion" Style="{StaticResource PreferenceName}"/><TextBlock Text="Keep clear selection feedback with less movement. Also respects Windows accessibility settings." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="ReducedMotionToggle" Grid.Column="2" Width="60" Content="" AutomationProperties.Name="Reduce operator interface motion" Checked="InteractionPreference_Changed" Unchecked="InteractionPreference_Changed"/></Grid>
  </StackPanel></Border>
  <Border Tag="CONTROLS|navigation hints shortcuts volunteers" Style="{StaticResource GlobalSettingsCard}"><Grid Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Navigation hints" Style="{StaticResource PreferenceName}"/><TextBlock Text="Show guidance for setup and common match actions." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="QuickHintsToggle" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Show navigation hints" VerticalAlignment="Center" Checked="QuickHintsToggle_Changed" Unchecked="QuickHintsToggle_Changed"/></Grid></Border>
  <Border x:Name="OutputDefaultsSection" Tag="SCOREBOARD|output dimensions width height reset" Style="{StaticResource GlobalSettingsCard}"><StackPanel>
   <TextBlock Text="Output defaults" Style="{StaticResource GroupCaption}"/>
   <Grid x:Name="OutputFieldsGrid" Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Window dimensions" Style="{StaticResource PreferenceName}"/><TextBlock Text="Shared across AFL, cricket and training. Values are in pixels." Style="{StaticResource PreferenceDetail}"/></StackPanel>
    <StackPanel x:Name="OutputDimensionsFieldPanel" Grid.Column="1" Width="270">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
      <TextBox x:Name="OutputWidthBox" Text="386" MaxLength="4" AutomationProperties.Name="Output width in pixels" AutomationProperties.HelpText="Enter a whole width from 50 to 7680 pixels. Apply commits both dimensions." Padding="10,8"/>
      <TextBlock Grid.Column="1" Text="×" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <TextBox x:Name="OutputHeightBox" Grid.Column="2" Text="193" MaxLength="4" AutomationProperties.Name="Output height in pixels" AutomationProperties.HelpText="Enter a whole height from 50 to 4320 pixels. Apply commits both dimensions." Padding="10,8"/>
      <Button Grid.Column="3" Content="Apply" Margin="8,0,0,0" Padding="10,8" Click="ApplyOutputDimensions_Click" Style="{StaticResource ControlCentre.PrimaryButton}"/>
     </Grid>
     <TextBlock x:Name="OutputDimensionsValidationText" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="{DynamicResource ControlCentre.CaptionSize}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <WrapPanel Margin="0,10,0,0"><Button Content="2× preview" Click="DoubleOutputDimensions_Click" Style="{StaticResource SettingsLaunchButton}" FontSize="13" Margin="0,0,8,0" Padding="12,8"/><Button Content="Reset dimensions" Click="ResetOutputDimensions_Click" Style="{StaticResource SettingsLaunchButton}" FontSize="13" Padding="12,8"/></WrapPanel>
    </StackPanel>
   </Grid>
  </StackPanel></Border>
  <Border Tag="SCOREBOARD|screensaver idle custom image video mp4 clock time" Style="{StaticResource GlobalSettingsCard}"><StackPanel><TextBlock Text="Between matches" Style="{StaticResource GroupCaption}"/>
   <Grid Margin="20,12,20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Idle screensaver" Style="{StaticResource PreferenceName}"/><TextBlock Text="Use the output display when no match is active." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="ScreensaverToggle" Style="{StaticResource SettingsPower}" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Idle screensaver" Checked="ScreensaverToggle_Changed" Unchecked="ScreensaverToggle_Changed"/></Grid><Border Style="{StaticResource PreferenceDivider}"/>
   <Grid Margin="16,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="BuiltinScreensaverButton" Tag="builtin" Click="ScreensaverSource_Click" Style="{StaticResource OperatorPresentationButton}" Margin="4" Padding="16"><StackPanel><motion:OperatorSymbol Kind="display" Width="26" Height="26" Foreground="#8BC7FF" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="Sports scene" FontSize="16" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Built-in movement" FontSize="13" Foreground="#B6B6C0" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="BuiltinScreensaverSelected" Text="✓ ACTIVE" Foreground="#82EDAF" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Button>
    <Button x:Name="CustomScreensaverButton" Grid.Column="1" Tag="custom" Click="ScreensaverSource_Click" Style="{StaticResource OperatorPresentationButton}" Margin="4" Padding="16"><StackPanel><motion:OperatorSymbol Kind="media" Width="26" Height="26" Foreground="#B59AFF" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="Your media" FontSize="16" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Image or MP4" FontSize="13" Foreground="#B6B6C0" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="CustomScreensaverSelected" Text="SELECT FILE →" Foreground="#B6B6C0" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Button>
   </Grid><TextBlock x:Name="GlobalScreensaverStatus" Text="Built-in sports scene" Style="{StaticResource PreferenceDetail}" Margin="20,0,20,18"/><Border Style="{StaticResource PreferenceDivider}"/>
   <Grid Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Show the clock" Style="{StaticResource PreferenceName}" VerticalAlignment="Center"/><CheckBox x:Name="ScreensaverClockToggle" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Show the clock on the screensaver" IsChecked="True" Checked="ScreensaverClock_Changed" Unchecked="ScreensaverClock_Changed"/></Grid>
  </StackPanel></Border>
  <Border x:Name="StartupSection" Tag="SYSTEM|startup resume last sport" Style="{StaticResource GlobalSettingsCard}"><StackPanel><TextBlock Text="On opening the app" Style="{StaticResource GroupCaption}"/><StackPanel Margin="16,0,16,16"><RadioButton x:Name="ResumeStartupTile" Content="Resume a saved match" Tag="startup:0" GroupName="Startup" Style="{StaticResource SettingsTile}" HorizontalContentAlignment="Left" Margin="0,4" Checked="PreferenceTile_Checked"/><RadioButton x:Name="LastModeStartupTile" Content="Open the last used sport" Tag="startup:1" GroupName="Startup" Style="{StaticResource SettingsTile}" HorizontalContentAlignment="Left" Margin="0,4" Checked="PreferenceTile_Checked"/><RadioButton x:Name="SelectionStartupTile" Content="Choose a sport" Tag="startup:2" GroupName="Startup" Style="{StaticResource SettingsTile}" HorizontalContentAlignment="Left" Margin="0,4" Checked="PreferenceTile_Checked"/></StackPanel><ComboBox Visibility="Collapsed" x:Name="StartupModeCombo" SelectionChanged="StartupModeCombo_SelectionChanged"/></StackPanel></Border>
  <Border Tag="SYSTEM|about version build revision source local support" Style="{StaticResource GlobalSettingsCard}"><StackPanel>
   <TextBlock Text="About Roche Scoreboard" Style="{StaticResource GroupCaption}"/>
   <TextBlock Text="Share this identifier when reporting a problem. Local changes are marked; the build code identifies this application binary." Style="{StaticResource PreferenceDetail}" Margin="20,0,20,12"/>
   <TextBox x:Name="BuildInfoBox" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Application version and build identifier" Margin="20,0,20,20" MinHeight="36" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
  </StackPanel></Border>
  <Border Tag="SCOREBOARD|goal animation AFL footy|scope:afl" Style="{StaticResource GlobalSettingsCard}"><StackPanel><TextBlock Text="AFL goal celebrations" Style="{StaticResource GroupCaption}"/>   <Grid x:Name="GoalAnimationRow" Margin="20,12,20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Goal animation" Style="{StaticResource PreferenceName}"/><TextBlock Text="The starting choice for a new AFL match." Style="{StaticResource PreferenceDetail}"/></StackPanel><ComboBox x:Name="GoalAnimationCombo" Grid.Column="1" Width="270" SelectionChanged="GoalAnimationCombo_SelectionChanged"/></Grid><Border Style="{StaticResource PreferenceDivider}"/>
</StackPanel></Border>
  <Border x:Name="AutomationSection" Tag="AUTOMATION|automatic overlays quarter break rotation|scope:afl" Style="{StaticResource GlobalSettingsCard}"><StackPanel><TextBlock Text="Automation" Style="{StaticResource GroupCaption}"/>
   <Grid Margin="20,12,20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quarter-break rotation" Style="{StaticResource PreferenceName}"/><TextBlock Text="Cycle presentation screens during AFL breaks." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="BreakScreenToggle" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Quarter-break rotation" Checked="BreakScreenToggle_Changed" Unchecked="BreakScreenToggle_Changed"/></Grid><Border Style="{StaticResource PreferenceDivider}"/>
   <Grid Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Automatic AFL overlays" Style="{StaticResource PreferenceName}"/><TextBlock Text="Show relevant match information during quiet play." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="AutoOverlaysToggle" Grid.Column="1" Width="60" Content="" AutomationProperties.Name="Automatic AFL overlays" Checked="AutoOverlaysToggle_Changed" Unchecked="AutoOverlaysToggle_Changed"/></Grid>
  </StackPanel></Border>
  <Border Tag="SCOREBOARD|cricket wickets boundaries rolling bowler overlays break rotation presentations|scope:cricket" Style="{StaticResource GlobalSettingsCard}"><StackPanel><TextBlock Text="Cricket presentation defaults" Style="{StaticResource GroupCaption}"/><TextBlock Text="Choose the starting presentation for new cricket sessions. Changes also update the open cricket panel." Style="{StaticResource PreferenceDetail}" Margin="20,0,20,12"/>
<Grid Margin="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Wicket &amp; boundary celebrations" Style="{StaticResource PreferenceName}"/><TextBlock Text="Show event animations on the cricket scorebug." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="CricketEventsDefaultToggle" Grid.Column="1" Width="60" AutomationProperties.Name="Wicket &amp; boundary celebrations" Checked="CricketDefault_Changed" Unchecked="CricketDefault_Changed"/></Grid>
<Grid Margin="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rolling figures" Style="{StaticResource PreferenceName}"/><TextBlock Text="Animate changes to scorebug figures." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="CricketRollingDefaultToggle" Grid.Column="1" Width="60" AutomationProperties.Name="Rolling figures" Checked="CricketDefault_Changed" Unchecked="CricketDefault_Changed"/></Grid>
<Grid Margin="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Bowler details" Style="{StaticResource PreferenceName}"/><TextBlock Text="Show the current bowler’s details on the scorebug." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="CricketBowlerDefaultToggle" Grid.Column="1" Width="60" AutomationProperties.Name="Bowler details" Checked="CricketDefault_Changed" Unchecked="CricketDefault_Changed"/></Grid>
<Grid Margin="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Automatic cricket overlays" Style="{StaticResource PreferenceName}"/><TextBlock Text="Show relevant information on the live scorebug only." Style="{StaticResource PreferenceDetail}"/></StackPanel><CheckBox x:Name="CricketAutomaticDefaultToggle" Grid.Column="1" Width="60" AutomationProperties.Name="Automatic cricket overlays" Checked="CricketDefault_Changed" Unchecked="CricketDefault_Changed"/></Grid>
<Grid Margin="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="Break rotation" Style="{StaticResource PreferenceName}" TextWrapping="Wrap"/><TextBlock Text="Rotate available screens during cricket breaks." Style="{StaticResource PreferenceDetail}" TextWrapping="Wrap"/></StackPanel>
 <CheckBox x:Name="CricketBreakRotationDefaultToggle" Grid.Column="1" Width="60" VerticalAlignment="Center"
           AutomationProperties.Name="Rotate cricket break presentations"
           AutomationProperties.HelpText="Automatic presentation rotation during cricket breaks. Only screens with available match data appear. This preference is independent of AFL quarter-break rotation."
           Checked="CricketDefault_Changed" Unchecked="CricketDefault_Changed"/>
</Grid>
</StackPanel></Border>
 </local:SettingsWorkspace>
 <Button x:Name="BackButton" Grid.Row="2" Content="←  Back to sports" HorizontalAlignment="Left" Margin="18,0,18,14" MinWidth="190" Height="42" Click="BackButton_Click" Style="{StaticResource SettingsLaunchButton}"/>
 </Grid>
</UserControl>
