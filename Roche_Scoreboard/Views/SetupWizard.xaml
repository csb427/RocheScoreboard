<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:layout="clr-namespace:Roche_Scoreboard.Views" xmlns:motion="clr-namespace:Roche_Scoreboard.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Roche_Scoreboard.Views.SetupWizard" Background="Transparent" motion:OperatorDesign.IsEnabled="True" PreviewKeyDown="UnifiedSetup_KeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/CricketActions.xaml" />
                <ResourceDictionary Source="../Resources/SettingsControls.xaml" />
                <ResourceDictionary Source="../Resources/ControlCentre.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="Shell">#09090B</Color>
            <Color x:Key="Surface0">#141416</Color>
            <Color x:Key="Surface1">#1C1C1F</Color>
            <Color x:Key="Surface2">#242427</Color>
            <Color x:Key="Surface3">#2C2C30</Color>
            <Color x:Key="Edge">#3A3A40</Color>
            <Color x:Key="EdgeHi">#5B5B66</Color>
            <Color x:Key="Accent">#58A6FF</Color>
            <Color x:Key="AccentDim">#1F6FEB</Color>
            <Color x:Key="TextBright">#E6EDF3</Color>
            <Color x:Key="TextMid">#B6B6C0</Color>
            <Color x:Key="TextDim">#8E8E98</Color>
            <Color x:Key="Go">#3FB950</Color>
            <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource Shell}" />
            <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource Edge}" />
            <SolidColorBrush x:Key="EdgeHiBrush" Color="{StaticResource EdgeHi}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
            <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
            <SolidColorBrush x:Key="TextBrightBrush" Color="{StaticResource TextBright}" />
            <SolidColorBrush x:Key="TextMidBrush" Color="{StaticResource TextMid}" />
            <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
            <SolidColorBrush x:Key="GoBrush" Color="{StaticResource Go}" />
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B6B6C0" />
                <Setter Property="FontSize" Value="{DynamicResource ControlCentre.CaptionSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="WizardField" TargetType="TextBox" BasedOn="{StaticResource SettingsInput}" />
            <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource ControlCentre.Button}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontSize" Value="{DynamicResource ControlCentre.CaptionSize}" />
            </Style>
            <Style x:Key="DarkCombo" TargetType="ComboBox" BasedOn="{StaticResource SettingsChoice}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <layout:WizardViewport x:Name="ResponsiveScrollHost" MinimumCanvasWidth="320" MinimumCanvasHeight="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" PanningMode="Both" CanContentScroll="False" PreviewMouseWheel="ResponsiveScrollHost_PreviewMouseWheel" Grid.Row="1">
            <Grid>
                <Grid Margin="18,8,18,22" MaxWidth="1440" HorizontalAlignment="Stretch" x:Name="WizardBody">
                    <StackPanel x:Name="SportStepContainer" Visibility="Collapsed" MaxWidth="880" Margin="0,12,0,20">
                     <TextBlock x:Name="SportQuestion" Text="Choose a sport" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                     <TextBlock x:Name="SportDescription" Text="Your current match stays intact until you finish setup." Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,24"/>
                     <Grid layout:WizardPair.MinimumColumnWidth="180">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <RadioButton x:Name="AflSportChoice" GroupName="MatchSportChoice" IsChecked="True" Style="{StaticResource SettingsTile}" Padding="22" Margin="0,0,8,12" HorizontalContentAlignment="Stretch" Checked="SportChoice_Changed" Unchecked="SportChoice_Changed" AutomationProperties.Name="AFL, Australian football, footy">
                       <StackPanel><motion:OperatorSymbol x:Name="AflSportSymbol" Kind="sport-afl" Width="52" Height="52" HorizontalAlignment="Left" Foreground="{DynamicResource ControlCentre.TextBrush}" Margin="0,0,0,20"/><TextBlock x:Name="AflSportLabel" Text="AFL (footy)" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="AflSportDescription" Text="Teams, quarter clock and match options" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                      </RadioButton>
                      <RadioButton x:Name="CricketSportChoice" Grid.Column="1" GroupName="MatchSportChoice" Style="{StaticResource SettingsTile}" Padding="22" Margin="8,0,0,12" HorizontalContentAlignment="Stretch" Checked="SportChoice_Changed" Unchecked="SportChoice_Changed" AutomationProperties.Name="Cricket">
                       <StackPanel><motion:OperatorSymbol x:Name="CricketSportSymbol" Kind="sport-cricket" Width="52" Height="52" HorizontalAlignment="Left" Foreground="{DynamicResource ControlCentre.TextBrush}" Margin="0,0,0,20"/><TextBlock x:Name="CricketSportLabel" Text="Cricket" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="CricketSportDescription" Text="Teams, players, format and match options" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                      </RadioButton>
                     </Grid>
                    </StackPanel>
                    <Grid x:Name="TeamsStepContainer" Visibility="Collapsed">
                        <Grid layout:WizardPair.MinimumColumnWidth="360">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <layout:OperatorGlassSurface Material="Regular" CornerRadius="28" Grid.Column="0" Padding="0">
                                <StackPanel>
                                    <Border x:Name="HomePresetCard" Grid.Column="0" Background="Transparent" BorderBrush="#383840" BorderThickness="0" Padding="18,16,18,8" Opacity="1" ClipToBounds="False" CornerRadius="20" Margin="0" MinHeight="0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="HomePresetTranslate" X="-60" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Background="Transparent" Padding="0" Margin="0,0,8,0" BorderThickness="0">
                                                    <TextBlock Text="Home team" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="20" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock x:Name="HomePresetEmpty" Text="No saved presets" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed" />
                                            </StackPanel>
                                            <WrapPanel x:Name="HomePresetPanel" Grid.Row="1" />
                                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                                <Button Content="Find a club" MinWidth="120" Height="40" FontSize="13" Margin="0,0,10,0" Click="BrowseHomeTeam_Click" Style="{StaticResource PrimaryCommandButton}" Padding="14,8" />
                                                <Button Content="Save Current" Height="34" Margin="0,0,6,0" Click="SaveHomePreset_Click" Style="{StaticResource SmallBtn}" />
                                                <Button Content="Delete" Height="34" Click="DeleteHomePreset_Click" Style="{StaticResource SmallBtn}" Foreground="#FF999F" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="HomeTeamCard" Grid.Column="0" ClipToBounds="False" Opacity="1" RenderTransformOrigin="0.5,0.5" CornerRadius="20" Background="Transparent" BorderThickness="0" Margin="0" MinHeight="0" Padding="0">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="HomeCardScale" />
                                                <TranslateTransform x:Name="HomeCardTranslate" X="-80" />
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Border x:Name="HomeGlow" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0.15" RadiusX="0.6" RadiusY="0.5">
                                                        <GradientStop Color="#3058A6FF" Offset="0" />
                                                        <GradientStop Color="#1058A6FF" Offset="0.5" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#00000000" Offset="0.2" />
                                                        <GradientStop Color="#40000000" Offset="1.0" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="18,4,18,18">
                                                <StackPanel Margin="0">
                                                    <StackPanel x:Name="HomeHeaderGroup" Opacity="0" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed">
                                                        <StackPanel.RenderTransform>
                                                            <TranslateTransform x:Name="HomeHeaderTranslate" Y="15" />
                                                        </StackPanel.RenderTransform>
                                                        <TextBlock Text="HOME" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" ShadowDepth="0" Color="#58A6FF" Opacity="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="TEAM CONFIGURATION" FontSize="9" FontWeight="SemiBold" Foreground="#4058A6FF" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="Team Name" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="SetupHomeNameBox" Text="" Style="{StaticResource WizardField}" Margin="0,0,0,10" />
                                                    <TextBlock Text="Abbreviation (3-4 letters)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="SetupHomeAbbrBox" Text="" Style="{StaticResource WizardField}" MaxLength="4" Margin="0,0,0,12" />
                                                    <Grid Margin="0,0,0,12" layout:WizardPair.MinimumColumnWidth="135">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Primary Colour" Style="{StaticResource FieldLabel}" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox x:Name="SetupHomeColorBox" Width="80" Text="#0A2A6A" FontSize="11" FontFamily="Consolas" Background="#111113" Foreground="{StaticResource TextBrightBrush}" BorderBrush="#3A3A40" BorderThickness="1" Padding="6,4" CaretBrush="White" VerticalContentAlignment="Center" TextChanged="SetupHomeColorBox_TextChanged" />
                                                                <layout:OperatorActionBorder x:Name="SetupHomeColorPreview" Background="#0A2A6A" Style="{StaticResource WizardColourAction}" AutomationProperties.Name="Choose home primary colour" ToolTip="Choose home primary colour" MouseLeftButtonUp="PickSetupHomeColor_Click" Margin="4,0,0,0" />
                                                                <layout:OperatorActionBorder Background="#1C1C1F" Style="{StaticResource WizardColourAction}" AutomationProperties.Name="Pick home primary colour from screen" ToolTip="Pick home primary colour from screen" MouseLeftButtonUp="DropperSetupHomeColor_Click" Margin="3,0,0,0">
                                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </layout:OperatorActionBorder>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Text Colour" Style="{StaticResource FieldLabel}" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox x:Name="SetupHomeSecondaryBox" Width="80" Text="#FFFFFF" FontSize="11" FontFamily="Consolas" Background="#111113" Foreground="{StaticResource TextBrightBrush}" BorderBrush="#3A3A40" BorderThickness="1" Padding="6,4" CaretBrush="White" VerticalContentAlignment="Center" TextChanged="SetupHomeSecondaryBox_TextChanged" />
                                                                <layout:OperatorActionBorder x:Name="SetupHomeSecondaryPreview" Background="#FFFFFF" Style="{StaticResource WizardColourAction}" AutomationProperties.Name="Choose home secondary colour" ToolTip="Choose home secondary colour" MouseLeftButtonUp="PickSetupHomeSecondary_Click" Margin="4,0,0,0" />
                                                                <layout:OperatorActionBorder Background="#1C1C1F" Style="{StaticResource WizardColourAction}" AutomationProperties.Name="Pick home secondary colour from screen" ToolTip="Pick home secondary colour from screen" MouseLeftButtonUp="DropperSetupHomeSecondary_Click" Margin="3,0,0,0">
                                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </layout:OperatorActionBorder>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border Height="1" Margin="0,2,0,12">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#0058A6FF" Offset="0" />
                                                                <GradientStop Color="#3058A6FF" Offset="0.5" />
                                                                <GradientStop Color="#0058A6FF" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="Logo" Style="{StaticResource FieldLabel}" />
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="Choose Logo" Height="28" Click="ChooseSetupHomeLogo_Click" Style="{StaticResource SmallBtn}" />
                                                        <TextBlock Grid.Column="1" x:Name="SetupHomeLogoText" Text="(none)" Foreground="#5B5B66" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Border x:Name="SetupHomeLogoPreview" Background="#111113" Padding="8" Margin="0,4,0,0" Visibility="Collapsed" HorizontalAlignment="Left">
                                                        <Image x:Name="SetupHomeLogoImage" MaxHeight="60" MaxWidth="160" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <Border Height="1" Background="#3A3A40" Margin="0,12,0,12" />
                                                    <TextBlock Text="Goal Video (optional)" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="Choose MP4" Height="28" Click="ChooseSetupHomeVideo_Click" Style="{StaticResource SmallBtn}" />
                                                        <TextBlock Grid.Column="1" x:Name="SetupHomeVideoText" Text="(none)" Foreground="#5B5B66" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </layout:OperatorGlassSurface>
                            <layout:OperatorGlassSurface Material="Regular" CornerRadius="28" Grid.Column="2" Padding="0">
                                <StackPanel>
                                    <Border x:Name="AwayPresetCard" Grid.Column="2" Background="Transparent" BorderBrush="#383840" BorderThickness="0" Padding="18,16,18,8" Opacity="1" ClipToBounds="False" CornerRadius="20" Margin="0" MinHeight="0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="AwayPresetTranslate" X="60" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Background="Transparent" Padding="0" Margin="0,0,8,0" BorderThickness="0">
                                                    <TextBlock Text="Away team" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="20" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock x:Name="AwayPresetEmpty" Text="No saved presets" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed" />
                                            </StackPanel>
                                            <WrapPanel x:Name="AwayPresetPanel" Grid.Row="1" />
                                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                                <Button Content="Find a club" MinWidth="120" Height="40" FontSize="13" Margin="0,0,10,0" Click="BrowseAwayTeam_Click" Style="{StaticResource PrimaryCommandButton}" Padding="14,8" />
                                                <Button Content="Save Current" Height="34" Margin="0,0,6,0" Click="SaveAwayPreset_Click" Style="{StaticResource SmallBtn}" />
                                                <Button Content="Delete" Height="34" Click="DeleteAwayPreset_Click" Style="{StaticResource SmallBtn}" Foreground="#FF999F" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="AwayTeamCard" Grid.Column="2" ClipToBounds="False" Opacity="1" RenderTransformOrigin="0.5,0.5" CornerRadius="20" Background="Transparent" BorderThickness="0" Margin="0" MinHeight="0" Padding="0">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="AwayCardScale" />
                                                <TranslateTransform x:Name="AwayCardTranslate" X="80" />
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Border x:Name="AwayGlow" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0.15" RadiusX="0.6" RadiusY="0.5">
                                                        <GradientStop Color="#30FF6B6B" Offset="0" />
                                                        <GradientStop Color="#10FF6B6B" Offset="0.5" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#00000000" Offset="0.2" />
                                                        <GradientStop Color="#40000000" Offset="1.0" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="18,4,18,18">
                                                <StackPanel Margin="0">
                                                    <StackPanel x:Name="AwayHeaderGroup" Opacity="0" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed">
                                                        <StackPanel.RenderTransform>
                                                            <TranslateTransform x:Name="AwayHeaderTranslate" Y="15" />
                                                        </StackPanel.RenderTransform>
                                                        <TextBlock Text="AWAY" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" ShadowDepth="0" Color="#FF6B6B" Opacity="0" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="TEAM CONFIGURATION" FontSize="9" FontWeight="SemiBold" Foreground="#40FF6B6B" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="Team Name" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="SetupAwayNameBox" Text="" Style="{StaticResource WizardField}" Margin="0,0,0,10" />
                                                    <TextBlock Text="Abbreviation (3-4 letters)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="SetupAwayAbbrBox" Text="" Style="{StaticResource WizardField}" MaxLength="4" Margin="0,0,0,12" />
                                                    <Grid Margin="0,0,0,12" layout:WizardPair.MinimumColumnWidth="135">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Primary Colour" Style="{StaticResource FieldLabel}" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox x:Name="SetupAwayColorBox" Width="80" Text="#7A1A1A" FontSize="11" FontFamily="Consolas" Background="#111113" Foreground="{StaticResource TextBrightBrush}" BorderBrush="#3A3A40" BorderThickness="1" Padding="6,4" CaretBrush="White" VerticalContentAlignment="Center" TextChanged="SetupAwayColorBox_TextChanged" />
                                                                <layout:OperatorActionBorder x:Name="SetupAwayColorPreview" Background="#7A1A1A" Style="{StaticResource WizardColourAction}" AutomationProperties.Name="Choose away primary colour" ToolTip="Choose away primary colour" MouseLeftButtonUp="PickSetupAwayColor_Click" Margin="4,0,0,0" />
                                                                <layout:OperatorActionBorder Background="#1C1C1F" Style="{StaticResource WizardColourAction}" AutomationProperties.Name="Pick away primary colour from screen" ToolTip="Pick away primary colour from screen" MouseLeftButtonUp="DropperSetupAwayColor_Click" Margin="3,0,0,0">
                                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </layout:OperatorActionBorder>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Text Colour" Style="{StaticResource FieldLabel}" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox x:Name="SetupAwaySecondaryBox" Width="80" Text="#FFFFFF" FontSize="11" FontFamily="Consolas" Background="#111113" Foreground="{StaticResource TextBrightBrush}" BorderBrush="#3A3A40" BorderThickness="1" Padding="6,4" CaretBrush="White" VerticalContentAlignment="Center" TextChanged="SetupAwaySecondaryBox_TextChanged" />
                                                                <layout:OperatorActionBorder x:Name="SetupAwaySecondaryPreview" Background="#FFFFFF" Style="{StaticResource WizardColourAction}" AutomationProperties.Name="Choose away secondary colour" ToolTip="Choose away secondary colour" MouseLeftButtonUp="PickSetupAwaySecondary_Click" Margin="4,0,0,0" />
                                                                <layout:OperatorActionBorder Background="#1C1C1F" Style="{StaticResource WizardColourAction}" AutomationProperties.Name="Pick away secondary colour from screen" ToolTip="Pick away secondary colour from screen" MouseLeftButtonUp="DropperSetupAwaySecondary_Click" Margin="3,0,0,0">
                                                                    <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </layout:OperatorActionBorder>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border Height="1" Margin="0,2,0,12">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#00FF6B6B" Offset="0" />
                                                                <GradientStop Color="#30FF6B6B" Offset="0.5" />
                                                                <GradientStop Color="#00FF6B6B" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="Logo" Style="{StaticResource FieldLabel}" />
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="Choose Logo" Height="28" Click="ChooseSetupAwayLogo_Click" Style="{StaticResource SmallBtn}" />
                                                        <TextBlock Grid.Column="1" x:Name="SetupAwayLogoText" Text="(none)" Foreground="#523030" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Border x:Name="SetupAwayLogoPreview" Background="#111113" Padding="8" Margin="0,4,0,0" Visibility="Collapsed" HorizontalAlignment="Left">
                                                        <Image x:Name="SetupAwayLogoImage" MaxHeight="60" MaxWidth="160" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <Border Height="1" Background="#3A3A40" Margin="0,12,0,12" />
                                                    <TextBlock Text="Goal Video (optional)" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="Choose MP4" Height="28" Click="ChooseSetupAwayVideo_Click" Style="{StaticResource SmallBtn}" />
                                                        <TextBlock Grid.Column="1" x:Name="SetupAwayVideoText" Text="(none)" Foreground="#523030" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </layout:OperatorGlassSurface>
                        </Grid>
                        <Grid Visibility="Collapsed" IsHitTestVisible="False">
                            <Grid Grid.Row="0" Margin="20,0,20,10" layout:WizardPair.MinimumColumnWidth="330">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
