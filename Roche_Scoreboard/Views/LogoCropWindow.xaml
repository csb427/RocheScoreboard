<Window x:Class="Roche_Scoreboard.Views.LogoCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:design="clr-namespace:Roche_Scoreboard.Services" design:OperatorDesign.IsEnabled="True"
        Title="Logo Crop Studio"
        Height="760"
        Width="1200"
        MinHeight="420"
        MinWidth="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        Background="#09090B" Foreground="#FAFAFC" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="30"/></shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/ControlCentre.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource ControlCentre.Button}"><Setter Property="MinHeight" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,2"/></Style>
    </ResourceDictionary></Window.Resources>
    <glass:OperatorGlassSurface Material="Regular" GlassSource="{Binding Owner.Content, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="30" BorderBrush="#68FFFFFF" BorderThickness="1" Background="{DynamicResource ControlCentre.GlassBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Grid Margin="18" MinWidth="980" MinHeight="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><StackPanel>
            <TextBlock Text="LOGO CROP STUDIO" Foreground="#F1F5F9" FontSize="19" FontWeight="Black"/>
            <TextBlock Text="Load logos, then drag in the wide preview or use sliders for precise positioning." Foreground="#B6B6C0" FontSize="12"/>
        </StackPanel><Button Grid.Column="1" Content="×" ToolTip="Cancel logo changes" Click="Cancel_Click" Width="34" Height="34" MinHeight="0" Padding="0" FontSize="22" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True"/></Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#19191C" BorderBrush="#44444B" BorderThickness="1" CornerRadius="16" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HOME" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Load Home Logo" Height="26" Padding="10,0" Click="LoadHomeLogo_Click"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="16" BorderBrush="#53535C" BorderThickness="1" ClipToBounds="True">
                            <Grid x:Name="HomeWideArea" MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseLeftButtonUp" MouseLeave="Preview_MouseLeave">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#222226" Offset="0"/>
                                        <GradientStop Color="#303036" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Image x:Name="HomeWideImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"/>
                                <TextBlock x:Name="HomeEmptyHint" Text="No home logo selected" Foreground="#A8B7CB" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Border Width="170" Height="170" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Width="190" Height="190" CornerRadius="16" BorderBrush="#53535C" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#222226" Offset="0"/>
                                        <GradientStop Color="#303036" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Image x:Name="HomeCropImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="HomeLogoPathText" Text="" Foreground="#B6B6C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Zoom" Foreground="#B6B6C0" FontSize="12" Margin="0,5,0,0"/>
                        <Slider x:Name="HomeZoomSlider" Minimum="0.6" Maximum="3.5" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock Text="Horizontal" Foreground="#B6B6C0" FontSize="12" Margin="0,3,0,0"/>
                        <Slider x:Name="HomeXSlider" Minimum="-220" Maximum="220" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock Text="Vertical" Foreground="#B6B6C0" FontSize="12" Margin="0,3,0,0"/>
                        <Slider x:Name="HomeYSlider" Minimum="-220" Maximum="220" ValueChanged="Slider_ValueChanged"/>
                        <Button Content="Reset Home" Height="28" Margin="0,8,0,0" Click="ResetHome_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#19191C" BorderBrush="#44444B" BorderThickness="1" CornerRadius="16" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AWAY" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Load Away Logo" Height="26" Padding="10,0" Click="LoadAwayLogo_Click"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="16" BorderBrush="#53535C" BorderThickness="1" ClipToBounds="True">
                            <Grid x:Name="AwayWideArea" MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseLeftButtonUp" MouseLeave="Preview_MouseLeave">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#222226" Offset="0"/>
                                        <GradientStop Color="#303036" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Image x:Name="AwayWideImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"/>
                                <TextBlock x:Name="AwayEmptyHint" Text="No away logo selected" Foreground="#A8B7CB" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Border Width="170" Height="170" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Width="190" Height="190" CornerRadius="16" BorderBrush="#53535C" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#222226" Offset="0"/>
                                        <GradientStop Color="#303036" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Image x:Name="AwayCropImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="AwayLogoPathText" Text="" Foreground="#B6B6C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Zoom" Foreground="#B6B6C0" FontSize="12" Margin="0,5,0,0"/>
                        <Slider x:Name="AwayZoomSlider" Minimum="0.6" Maximum="3.5" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock Text="Horizontal" Foreground="#B6B6C0" FontSize="12" Margin="0,3,0,0"/>
                        <Slider x:Name="AwayXSlider" Minimum="-220" Maximum="220" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock Text="Vertical" Foreground="#B6B6C0" FontSize="12" Margin="0,3,0,0"/>
                        <Slider x:Name="AwayYSlider" Minimum="-220" Maximum="220" ValueChanged="Slider_ValueChanged"/>
                        <Button Content="Reset Away" Height="28" Margin="0,8,0,0" Click="ResetAway_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" Width="96" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Apply" Width="96" Height="38" Padding="10,0" MinHeight="0" FontSize="14" Style="{StaticResource ControlCentre.PrimaryButton}" Click="Apply_Click"/>
        </Grid>
    </Grid>
    </ScrollViewer>
    </glass:OperatorGlassSurface>
</Window>
