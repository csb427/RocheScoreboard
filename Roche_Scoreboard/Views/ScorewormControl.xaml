<UserControl x:Class="Roche_Scoreboard.Views.ScorewormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Roche_Scoreboard.Views"
             mc:Ignorable="d"
             d:DesignHeight="193" d:DesignWidth="386"
             Width="386" Height="193">

    <!-- Fixed 386x193 layout authored 1:1. No Viewbox/scaling. -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush x:Name="WormBgGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D1117" Offset="0.0"/>
                <GradientStop Color="#0D1117" Offset="0.5"/>
                <GradientStop Color="#0D1117" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="16"/>   <!-- title -->
            <RowDefinition Height="*"/>    <!-- graph (now consumes the freed team-header row) -->
            <RowDefinition Height="44"/>   <!-- score bar -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <Border Grid.Row="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <Border VerticalAlignment="Bottom" Height="1" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush x:Name="WormTitleAccent" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#4488FF" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="0.5"/>
                        <GradientStop Color="#FF6644" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Border>
        <Grid Grid.Row="0" Margin="6,0">
            <TextBlock Text="SCORE WORM" Foreground="#F0C040"
                       FontSize="13" FontWeight="Black" FontFamily="Bahnschrift"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="WormTimeText" Text="1:26 PM" Foreground="#58A6FF"
                       FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- GRAPH with a left-edge indicator column carrying each team's
             zoomed-in logo (dimmed) with the abbreviation overlaid on top. -->
        <Grid Grid.Row="1" Margin="4,2,4,2">
            <Grid.ColumnDefinitions>
                <!-- Indicator column: zoomed dimmed logo with abbreviation
                     text on top, split home (top) / away (bottom). -->
                <ColumnDefinition Width="36"/>
                <!-- Y-axis margin labels. -->
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Indicator column: full-height background split home/away.
                 Inside each half: a zoomed-in logo at reduced opacity with
                 the rotated team abbreviation drawn on top — same idea as
                 the quarter-summary boxes. -->
            <Border Grid.Column="0" Margin="0,0,3,0" CornerRadius="3"
                    BorderBrush="#30363D" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush x:Name="WormSideStripBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#4488FF" Offset="0.0"/>
                            <GradientStop Color="#4488FF" Offset="0.5"/>
                            <GradientStop Color="#FF6644" Offset="0.5"/>
                            <GradientStop Color="#FF6644" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HOME half (top) -->
                    <Grid Grid.Row="0" ClipToBounds="True">
                        <!-- Zoomed-in dimmed logo, centred and filling the half -->
                        <Image x:Name="WormHomeLogoImage"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.35"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>
                        <Ellipse x:Name="WormHomeLogoFallback"
                                 Fill="#22FFFFFF" Margin="3"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- Rotated abbreviation on top, auto-scaled by Viewbox
                             so the text fills as much of the half as possible
                             without enlarging the column. -->
                        <Viewbox Stretch="Uniform" Margin="2" IsHitTestVisible="False">
                            <TextBlock x:Name="WormHomeAbbrText"
                                       Text="HOM"
                                       Foreground="White"
                                       FontFamily="Bahnschrift"
                                       FontWeight="Black"
                                       FontSize="32">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.95"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Viewbox>
                    </Grid>

                    <!-- AWAY half (bottom) -->
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <Image x:Name="WormAwayLogoImage"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.35"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>
                        <Ellipse x:Name="WormAwayLogoFallback"
                                 Fill="#22FFFFFF" Margin="3"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <Viewbox Stretch="Uniform" Margin="2" IsHitTestVisible="False">
                            <TextBlock x:Name="WormAwayAbbrText"
                                       Text="AWY"
                                       Foreground="White"
                                       FontFamily="Bahnschrift"
                                       FontWeight="Black"
                                       FontSize="32">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.95"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Border>

            <Canvas x:Name="YAxisCanvas" Grid.Column="1" ClipToBounds="False"/>

            <Border Grid.Column="2" ClipToBounds="True"
                    Background="#0D1117" BorderBrush="#30363D" BorderThickness="1">
                <Canvas x:Name="GraphCanvas" ClipToBounds="True"/>
            </Border>
        </Grid>

        <!-- BOTTOM SCORE BAR -->
        <local:PresentationScoreBar x:Name="ScoreBar" Grid.Row="2"/>
    </Grid>
</UserControl>

