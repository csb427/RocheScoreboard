<UserControl x:Class="Roche_Scoreboard.Views.ScorewormControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Roche_Scoreboard.Views" mc:Ignorable="d" d:DesignHeight="193" d:DesignWidth="386"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">
    <Grid ClipToBounds="True">
        <Grid.Background><LinearGradientBrush x:Name="WormBgGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0B1119" Offset="0"/><GradientStop Color="#070B11" Offset="0.5"/><GradientStop Color="#0B1119" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Grid.RowDefinitions><RowDefinition Height="24*"/><RowDefinition Height="125*"/><RowDefinition Height="0"/><RowDefinition Height="44*"/></Grid.RowDefinitions>

        <Border x:Name="WormTitlePanel" Grid.Row="0" Background="#ED0A1018" BorderBrush="#29384B" BorderThickness="0,0,0,1">
            <Grid Margin="8,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="WormTitleText" Text="MARGIN FLOW" Foreground="White" FontSize="16" FontWeight="Black" FontFamily="Bahnschrift" VerticalAlignment="Center"/>
                <TextBlock x:Name="WormMarginText" Grid.Column="1" Text="SCORES LEVEL" Foreground="#FFFFFF" FontSize="14" FontWeight="Black" FontFamily="Bahnschrift" VerticalAlignment="Center"/>
                <TextBlock x:Name="WormTimeText" Text="1:26 PM" Visibility="Collapsed"/>
                <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="2"><Border.Background><LinearGradientBrush x:Name="WormTitleAccent" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#4488FF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.5"/><GradientStop Color="#FF6644" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="7,5" CornerRadius="8" Background="#E8080D14" BorderBrush="#33465B" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Canvas x:Name="ZoneCanvas" IsHitTestVisible="False"/>
                <Grid Margin="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Canvas x:Name="YAxisCanvas" Grid.Column="0" ClipToBounds="False"/>
                    <Canvas x:Name="GraphCanvas" Grid.Column="1" ClipToBounds="True"/>
                </Grid>
            </Grid>
        </Border>

        <local:PresentationScoreBar x:Name="ScoreBar" Grid.Row="3"/>
    </Grid>
</UserControl>
