<Window x:Class="Roche_Scoreboard.Views.ResumeGameDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:design="clr-namespace:Roche_Scoreboard.Services" design:OperatorDesign.IsEnabled="True"
 Title="Continue saved match" Width="580" Height="410" MinWidth="340" MinHeight="310"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#09090B" Foreground="#FAFAFC" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15"
 ShowInTaskbar="False" WindowStyle="None" PreviewKeyDown="Window_PreviewKeyDown">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="30"/></shell:WindowChrome.WindowChrome>
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/OperatorControls.xaml"/><ResourceDictionary Source="../Resources/ControlCentre.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<glass:OperatorGlassSurface x:Name="DialogShell" Material="Regular" GlassSource="{Binding Owner.Content, RelativeSource={RelativeSource AncestorType=Window}}" TextElement.Foreground="{DynamicResource ControlCentre.TextBrush}" Padding="24" Background="{DynamicResource ControlCentre.GlassBrush}" CornerRadius="30" BorderBrush="#68FFFFFF" BorderThickness="1">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CONTINUE YOUR MATCH?" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="PhaseText" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="14" Margin="0,8,0,12"/></StackPanel><Button Grid.Column="1" Content="×" ToolTip="Continue later" Click="KeepSaved_Click" Width="34" Height="34" MinHeight="0" Padding="0" FontSize="22" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ControlCentre.Button}"/></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<Border x:Name="HomeTeamCard" Style="{StaticResource SettingsSectionSurface}" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="HomeLogoImage" Height="38" Stretch="Uniform"/><TextBlock Foreground="White" x:Name="HomeNameText" Grid.Column="1" Margin="12,0,0,0" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
<Border x:Name="AwayTeamCard" Style="{StaticResource SettingsSectionSurface}" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="AwayLogoImage" Height="38" Stretch="Uniform"/><TextBlock Foreground="White" x:Name="AwayNameText" Grid.Column="1" Margin="12,0,0,0" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2">
<UniformGrid Columns="2"><Button Content="CONTINUE LATER" Click="KeepSaved_Click" Style="{StaticResource ControlCentre.Button}" Height="46" FontSize="14" Padding="8,0" Margin="0,0,6,0"/><Button Content="CONTINUE MATCH" Click="Resume_Click" Style="{StaticResource ControlCentre.PrimaryButton}" Height="46" FontSize="14" Padding="8,0" Margin="6,0,0,0" IsDefault="True"/></UniformGrid>
<Button x:Name="DiscardButton" Content="DISCARD SAVE" Click="Discard_Click" Style="{StaticResource ControlCentre.Button}" MinHeight="0" Height="38" Padding="8,0" Margin="0,10,0,0" Foreground="#FFA3AA" Background="#302024" BorderBrush="#66424A"/>
</StackPanel></Grid></glass:OperatorGlassSurface></Window>
