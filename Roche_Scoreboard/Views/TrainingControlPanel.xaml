<UserControl x:Class="Roche_Scoreboard.Views.TrainingControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:Roche_Scoreboard.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Roche_Scoreboard.Views"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             Background="#09090B"
             Focusable="True" Loaded="ControlCentre_Loaded" SizeChanged="ControlCentre_SizeChanged" motion:OperatorDesign.IsEnabled="True">

    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/CricketActions.xaml"/><ResourceDictionary Source="../Resources/SettingsControls.xaml"/><ResourceDictionary Source="../Resources/ControlCentre.xaml"/></ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ShellBrush" Color="#09090B"/>
            <SolidColorBrush x:Key="RegionBrush" Color="#09090B"/>
            <SolidColorBrush x:Key="RegionAltBrush" Color="#19191C"/>
            <SolidColorBrush x:Key="RegionEdgeBrush" Color="#303035"/>
            <SolidColorBrush x:Key="Training.ErrorBrush" Color="#FF7B72"/>
            <Style x:Key="SectionHead" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource ControlCentre.Font}"/><Setter Property="FontSize" Value="{DynamicResource ControlCentre.CaptionSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource ControlCentre.SecondaryTextBrush}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>

        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource SettingsInput}">
            <Setter Property="Background" Value="#19191C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#58A6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource HelperText}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource SettingsSectionSurface}">
            <Setter Property="Background" Value="#09090B"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Custom button template — the default WPF Aero chrome paints its
             own gradient and ignores Background, which made our colours
             read as light text on a system grey/white. This template uses
             the Background / Foreground / BorderBrush we set directly. -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource CricketActionButton}"><Setter Property="MinHeight" Value="{DynamicResource ControlCentre.ControlHeight}"/><Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="16,10"/></Style>

        <Style x:Key="PresetChip" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#19191C"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </ResourceDictionary></UserControl.Resources>

    <!-- Master Viewbox: at the natural design size (1280×820) the layout is
         identical to before. If the host window is smaller, everything
         inside scales DOWN proportionally so the panel always fits. -->
    <Grid x:Name="TrainingClearDecisionHost">
    <views:OperatorViewport x:Name="TrainingViewport" MinimumCanvasWidth="380" MinimumCanvasHeight="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- ═══════════════════ TOP HEADER BAR ═══════════════════ -->
        <Border Grid.Row="0" CornerRadius="20" Margin="12,10,12,0" Background="#19191C" BorderBrush="#303035" BorderThickness="1" Padding="16,12">
            <Grid x:Name="TrainingHeaderGrid">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#09090B" CornerRadius="14" BorderBrush="#3A3A40" BorderThickness="1" Padding="12,8">

                    <StackPanel Orientation="Horizontal">
                        <motion:OperatorSymbol x:Name="TrainingEntrySymbol" Kind="training-entry" Width="28" Height="28" Margin="0,0,10,0" Foreground="#73B9FF" VerticalAlignment="Center"/>
                        <TextBlock Text="TRAINING MODE" Foreground="White"
                                   FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="SemiBold" FontSize="22"/>
                        <Border x:Name="TrainingTitleDivider" Width="1" Background="#3A3A40" Margin="14,2,14,2"/>
                        <TextBlock x:Name="TrainingSubtitle" Text="Operator Console" Foreground="#8B949E"
                                   FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="TrainingSessionReadout" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="SESSION TOTAL" Style="{StaticResource HelperText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="SessionTotalText" Text="00:00"
                               Foreground="#58A6FF" FontFamily="{DynamicResource ControlCentre.Font}"
                               FontWeight="SemiBold" FontSize="28" VerticalAlignment="Center">

                    </TextBlock>
                </StackPanel>

                <views:CloudRemoteLauncher x:Name="TrainingCloudLauncher" Grid.Column="3"
                                           Width="300" VerticalAlignment="Center" Margin="0,0,18,0"/>

                <Button Grid.Column="4" x:Name="ExitButton" Content="✕  Exit Training"
                        Click="OnExitClicked"
                        Style="{StaticResource ActionButton}"
                        Background="#3F1212" Foreground="#FECACA" BorderBrush="#B91C1C"
                        ToolTip="Close Training Mode and return to sport selection (Esc)"/>
            </Grid>
        </Border>

        <!-- ═══════════════════ MAIN BODY ═══════════════════ -->
        <ScrollViewer x:Name="TrainingPageViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="TrainingBodyColumns" Margin="16,14,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────── LEFT: NOW PLAYING + TRANSPORT + QUEUE ─────────── -->
            <Grid x:Name="TrainingActiveColumn" Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24">

                    <Grid x:Name="TrainingActiveCardGrid">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="NOW PLAYING" Foreground="#C9D1D9" Style="{StaticResource SectionCaption}"
                                       FontSize="11"/>
                            <TextBlock x:Name="ActiveTitleText" Text="No timer"
                                       Foreground="White" FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="SemiBold" FontSize="42"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="ActiveStatusPill" Background="#19191C" BorderBrush="#58A6FF"
                                    BorderThickness="2" Padding="12,4" Margin="0,8,0,0"
                                    HorizontalAlignment="Left">
                                <TextBlock x:Name="ActiveStatusText" Text="READY"
                                           Foreground="#58A6FF" FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="ActiveRemainingText" Text="00:00"
                                   Foreground="White" FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="SemiBold" FontSize="84"
                                   VerticalAlignment="Center">

                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                    <WrapPanel>


                            <Button x:Name="StartPauseButton" Width="152" Height="46" Click="OnStartPauseClicked"
                                    Style="{StaticResource ActionButton}"
                                    Background="#166534" Foreground="#DCFCE7" BorderBrush="#22C55E"
                                    Padding="16,8" Margin="0,0,8,8"
                                    FontWeight="SemiBold" FontSize="18"
                                    ToolTip="Start or pause the active timer (Spacebar)" AutomationProperties.Name="Start active timer">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <motion:OperatorSymbol x:Name="TrainingTransportSymbol" Kind="training-transport" Width="24" Height="24" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock x:Name="TrainingTransportLabel" Text="START" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResetActiveButton" Height="46" Click="OnResetActiveClicked"
                                    Content="↺  Reset"
                                    Style="{StaticResource ActionButton}"
                                    Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151"
                                    Padding="16,12" Margin="0,0,8,8"
                                    ToolTip="Reset the active timer to its full duration (R)"/>
                            <Button x:Name="SkipButton" Height="46" Click="OnSkipClicked"
                                    Content="⏭  Skip"
                                    Style="{StaticResource ActionButton}"
                                    Background="#3B2A0A" Foreground="#FDE68A" BorderBrush="#D97706"
                                    Padding="16,12"
                                    ToolTip="Skip the active timer and move to the next one (S)"/>



                            <Button x:Name="AddOneMinButton" Height="46" Click="OnAdd60sClicked"
                                    Content="+1:00"
                                    Style="{StaticResource ActionButton}"
                                    Background="#0F2A4A" Foreground="#DBEAFE" BorderBrush="#2563EB"
                                    Margin="0,0,8,8"
                                    ToolTip="Add one minute to the active timer (works while running)"/>
                            <Button x:Name="AddTenSecButton" Height="46" Click="OnAdd10sClicked"
                                    Content="+0:10" Margin="0,0,8,8"
                                    Style="{StaticResource ActionButton}"
                                    Background="#0F2A4A" Foreground="#DBEAFE" BorderBrush="#2563EB"
                                    ToolTip="Add ten seconds to the active timer (works while running)"/>

                    </WrapPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                    <DockPanel>
                        <Grid x:Name="TrainingQueueHeader" DockPanel.Dock="Top" Background="#19191C"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QUEUE" Foreground="#E5E7EB"
                                       Style="{StaticResource SectionCaption}" Padding="16,12,8,12"/>
                            <Border Grid.Column="1" Background="#09090B" BorderBrush="#3A3A40" BorderThickness="1"
                                    Padding="8,2" VerticalAlignment="Center" Margin="2,0,0,0">
                                <TextBlock x:Name="QueueCountText" Text="0 timers"
                                           Foreground="#C9D1D9" FontFamily="{DynamicResource ControlCentre.Font}" FontWeight="Bold" FontSize="11"/>
                            </Border>
                            <TextBlock x:Name="TrainingQueueHint" Grid.Column="2" Text="Drag rows to reorder · Click ✎ to edit · ▲ ▼ to move · ✕ to remove"
                                       Style="{StaticResource HelperText}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <StackPanel x:Name="TrainingQueueActions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border Background="#19191C" BorderBrush="#3A3A40" BorderThickness="1"
                                        Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <CheckBox x:Name="AutoAdvanceToggle" Style="{StaticResource SettingsToggle}" Content="AUTO-ADVANCE"
                                              IsChecked="True"
                                              Checked="OnAutoAdvanceChanged" Unchecked="OnAutoAdvanceChanged"
                                              Foreground="#E5E7EB" FontFamily="{DynamicResource ControlCentre.Font}"
                                              FontWeight="Bold" FontSize="11"
                                              VerticalContentAlignment="Center"
                                              ToolTip="When on, the next timer starts automatically. When off, the session pauses at the end of each timer and waits for Start."/>
                                </Border>
                                <Button Content="Clear All"
                                        x:Name="ClearAllButton" Click="OnClearAllClicked" IsEnabled="False"
                                        Style="{StaticResource ActionButton}"
                                        Background="#3F1212" Foreground="#FECACA" BorderBrush="#B91C1C"
                                        Padding="12,5" FontSize="11"
                                        ToolTip="Remove every timer from the queue"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TrainingCorrectionNotice" DockPanel.Dock="Top"
                                   Visibility="Collapsed" Foreground="{StaticResource Training.ErrorBrush}"
                                   FontSize="14" TextWrapping="Wrap" Margin="16,8,16,8"/>
                        <Grid x:Name="QueueArea">
                            <ScrollViewer x:Name="QueueScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="QueueItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Drag insertion line — moved via Margin in code-behind, never
                                 affects row layout. Drawn on top so rows underneath don't
                                 reflow when it appears. -->
                            <Border x:Name="DropIndicator" Height="3"
                                    Background="#58A6FF"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                    Margin="6,0,6,0" IsHitTestVisible="False"
                                    Visibility="Collapsed">

                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ─────────── RIGHT: BUILDER PANELS ─────────── -->
            <Grid x:Name="TrainingBuilderColumn" Grid.Column="1" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Background="#58A6FF" Margin="0,2,10,2"/>
                                    <TextBlock Text="ADD A TIMER" Foreground="#58A6FF" Style="{StaticResource SectionCaption}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Create one custom interval and append it to the queue."
                                           Style="{StaticResource HelperText}" Margin="0,6,0,12"/>

                                <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NewTitleBox" Text="WARM-UP"
                                         AutomationProperties.Name="New timer title"
                                         Style="{StaticResource InputBox}" FontSize="15"
                                         MaxLength="40"
                                         KeyDown="OnNewTitleBoxKeyDown"
                                         ToolTip="Press Enter to add this timer to the queue"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Minutes" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NewMinutesBox" Text="5"
                                                 AutomationProperties.Name="New timer minutes"
                                                 Style="{StaticResource InputBox}" FontSize="22"
                                                 TextAlignment="Center" Padding="8,8"
                                                 PreviewTextInput="OnNumericPreviewTextInput"
                                                 KeyDown="OnNumericKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Seconds" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NewSecondsBox" Text="0"
                                                 AutomationProperties.Name="New timer seconds"
                                                 Style="{StaticResource InputBox}" FontSize="22"
                                                 TextAlignment="Center" Padding="8,8"
                                                 PreviewTextInput="OnNumericPreviewTextInput"
                                                 KeyDown="OnNumericKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TrainingEntryError" Visibility="Collapsed"
                                           Foreground="{StaticResource Training.ErrorBrush}" TextWrapping="Wrap"
                                           FontSize="14" Margin="0,10,0,0"/>
                                <Button x:Name="AddTimerButton" Click="OnAddTimerClicked"
                                        Content="＋  ADD TO QUEUE"
                                        Style="{StaticResource ActionButton}"
                                        Background="#1E40AF" Foreground="#EFF6FF" BorderBrush="#3B82F6"
                                        Padding="14,11" Margin="0,14,0,0"
                                        FontWeight="SemiBold" FontSize="14"
                                        ToolTip="Add this timer to the end of the queue (Enter while typing the title)"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Background="#3FB950" Margin="0,2,10,2"/>
                                    <TextBlock Text="RECENT TIMERS" Foreground="#3FB950" Style="{StaticResource SectionCaption}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Your last-used timers — click to append. Persists across app launches."
                                           Style="{StaticResource HelperText}" Margin="0,6,0,12"/>
                                <WrapPanel x:Name="RecentTimersPanel"/>
                                <TextBlock x:Name="RecentTimersEmptyText"
                                           Text="No recent timers yet — add one above and it'll appear here."
                                           Style="{StaticResource HelperText}" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Background="#FBBF24" Margin="0,2,10,2"/>
                                    <TextBlock Text="INTERVAL BUILDER" Foreground="#FBBF24" Style="{StaticResource SectionCaption}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Adds work timers with optional rest between rounds."
                                           Style="{StaticResource HelperText}" Margin="0,6,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Rounds" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="IntervalRoundsBox" Text="8" AutomationProperties.Name="Interval rounds" ToolTip="1 to 100 whole rounds"
                                                 Style="{StaticResource InputBox}" FontSize="18"
                                                 TextAlignment="Center" Padding="6,6"
                                                 PreviewTextInput="OnNumericPreviewTextInput"
                                                 KeyDown="OnNumericKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Text="Work (s)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="IntervalWorkBox" Text="20" AutomationProperties.Name="Work seconds" ToolTip="At least 1 whole second of work"
                                                 Style="{StaticResource InputBox}" FontSize="18"
                                                 TextAlignment="Center" Padding="6,6"
                                                 PreviewTextInput="OnNumericPreviewTextInput"
                                                 KeyDown="OnNumericKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="Rest (s)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="IntervalRestBox" Text="10" AutomationProperties.Name="Rest seconds" ToolTip="Whole seconds of rest; use 0 for no rest"
                                                 Style="{StaticResource InputBox}" FontSize="18"
                                                 TextAlignment="Center" Padding="6,6"
                                                 PreviewTextInput="OnNumericPreviewTextInput"
                                                 KeyDown="OnNumericKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TrainingIntervalError" Visibility="Collapsed" Foreground="{StaticResource Training.ErrorBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,10,0,0"/>
                                <Button x:Name="BuildIntervalButton" Click="OnBuildIntervalClicked"
                                        Content="＋  BUILD INTERVAL SESSION"
                                        Style="{StaticResource ActionButton}"
                                        Background="#9A3412" Foreground="#FFEDD5" BorderBrush="#F97316"
                                        Padding="14,11" Margin="0,14,0,0"
                                        FontWeight="SemiBold" FontSize="13"
                                        ToolTip="Append all rounds to the queue as alternating WORK/REST timers"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                            <StackPanel>
                                <TextBlock Text="KEYBOARD SHORTCUTS" Foreground="#C9D1D9"
                                           Style="{StaticResource SectionCaption}" FontSize="11"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="#19191C" BorderBrush="#3A3A40"
                                            BorderThickness="1" Padding="8,2" Margin="0,0,8,4">
                                        <TextBlock Text="Space" Foreground="#E5E7EB" FontFamily="{DynamicResource ControlCentre.Font}"
                                                   FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Start / pause active timer"
                                               Style="{StaticResource HelperText}" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#19191C" BorderBrush="#3A3A40"
                                            BorderThickness="1" Padding="8,2" Margin="0,0,8,4">
                                        <TextBlock Text="S" Foreground="#E5E7EB" FontFamily="{DynamicResource ControlCentre.Font}"
                                                   FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Skip to next timer"
                                               Style="{StaticResource HelperText}" VerticalAlignment="Center"/>
                                    <Border Grid.Row="2" Grid.Column="0" Background="#19191C" BorderBrush="#3A3A40"
                                            BorderThickness="1" Padding="8,2" Margin="0,0,8,4">
                                        <TextBlock Text="R" Foreground="#E5E7EB" FontFamily="{DynamicResource ControlCentre.Font}"
                                                   FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Reset active timer"
                                               Style="{StaticResource HelperText}" VerticalAlignment="Center"/>
                                    <Border Grid.Row="3" Grid.Column="0" Background="#19191C" BorderBrush="#3A3A40"
                                            BorderThickness="1" Padding="8,2" Margin="0,0,8,0">
                                        <TextBlock Text="Esc" Foreground="#E5E7EB" FontFamily="{DynamicResource ControlCentre.Font}"
                                                   FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Exit Training Mode"
                                               Style="{StaticResource HelperText}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid></ScrollViewer>
        </Grid>
    </views:OperatorViewport>
        <!-- Local queue review is outside the scrolling/minimum-width canvas.
             Only its decorative shell expands; labels and input bounds stay fixed. -->
        <Border x:Name="TrainingClearReviewOverlay" Tag="training-clear-review" Visibility="Collapsed"
                Background="#99080A12" Padding="16" Panel.ZIndex="200" Focusable="True"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
            <Grid MaxWidth="600" MaxHeight="480" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <views:OperatorGlassSurface x:Name="TrainingClearReviewShell" Visibility="Collapsed"
                    Material="Regular" GlassSource="{Binding ElementName=TrainingClearDecisionHost}"
                    Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}"
                    BorderThickness="1" CornerRadius="26" IsHitTestVisible="False"/>
                <!-- Keep the decision and both actions stationary and reachable;
                     only potentially long drill context scrolls inside the sheet. -->
                <Grid x:Name="TrainingClearReviewContent" Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="TrainingClearReviewHeading" Text="Clear all timers?" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap"/>
                    <ScrollViewer x:Name="TrainingClearReviewScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Focusable="False">
                        <TextBlock x:Name="TrainingClearReviewContext" FontSize="15" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="This cannot be undone. Opening this review does not pause the session." Margin="0,10,0,18" FontSize="13" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="TrainingClearReviewActions" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!-- Leaving a session has its own source and consequence; only this
             decorative shell travels. Heading and actions remain pinned. -->
        <Border x:Name="TrainingExitReviewOverlay" Tag="training-exit-review" Visibility="Collapsed"
                Background="#A0080A12" Padding="16" Panel.ZIndex="201" Focusable="True"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
            <Grid MaxWidth="560" MaxHeight="440" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <views:OperatorGlassSurface x:Name="TrainingExitReviewShell" Visibility="Collapsed"
                    Material="Regular" GlassSource="{Binding ElementName=TrainingClearDecisionHost}"
                    Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}"
                    BorderThickness="1" CornerRadius="30" IsHitTestVisible="False"/>
                <Grid x:Name="TrainingExitReviewContent" Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <motion:OperatorSymbol Kind="back" Width="24" Height="24" Margin="0,0,10,0" Foreground="{DynamicResource ControlCentre.TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TrainingExitReviewHeading" Grid.Column="1" Text="Exit Training?" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock x:Name="TrainingExitReviewStatus" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer x:Name="TrainingExitReviewScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Focusable="False">
                        <TextBlock x:Name="TrainingExitReviewContext" FontSize="15" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="This Training session cannot be resumed after exit. Your saved matches are kept." Margin="0,10,0,18" FontSize="13" Foreground="{DynamicResource ControlCentre.TextBrush}" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="TrainingExitReviewActions" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
