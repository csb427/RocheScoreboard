<UserControl x:Class="Roche_Scoreboard.Views.SportSelectionScreen"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:motion="clr-namespace:Roche_Scoreboard.Services"
 xmlns:local="clr-namespace:Roche_Scoreboard.Views"
 Background="#070A0F" SizeChanged="SportViewport_SizeChanged" motion:OperatorDesign.IsEnabled="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Resources/OperatorControls.xaml"/>
  <ResourceDictionary Source="../Resources/ControlCentre.xaml"/>
 </ResourceDictionary.MergedDictionaries>
  <LinearGradientBrush x:Key="HomeIconFill" StartPoint=".2,0" EndPoint=".8,1"><GradientStop Color="White"/><GradientStop Color="#D5DEE9" Offset=".55"/><GradientStop Color="#8E9BAC" Offset="1"/></LinearGradientBrush>
  <Style x:Key="SportsLaunchSurface" TargetType="Button">
   <Setter Property="motion:CricketActionMotion.Enabled" Value="False"/><Setter Property="motion:OperatorControlMotion.Enabled" Value="False"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Grid x:Name="PART_Surface" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><ScaleTransform x:Name="TbSc"/></Grid.RenderTransform><Border x:Name="PressWash" CornerRadius="32" Background="Transparent" Opacity="0" IsHitTestVisible="False"/><Border x:Name="ActionGlow" CornerRadius="32" Background="Transparent" Opacity="0" IsHitTestVisible="False"/></Grid></Grid><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="PressWash" Property="Opacity" Value=".1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HomeUtility" TargetType="Button" BasedOn="{StaticResource ToolBtn}"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="ReleaseFilter" TargetType="Button" BasedOn="{StaticResource ToolBtn}"><Setter Property="MinHeight" Value="38"/><Setter Property="MinWidth" Value="68"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="13,7"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="ReleaseDisclosure" TargetType="Expander">
   <Setter Property="motion:DisclosureMotion.Enabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="#A9D9FF" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{x:Null}" MinHeight="40" Padding="10,8" Margin="24,2,0,0">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="DisclosureHeader" CornerRadius="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DisclosureHeader" Property="Background" Value="#1C9DCFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="DisclosureHeader" Property="Background" Value="#339DCFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DisclosureHeader" Property="BorderBrush" Value="#A9D9FF"/><Setter TargetName="DisclosureHeader" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton><ContentPresenter x:Name="Body" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer x:Name="ResponsiveScrollHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" PanningMode="Both" CanContentScroll="False" PreviewMouseWheel="ResponsiveScrollHost_PreviewMouseWheel">
 <Grid x:Name="SportViewport" Width="{Binding ViewportWidth, ElementName=ResponsiveScrollHost}" Height="{Binding ViewportHeight, ElementName=ResponsiveScrollHost}" ClipToBounds="True">
  <Grid x:Name="HomeBackdrop" IsHitTestVisible="False"><local:OperatorSceneBackdrop/><Border><Border.Background><RadialGradientBrush Center=".5,.45" GradientOrigin=".5,.45" RadiusX=".65" RadiusY=".85"><GradientStop Color="#002B3C55"/><GradientStop Color="#3C02070D" Offset="1"/></RadialGradientBrush></Border.Background></Border></Grid>
  <Grid x:Name="HomeLayout" Margin="28,22,28,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="HomeToolbar">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <local:OperatorGlassSurface x:Name="SettingsTile" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="24" HorizontalAlignment="Left" Padding="14,9" Cursor="Hand" BorderBrush="#60FFFFFF" BorderThickness="1" MouseLeftButtonUp="Settings_Click" MouseEnter="SettingsTile_MouseEnter" MouseLeave="SettingsTile_MouseLeave">
     <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="SettingsTileScale"/><TranslateTransform x:Name="SettingsTileTranslate"/></TransformGroup></Border.RenderTransform>
     <Border.Effect><DropShadowEffect x:Name="SettingsTileGlow" BlurRadius="18" ShadowDepth="4" Color="Black" Opacity=".18"/></Border.Effect>
     <StackPanel Orientation="Horizontal"><motion:OperatorSymbol Kind="Settings" Width="22" Height="22" Margin="0,0,9,0" Foreground="White"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SettingsActionCaption" Text="Settings" Foreground="White" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="SettingsSubtitle" Text="Application preferences" Foreground="#B9C4D4" FontSize="12" Margin="0,2,0,0"/></StackPanel></StackPanel>
    </local:OperatorGlassSurface>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
     <local:OperatorGlassSurface x:Name="ResumeUtilitySurface" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="24" Margin="8,0,0,0" Visibility="{Binding Visibility, ElementName=ResumeSavedMatchButton}"><Button x:Name="ResumeSavedMatchButton" Content="Continue match" Visibility="Collapsed" Style="{StaticResource HomeUtility}" Click="ResumeSavedMatch_Click" ToolTip="Resume the match you chose to continue later"/></local:OperatorGlassSurface>
     <local:OperatorGlassSurface Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="24" Margin="8,0,0,0">
      <Button x:Name="ChangelogToggle" Style="{StaticResource HomeUtility}" Click="ChangelogToggle_Click">
       <StackPanel Orientation="Horizontal"><motion:OperatorSymbol x:Name="UpdatesActionIcon" Kind="Updates" Width="20" Height="20" Margin="0,0,8,0" Foreground="White"/><StackPanel><TextBlock Text="What’s New" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Text="Latest release" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/></StackPanel></StackPanel>
      </Button>
     </local:OperatorGlassSurface>
    </StackPanel>
   </Grid>
   <Border x:Name="HeaderPanel" Grid.Row="1" Background="Transparent" Margin="0,28,0,22" IsHitTestVisible="False">
    <Border.RenderTransform><TranslateTransform x:Name="HeaderTranslate"/></Border.RenderTransform>
    <StackPanel><TextBlock x:Name="HomeHeading" Text="Choose a sport" Foreground="White" FontSize="32" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="HomeSubtitle" Text="Start a match or a training session." Foreground="#D8E2EC" FontSize="15" TextAlignment="Center" Margin="0,7,0,0"/></StackPanel>
   </Border>
   <Grid x:Name="SportCardsGrid" Grid.Row="2" MaxWidth="1100" Height="330" VerticalAlignment="Center" HorizontalAlignment="Stretch">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <local:OperatorGlassSurface x:Name="HomeInteractionLens" Material="Clear" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="36" Width="0" Height="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="3" Grid.RowSpan="3"><Border.RenderTransform><TranslateTransform x:Name="HomeLensTranslate"/></Border.RenderTransform></local:OperatorGlassSurface>
    <local:OperatorGlassSurface x:Name="AflCard" Grid.Column="0" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="36" Margin="10" Cursor="Hand" ClipToBounds="True" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" MouseLeftButtonUp="AFL_Click" RenderTransformOrigin=".5,.5">
     <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="AflCardScale"/><TranslateTransform x:Name="AflCardTranslate"/></TransformGroup></Border.RenderTransform>
     <Grid>
      <Border x:Name="AflGlow" CornerRadius="36" BorderBrush="#CFFFFFFF" BorderThickness="2" Opacity=".1" IsHitTestVisible="False"/>
      <Border IsHitTestVisible="False" Opacity="0"><Border.RenderTransform><TranslateTransform x:Name="AflBeamTranslate"/></Border.RenderTransform></Border>
      <Grid x:Name="AflTileBody" Margin="20,18,20,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Viewbox x:Name="AflContentFit" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="165" Margin="0,0,0,12">
        <Border x:Name="AflIconGroup" Width="145" Height="155" RenderTransformOrigin=".5,.5"><Border.RenderTransform><TransformGroup><ScaleTransform x:Name="AflIconScale"/><TranslateTransform x:Name="AflIconFloat"/><TranslateTransform x:Name="AflIconHover"/></TransformGroup></Border.RenderTransform>
         <motion:OperatorSymbol Kind="afl" Width="124" Height="124" Foreground="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
       </Viewbox>
       <StackPanel x:Name="AflTextPanel" Grid.Row="1"><StackPanel.RenderTransform><TranslateTransform x:Name="AflTextTranslate"/></StackPanel.RenderTransform><TextBlock Text="AFL" FontSize="26" FontWeight="SemiBold" Foreground="White" TextAlignment="Center"/><TextBlock x:Name="AflDescription" Text="Australian football" FontSize="14" Foreground="#D8E2EC" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
      </Grid>
      <Border x:Name="AflHover" CornerRadius="36" Background="White" Opacity="0" IsHitTestVisible="False"/><Border x:Name="AflFlash" CornerRadius="36" Background="White" Opacity="0" IsHitTestVisible="False"/>
     </Grid>
    </local:OperatorGlassSurface>
    <local:OperatorGlassSurface x:Name="CricketCard" Grid.Column="1" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="36" Margin="10" Cursor="Hand" ClipToBounds="True" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" MouseLeftButtonUp="Cricket_Click" RenderTransformOrigin=".5,.5">
     <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="CricketCardScale"/><TranslateTransform x:Name="CricketCardTranslate"/></TransformGroup></Border.RenderTransform>
     <Grid>
      <Border x:Name="CricketGlow" CornerRadius="36" BorderBrush="#CFFFFFFF" BorderThickness="2" Opacity=".1" IsHitTestVisible="False"/>
      <Border IsHitTestVisible="False" Opacity="0"><Border.RenderTransform><TranslateTransform x:Name="CricketBeamTranslate"/></Border.RenderTransform></Border>
      <Grid x:Name="CricketTileBody" Margin="20,18,20,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Viewbox x:Name="CricketContentFit" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="165" Margin="0,0,0,12">
        <Border x:Name="CricketIconGroup" Width="155" Height="155" RenderTransformOrigin=".5,.5"><Border.RenderTransform><TransformGroup><ScaleTransform x:Name="CricketIconScale"/><TranslateTransform x:Name="CricketIconFloat"/><TranslateTransform x:Name="CricketIconHover"/></TransformGroup></Border.RenderTransform>
         <motion:OperatorSymbol Kind="cricket" Width="124" Height="124" Foreground="#30D994" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
       </Viewbox>
       <StackPanel x:Name="CricketTextPanel" Grid.Row="1"><StackPanel.RenderTransform><TranslateTransform x:Name="CricketTextTranslate"/></StackPanel.RenderTransform><TextBlock Text="Cricket" FontSize="26" FontWeight="SemiBold" Foreground="White" TextAlignment="Center"/><TextBlock x:Name="CricketDescription" Text="Every innings" FontSize="14" Foreground="#D8E2EC" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
      </Grid>
      <Border x:Name="CricketHover" CornerRadius="36" Background="White" Opacity="0" IsHitTestVisible="False"/><Border x:Name="CricketFlash" CornerRadius="36" Background="White" Opacity="0" IsHitTestVisible="False"/>
     </Grid>
    </local:OperatorGlassSurface>
    <local:OperatorGlassSurface x:Name="TrainingCard" Grid.Column="2" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="36" Margin="10" Cursor="Hand" ClipToBounds="True" MouseEnter="TrainingTile_MouseEnter" MouseLeave="TrainingTile_MouseLeave" MouseLeftButtonUp="Training_Click" RenderTransformOrigin=".5,.5">
     <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="TrainingTileScale"/><TranslateTransform x:Name="TrainingTileTranslate"/></TransformGroup></Border.RenderTransform>
     <Border.Effect><DropShadowEffect x:Name="TrainingTileGlow" Color="#A8C1DF" BlurRadius="16" ShadowDepth="0" Opacity=".12"/></Border.Effect>
     <Grid x:Name="TrainingContentRoot" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><ScaleTransform x:Name="TrainingContentScale"/></Grid.RenderTransform>
      <Border x:Name="TrainingGlassEdge" CornerRadius="36" BorderBrush="#CFFFFFFF" BorderThickness="2" Opacity=".12" IsHitTestVisible="False"/>
      <Grid x:Name="TrainingTileBody" Margin="20,18,20,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Viewbox x:Name="TrainingContentFit" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="165" Margin="0,0,0,12"><Canvas Width="145" Height="155" RenderTransformOrigin=".5,.5"><Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="TrainingIconMotionScale"/><TranslateTransform x:Name="TrainingIconMotionShift"/></TransformGroup></Canvas.RenderTransform><motion:OperatorSymbol Kind="training" Width="124" Height="124" Foreground="#73B9FF" Canvas.Left="10" Canvas.Top="10"/></Canvas></Viewbox>
       <StackPanel x:Name="TrainingTextPanel" Grid.Row="1"><TextBlock Text="Training" FontSize="26" FontWeight="SemiBold" Foreground="White" TextAlignment="Center"/><TextBlock x:Name="TrainingDescription" Text="Sessions and drills" FontSize="14" Foreground="#D8E2EC" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
      </Grid><Border x:Name="TrainingHover" CornerRadius="36" Background="White" Opacity="0" IsHitTestVisible="False"/><Border x:Name="TrainingFlash" CornerRadius="36" Background="White" Opacity="0" IsHitTestVisible="False"/>
     </Grid>
    </local:OperatorGlassSurface>
    <Grid Visibility="Collapsed" IsHitTestVisible="False"><Grid.RenderTransform><ScaleTransform x:Name="DividerScale"/></Grid.RenderTransform><Border x:Name="DividerGlowLine"/></Grid>
   </Grid>
  </Grid>
  <Border x:Name="BottomAccent" Height="1" Background="#24FFFFFF" VerticalAlignment="Bottom" Margin="28,0,28,0" IsHitTestVisible="False"/>
  <Grid x:Name="ChangelogOverlay" Panel.ZIndex="100" Visibility="Collapsed" Opacity="0" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True" PreviewKeyDown="ChangelogOverlay_PreviewKeyDown">
   <Border Background="#A5020509" MouseLeftButtonUp="ChangelogBackdrop_Click"/>
   <local:OperatorGlassSurface x:Name="ChangelogPanel" Material="Regular" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="32" MaxWidth="1080" Margin="22" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin=".5,.5">
    <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="ChangelogPanelScale" ScaleX=".96" ScaleY=".96"/><TranslateTransform x:Name="ChangelogPanelTranslate" Y="24"/></TransformGroup></Border.RenderTransform>
        <Grid x:Name="ReleaseSheetBody" Margin="26">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid x:Name="ReleaseHeader">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="ReleaseSheetHeading" Text="What’s New" FontSize="30" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="ReleaseSheetSubtitle" Text="Explore the latest release." FontSize="14" Foreground="#BAC5D6" Margin="0,5,12,0" TextWrapping="Wrap"/></StackPanel>
      <ComboBox x:Name="ReleaseVersionChoice" Grid.Column="1" Width="114" MinHeight="38" Margin="8,0,8,0" VerticalAlignment="Top" Visibility="Collapsed" SelectedValuePath="Tag" Style="{StaticResource SettingsChoice}" SelectionChanged="ReleaseVersionChoice_SelectionChanged" AutomationProperties.Name="Choose release"/>
      <Button Grid.Column="2" Width="44" Height="44" MinHeight="0" Padding="0" Content="×" FontSize="25" VerticalAlignment="Top" Click="ChangelogClose_Click" AutomationProperties.Name="Close What's New"/>
     </Grid>
     <Grid x:Name="ReleaseSearchHost" Grid.Row="1" Margin="0,18,0,10">
      <local:OperatorSearchBox x:Name="ChangelogSearchBox" Placeholder="Search changes or a version" MinHeight="44" FontSize="15" TextChanged="ChangelogSearch_TextChanged" AutomationProperties.Name="Search releases"/>
     </Grid>
     <Grid x:Name="ReleaseFilterHost" Grid.Row="2" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <WrapPanel x:Name="ReleaseFilters"><Button x:Name="AllReleaseFilter" Content="All" Tag="All" Style="{StaticResource ReleaseFilter}" Click="ChangelogFilter_Click"/><Button x:Name="NewReleaseFilter" Content="New" Tag="New" Style="{StaticResource ReleaseFilter}" Click="ChangelogFilter_Click"/><Button x:Name="FixedReleaseFilter" Content="Fixed" Tag="Fixed" Style="{StaticResource ReleaseFilter}" Click="ChangelogFilter_Click"/></WrapPanel>
      <TextBlock x:Name="ReleaseResultCount" Grid.Column="1" Foreground="#B8C4D6" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
     </Grid>
     <Grid x:Name="ReleaseLayout" Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <local:OperatorGlassSurface x:Name="ReleaseVersionRail" Material="Clear" GlassSource="{Binding ElementName=HomeBackdrop}" CornerRadius="25" Grid.RowSpan="2" Padding="8">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="ReleaseHistoryHeading" Text="Releases" Foreground="#C1D0E2" FontSize="13" FontWeight="SemiBold" Margin="9,7,9,12"/>
        <ScrollViewer x:Name="ReleaseHistoryScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="ReleaseVersionButtons" Orientation="Vertical"/></ScrollViewer>
       </Grid>
      </local:OperatorGlassSurface>
      <ScrollViewer x:Name="ReleaseScroller" Grid.Column="1" Grid.RowSpan="2" Margin="20,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,2"><StackPanel x:Name="ChangelogEntries"/></ScrollViewer>
     </Grid>
    </Grid>
</local:OperatorGlassSurface>
  </Grid>
 </Grid>
 </ScrollViewer>
</UserControl>
