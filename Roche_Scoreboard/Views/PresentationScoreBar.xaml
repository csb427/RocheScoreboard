<UserControl x:Class="Roche_Scoreboard.Views.PresentationScoreBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="386"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <!--
        Distance-first persistent score bar. Goals and behinds remain available
        on the live scorebug and Quarter Breakdown; this compact bar dedicates
        each team panel to the match total so no unreadable micro-score is shown.

        Layout columns (left -> right):
            HOME panel  | LOGO | CENTRE quarter+clock | LOGO | AWAY panel
        Totals stay adjacent to the team logos and centre match-state cell,
        producing one consistent score hierarchy on every presentation.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="HomeLogoColumn" Width="42"/>
            <ColumnDefinition x:Name="CenterColumn" Width="80"/>
            <ColumnDefinition x:Name="AwayLogoColumn" Width="42"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =========================== HOME PANEL =========================== -->
        <Grid Grid.Column="0" x:Name="HomePanel" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="HomePanelGradStart" Color="#5C2118" Offset="0.0"/>
                    <GradientStop x:Name="HomePanelGradEnd"   Color="#C9483B" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- 3D top-light overlay -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <TextBlock x:Name="HomeTotalText" Text="0" Foreground="White"
                           FontFamily="Arial" FontStretch="Normal" FontSize="30" FontWeight="Black"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                <Rectangle x:Name="HomeGoalFlash" Opacity="0" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Border x:Name="HomeDeltaOverlay" Opacity="0" IsHitTestVisible="False" Background="White" Panel.ZIndex="20">
                    <Border.RenderTransform><TranslateTransform x:Name="HomeDeltaTranslate"/></Border.RenderTransform>
                    <TextBlock x:Name="HomeDeltaText" Text="+6" FontFamily="Arial" FontSize="32" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>

        <!-- 3D separator: home panel -> home logo -->
        <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="3" IsHitTestVisible="False" Panel.ZIndex="50">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- =========================== HOME LOGO =========================== -->
        <Border Grid.Column="1" x:Name="HomeLogoCell" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="HomeLogoCellGradStart" Color="#5C2118" Offset="0.0"/>
                    <GradientStop x:Name="HomeLogoCellGradEnd"   Color="#C9483B" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="3">
                <TextBlock x:Name="HomeLogoFallback" Text="HOM" Foreground="#EEEEEE"
                           FontWeight="Black" FontFamily="Bahnschrift" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="HomeLogoImage" Stretch="Uniform" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 3D separator: home logo -> centre -->
        <Rectangle Grid.Column="1" HorizontalAlignment="Right" Width="3" IsHitTestVisible="False" Panel.ZIndex="50">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- =========================== CENTRE: QUARTER / CLOCK =========================== -->
        <Grid Grid.Column="2" x:Name="CenterPanel">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A1F2E" Offset="0.0"/>
                    <GradientStop Color="#0A0D14" Offset="0.5"/>
                    <GradientStop Color="#000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid Margin="3,2">
                <Grid x:Name="LiveCenterPanel">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="3,1">
                        <TextBlock x:Name="LiveCenterText" Text="Q1 14′" Foreground="White"
                                   FontFamily="Arial Black" FontSize="31" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                    </Viewbox>
                </Grid>
                <Viewbox x:Name="BreakCenterPanel" Visibility="Collapsed" Stretch="Uniform" StretchDirection="Both" Margin="2,0">
                    <TextBlock x:Name="BreakCenterText" Text="QT" Foreground="White"
                               FontFamily="Arial Black" FontSize="38" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                </Viewbox>
            </Grid>
        </Grid>

        <!-- 3D separator: centre -> away logo -->
        <Rectangle Grid.Column="2" HorizontalAlignment="Right" Width="3" IsHitTestVisible="False" Panel.ZIndex="50">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- =========================== AWAY LOGO =========================== -->
        <Border Grid.Column="3" x:Name="AwayLogoCell" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="AwayLogoCellGradStart" Color="#5C470A" Offset="0.0"/>
                    <GradientStop x:Name="AwayLogoCellGradEnd"   Color="#B68F12" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="3">
                <TextBlock x:Name="AwayLogoFallback" Text="AWA" Foreground="#EEEEEE"
                           FontWeight="Black" FontFamily="Bahnschrift" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="AwayLogoImage" Stretch="Uniform" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 3D separator: away logo -> away panel -->
        <Rectangle Grid.Column="3" HorizontalAlignment="Right" Width="3" IsHitTestVisible="False" Panel.ZIndex="50">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- =========================== AWAY PANEL =========================== -->
        <Grid Grid.Column="4" x:Name="AwayPanel" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="AwayPanelGradStart" Color="#B68F12" Offset="0.0"/>
                    <GradientStop x:Name="AwayPanelGradEnd"   Color="#5C470A" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- 3D top-light overlay -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <TextBlock x:Name="AwayTotalText" Text="0" Foreground="White"
                           FontFamily="Arial" FontStretch="Normal" FontSize="30" FontWeight="Black"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Rectangle x:Name="AwayGoalFlash" Opacity="0" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Border x:Name="AwayDeltaOverlay" Opacity="0" IsHitTestVisible="False" Background="White" Panel.ZIndex="20">
                    <Border.RenderTransform><TranslateTransform x:Name="AwayDeltaTranslate"/></Border.RenderTransform>
                    <TextBlock x:Name="AwayDeltaText" Text="+6" FontFamily="Arial" FontSize="32" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                </Border>

            </Grid>
        </Grid>

        <!-- Top + bottom hairlines for crisp scorebug edge -->
        <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Top"  Background="#66000000" IsHitTestVisible="False"/>
        <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Background="#88000000" IsHitTestVisible="False"/>

    </Grid>
</UserControl>
