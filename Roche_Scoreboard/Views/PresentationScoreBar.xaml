<UserControl x:Class="Roche_Scoreboard.Views.PresentationScoreBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="44" d:DesignWidth="386"
             Height="44">

    <!--
        Broadcast-style compact score bar.
        Mirrors the main scorebug layout: team-colour gradient panels, dark
        centre quarter/clock panel, scorebug-style 3D separator bars between
        Goals | Behinds | Total cells, Stolzl typography, transparent score
        cells sharing the panel gradient.

        Layout columns (left -> right):
            HOME panel  | LOGO | CENTRE quarter+clock | LOGO | AWAY panel
        Score order:
            HOME:   Total  Behinds  Goals     (logo on right edge of home panel)
            AWAY:   Goals  Behinds  Total     (logo on left edge of away panel)
        - Totals are kept adjacent to the centre so the headline score reads
          across like a real scorebug.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>      <!-- Home panel (scores) -->
            <ColumnDefinition Width="44"/>     <!-- Home logo -->
            <ColumnDefinition Width="62"/>     <!-- Centre: quarter / clock -->
            <ColumnDefinition Width="44"/>     <!-- Away logo -->
            <ColumnDefinition Width="*"/>      <!-- Away panel (scores) -->
        </Grid.ColumnDefinitions>

        <!-- =========================== HOME PANEL =========================== -->
        <Grid Grid.Column="0" x:Name="HomePanel" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="HomePanelGradStart" Color="#5C2118" Offset="0.0"/>
                    <GradientStop x:Name="HomePanelGradEnd"   Color="#C9483B" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- 3D top-light overlay -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>   <!-- Goals -->
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="1.25*"/>   <!-- Behinds -->
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="2.2*"/>    <!-- Total -->
                </Grid.ColumnDefinitions>

                <!-- Goals -->
                <TextBlock Grid.Column="0" x:Name="HomeGoalsText" Text="0" Foreground="White"
                           FontFamily="Stolzl" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

                <!-- 3D separator -->
                <Rectangle Grid.Column="1" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#55000000" Offset="0"/>
                            <GradientStop Color="#66FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Behinds -->
                <TextBlock Grid.Column="2" x:Name="HomeBehindsText" Text="0" Foreground="White"
                           FontFamily="Stolzl" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

                <!-- 3D separator -->
                <Rectangle Grid.Column="3" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#55000000" Offset="0"/>
                            <GradientStop Color="#66FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Total -->
                <TextBlock Grid.Column="4" x:Name="HomeTotalText" Text="0" Foreground="White"
                           FontFamily="Stolzl Bold" FontSize="30" FontWeight="Black"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- 3D separator: home panel -> home logo -->
        <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="3" IsHitTestVisible="False" Panel.ZIndex="50">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- =========================== HOME LOGO =========================== -->
        <Border Grid.Column="1" x:Name="HomeLogoCell" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="HomeLogoCellGradStart" Color="#5C2118" Offset="0.0"/>
                    <GradientStop x:Name="HomeLogoCellGradEnd"   Color="#C9483B" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="3">
                <TextBlock x:Name="HomeLogoFallback" Text="HOM" Foreground="#EEEEEE"
                           FontWeight="Black" FontFamily="Stolzl Bold" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="HomeLogoImage" Stretch="Uniform" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 3D separator: home logo -> centre -->
        <Rectangle Grid.Column="1" HorizontalAlignment="Right" Width="3" IsHitTestVisible="False" Panel.ZIndex="50">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- =========================== CENTRE: QUARTER / CLOCK =========================== -->
        <Grid Grid.Column="2" x:Name="CenterPanel">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A1F2E" Offset="0.0"/>
                    <GradientStop Color="#0A0D14" Offset="0.5"/>
                    <GradientStop Color="#000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="2,3">
                <StackPanel x:Name="CenterStack" Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock x:Name="QuarterText" Text="QT" Foreground="White"
                               FontFamily="Stolzl Bold" FontSize="40" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="TimerText" Text="14:37" Foreground="White"
                               FontFamily="Stolzl Bold" FontSize="32" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Viewbox>
        </Grid>

        <!-- 3D separator: centre -> away logo -->
        <Rectangle Grid.Column="2" HorizontalAlignment="Right" Width="3" IsHitTestVisible="False" Panel.ZIndex="50">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- =========================== AWAY LOGO =========================== -->
        <Border Grid.Column="3" x:Name="AwayLogoCell" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="AwayLogoCellGradStart" Color="#5C470A" Offset="0.0"/>
                    <GradientStop x:Name="AwayLogoCellGradEnd"   Color="#B68F12" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="3">
                <TextBlock x:Name="AwayLogoFallback" Text="AWA" Foreground="#EEEEEE"
                           FontWeight="Black" FontFamily="Stolzl Bold" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="AwayLogoImage" Stretch="Uniform" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 3D separator: away logo -> away panel -->
        <Rectangle Grid.Column="3" HorizontalAlignment="Right" Width="3" IsHitTestVisible="False" Panel.ZIndex="50">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#55000000" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- =========================== AWAY PANEL =========================== -->
        <Grid Grid.Column="4" x:Name="AwayPanel" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="AwayPanelGradStart" Color="#B68F12" Offset="0.0"/>
                    <GradientStop x:Name="AwayPanelGradEnd"   Color="#5C470A" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- 3D top-light overlay -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>   <!-- Goals -->
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="1.25*"/>   <!-- Behinds -->
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="2.2*"/>    <!-- Total -->
                </Grid.ColumnDefinitions>

                <!-- Goals -->
                <TextBlock Grid.Column="0" x:Name="AwayGoalsText" Text="0" Foreground="White"
                           FontFamily="Stolzl" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

                <!-- 3D separator -->
                <Rectangle Grid.Column="1" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#55000000" Offset="0"/>
                            <GradientStop Color="#66FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Behinds -->
                <TextBlock Grid.Column="2" x:Name="AwayBehindsText" Text="0" Foreground="White"
                           FontFamily="Stolzl" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

                <!-- 3D separator -->
                <Rectangle Grid.Column="3" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#55000000" Offset="0"/>
                            <GradientStop Color="#66FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Total -->
                <TextBlock Grid.Column="4" x:Name="AwayTotalText" Text="0" Foreground="White"
                           FontFamily="Stolzl Bold" FontSize="30" FontWeight="Black"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Top + bottom hairlines for crisp scorebug edge -->
        <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Top"  Background="#66000000" IsHitTestVisible="False"/>
        <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Background="#88000000" IsHitTestVisible="False"/>

        <!-- Finals gold tint overlay — toggled by SetFinalsMode in code-behind -->
        <Rectangle x:Name="ScoreBarFinalsGoldOverlay" Grid.ColumnSpan="5"
                   Panel.ZIndex="200" IsHitTestVisible="False" Opacity="0">
            <Rectangle.Fill>
                <SolidColorBrush Color="#C8980A"/>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
