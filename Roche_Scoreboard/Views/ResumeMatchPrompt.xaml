<UserControl x:Class="Roche_Scoreboard.Views.ResumeMatchPrompt" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:design="clr-namespace:Roche_Scoreboard.Services" design:OperatorDesign.IsEnabled="True" MaxWidth="580" MaxHeight="430" SizeChanged="Prompt_SizeChanged" Focusable="True" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Window_PreviewKeyDown">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/OperatorControls.xaml"/><ResourceDictionary Source="../Resources/CricketActions.xaml"/><ResourceDictionary Source="../Resources/ControlCentre.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<glass:OperatorGlassSurface x:Name="DialogShell" Material="Regular" GlassSource="{Binding Content, RelativeSource={RelativeSource AncestorType=Window}}" Padding="26" CornerRadius="30" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="#68FFFFFF" BorderThickness="1" TextElement.Foreground="{DynamicResource ControlCentre.TextBrush}" TextElement.FontFamily="Segoe UI Variable, Segoe UI">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="PromptHeading" Text="CONTINUE YOUR MATCH?" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="PhaseText" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="14" Margin="0,8,0,12"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<Border x:Name="HomeTeamCard" Style="{StaticResource SettingsSectionSurface}" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="HomeLogoImage" Height="38" Stretch="Uniform"/><TextBlock Foreground="White" x:Name="HomeNameText" Grid.Column="1" Margin="12,0,0,0" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
<Border x:Name="AwayTeamCard" Style="{StaticResource SettingsSectionSurface}" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="AwayLogoImage" Height="38" Stretch="Uniform"/><TextBlock Foreground="White" x:Name="AwayNameText" Grid.Column="1" Margin="12,0,0,0" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2">
<UniformGrid Columns="2"><Button x:Name="LaterButton" Content="CONTINUE LATER" Click="KeepSaved_Click" Style="{StaticResource ControlCentre.Button}" FontSize="14" Padding="8,0" MinHeight="0" Height="46" Margin="0,0,6,0"/><Button x:Name="ResumeButton" Content="CONTINUE MATCH  →" Click="Resume_Click" Style="{StaticResource ControlCentre.PrimaryButton}" FontSize="14" Padding="8,0" MinHeight="0" Height="46" Margin="6,0,0,0" IsDefault="True"/></UniformGrid>
<Button x:Name="DiscardButton" Content="DISCARD SAVE" Click="Discard_Click" Style="{StaticResource ControlCentre.Button}" MinHeight="0" FontSize="13" Padding="8,0" Height="38" Margin="0,12,0,0" Foreground="#FFA3AA" Background="#302024" BorderBrush="#66424A"/>
<ProgressBar x:Name="DiscardConfirmationProgress" Minimum="0" Maximum="1" Value="0" Height="2" Margin="14,5,14,0" Foreground="#FF9BA3" Background="Transparent" BorderThickness="0" Visibility="Hidden" IsHitTestVisible="False"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="Transparent"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1"/></Grid></ControlTemplate></ProgressBar.Template></ProgressBar>
</StackPanel></Grid></glass:OperatorGlassSurface></UserControl>
