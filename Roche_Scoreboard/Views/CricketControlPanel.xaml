            <TabItem x:Name="CricketSettingsTab" Header="4  SETTINGS" Tag="MATCH OPTIONS">
<local:SettingsWorkspace Heading="CRICKET SETTINGS" Subtitle="Match, controls and output">
<Grid x:Name="CricketSettingsColumns" Tag="MATCH|innings format bowler players recovery selections">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MATCH HEALTH" Style="{StaticResource SectionHead}" Foreground="#58A6FF"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="SettingsMatchText" Text="LIMITED OVERS • 20 OVERS" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SettingsStateText" Text="1ST INNINGS • 0/0 (0.0)" Foreground="#C4D0DD" FontSize="14" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <Border Height="1" Background="#3A3A40" Margin="0,12"/>
                                    <TextBlock x:Name="SettingsAutosaveText" Text="● LIVE RECOVERY ARMED" Foreground="#67D17B" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Every confirmed delivery is mirrored to the display, analytics, recovery state and connected remote." Foreground="#AAB7C5" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
<TextBlock Text="OPERATOR GUARD" Foreground="#F0C96A" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SettingsSelectionText" Text="Select both opening batters and a bowler to begin." Foreground="#D6E0EA" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="BROADCAST PREFERENCES" Style="{StaticResource SectionHead}"/>
                                <CheckBox x:Name="CricketEventAnimations" Content="Scoring celebrations" ToolTip="Four, six, wicket, 50 and 100 presentations" IsChecked="True" Style="{StaticResource SettingsToggle}" Checked="CricketPresentationPreference_Changed" Unchecked="CricketPresentationPreference_Changed"/>
                                <TextBlock Text="Play the moment first, then roll the figures. Scoring and recovery remain immediate." Foreground="#B9C9DC" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                <CheckBox x:Name="CricketRollingFigures" Content="Rolling figure updates" IsChecked="True" Style="{StaticResource SettingsToggle}" Checked="CricketPresentationPreference_Changed" Unchecked="CricketPresentationPreference_Changed"/>
                                <TextBlock Text="Turn off for instant, still figure updates." Foreground="#B9C9DC" TextWrapping="Wrap" Margin="0,8,0,14"/>
<CheckBox x:Name="CricketBowlerDetails" Content="Occasional bowler details in over strip" IsChecked="True" Style="{StaticResource SettingsToggle}" Checked="CricketPresentationPreference_Changed" Unchecked="CricketPresentationPreference_Changed"/>
<TextBlock Text="During quiet play, show economy and only the extras the current bowler has delivered. The ball strip returns as soon as play resumes." Foreground="#B9C9DC" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel></Border>
                        </StackPanel>
                    </Grid>

<Border Style="{StaticResource Card}" Tag="AUTOMATION|automatic overlays cancel hold manual">
<StackPanel><TextBlock Text="OVERLAY AUTOMATION" Style="{StaticResource SectionHead}"/>
<CheckBox x:Name="CricketAutomaticOverlays" Content="Automatic cricket overlays" IsChecked="True" Style="{StaticResource SettingsToggle}" Checked="AutoOverlays_Changed" Unchecked="AutoOverlays_Changed"/>
<TextBlock Text="Manual overlays remain available. Automatic selection favours fresh events and leaves quiet time after scoring and corrections." Foreground="#B6C2CF" FontSize="12" TextWrapping="Wrap" Margin="0,10"/>
<Button Content="CANCEL CURRENT OVERLAY" Style="{StaticResource ToolBtn}" Click="CancelCricketOverlay_Click" Height="42"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}" Tag="SYSTEM|application preferences output window dimensions appearance">
<StackPanel><TextBlock Text="APPLICATION PREFERENCES" Style="{StaticResource SectionHead}"/>
<Button Click="OpenApplicationPreferences_Click" Style="{StaticResource ToolBtn}" MinHeight="48"><TextBlock Text="APPLICATION &amp; OUTPUT PREFERENCES" TextWrapping="Wrap" TextAlignment="Center"/></Button>
</StackPanel></Border></local:SettingsWorkspace>
            </TabItem>
        </TabControl>

        </Grid>
    </layout:OperatorViewport>
<Border x:Name="BatterSelectionOverlay" KeyboardNavigation.TabNavigation="Cycle" Visibility="Collapsed" Panel.ZIndex="50" Background="#B8000000" Grid.RowSpan="2" Padding="24">
<Border x:Name="BatterSelectionCard" ClipToBounds="True" CornerRadius="26" MaxWidth="600" MaxHeight="680" Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="BatterSelectionLogo" Grid.RowSpan="4" Stretch="UniformToFill" Opacity=".08" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
<TextBlock x:Name="BatterSelectionTitle" Text="SELECT BATTER" FontSize="25" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
<TextBlock x:Name="BatterSelectionTeamText" Grid.Row="1" Foreground="#DCE8F5" FontSize="16" FontWeight="Bold" Margin="0,7,0,16" TextWrapping="Wrap"/>
<ListBox Grid.Row="2" x:Name="BatterSelectionList" FocusVisualStyle="{x:Null}" Background="Transparent" Foreground="White" BorderThickness="0" MinHeight="0" MaxHeight="440" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource PlayerChoice}" ItemTemplate="{StaticResource PlayerChoiceContent}"/>
<StackPanel Grid.Row="3"><Button MinHeight="0" Content="SKIP FOR NOW" Click="SkipPlayerSelection_Click" Style="{StaticResource ToolBtn}" Height="36" Margin="0,8,0,0"/><Button x:Name="ConfirmBatterButton" Grid.Row="3" Content="CONFIRM BATTER" Height="48" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" Click="ConfirmBatterSelection_Click" Style="{StaticResource ToolBtn}" Background="#173655" BorderBrush="#79B9FF"/></StackPanel>
</Grid></Border></Border>
<Border x:Name="BowlerSelectionOverlay" KeyboardNavigation.TabNavigation="Cycle" Visibility="Collapsed" Panel.ZIndex="50" Background="#B8000000" Grid.RowSpan="2" Padding="24">
<Border x:Name="BowlerSelectionCard" ClipToBounds="True" CornerRadius="26" MaxWidth="600" MaxHeight="680" Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="BowlerSelectionLogo" Grid.RowSpan="4" Stretch="UniformToFill" Opacity=".08" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
<TextBlock  Text="SELECT BOWLER" FontSize="25" FontWeight="SemiBold" Foreground="White"/>
<StackPanel Grid.Row="1"><TextBlock x:Name="BowlerSelectionTeamText" Foreground="#DCE8F5" FontSize="16" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="BowlerSelectionHint" Text="Choose the bowler for this over." Foreground="#BBCADC" FontSize="14" Margin="0,4,0,16" TextWrapping="Wrap"/></StackPanel>
<ListBox Grid.Row="2" x:Name="BowlerSelectionList" FocusVisualStyle="{x:Null}" Background="Transparent" Foreground="White" BorderThickness="0" MinHeight="0" MaxHeight="440" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource PlayerChoice}" ItemTemplate="{StaticResource PlayerChoiceContent}"/>
<StackPanel Grid.Row="3"><Button MinHeight="0" Content="SKIP FOR NOW" Click="SkipPlayerSelection_Click" Style="{StaticResource ToolBtn}" Height="36" Margin="0,8,0,0"/><Button x:Name="ConfirmBowlerButton" Grid.Row="3" Content="CONFIRM BOWLER" Height="48" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" Click="ConfirmBowlerSelection_Click" Style="{StaticResource ToolBtn}" Background="#173655" BorderBrush="#79B9FF"/></StackPanel>
</Grid></Border></Border>

<Border x:Name="DeliveryEntryOverlay" Visibility="Collapsed" Panel.ZIndex="90" Background="#B8000000" Padding="12">
<Border CornerRadius="26" motion:OperatorRoundedClip.Radius="26" Background="#202024" BorderBrush="#52647A" BorderThickness="1" MaxWidth="620" MaxHeight="710" ClipToBounds="True"><ContentControl x:Name="DeliveryEntryContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Border>
</Border>
<Border x:Name="TossOverlay" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Toss_PreviewKeyDown" Visibility="Collapsed" Panel.ZIndex="80" Background="#A0000000" Padding="16">
<local:OperatorGlassSurface x:Name="TossSheet" CornerRadius="32" MaxWidth="620" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="#68FFFFFF" BorderThickness="1" Padding="24" VerticalAlignment="Center">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Grid><TextBlock Text="Record the toss" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.TextBrush}" Margin="0,0,46,0"/><Button Padding="0" MinHeight="0" ToolTip="Close toss" Click="CloseToss_Click" Style="{StaticResource ToolBtn}" HorizontalAlignment="Right" Width="34" Height="34"><motion:OperatorSymbol Kind="close" Width="22" Height="22" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button></Grid>
<TextBlock Text="Choose the winner, then their decision." Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,20"/>
<TextBlock Text="Toss winner" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="13" Margin="4,0,0,7"/>
<UniformGrid Columns="2"><RadioButton x:Name="TossHomeChoice" GroupName="TossTeam" Checked="TossChoice_Checked" Style="{StaticResource TossChoice}" MinHeight="82" HorizontalContentAlignment="Stretch"/><RadioButton x:Name="TossAwayChoice" GroupName="TossTeam" Checked="TossChoice_Checked" Style="{StaticResource TossChoice}" MinHeight="82" HorizontalContentAlignment="Stretch"/></UniformGrid>
<TextBlock Text="Decision" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="13" Margin="4,18,0,7"/>
<UniformGrid Columns="2"><RadioButton x:Name="TossBatChoice" GroupName="TossDecision" Checked="TossChoice_Checked" Style="{StaticResource TossChoice}" MinHeight="70"><StackPanel Orientation="Horizontal"><motion:OperatorSymbol Kind="bat" Width="24" Height="24" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Bat" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton x:Name="TossBowlChoice" GroupName="TossDecision" Checked="TossChoice_Checked" Style="{StaticResource TossChoice}" MinHeight="70"><StackPanel Orientation="Horizontal"><motion:OperatorSymbol Kind="ball" Width="24" Height="24" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="Bowl" VerticalAlignment="Center"/></StackPanel></RadioButton></UniformGrid>
<TextBlock x:Name="TossSelectionSummary" Text="Choose the toss winner and their decision." Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,20,4,0"/>
<TextBlock x:Name="TossError" Foreground="#FFB1B1" TextWrapping="Wrap" Margin="0,8"/>
<Button x:Name="ConfirmTossButton" Content="Confirm toss" Click="ConfirmToss_Click" Style="{StaticResource ControlCentre.PrimaryButton}" MinHeight="48"/>
</StackPanel></ScrollViewer></local:OperatorGlassSurface></Border>
</Grid>
</UserControl>
