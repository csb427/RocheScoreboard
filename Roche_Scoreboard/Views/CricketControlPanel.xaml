<UserControl x:Class="Roche_Scoreboard.Views.CricketControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:local="clr-namespace:Roche_Scoreboard.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:Roche_Scoreboard.Views"
             xmlns:motion="clr-namespace:Roche_Scoreboard.Services"
             Background="#09090B" SizeChanged="Console_SizeChanged" motion:OperatorDesign.IsEnabled="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/OperatorControls.xaml"/>
                <ResourceDictionary Source="../Resources/SettingsControls.xaml"/>
                <ResourceDictionary Source="../Resources/CricketActions.xaml"/>
            <ResourceDictionary Source="../Resources/ControlCentre.xaml"/></ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ShellBrush" Color="#09090B"/>
            <SolidColorBrush x:Key="RegionBrush" Color="#09090B"/>
            <SolidColorBrush x:Key="RegionAltBrush" Color="#19191C"/>
            <SolidColorBrush x:Key="RegionEdgeBrush" Color="#303035"/>
            <Style x:Key="SectionHead" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource ControlCentre.Font}"/><Setter Property="FontSize" Value="{DynamicResource ControlCentre.CaptionSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource ControlCentre.SecondaryTextBrush}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>

            <Style x:Key="RunBtn" TargetType="Button" BasedOn="{StaticResource PrimaryCommandButton}">
                <Setter Property="Height" Value="54"/><Setter Property="Margin" Value="3"/>
                <Setter Property="FontSize" Value="23"/><Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            <Style x:Key="TossChoice" TargetType="RadioButton" BasedOn="{StaticResource SettingsCommand}">
                <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="16,14"/>
                <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource SettingsSectionSurface}"/>
            <Style x:Key="MenuBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style x:Key="PresentationButton" TargetType="Button" BasedOn="{StaticResource OperatorPresentationButton}"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12"/><Setter Property="MinHeight" Value="96"/></Style>
            <Style x:Key="PlayerChoice" TargetType="ListBoxItem">
 <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="motion:OperatorControlMotion.Enabled" Value="True"/><Setter Property="motion:SelectionCheckMotion.Enabled" Value="True"/>
 <Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#E6EDF3"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
  <Grid Background="Transparent"><Grid x:Name="PART_Surface" RenderTransformOrigin=".5,.5" motion:OperatorRoundedClip.Radius="15"><Grid.RenderTransform><ScaleTransform x:Name="TbSc"/></Grid.RenderTransform>
   <Border x:Name="Surface" CornerRadius="15" Background="#202024" Padding="{TemplateBinding Padding}"><ContentPresenter Margin="0,0,28,0"/></Border>
   <Border x:Name="ActionGlow" CornerRadius="15" Background="White" Opacity="0" IsHitTestVisible="False"/>
   <Border x:Name="PlayerSelected" Width="22" Height="22" CornerRadius="11" Background="#24925C" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" RenderTransformOrigin=".5,.5" IsHitTestVisible="False">
    <Border.RenderTransform><ScaleTransform x:Name="SelectionPop"/></Border.RenderTransform><Path x:Name="SelectionStroke" Data="M2,7 L6,11 13,3" Stroke="White" StrokeThickness="2" StrokeDashArray="7 7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
  </Grid><Border x:Name="PlayerFocus" CornerRadius="15" BorderBrush="{DynamicResource ControlCentre.TextBrush}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
  <ControlTemplate.Triggers>
   <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocusWithin" Value="True"/><Condition Property="motion:OperatorInputFocus.IsKeyboardMode" Value="True"/></MultiTrigger.Conditions><Setter TargetName="PlayerFocus" Property="Visibility" Value="Visible"/></MultiTrigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PlayerSelectionHover}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PlayerSelectionSurface}"/><Setter TargetName="PlayerSelected" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="White"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<SolidColorBrush x:Key="PlayerSelectionHover" Color="#243348"/><SolidColorBrush x:Key="PlayerSelectionSurface" Color="#173655"/><SolidColorBrush x:Key="PlayerSelectionAccent" Color="#79B9FF"/>
<DataTemplate x:Key="PlayerChoiceContent"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" FontSize="13" Foreground="#BBCADC" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Figures}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></DataTemplate>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8291A2"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Responsive AFL-style command surface; individual regions scroll when needed. -->
    <Grid x:Name="CricketRoot">
    <layout:OperatorViewport x:Name="ConsoleViewport" MinimumCanvasWidth="380" MinimumCanvasHeight="0">
        <Grid Background="{StaticResource ShellBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- ═══ PERSISTENT MATCH STRIP — always visible, dense, functional ═══ -->
        <Border Grid.Row="0" CornerRadius="18" Margin="12,10,12,8" Background="#19191C" BorderBrush="#303035" BorderThickness="1" Padding="16,10">
            <Grid x:Name="PersistentHeader"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status badge — green/amber -->
                <Border x:Name="WorkflowBadge" CornerRadius="10" Grid.Column="0" BorderBrush="#244A34" BorderThickness="1.5" Background="#0D2818" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#3FB950" Margin="0,0,6,0"/>
                        <TextBlock x:Name="WorkflowStatus" Text="LIVE" Foreground="#3FB950" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Innings label — dominant -->
                <TextBlock Grid.Column="2" x:Name="InningsLabel" Text="1st Innings" Foreground="White" FontSize="24" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center"/>

                <!-- Over count -->
                <Border x:Name="HeaderOversBadge" CornerRadius="10" Grid.Column="4" BorderBrush="#3A3A40" BorderThickness="1" Background="#202024" Padding="10,4">
                    <TextBlock x:Name="HeaderOvers" Text="" Foreground="{StaticResource TextMidBrush}" FontSize="10" FontWeight="Bold"/>
                </Border>

                <!-- Score readout -->
                <TextBlock Grid.Column="6" x:Name="HeaderScore" Text="0/0" Foreground="White" FontSize="28" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT — tabbed command surface ═══ -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" TabStripPlacement="Top" Style="{StaticResource OperatorTabs}" SelectionChanged="MainTabControl_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource PanelTab}"/>
            </TabControl.Resources>

            <!-- ══════════════════════════════════════════ -->
            <!-- TAB 1: SCORING — the heart                -->
            <!-- ══════════════════════════════════════════ -->
            <TabItem x:Name="MatchTab" Header="1  MATCH" Tag="SCORING &amp; LOG">
                <ScrollViewer x:Name="CricketMatchPageViewport" SizeChanged="Console_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="{StaticResource RegionBrush}" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0" Padding="12,12">
                    <Grid x:Name="ScoringColumns">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="290" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Scoring controls — command deck -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                    <!-- BATTING — team-coloured accent zone -->
                    <Border Grid.Row="0" x:Name="BattingZone" BorderBrush="#4D3D8F" CornerRadius="22" BorderThickness="1" Background="#0D0A28" Margin="0,0,0,8">
                        <Grid ClipToBounds="True"><Canvas IsHitTestVisible="False" ClipToBounds="True"><Image x:Name="BattingZoneLogo" Stretch="UniformToFill" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}" Opacity=".06"/></Canvas><StackPanel Margin="12">
                            <TextBlock x:Name="BattingStartHint" Text="Complete the toss before selecting players." Foreground="#F0C96A" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
<Button x:Name="SelectOpeningBatters" Content="SELECT BATTERS" Click="SelectOpeningBatters_Click" Style="{StaticResource ToolBtn}" Height="44" Margin="0,0,0,8"/>
<TextBlock x:Name="BattingTeamHeading" Text="BATTING" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <!-- Top batter bar -->
                            <Border x:Name="StrikerBar" CornerRadius="14" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" Padding="12,10" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TopBatterIndicator" Text="▶" Foreground="#58A6FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="StrikerName" Text="Striker" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock x:Name="StrikerStats" Text="0 (0)  SR 0.0" Foreground="{StaticResource TextMidBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock x:Name="StrikerRuns" Text="0" Foreground="White" FontSize="24" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="StrikerBallsFaced" Text="" Foreground="#B9C9DC" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/></StackPanel>
                                    <Button Grid.Column="3" Content="⋯" Click="StrikerMenu_Click" Style="{StaticResource MenuBtn}" ToolTip="Options">
                                    </Button>
                                </Grid>
                            </Border>
                            <!-- Bottom batter bar -->
                            <Border x:Name="NonStrikerBar" CornerRadius="14" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BottomBatterIndicator" Text="  " Foreground="#58A6FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="NonStrikerName" Text="Non-Striker" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock x:Name="NonStrikerStats" Text="0 (0)  SR 0.0" Foreground="{StaticResource TextMidBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock x:Name="NonStrikerRunsText" Text="0" Foreground="White" FontSize="24" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="NonStrikerBallsFaced" Text="" Foreground="#B9C9DC" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/></StackPanel>
                                    <Button Grid.Column="3" Content="⋯" Click="NonStrikerMenu_Click" Style="{StaticResource MenuBtn}" ToolTip="Options">
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel></Grid>
                    </Border>

                    <!-- BOWLING — green accent zone -->
                    <Border Grid.Row="1" x:Name="BowlingZone" BorderBrush="#1A6040" CornerRadius="22" BorderThickness="1" Background="#0D1E14" Margin="0,0,0,8">
                        <Grid ClipToBounds="True"><Canvas IsHitTestVisible="False" ClipToBounds="True"><Image x:Name="BowlingZoneLogo" Stretch="UniformToFill" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}" Opacity=".06"/></Canvas><StackPanel Margin="12">
                            <TextBlock x:Name="BowlingStartHint" Text="Complete the toss before selecting players." Foreground="#F0C96A" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
<Button x:Name="SelectOpeningBowler" Content="SELECT BOWLER" Click="SelectOpeningBowler_Click" Style="{StaticResource ToolBtn}" Height="44" Margin="0,0,0,8"/>
<TextBlock x:Name="BowlingTeamHeading" Text="BOWLING" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border x:Name="BowlerBar" CornerRadius="14" Background="#242428" BorderBrush="#3A3A40" BorderThickness="1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="BowlerName" Text="Bowler" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock x:Name="BowlerStats" Text="0-0 (0)  Econ 0.00" Foreground="{StaticResource TextMidBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="BowlerFigures" Text="0-0" Foreground="White" FontSize="20" FontWeight="SemiBold" FontFamily="{DynamicResource ControlCentre.Font}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="BowlerOverFigures" Text="" Foreground="#B9C9DC" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/></StackPanel>
                                    <Button Grid.Column="2" Content="⋯" Click="BowlerMenu_Click" Style="{StaticResource MenuBtn}" ToolTip="Options">
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="OverDisplay" Text="This over: " Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="4,6,0,0"/>
                        </StackPanel></Grid>
                    </Border>

                    <!-- SCORING GRID — run buttons with gradient accents -->
                    <Border x:Name="ScoringCommands" CornerRadius="22" Grid.Row="2" Background="{StaticResource RegionAltBrush}" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel><TextBlock x:Name="OperatorFreeHitText" DockPanel.Dock="Right" Visibility="Collapsed" Text="FREE HIT" Foreground="#FFD980" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="SCORING" Style="{StaticResource SectionHead}"/></DockPanel>
                            <UniformGrid Columns="4" Margin="0,0,0,6">
                                <Button Content="•" Click="Dot_Click" Style="{StaticResource RunBtn}" ToolTip="Dot ball" Background="#3A3A40" BorderBrush="#484F58"/>
                                <Button Content="1" Click="Run1_Click" Style="{StaticResource RunBtn}" ToolTip="1 run" Background="#1E40AF" BorderBrush="#3B6AE0"/>
                                <Button Content="2" Click="Run2_Click" Style="{StaticResource RunBtn}" ToolTip="2 runs" Background="#1E40AF" BorderBrush="#3B6AE0"/>
                                <Button Content="3" Click="Run3_Click" Style="{StaticResource RunBtn}" ToolTip="3 runs" Background="#1E40AF" BorderBrush="#3B6AE0"/>
                            </UniformGrid>
                            <UniformGrid Columns="4">
                                <Button Content="4" Click="Four_Click" Style="{StaticResource RunBtn}" ToolTip="Boundary four" BorderBrush="#22C55E">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#15803D" Offset="0"/>
                                            <GradientStop Color="#166534" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                                <Button Content="5" Click="Run5_Click" Style="{StaticResource RunBtn}" ToolTip="5 runs" Background="#1E40AF" BorderBrush="#3B6AE0"/>
                                <Button Content="6" Click="Six_Click" Style="{StaticResource RunBtn}" ToolTip="Maximum six" BorderBrush="#A855F7">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7C3AED" Offset="0"/>
                                            <GradientStop Color="#9333EA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                                <Button Content="W" Click="Wicket_Click" Style="{StaticResource RunBtn}" ToolTip="Wicket" BorderBrush="#F87171">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#DC2626" Offset="0"/>
                                            <GradientStop Color="#B91C1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

<Button x:Name="ScoringLockBanner" Grid.Row="2" Grid.RowSpan="2" Panel.ZIndex="2" Visibility="Collapsed" Click="ScoringGate_Click" Background="#152B43" BorderBrush="#79B9FF" BorderThickness="2" Margin="0" MinHeight="180" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource CricketActionButton}"><StackPanel VerticalAlignment="Center" Margin="24"><TextBlock x:Name="ScoringReadyHint" Text="" Foreground="White" FontSize="25" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="ScoringReadyDetail" Foreground="#C2D8ED" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Button>
<Button x:Name="StartTossButton" Grid.Row="2" Grid.RowSpan="2" Content="RECORD THE TOSS" Click="OpenToss_Click" Background="#163657" BorderBrush="#79B9FF" Foreground="White" Style="{StaticResource CricketActionButton}" MinHeight="180" FontSize="25" Margin="0" Panel.ZIndex="3"/>
                    <!-- EXTRAS — amber accent zone -->
                    <Border x:Name="ExtraCommands" CornerRadius="22" Grid.Row="3" Background="#19191C" BorderBrush="#3A3A40" BorderThickness="1" Padding="12" Margin="0,0,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="EXTRAS" Foreground="#D29922" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="4">
                                    <Button Content="Wide" Click="Wide_Click" Style="{StaticResource ToolBtn}" Margin="3" ToolTip="Wide delivery" Background="#29292D" BorderBrush="#4B4B51"/>
                                    <Button Content="No Ball" Click="NoBall_Click" Style="{StaticResource ToolBtn}" Margin="3" ToolTip="No ball" Background="#29292D" BorderBrush="#4B4B51"/>
                                    <Button Content="Bye" Click="Bye_Click" Style="{StaticResource ToolBtn}" Margin="3" ToolTip="Bye runs" Background="#29292D" BorderBrush="#4B4B51"/>
                                    <Button Content="Leg Bye" Click="LegBye_Click" Style="{StaticResource ToolBtn}" Margin="3" ToolTip="Leg bye" Background="#29292D" BorderBrush="#4B4B51"/>
                                </UniformGrid>
                            </StackPanel>


                        </Grid>
                    </Border>

                    <!-- UNDO / END INNINGS — danger row -->
                    <UniformGrid Grid.Row="5" Columns="3">
                        <Button x:Name="MatchOptionsButton" Content="OPTIONS" Click="MatchOptions_Click" Style="{StaticResource ToolBtn}" Height="42" Margin="0,0,6,0"/>
                        <Button x:Name="UndoDeliveryButton" Content="↩ Undo" Height="42" Margin="0,0,6,0" Click="Undo_Click" Style="{StaticResource ToolBtn}" ToolTip="Undo last delivery" Background="#303035" BorderBrush="#6B3A3E"/>
                        <Button x:Name="EndInningsButton" Content="End innings" MinHeight="42" Click="EndInnings_Click" Style="{StaticResource ToolBtn}" ToolTip="Innings and match options" Foreground="White"/>
                    </UniformGrid>

                    <!-- RESET — danger zone -->
                    <Button Grid.Row="7" Grid.ColumnSpan="20" Content="Reset match" HorizontalAlignment="Stretch" Margin="0,12,0,0" MinWidth="0" Height="44" FontSize="13" FontWeight="SemiBold" Click="ResetMatch_Click"
                            Style="{StaticResource ToolBtn}" ToolTip="Reset the entire match and return to setup"
                            Background="#2A1416" BorderBrush="#6B3A3E" Foreground="#FF6B6B"/>
                                </Grid>
                        </ScrollViewer>

                        <!-- RIGHT: Delivery log — live feed style -->
                        <Border Grid.Column="2" CornerRadius="22" Background="#19191C" BorderBrush="#303035" BorderThickness="1" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="DELIVERY LOG" Style="{StaticResource SectionHead}"/>
<ComboBox x:Name="DeliveryOverChoice" Style="{StaticResource SettingsChoice}" MinHeight="32" FontSize="12" Margin="0,4,0,8" SelectionChanged="DeliveryOverChoice_Changed"/>
</StackPanel>
                                <ScrollViewer x:Name="DeliveryLogScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="EventLog"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border></ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════════ -->
            <!-- TAB 2: DISPLAY &amp; MESSAGES — cinematic  -->
            <!-- ══════════════════════════════════════════ -->
            <TabItem x:Name="ScorecardTab" Header="2  SCORECARD" Tag="BATTING &amp; BOWLING"><ContentControl x:Name="ScorecardHost"/></TabItem>
            <TabItem x:Name="OutputTab" Header="3  OUTPUT" Tag="PRESENTATIONS">
<ScrollViewer x:Name="CricketOutputPageViewport" SizeChanged="Console_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="#09090B" BorderBrush="{StaticResource RegionEdgeBrush}" BorderThickness="0,1,0,0" Padding="20,16">
<Grid x:Name="DisplayColumns"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<StackPanel Margin="0,0,0,12"><TextBlock Text="LIVE OUTPUT ROUTER" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
<TextBlock Text="One click changes the public screen · active output is highlighted" FontSize="12" Foreground="#9BB0C6" TextWrapping="Wrap"/></StackPanel>
<Border Background="#142236" BorderBrush="#3D5F85" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10"><TextBlock x:Name="CricketOnAirText" Text="ON AIR · LIVE SCOREBUG" Foreground="#9CCBFF" FontSize="11" FontWeight="SemiBold"/></Border>
<UniformGrid x:Name="CricketPresentationGrid" Columns="2" Margin="0,0,0,18">
<Button x:Name="Presentationscorebug" Tag="scorebug" Style="{StaticResource PresentationButton}" Click="PresentationButton_Click"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"><TextBlock Text="LIVE" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7"/><TextBlock Text="SCOREBUG" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Live scoring" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Button>
<Button x:Name="Presentationbatting" Tag="batting" Style="{StaticResource PresentationButton}" Click="PresentationButton_Click"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"><TextBlock Text="BAT" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7"/><TextBlock Text="BATTING" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Batting scorecard" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Button>
<Button x:Name="Presentationbowling" Tag="bowling" Style="{StaticResource PresentationButton}" Click="PresentationButton_Click"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"><TextBlock Text="BOWL" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7"/><TextBlock Text="BOWLING" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Bowling figures" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Button>
<Button x:Name="Presentationwindow" Tag="window" Style="{StaticResource PresentationButton}" Click="PresentationButton_Click"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"><TextBlock Text="OUTPUT" FontSize="11" FontWeight="SemiBold" Foreground="#67D17B" HorizontalAlignment="Center" Margin="0,0,0,7"/><TextBlock Text="SHOW WINDOW" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Restore output" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Button>
<Button x:Name="Presentationsummary" Tag="summary" Style="{StaticResource PresentationButton}" Click="PresentationButton_Click"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"><TextBlock Text="MATCH" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,7"/><TextBlock Text="SUMMARY" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Score and leading players" FontSize="12" Foreground="#B6B6C0" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Button>
<Button x:Name="Presentationworm" Tag="worm" Style="{StaticResource PresentationButton}" Click="PresentationButton_Click"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"><TextBlock Text="SCOREWORM" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Compare innings progress" FontSize="12" Foreground="#B6B6C0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Button>
<Button x:Name="Presentationmanhattan" Tag="manhattan" Style="{StaticResource PresentationButton}" Click="PresentationButton_Click"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4"><TextBlock Text="MANHATTAN" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Runs and wickets per over" FontSize="12" Foreground="#B6B6C0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Button>
</UniformGrid>
<TextBlock Text="CRICKET OVERLAYS" Style="{StaticResource SectionHead}" FontSize="14"/>
<TextBlock x:Name="OverlayStatusText" Text="NO OVERLAY ON AIR" Foreground="#9CCBFF" FontWeight="Bold" FontSize="11" Margin="0,4,0,8"/>
<StackPanel x:Name="CricketOverlayButtons"/>
<Button Content="CANCEL CURRENT OVERLAY" Click="CancelCricketOverlay_Click" Style="{StaticResource ToolBtn}" Height="42" Margin="4,10,4,8"/>
</StackPanel></ScrollViewer>
<StackPanel Grid.Column="2"><TextBlock Text="VENUE WEATHER" Style="{StaticResource SectionHead}" FontSize="14"/><local:OperatorGlassSurface Material="Regular" Style="{StaticResource Card}" Background="{DynamicResource ControlCentre.GlassBrush}"><StackPanel>
<TextBlock x:Name="CricketWeatherTemperature" Text="—" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource ControlCentre.TextBrush}"/>
<TextBlock x:Name="CricketWeatherDescription" Text="Waiting for weather" FontSize="15" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap"/>
<TextBox x:Name="CricketWeatherLocation" Text="Melbourne" Margin="0,14,0,0" FontSize="16" Style="{StaticResource SettingsInput}"/>
<Button Content="Update weather" Click="UpdateCricketWeather_Click" Style="{StaticResource ToolBtn}" Height="50" Margin="0,12,0,0"/>
</StackPanel></local:OperatorGlassSurface></StackPanel>
</Grid></Border></ScrollViewer></TabItem>

