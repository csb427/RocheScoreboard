<UserControl x:Class="Roche_Scoreboard.Views.VideoPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="707"
             Background="Black">

    <!-- VLC-backed playback surface. Handles VFR, mixed codecs and HW
         decode fallback far better than WPF's MediaElement; the public API
         on VideoPlayerControl is unchanged so existing consumers don't care. -->
    <Grid ClipToBounds="True">
        <vlc:VideoView x:Name="VideoPlayer" Background="Black" />
    </Grid>
</UserControl>
