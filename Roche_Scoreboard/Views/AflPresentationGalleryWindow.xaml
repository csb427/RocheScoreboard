<Window x:Class="Roche_Scoreboard.Views.AflPresentationGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFL Presentation Gallery"
        Width="1500" Height="900"
        MinWidth="900" MinHeight="600"
        Background="#080D14"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#101824" BorderBrush="#2B3B50" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="AFL PRESENTATION QA" FontFamily="Bahnschrift" FontSize="24" FontWeight="Black"/>
                <TextBlock Text="Representative in-memory match • standard and compact output dimensions • no saved match is loaded or changed"
                           Foreground="#AFC0D2" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock x:Name="GalleryErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="#FF8C8C" FontSize="13" FontWeight="Bold" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="GalleryTabs" Grid.Row="1" Margin="14" Background="#080D14" BorderBrush="#2B3B50" Foreground="White">
            <TabItem Header="LIVE SCOREBUG"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="ScorebugHost" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="OVERLAYS"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="OverlayHost" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="QUARTER BREAKDOWN"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="BreakHost" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="MARGIN FLOW"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="WormHost" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="MATCH STATS"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="StatsHost" Margin="14"/></ScrollViewer></TabItem>
            <TabItem Header="WEATHER"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="WeatherHost" Margin="14"/></ScrollViewer></TabItem>
        </TabControl>
    </Grid>
</Window>
