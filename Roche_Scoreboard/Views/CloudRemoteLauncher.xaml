<UserControl x:Class="Roche_Scoreboard.Views.CloudRemoteLauncher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:motion="clr-namespace:Roche_Scoreboard.Services" motion:OperatorDesign.IsEnabled="True"
             FontFamily="Segoe UI Variable, Segoe UI" mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="80">

    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/ControlCentre.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <!-- Compact reusable cloud remote launcher. Collapsed shows a single
         "📱 Cloud Remote" button. Expanded shows status, join code, QR,
         copy buttons, and start/end controls. Used in: AFL Scoring &
         Clock tab and Training Mode header. The full settings card stays
         the source of truth in MainWindow.xaml. -->
    <Border Background="#19191C" BorderBrush="#44444B" BorderThickness="1" CornerRadius="16">
        <StackPanel>

            <!-- ── COLLAPSED: single button ── -->
            <Button x:Name="CollapsedButton"
                    Click="CollapsedButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="10,8"
                    HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <motion:OperatorSymbol Kind="Remote" Width="22" Height="22" Foreground="#A9D3FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Cloud remote" FontSize="15" FontWeight="SemiBold" Foreground="#78B7FF"/>
                        <TextBlock x:Name="CollapsedStatusText" Text="Tap to start" FontSize="13" FontWeight="SemiBold" Foreground="#B6B6C0"/>
                    </StackPanel>
                    <TextBlock x:Name="CollapsedChevron" Grid.Column="2" Text="▾" FontSize="12" FontWeight="SemiBold" Foreground="#58A6FF" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- ── EXPANDED: full controls ── -->
            <StackPanel x:Name="ExpandedPanel" Visibility="Collapsed" Margin="10,2,10,10">

                <Border Height="1" Background="#44444B" Margin="0,0,0,8"/>

                <TextBlock x:Name="StatusText" Text="Checking configuration…"
                           FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- IDLE STATE -->
                <StackPanel x:Name="IdleState" Visibility="Collapsed">
                    <Button x:Name="StartButton" Content="Start cloud session"
                            Height="42" MinHeight="0" Padding="8,0" FontSize="14" FontWeight="SemiBold"
                            Background="#29292D" BorderBrush="#44444B" BorderThickness="1"
                            Foreground="#58A6FF" Cursor="Hand"
                            Click="StartButton_Click"/>
                    <TextBlock Text="A new join code is created each time."
                               FontSize="12" Foreground="#B6B6C0"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- DISABLED STATE -->
                <StackPanel x:Name="DisabledState" Visibility="Collapsed">
                    <Border Background="#1C140A" BorderBrush="#4A3A1A" BorderThickness="1" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Setup required" FontSize="13" FontWeight="SemiBold" Foreground="#E7B94F"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Add supabase.config.json next to the executable."
                                       FontSize="12" FontWeight="SemiBold" Foreground="#D8C483" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- LIVE STATE -->
                <StackPanel x:Name="LiveState" Visibility="Collapsed">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#6E7681" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionLabel" Text="Connecting…" FontSize="12" FontWeight="Bold"
                                   Foreground="#6E7681" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="JOIN CODE" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0" HorizontalAlignment="Center"/>
                    <Border Background="#111113" BorderBrush="#44444B" BorderThickness="1"
                            Padding="10,6" Margin="0,4,0,4" Cursor="Hand"
                            MouseLeftButtonUp="JoinCodeBox_Click" ToolTip="Click to copy">
                        <TextBlock x:Name="JoinCodeText" Text="—" FontSize="22" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="#58A6FF"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>

                    <Border Background="#19191C" BorderBrush="#44444B" BorderThickness="1"
                            Padding="6" HorizontalAlignment="Center" Margin="0,6,0,6">
                        <Image x:Name="QrImage" Width="140" Height="140" Stretch="Uniform"
                               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <StackPanel x:Name="JoinUrlPanel" Visibility="Collapsed">
                        <TextBlock Text="OR OPEN" FontSize="12" FontWeight="SemiBold" Foreground="#B6B6C0"
                                   HorizontalAlignment="Center" Margin="0,2,0,2"/>
                        <TextBlock x:Name="JoinUrlText" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#B6B6C0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="CopyUrlButton" Content="Copy URL" Height="30" FontSize="12" FontWeight="Bold"
                                Background="#29292D" BorderBrush="#44444B" BorderThickness="1"
                                Foreground="#58A6FF" Cursor="Hand" Margin="0,4,0,0"
                                Click="CopyUrlButton_Click"/>
                    </StackPanel>

                    <Button x:Name="EndButton" Content="End session" Height="32" FontSize="12" FontWeight="Bold"
                            Background="Transparent" BorderBrush="#3A2020" BorderThickness="1"
                            Foreground="#FF6B6B" Cursor="Hand" Margin="0,10,0,0"
                            Click="EndButton_Click"/>
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
