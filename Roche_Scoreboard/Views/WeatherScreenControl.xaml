<UserControl x:Class="Roche_Scoreboard.Views.WeatherScreenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Roche_Scoreboard.Views"
             mc:Ignorable="d"
             d:DesignHeight="193" d:DesignWidth="386"
             Width="386" Height="193">

    <!-- Native 386x193 weather layout. No scaling/Viewbox. -->
    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="14"/>   <!-- title -->
            <RowDefinition Height="*"/>    <!-- content -->
            <RowDefinition Height="44"/>   <!-- score bar -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <Border Grid.Row="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,0,1"/>
        <Grid Grid.Row="0" Margin="6,0">
            <TextBlock x:Name="LocationText" Text="WEATHER" Foreground="#F0C040"
                       FontSize="10" FontWeight="Black"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Text="WEATHER FORECAST" Foreground="#F0C040"
                       FontSize="12" FontWeight="Black" FontFamily="Bahnschrift"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="WeatherTimeText" Text="1:26 PM" Foreground="#58A6FF"
                       FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- CONTENT: icon + huge temp dominant, description underneath, clean stat row at bottom -->
        <Border Grid.Row="1" Background="#0D1117" BorderBrush="#F0C040" BorderThickness="2" Margin="4,2,4,2">
            <Grid Margin="6,4,6,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>      <!-- hero: icon + temp + description -->
                    <RowDefinition Height="36"/>     <!-- min / feels / max strip -->
                </Grid.RowDefinitions>

                <!-- HERO: icon on left, temp + description stacked on right -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Stretch="Uniform" Margin="2">
                        <TextBlock x:Name="CurrentIcon" Text="☀️" FontFamily="Segoe UI Emoji" FontSize="80"/>
                    </Viewbox>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="2,0,2,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="CurrentTemp" Text="22&#176;"
                                       Foreground="#FFD54A" FontSize="160" FontWeight="Black" FontFamily="Bahnschrift, Segoe UI, Arial"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" x:Name="CurrentDescription" Text="Clear Sky"
                                   Foreground="White" FontSize="16" FontWeight="Black" FontFamily="Bahnschrift"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
                    </Grid>
                </Grid>

                <!-- BOTTOM STRIP: three equal cells, unified style -->
                <Border Grid.Row="1" BorderBrush="#30363D" BorderThickness="0,1,0,0" Margin="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="MIN" Foreground="#7AB8FF" FontSize="11" FontWeight="Black" FontFamily="Bahnschrift" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" x:Name="DayMinTemp" Text="14&#176;" Foreground="#7AB8FF"
                                       FontSize="22" FontWeight="Black" FontFamily="Bahnschrift, Segoe UI, Arial"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="FEELS" Foreground="#B0BEC5" FontSize="11" FontWeight="Black" FontFamily="Bahnschrift" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" x:Name="FeelsLikeTemp" Text="20&#176;" Foreground="White"
                                       FontSize="22" FontWeight="Black" FontFamily="Bahnschrift, Segoe UI, Arial"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="MAX" Foreground="#FF6E6E" FontSize="11" FontWeight="Black" FontFamily="Bahnschrift" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" x:Name="DayMaxTemp" Text="26&#176;" Foreground="#FF6E6E"
                                       FontSize="22" FontWeight="Black" FontFamily="Bahnschrift, Segoe UI, Arial"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- BOTTOM SCORE BAR -->
        <local:PresentationScoreBar x:Name="ScoreBar" Grid.Row="2"/>
    </Grid>
</UserControl>
