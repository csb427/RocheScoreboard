<UserControl x:Class="Roche_Scoreboard.Views.WeatherScreenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Roche_Scoreboard.Views"
             mc:Ignorable="d"
             d:DesignHeight="193" d:DesignWidth="386"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <!-- Native 386x193 weather layout. No scaling/Viewbox. -->
    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="WeatherTitleRow" Height="0"/>
            <RowDefinition x:Name="WeatherBodyRow" Height="149*"/>
            <RowDefinition Height="44*"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <Border x:Name="WeatherTitlePanel" Grid.Row="0" Visibility="Collapsed" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,0,1"/>
        <Grid Grid.Row="0" Visibility="Collapsed" Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LocationText" Text="WEATHER" Foreground="White"
                       FontSize="18" FontWeight="Black" FontFamily="Segoe UI" Margin="0,0,8,0"
                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <TextBlock x:Name="WeatherTitleText" Visibility="Collapsed"/>
            <TextBlock x:Name="WeatherTimeText" Grid.Column="1" Text="1:26 PM" Foreground="#D6E3EF"
                       FontSize="16" FontWeight="Black"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- CONTENT: icon + huge temp dominant, description underneath, clean stat row at bottom -->
        <Border Grid.Row="1" Background="#0D1117" BorderBrush="#F0C040" BorderThickness="2" Margin="4,2,4,2">
            <Grid Margin="6,4,6,4">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="WeatherHeroRow" Height="78*"/>    <!-- hero: icon + temp + description -->
                    <RowDefinition x:Name="WeatherStatsRow" Height="51*"/>    <!-- larger min / feels / max strip -->
                </Grid.RowDefinitions>

                <!-- HERO: icon on left, temp + description stacked on right -->
                <Grid x:Name="WeatherDataPanel" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Stretch="Uniform" Margin="2">
                        <!-- Bright foreground so the icon stays readable even
                             when Windows falls back to the monochrome glyph
                             from Segoe UI Symbol (Segoe UI Emoji on some
                             systems renders flat instead of full colour). -->
                        <TextBlock x:Name="CurrentIcon" Text="☀" FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                                   FontSize="80" Foreground="#FFD54A">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#FFD54A" Opacity="0.55"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Viewbox>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="2,0,2,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="CurrentTemp" Text="22&#176;"
                                       Foreground="#FFD54A" FontSize="160" FontWeight="Black" FontFamily="Arial"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" x:Name="CurrentDescription" Text="Clear Sky"
                                   Foreground="White" FontSize="18" FontWeight="Black" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
                    </Grid>
                </Grid>

                <!-- BOTTOM STRIP: one strong line per value. Stacking tiny
                     captions above values wasted half the available height. -->
                <Border x:Name="WeatherStatsPanel" Grid.Row="1" BorderBrush="#30363D" BorderThickness="0,1,0,0" Margin="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="5,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MIN " Foreground="#9ACBFF" FontSize="18" FontWeight="Black" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DayMinTemp" Text="14&#176;" Foreground="#7AB8FF" FontSize="38" FontWeight="Black" FontFamily="Arial" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="5,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="FEELS " Foreground="#D6E3EF" FontSize="18" FontWeight="Black" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FeelsLikeTemp" Text="20&#176;" Foreground="White" FontSize="38" FontWeight="Black" FontFamily="Arial" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="5,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MAX " Foreground="#FF9292" FontSize="18" FontWeight="Black" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DayMaxTemp" Text="26&#176;" Foreground="#FF6E6E" FontSize="38" FontWeight="Black" FontFamily="Arial" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- Deliberate empty state. Never fabricate zero-degree readings when
                     the weather service has not received a forecast yet. -->
                <Grid x:Name="WeatherUnavailablePanel" Grid.RowSpan="2" Visibility="Collapsed"
                      Margin="12,5" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="WEATHER DATA UNAVAILABLE"
                                   Foreground="#FFD54A" FontFamily="Arial"
                                   FontSize="18" FontWeight="Black"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <Border Height="2" Width="72" Margin="0,7,0,7" Background="#58A6FF"/>
                        <TextBlock Text="SET A LOCATION OR CHECK THE CONNECTION"
                                   Foreground="#C9D1D9" FontFamily="Arial"
                                   FontSize="14" FontWeight="Black"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- BOTTOM SCORE BAR -->
        <local:PresentationScoreBar x:Name="ScoreBar" Grid.Row="2"/>
    </Grid>
</UserControl>
