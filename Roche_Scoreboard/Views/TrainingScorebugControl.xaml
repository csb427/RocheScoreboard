<UserControl x:Class="Roche_Scoreboard.Views.TrainingScorebugControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="540" d:DesignWidth="960"
             Background="#080C12">

    <!-- Uniform scaling keeps stopwatch digits and graphics undistorted. -->
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="RootGrid" Width="960" Height="540" ClipToBounds="True">
        <Grid.Background>
            <!-- Solid base colour we animate to red during finish flashes
                 (no overlay element — the background itself swaps colour). -->
            <SolidColorBrush x:Name="RootBg" Color="#080C12"/>
        </Grid.Background>

        <!-- Background gradient — sits over the solid root colour but uses
             alpha so the red flash bleeds through cleanly when active. -->
        <Border x:Name="GradientBg">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Color="#0F1A28" Offset="0"/>
                    <GradientStop Color="#080C12" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Diagonal stripe texture -->
        <Border Opacity="0.025" IsHitTestVisible="False">
            <Border.Background>
                <VisualBrush TileMode="Tile"
                             Viewport="0,0,40,40" ViewportUnits="Absolute"
                             Viewbox="0,0,40,40" ViewboxUnits="Absolute">
                    <VisualBrush.Visual>
                        <Canvas Width="40" Height="40">
                            <Line X1="0" Y1="40" X2="40" Y2="0"
                                  Stroke="White" StrokeThickness="1"/>
                        </Canvas>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
        </Border>

        <!-- Inner Viewbox: scales the 1920×1080 content canvas inside the
             outer 960×540 grid. Stretch="Fill" matches the outer Viewbox so
             non-uniform host ratios pass through cleanly without bars. -->
        <Viewbox Stretch="Fill" StretchDirection="Both"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid Width="1920" Height="1080">
                <!-- Five rows: title / flex spacer / timer block / flex spacer / up-next.
                     Flex spacers absorb the up-next bar's growth so the timer
                     block always stays vertically centred in the *remaining*
                     space, never overlapping the up-next bar. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <Border Grid.Row="0" Margin="0,70,0,0"
                        HorizontalAlignment="Center"
                        MaxWidth="1500"
                        Padding="56,22"
                        Background="#0D1117"
                        BorderBrush="#58A6FF" BorderThickness="3">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="TitleScale" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform x:Name="TitleTranslate"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect x:Name="TitleGlow" BlurRadius="34" ShadowDepth="0" Color="#58A6FF" Opacity="0.55"/>
                    </Border.Effect>
                    <!-- Canvas-based scroller: when the title is wider than the
                         clip, the text-block is translated back and forth. When
                         it fits, the translate stays at 0 and centring is done
                         by the host border. -->
                    <Canvas x:Name="TitleClip" Height="140" Width="1380" ClipToBounds="True">
                        <TextBlock x:Name="TitleText" Text="WARM-UP"
                                   FontSize="110" FontWeight="Black" FontFamily="Bahnschrift"
                                   Foreground="White" TextAlignment="Center"
                                   Canvas.Left="0" Canvas.Top="0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TitleScrollTransform" X="0"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#58A6FF" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Canvas>
                </Border>

                <!-- Big timer block (auto-sized so spacer rows centre it) -->
                <StackPanel Grid.Row="2" x:Name="ActiveTimerHost"
                            HorizontalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="TimerScale" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="TimerTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <TextBlock x:Name="TimerText" Text="05:00"
                               FontSize="420" FontWeight="Black"
                               FontFamily="Bahnschrift"
                               Foreground="#FFFFFF"
                               TextAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect x:Name="TimerGlow" BlurRadius="55" ShadowDepth="0" Color="#58A6FF" Opacity="0.75"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Progress: segmented tick row. 20 segments fill left-to-right
                         as time elapses. Code-behind toggles each segment's
                         opacity/colour to reflect progress. -->
                    <ItemsControl x:Name="ProgressSegments" Margin="0,28,0,0"
                                  Width="1400" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="20"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Up next bar — pinned to row 4. The bar is ALWAYS laid out
                     at its full natural height; we just toggle Visibility to
                     show/hide it (with a quick opacity fade for polish).
                     Earlier we animated Height from 0->N, but starting at
                     Height=0 with ClipToBounds=True caused WPF to short-
                     circuit the child measure pass on first show — the
                     text never appeared until the next layout invalidation.
                     Row 3 is a flex spacer so making the bar always present
                     simply pushes the timer block up slightly when visible. -->
                <Border x:Name="UpNextBar" Grid.Row="4"
                        Visibility="Collapsed" Opacity="0"
                        Background="#0D1117"
                        BorderBrush="#58A6FF" BorderThickness="0,5,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#58A6FF" Opacity="0.45"/>
                    </Border.Effect>
                    <Grid Margin="80,28,80,28" MinHeight="160">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="UpNextLabel" Text="UP NEXT"
                                   Foreground="#FFFFFF" FontSize="96" FontWeight="Black"
                                   FontFamily="Bahnschrift" VerticalAlignment="Center"
                                   Margin="0,0,40,0"/>
                        <TextBlock Grid.Column="1" x:Name="UpNextTitle" Text=""
                                   Foreground="White" FontSize="96" FontWeight="Black"
                                   FontFamily="Bahnschrift"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,40,0"/>
                        <TextBlock Grid.Column="2" x:Name="UpNextDuration" Text="00:00"
                                   Foreground="#FF9100" FontSize="112" FontWeight="Black"
                                   FontFamily="Bahnschrift" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#FF9100" Opacity="0.75"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Staged next timer — sits in row 4 (replaces the up-next
                     bar visually). During the finish flash this hosts a live
                     mini-preview of the next interval already ticking down.
                     When the flash ends the active timer slides up & out and
                     this block animates up to centre to take its place. -->
                <Grid Grid.Row="4" x:Name="StagedTimerHost" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="StagedScale" CenterX="0.5" CenterY="1" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="StagedTranslate" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Background="#0D1117"
                            BorderBrush="#3FB950" BorderThickness="0,5,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#3FB950" Opacity="0.55"/>
                        </Border.Effect>
                        <Grid Margin="80,28,80,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="StagedLabel" Text="NOW STARTING"
                                       Foreground="#3FB950" FontSize="56" FontWeight="Black"
                                       FontFamily="Bahnschrift" VerticalAlignment="Center"
                                       Margin="0,0,40,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#3FB950" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Grid.Column="1" x:Name="StagedTitleText" Text=""
                                       Foreground="White" FontSize="100" FontWeight="Black"
                                       FontFamily="Bahnschrift" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" x:Name="StagedTimerText" Text="00:00"
                                       Foreground="#FFFFFF" FontSize="120" FontWeight="Black"
                                       FontFamily="Bahnschrift" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#3FB950" Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- Session complete overlay -->
        <Border x:Name="SessionCompleteOverlay"
                IsHitTestVisible="False"
                Opacity="0"
                Panel.ZIndex="200">
            <Grid>
                <Border Background="#000000" Opacity="0.65"/>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="40">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="SESSION COMPLETE"
                                   FontSize="160" FontWeight="Black" FontFamily="Bahnschrift"
                                   Foreground="White" TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="50" ShadowDepth="0" Color="#FF0000" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="ALL TIMERS FINISHED"
                                   FontSize="42" FontWeight="Black" FontFamily="Bahnschrift"
                                   Foreground="#FFD1D1" TextAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
    </Viewbox>
</UserControl>
