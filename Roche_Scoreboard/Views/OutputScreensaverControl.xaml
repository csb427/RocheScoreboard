<UserControl x:Class="Roche_Scoreboard.Views.OutputScreensaverControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 d:DesignWidth="386" d:DesignHeight="193" mc:Ignorable="d"
 Background="Black" SnapsToDevicePixels="False" UseLayoutRounding="True"
 RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified">
 <Grid x:Name="Root" Background="Black" ClipToBounds="True">
  <Grid x:Name="CustomVideoHost" Visibility="Collapsed"/>
  <Image x:Name="CustomImage" Visibility="Collapsed" Stretch="UniformToFill"
         RenderOptions.BitmapScalingMode="HighQuality"/>
  <Grid x:Name="DefaultScene">
   <Grid.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#030711" Offset="0"/>
     <GradientStop Color="#0A1A2C" Offset="0.48"/>
     <GradientStop Color="#07101C" Offset="1"/>
    </LinearGradientBrush>
   </Grid.Background>
   <Rectangle Opacity="0.32">
    <Rectangle.Fill><RadialGradientBrush Center="0.5,0.48" GradientOrigin="0.5,0.48" RadiusX="0.62" RadiusY="0.82"><GradientStop Color="#304B90C8" Offset="0"/><GradientStop Color="#00132638" Offset="1"/></RadialGradientBrush></Rectangle.Fill>
   </Rectangle>
   <Canvas Opacity="0.22" ClipToBounds="True">
    <Rectangle x:Name="LightBeamOne" Width="150" Height="420" RenderTransformOrigin="0.5,0.5" Canvas.Left="-105" Canvas.Top="-120">
     <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0058A6FF"/><GradientStop Color="#3858A6FF" Offset="0.5"/><GradientStop Color="#0058A6FF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
     <Rectangle.Effect><BlurEffect Radius="18"/></Rectangle.Effect>
     <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="-25"/><TranslateTransform x:Name="BeamOneTranslate"/></TransformGroup></Rectangle.RenderTransform>
    </Rectangle>
    <Rectangle x:Name="LightBeamTwo" Width="125" Height="420" RenderTransformOrigin="0.5,0.5" Canvas.Left="300" Canvas.Top="-90">
     <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00E7B94F"/><GradientStop Color="#2AE7B94F" Offset="0.5"/><GradientStop Color="#00E7B94F" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
     <Rectangle.Effect><BlurEffect Radius="20"/></Rectangle.Effect>
     <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="27"/><TranslateTransform x:Name="BeamTwoTranslate"/></TransformGroup></Rectangle.RenderTransform>
    </Rectangle>
   </Canvas>
   <!-- Lightweight vector field geometry gives the idle output a recognisable
        sporting rhythm without decoding video or continuously changing layout. -->
   <Canvas x:Name="FieldLayer" Width="500" Height="260" Opacity="0.09" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
           SnapsToDevicePixels="False" RenderOptions.EdgeMode="Unspecified">
    <Canvas.Effect><BlurEffect Radius="0.55"/></Canvas.Effect>
    <Canvas.RenderTransform><TranslateTransform x:Name="FieldTranslate"/></Canvas.RenderTransform>
    <Ellipse Canvas.Left="30" Canvas.Top="28" Width="440" Height="204" Stroke="#9BC8EE" StrokeThickness="2"/>
    <Rectangle Canvas.Left="237" Canvas.Top="84" Width="26" Height="92" Stroke="#9BC8EE" StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
    <Line X1="226" Y1="98" X2="274" Y2="98" Stroke="#9BC8EE" StrokeThickness="1.5"/><Line X1="226" Y1="162" X2="274" Y2="162" Stroke="#9BC8EE" StrokeThickness="1.5"/>
    <Line X1="250" Y1="28" X2="250" Y2="232" Stroke="#9BC8EE" StrokeThickness="2"/>
    <Line X1="30" Y1="94" X2="82" Y2="94" Stroke="#9BC8EE" StrokeThickness="2"/>
    <Line X1="418" Y1="166" X2="470" Y2="166" Stroke="#9BC8EE" StrokeThickness="2"/>
   </Canvas>
   <Canvas ClipToBounds="True" IsHitTestVisible="False">
    <Ellipse Width="7" Height="7" Fill="#B9E0FF" Opacity="0.55" Canvas.Left="34" Canvas.Top="42"><Ellipse.RenderTransform><TranslateTransform x:Name="ParticleOneTranslate"/></Ellipse.RenderTransform></Ellipse>
    <Ellipse Width="5" Height="5" Fill="#F2CA66" Opacity="0.50" Canvas.Left="310" Canvas.Top="138"><Ellipse.RenderTransform><TranslateTransform x:Name="ParticleTwoTranslate"/></Ellipse.RenderTransform></Ellipse>
    <Ellipse Width="4" Height="4" Fill="#8EC8F3" Opacity="0.45" Canvas.Left="176" Canvas.Top="22"><Ellipse.RenderTransform><TranslateTransform x:Name="ParticleThreeTranslate"/></Ellipse.RenderTransform></Ellipse>
   </Canvas>
   <Border x:Name="HorizonGlow" Height="3" VerticalAlignment="Bottom" Margin="28,0" Opacity="0.25" IsHitTestVisible="False">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0058A6FF"/><GradientStop Color="#8058A6FF" Offset="0.35"/><GradientStop Color="#80E7B94F" Offset="0.65"/><GradientStop Color="#00E7B94F" Offset="1"/></LinearGradientBrush></Border.Background>
   </Border>
  </Grid>
   <Grid Margin="12,8" IsHitTestVisible="False">
    <TextBlock x:Name="ClockText" Text="8:05 PM" Foreground="#F3F8FC" FontFamily="Arial" FontSize="34" FontWeight="Black"
               VerticalAlignment="Bottom" HorizontalAlignment="Right">
     <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
    </TextBlock>
   </Grid>
  <Grid.Triggers>
   <EventTrigger RoutedEvent="FrameworkElement.Loaded">
    <BeginStoryboard>
     <Storyboard RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="BeamOneTranslate" Storyboard.TargetProperty="X" From="-20" To="470" Duration="0:0:18" AutoReverse="True">
       <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="BeamTwoTranslate" Storyboard.TargetProperty="X" From="40" To="-430" Duration="0:0:22" AutoReverse="True">
       <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="FieldTranslate" Storyboard.TargetProperty="X" From="-12" To="12" Duration="0:0:16" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="FieldTranslate" Storyboard.TargetProperty="Y" From="-5" To="5" Duration="0:0:21" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ParticleOneTranslate" Storyboard.TargetProperty="X" From="0" To="310" Duration="0:0:13" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ParticleOneTranslate" Storyboard.TargetProperty="Y" From="0" To="72" Duration="0:0:9" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ParticleTwoTranslate" Storyboard.TargetProperty="X" From="0" To="-250" Duration="0:0:17" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ParticleTwoTranslate" Storyboard.TargetProperty="Y" From="0" To="-92" Duration="0:0:14" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ParticleThreeTranslate" Storyboard.TargetProperty="X" From="0" To="135" Duration="0:0:11" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="HorizonGlow" Storyboard.TargetProperty="Opacity" From="0.16" To="0.48" Duration="0:0:4" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
     </Storyboard>
    </BeginStoryboard>
   </EventTrigger>
  </Grid.Triggers>
 </Grid>
</UserControl>
