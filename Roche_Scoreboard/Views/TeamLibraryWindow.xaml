<Window x:Class="Roche_Scoreboard.Views.TeamLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:Roche_Scoreboard.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:design="clr-namespace:Roche_Scoreboard.Services" design:OperatorDesign.IsEnabled="True"
        Title="Club Library" Width="1080" Height="760" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner" WindowStyle="None" Background="{DynamicResource ControlCentre.CanvasBrush}" Foreground="{DynamicResource ControlCentre.TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="30"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DesignSystem/DarkTheme.xaml"/>
                <ResourceDictionary Source="/Resources/OperatorControls.xaml"/>
                <ResourceDictionary Source="/Resources/SettingsControls.xaml"/>
                <ResourceDictionary Source="/Resources/ControlCentre.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="LibraryButton" TargetType="Button" BasedOn="{StaticResource ControlCentre.Button}">
                <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="14,8"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsChoice}"/>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource SettingsChoiceItem}"/>
            <Style TargetType="TextBox" BasedOn="{StaticResource SettingsInput}">
                <Setter Property="FontSize" Value="16"/><Setter Property="MinHeight" Value="44"/>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsToggle}"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="LibrarySurface" Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <glass:OperatorGlassSurface x:Name="LibraryToolbar" Material="Regular" CornerRadius="28" Padding="22" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="#58FFFFFF" BorderThickness="1"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="CLUB LIBRARY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}"/>
                <TextBlock x:Name="TargetHeading" Text="Choose a team" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="CatalogueDescription" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="×" ToolTip="Close club library" Width="36" Height="36" MinHeight="0" Padding="0" FontSize="22" VerticalAlignment="Top" Style="{StaticResource LibraryButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
        </Grid></glass:OperatorGlassSurface>
        <WrapPanel Grid.Row="1" Margin="0,20,0,16">
            <StackPanel Width="280" Margin="0,0,10,10"><TextBlock Text="Club name or abbreviation" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" Margin="0,0,0,5"/><glass:OperatorSearchBox x:Name="SearchBox" Placeholder="Search clubs" TextChanged="Search_Changed" ToolTip="Search clubs" AutomationProperties.Name="Search clubs"/></StackPanel>
            <StackPanel Width="205" Margin="0,0,10,10"><TextBlock Text="Competition" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" Margin="0,0,0,5"/><ComboBox x:Name="LeagueFilter" SelectionChanged="Filter_Changed"><ComboBoxItem Content="All leagues" IsSelected="True"/></ComboBox></StackPanel>
            <StackPanel Width="125" Margin="0,0,10,10"><TextBlock Text="State" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" Margin="0,0,0,5"/><ComboBox x:Name="StateFilter" SelectionChanged="Filter_Changed"><ComboBoxItem Content="All states" IsSelected="True"/><ComboBoxItem Content="VIC"/><ComboBoxItem Content="NSW"/><ComboBoxItem Content="QLD"/><ComboBoxItem Content="SA"/><ComboBoxItem Content="WA"/></ComboBox></StackPanel>
            <StackPanel Width="145" Margin="0,0,10,10"><TextBlock Text="Sort clubs" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" Margin="0,0,0,5"/><ComboBox x:Name="SortFilter" SelectionChanged="Filter_Changed"><ComboBoxItem Content="A–Z" IsSelected="True"/><ComboBoxItem Content="Favourites"/><ComboBoxItem Content="League"/><ComboBoxItem Content="State"/></ComboBox></StackPanel>
            <CheckBox x:Name="FavouriteOnly" Content="Saved clubs" Width="160" Margin="0,16,0,10" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        </WrapPanel>
        <Grid x:Name="ClubContent" Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="1.2*"/><ColumnDefinition x:Name="DetailColumn" Width=".8*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <glass:OperatorGlassSurface x:Name="ListSurface" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="8">
                <Grid>
                    <ListBox x:Name="TeamList" Height="390" Background="Transparent" BorderThickness="0" SelectionChanged="TeamList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="design:OperatorControlMotion.Enabled" Value="True"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="{DynamicResource ControlCentre.SurfaceBrush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="20" Padding="12,10" RenderTransformOrigin=".5,.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="TbSc"/></Border.RenderTransform>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid Width="46" Height="46"><Border Background="{Binding PrimaryColor}" Opacity=".22" CornerRadius="13"/><TextBlock Text="{Binding Abbreviation}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/><Image Source="{Binding PreviewLogo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="3"/></Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding TeamName}" Foreground="{DynamicResource ControlCentre.TextBrush}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding League}" FontSize="12" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" Margin="0,3,0,0"/></StackPanel>
                                            <design:OperatorSymbol x:Name="SavedStar" Grid.Column="2" Kind="favourite" IsActive="True" Foreground="#FFD166" Width="18" Height="18" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <Border x:Name="SelectedMark" Grid.Column="3" Margin="8,0,0,0" Width="25" Height="25" CornerRadius="12.5" Background="{DynamicResource ControlCentre.AccentBrush}" Visibility="Hidden" VerticalAlignment="Center"><design:OperatorSymbol Kind="check" IsActive="{TemplateBinding IsSelected}" Foreground="#101318" Margin="4"/></Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFavourite}" Value="True"><Setter TargetName="SavedStar" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlCentre.RaisedBrush}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlCentre.SelectionBrush}"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlCentre.AccentBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock x:Name="EmptyResults" Text="No clubs found. Try another name or clear the filters." Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" TextWrapping="Wrap" Margin="24" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
            </glass:OperatorGlassSurface>
            <glass:OperatorGlassSurface x:Name="DetailSurface" Grid.Column="1" Background="{DynamicResource ControlCentre.GlassBrush}" BorderBrush="{DynamicResource ControlCentre.BorderBrush}" BorderThickness="1" CornerRadius="28" Padding="22" Margin="16,0,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="DetailContent" VerticalAlignment="Center">
                        <StackPanel.RenderTransform><TranslateTransform x:Name="DetailTranslate"/></StackPanel.RenderTransform>
                        <Grid Height="126"><TextBlock x:Name="LogoPlaceholder" Text="Choose a club to preview its crest and colours" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="LogoPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                        <TextBlock x:Name="SelectedName" Text="Your club, ready to score" FontSize="23" FontWeight="Bold" TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedMeta" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="13" TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Border x:Name="PrimarySwatch" Width="64" Height="8"/><Border x:Name="SecondarySwatch" Width="64" Height="8" Margin="6,0,0,0"/></StackPanel>
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="12" TextAlignment="Center" Margin="0,10,0,10" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PresetStatus" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="12" TextAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Button x:Name="UseButton" Content="Use this team" Style="{StaticResource ControlCentre.PrimaryButton}" Click="Use_Click" IsEnabled="False" Margin="0,0,0,8"/>
                        <Button x:Name="FavouriteButton" Content="Save to presets" Tag="False" Style="{StaticResource SettingsSavedAction}" Click="Favourite_Click" IsEnabled="False">
                            <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><design:OperatorSymbol Kind="favourite" Width="19" Height="19" Margin="0,0,9,0" Foreground="#FFD166" IsActive="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate></Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                </Grid>
            </glass:OperatorGlassSurface>
        </Grid>
        <TextBlock x:Name="ResultCount" Grid.Row="3" Foreground="{DynamicResource ControlCentre.SecondaryTextBrush}" FontSize="12" Margin="2,12,0,0"/>
    </Grid>
    </ScrollViewer>
    </Grid>
</Window>
